<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= seo.title %></title>
    <meta name="description" content="<%= seo.desc %>">
    <link rel="canonical" href="<%= settings.siteUrl %><%= seo.path %>">
    <link rel="stylesheet" href="/public/css/style.css">
</head>
<body>
    <header id="main-header">
        <div class="container nav-container">
            <a href="/" class="logo"><span class="logo-mark"></span><%= settings.siteName || 'Dents Web' %></a>
            <div class="hamburger" id="hamburger-btn"><span></span><span></span><span></span></div>
            <nav class="nav-links" id="nav-links">
                <a href="/">Home</a>
                <a href="/services">Services</a>
                <a href="/portfolio">Portfolio</a>
                <a href="/pricing">Pricing</a>
                <a href="/about">About</a>
                <a href="/contact">Contact</a>
                <a href="/faq" class="active">FAQ</a>
            </nav>
        </div>
    </header>

    <main>
        <section class="section section-pt-hero">
            <div class="container">
                <div class="text-center" style="max-width: 600px; margin: 0 auto 80px;">
                    <h1 style="margin-bottom: 16px;">FAQ</h1>
                    <p>Pertanyaan yang sering diajukan terkait proses dan layanan teknis kami.</p>
                </div>
                
                <div style="max-width: 800px; margin: 0 auto; display: flex; flex-direction: column; gap: 16px;">
                    <% if(faq && faq.length > 0) { %>
                        <% faq.forEach(item => { %>
                            <div class="glass-panel" style="padding: 24px; cursor: pointer; border-left: 4px solid var(--primary);">
                                <h3 style="font-size: 1.2rem; margin-bottom: 8px;"><%= item.question %></h3>
                                <p style="margin-bottom: 0;"><%= item.answer %></p>
                            </div>
                        <% }) %>
                    <% } else { %>
                        <p class="text-center">FAQ belum tersedia.</p>
                    <% } %>
                </div>
                
                <div class="text-center" style="margin-top: 60px;">
                    <p style="margin-bottom: 16px;">Punya pertanyaan spesifik tentang bisnis Anda?</p>
                    <a href="/contact" class="btn btn-secondary">Hubungi Engineer Kami</a>
                </div>
            </div>
        </section>
    </main>

    <footer class="section" style="border-top: 1px solid var(--glass-border); padding-bottom: 40px;">
        <div class="container text-center" style="color: var(--text-muted); font-size: 0.9rem;">
            &copy; <span id="year"></span> <%= settings.siteName || 'Dents Web' %>. All rights reserved.
        </div>
    </footer>
    <script>
        document.getElementById('year').textContent = new Date().getFullYear();
        window.addEventListener('scroll', () => document.getElementById('main-header').classList.toggle('scrolled', window.scrollY > 20));
        document.getElementById('hamburger-btn').addEventListener('click', () => document.getElementById('nav-links').classList.toggle('mobile-open'));
    </script>
</body>
</html>