<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="theme-color" content="#05081c">
    
    <!-- DYNAMIC SEO GOLD STANDARD -->
    <title><%= typeof seo !== 'undefined' ? seo.title : 'FAQ | Dents Web' %></title>
    <meta name="description" content="<%= typeof seo !== 'undefined' ? seo.desc : 'Pertanyaan yang sering ditanyakan seputar proses pengerjaan, sistem pembayaran, keamanan, dan kepemilikan aset di Dents Web.' %>">
    <meta name="keywords" content="<%= typeof seo !== 'undefined' ? seo.keywords : 'faq website, tanya jawab pembuatan web, panduan pesan website, Dents Web' %>">
    <link rel="canonical" href="<%= typeof settings !== 'undefined' && settings.siteUrl ? settings.siteUrl : 'https://dentsweb.my.id' %><%= typeof seo !== 'undefined' ? seo.path : '/faq' %>">
    
    <!-- Google Site Verification -->
    <% if (typeof settings !== 'undefined' && settings.googleVerification) { %>
    <meta name="google-site-verification" content="<%= settings.googleVerification %>" />
    <% } %>
    
    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="article">
    <meta property="og:url" content="<%= typeof settings !== 'undefined' && settings.siteUrl ? settings.siteUrl : 'https://dentsweb.my.id' %><%= typeof seo !== 'undefined' ? seo.path : '/faq' %>">
    <meta property="og:title" content="<%= typeof seo !== 'undefined' ? seo.title : 'FAQ | Dents Web' %>">
    <meta property="og:description" content="<%= typeof seo !== 'undefined' ? seo.desc : '' %>">
    <meta property="og:image" content="<%= typeof seo !== 'undefined' ? seo.image : '/public/img/axalogo.png' %>">
    
    <!-- Twitter Cards -->
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:url" content="<%= typeof settings !== 'undefined' && settings.siteUrl ? settings.siteUrl : 'https://dentsweb.my.id' %><%= typeof seo !== 'undefined' ? seo.path : '/faq' %>">
    <meta name="twitter:title" content="<%= typeof seo !== 'undefined' ? seo.title : 'FAQ | Dents Web' %>">
    <meta name="twitter:description" content="<%= typeof seo !== 'undefined' ? seo.desc : '' %>">
    <meta name="twitter:image" content="<%= typeof seo !== 'undefined' ? seo.image : '/public/img/axalogo.png' %>">

    <!-- Schema.org JSON-LD -->
    <% if (typeof seo !== 'undefined' && seo.schemaString) { %>
    <script type="application/ld+json">
        <%- seo.schemaString %>
    </script>
    <% } %>
    
    <link rel="icon" type="image/png" href="<%= typeof settings !== 'undefined' && settings.favicon ? settings.favicon : '/public/img/axalogo.png' %>">
    <link rel="apple-touch-icon" href="<%= typeof settings !== 'undefined' && settings.logo ? settings.logo : '/public/img/axalogo.png' %>">
    
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Lexend+Deca:wght@500;600;700;800&family=Playfair+Display:ital,wght@1,400;1,500;1,600;1,700&family=Plus+Jakarta+Sans:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
    
    <link rel="stylesheet" href="/public/css/style.css">
</head>
<body>
    
    <%- include('partials/header') %>

    <main>
        <!-- FAQ Hero -->
        <section class="section-hero" style="min-height: 45vh; padding-top: 150px; padding-bottom: 60px;">
            <div class="orb-glow-blue" style="top: -10%; left: -5%;"></div>
            <div class="orb-glow-lime" style="bottom: -15%; right: 5%; opacity: 0.1;"></div>

            <div class="container text-center" style="position: relative; z-index: 2; max-width: 820px;">
                <div class="badge-tag-lime" style="margin-bottom: 20px;">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"></path><line x1="12" y1="17" x2="12.01" y2="17"></line></svg>
                    FREQUENTLY ASKED QUESTIONS
                </div>
                <h1 style="margin-bottom: 20px;">
                    Tanya Jawab &amp; <span class="font-editorial text-lime">Solusi Jelas</span>
                </h1>
                <p style="font-size: 1.15rem; color: rgba(255,255,255,0.76); line-height: 1.75;">
                    Semua jawaban transparan seputar durasi pengerjaan, skema pembayaran, kepemilikan aset, dan jaminan keamanan kode lu.
                </p>
            </div>
        </section>

        <!-- FAQ Section (Tactile Style) -->
        <section class="section-white" style="padding-top: 70px; padding-bottom: 100px;">
            <div class="container">
                <div class="process-grid">
                    <!-- Left Sticky Info -->
                    <div class="sticky-col">
                        <div class="badge-tag-royal" style="margin-bottom: 16px;">KONSULTASI LANGSUNG</div>
                        <h2 style="font-size: clamp(2rem, 3.5vw, 2.8rem); line-height: 1.2; color: var(--navy-text); margin-bottom: 16px;">
                            Punya Pertanyaan <span class="font-editorial text-royal">Lainnya?</span>
                        </h2>
                        <p style="font-size: 1.05rem; line-height: 1.7; margin-bottom: 32px; color: var(--slate-body);">
                            Pertanyaan di samping adalah yang paling sering ditanyakan klien. Masih ada hal teknis atau spesifikasi khusus yang mau diobrolin? Langsung kontak tim kami.
                        </p>
                        <a href="/contact" class="btn-royal" style="display: inline-flex; align-items: center; gap: 8px;">
                            <span>Hubungi Kami Langsung</span>
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="7" y1="17" x2="17" y2="7"></line><polyline points="7 7 17 7 17 17"></polyline></svg>
                        </a>
                    </div>

                    <!-- Right Accordion List -->
                    <div>
                        <div class="faq-accordion">
                            <% if (typeof faq !== 'undefined' && faq.length > 0) { %>
                                <% faq.forEach((item, idx) => { %>
                                    <div class="faq-item-kalana <%= idx === 0 ? 'active' : '' %>">
                                        <button class="faq-question-btn" onclick="toggleFaq(this)" aria-expanded="<%= idx === 0 ? 'true' : 'false' %>">
                                            <span><%= item.question %></span>
                                            <span class="faq-arrow-icon">
                                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg>
                                            </span>
                                        </button>
                                        <div class="faq-answer-body">
                                            <%= item.answer %>
                                        </div>
                                    </div>
                                <% }) %>
                            <% } else { %>
                                <!-- Fallback FAQ List with 100% SVG Icons -->
                                <div class="faq-item-kalana active">
                                    <button class="faq-question-btn" onclick="toggleFaq(this)">
                                        <span>Berapa lama estimasi pengerjaan website sampai siap live?</span>
                                        <span class="faq-arrow-icon">
                                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg>
                                        </span>
                                    </button>
                                    <div class="faq-answer-body">
                                        Buat Landing Page atau Company Profile standar, durasi pengerjaan antara 3 sampai 7 hari kerja. Buat sistem web aplikasi kustom dengan database dan integrasi API khusus, rata-rata 2 sampai 4 minggu kerja setelah materi disetujui bersama.
                                    </div>
                                </div>

                                <div class="faq-item-kalana">
                                    <button class="faq-question-btn" onclick="toggleFaq(this)">
                                        <span>Bagaimana skema pembayaran di Dents Web?</span>
                                        <span class="faq-arrow-icon">
                                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg>
                                        </span>
                                    </button>
                                    <div class="faq-answer-body">
                                        Skema pembayaran standar kami transparan: Down Payment (DP) 50% di awal saat kick-off proyek, dan sisa pelunasan 50% dibayarkan setelah tahap review tuntas dan sistem siap di-deploy ke domain utama milik lu.
                                    </div>
                                </div>

                                <div class="faq-item-kalana">
                                    <button class="faq-question-btn" onclick="toggleFaq(this)">
                                        <span>Apakah website yang dibuat dijamin aman dari serangan siber?</span>
                                        <span class="faq-arrow-icon">
                                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg>
                                        </span>
                                    </button>
                                    <div class="faq-answer-body">
                                        Jelas aman. Kami menerapkan proteksi bertingkat: Helmet HTTP Headers, mitigasi XSS/CSRF, proteksi brute-force rate limiting, SSL/TLS TLS 1.3 enkripsi penuh, serta routing edge via Cloudflare.
                                    </div>
                                </div>

                                <div class="faq-item-kalana">
                                    <button class="faq-question-btn" onclick="toggleFaq(this)">
                                        <span>Apakah klien mendapatkan akses penuh ke source code?</span>
                                        <span class="faq-arrow-icon">
                                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg>
                                        </span>
                                    </button>
                                    <div class="faq-answer-body">
                                        100% Ya! Setelah pelunasan, seluruh kepemilikan source code, akun domain, dan kredensial hosting/database diserahkan mutlak ke lu tanpa ikatan sewa platform proprietary bulanan yang mengunci.
                                    </div>
                                </div>

                                <div class="faq-item-kalana">
                                    <button class="faq-question-btn" onclick="toggleFaq(this)">
                                        <span>Apakah ada garansi purnajual jika terjadi kendala atau bug?</span>
                                        <span class="faq-arrow-icon">
                                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg>
                                        </span>
                                    </button>
                                    <div class="faq-answer-body">
                                        Tiap paket sudah dilengkapi garansi maintenance dan bug-fixing gratis selama 30 hari pertama pasca-launching. Tim kami tetap stand by buat konsultasi jangka panjang sesuai kebutuhan scale lu.
                                    </div>
                                </div>
                            <% } %>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </main>

    <%- include('partials/footer') %>

    <script>
        function toggleFaq(btn) {
            const item = btn.closest('.faq-item-kalana');
            const isActive = item.classList.contains('active');
            
            document.querySelectorAll('.faq-item-kalana').forEach(i => {
                i.classList.remove('active');
                const qBtn = i.querySelector('.faq-question-btn');
                if (qBtn) qBtn.setAttribute('aria-expanded', 'false');
            });
            
            if (!isActive) {
                item.classList.add('active');
                btn.setAttribute('aria-expanded', 'true');
            }
        }
    </script>
</body>
</html>
