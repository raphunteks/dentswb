<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="theme-color" content="#05081c">
    
    <!-- DYNAMIC SEO GOLD STANDARD -->
    <title><%= typeof seo !== 'undefined' ? seo.title : 'Artikel & Materi | Dents Web' %></title>
    <meta name="description" content="<%= typeof seo !== 'undefined' ? seo.desc : 'Wawasan rekayasa web, tutorial teknis, dan standar industri pemrograman modern.' %>">
    <meta name="keywords" content="<%= typeof seo !== 'undefined' ? seo.keywords : 'artikel pemrograman, tutorial web, frontend, backend, devops' %>">
    <link rel="canonical" href="<%= typeof seo !== 'undefined' ? seo.url : 'https://dentsweb.my.id/articles' %>">
    
    <!-- Google Site Verification -->
    <% if (typeof settings !== 'undefined' && settings.googleVerification) { %>
    <meta name="google-site-verification" content="<%= settings.googleVerification %>" />
    <% } %>
    
    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website">
    <meta property="og:url" content="<%= typeof seo !== 'undefined' ? seo.url : 'https://dentsweb.my.id/articles' %>">
    <meta property="og:title" content="<%= typeof seo !== 'undefined' ? seo.title : 'Artikel & Materi | Dents Web' %>">
    <meta property="og:description" content="<%= typeof seo !== 'undefined' ? seo.desc : '' %>">
    <meta property="og:image" content="<%= typeof seo !== 'undefined' ? seo.image : '/public/img/axalogo.png' %>">
    
    <!-- Twitter Cards -->
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:url" content="<%= typeof seo !== 'undefined' ? seo.url : 'https://dentsweb.my.id/articles' %>">
    <meta name="twitter:title" content="<%= typeof seo !== 'undefined' ? seo.title : 'Artikel & Materi | Dents Web' %>">
    <meta name="twitter:description" content="<%= typeof seo !== 'undefined' ? seo.desc : '' %>">
    <meta name="twitter:image" content="<%= typeof seo !== 'undefined' ? seo.image : '/public/img/axalogo.png' %>">

    <!-- Schema.org JSON-LD -->
    <% if (typeof seo !== 'undefined' && seo.schemaString) { %>
    <script type="application/ld+json">
        <%- seo.schemaString %>
    </script>
    <% } %>
    
    <link rel="icon" type="image/png" href="<%= typeof settings !== 'undefined' && settings.favicon ? settings.favicon : '/public/img/axalogo.png' %>">
    <link rel="apple-touch-icon" href="<%= typeof settings !== 'undefined' && settings.logo ? settings.logo : '/public/img/axalogo.png' %>">
    
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Lexend+Deca:wght@500;600;700;800&family=Playfair+Display:ital,wght@1,400;1,500;1,600;1,700&family=Plus+Jakarta+Sans:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
    
    <link rel="stylesheet" href="/public/css/style.css">
    <script src="/public/js/tech-icons.js"></script>
</head>
<body>
    <%- include('partials/header') %>

<main class="main-content" style="background: var(--navy-deep); min-height: 85vh; padding: 60px 0 100px;">
    <!-- Ambient Hero Background -->
    <div style="position: absolute; width: 500px; height: 500px; border-radius: 50%; background: radial-gradient(circle, rgba(33, 82, 207, 0.2) 0%, transparent 70%); top: 100px; left: 10%; filter: blur(80px); pointer-events: none;"></div>
    <div style="position: absolute; width: 400px; height: 400px; border-radius: 50%; background: radial-gradient(circle, rgba(217, 255, 66, 0.08) 0%, transparent 70%); top: 200px; right: 10%; filter: blur(90px); pointer-events: none;"></div>

    <div class="container" style="position: relative; z-index: 2;">
        
        <!-- Hero Header -->
        <header class="section-header" style="text-align: center; max-width: 820px; margin: 0 auto 48px;">
            <div style="display: inline-flex; align-items: center; gap: 8px; padding: 6px 14px; border-radius: 999px; background: rgba(33, 82, 207, 0.15); border: 1px solid rgba(59, 130, 246, 0.3); color: #60a5fa; font-size: 0.8rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em; margin-bottom: 16px;">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path></svg>
                KNOWLEDGE BASE & MATERI TEKNIS
            </div>
            <h1 style="font-size: 2.5rem; font-weight: 800; color: #ffffff; line-height: 1.25; letter-spacing: -0.02em; margin-bottom: 18px;">
                Wawasan Rekayasa Web & Materi Pemrograman Modern
            </h1>
            <p style="font-size: 1.05rem; color: #cbd5e1; line-height: 1.65; max-width: 680px; margin: 0 auto;">
                Dokumentasi arsitektur, panduan teknis praktis, dan standar industri untuk membantu Anda memahami ekosistem teknologi digital.
            </p>
        </header>

        <!-- Search & Filter Controls -->
        <div style="background: rgba(16, 24, 59, 0.7); backdrop-filter: blur(12px); border: 1px solid var(--navy-surface-border); border-radius: var(--radius-lg); padding: 20px 24px; margin-bottom: 40px; display: flex; flex-direction: column; gap: 16px;">
            
            <div style="display: flex; flex-direction: column; gap: 16px; justify-content: space-between; align-items: center;">
                <!-- Category Tabs -->
                <div style="display: flex; flex-wrap: wrap; gap: 8px; width: 100%; justify-content: center;">
                    <% categories.forEach(function(cat) { %>
                        <a href="/articles?category=<%= encodeURIComponent(cat) %><%= searchQuery ? '&q=' + encodeURIComponent(searchQuery) : '' %>" 
                           class="tech-tab-btn <%= selectedCategory.toLowerCase() === cat.toLowerCase() ? 'active' : '' %>"
                           style="text-decoration: none;">
                            <%= cat %>
                        </a>
                    <% }); %>
                </div>

                <!-- Search Input Form -->
                <form action="/articles" method="GET" style="display: flex; gap: 8px; width: 100%; max-width: 460px;">
                    <% if (selectedCategory && selectedCategory !== 'All') { %>
                        <input type="hidden" name="category" value="<%= selectedCategory %>">
                    <% } %>
                    <div style="position: relative; flex: 1;">
                        <input type="text" name="q" value="<%= searchQuery || '' %>" placeholder="Cari materi (misal: CSS, Node.js, SQL)..." 
                               style="width: 100%; padding: 10px 16px 10px 38px; background: #080c24; border: 1px solid #28325a; border-radius: var(--radius-pill); color: #ffffff; font-size: 0.875rem; outline: none;">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#94a3b8" stroke-width="2" style="position: absolute; left: 14px; top: 50%; transform: translateY(-50%);">
                            <circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                        </svg>
                    </div>
                    <button type="submit" style="background: var(--royal-blue); color: #ffffff; border: none; padding: 10px 20px; border-radius: var(--radius-pill); font-size: 0.875rem; font-weight: 700; cursor: pointer; transition: background 0.2s;">
                        Cari
                    </button>
                    <% if (searchQuery || selectedCategory !== 'All') { %>
                        <a href="/articles" style="display: inline-flex; align-items: center; justify-content: center; background: rgba(255, 255, 255, 0.08); color: #94a3b8; border: 1px solid rgba(255, 255, 255, 0.15); border-radius: var(--radius-pill); padding: 0 14px; font-size: 0.8rem; text-decoration: none;" title="Reset Filter">
                            Reset
                        </a>
                    <% } %>
                </form>
            </div>
        </div>

        <!-- Article Card Grid -->
        <% if (articles && articles.length > 0) { %>
            <div class="article-grid">
                <% articles.forEach(function(article) { %>
                    <article class="article-card" itemscope itemtype="https://schema.org/TechArticle">
                        <a href="/article/<%= article.slug %>" class="article-card-cover-link" itemprop="url">
                            <% if (article.coverImage) { %>
                                <img src="<%= article.coverImage %>" alt="<%= article.title %>" class="article-card-cover" itemprop="image" loading="lazy">
                            <% } else { %>
                                <div style="width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; background: linear-gradient(135deg, #0d1230 0%, #10183b 100%); color: var(--royal-blue);">
                                    <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path></svg>
                                </div>
                            <% } %>
                            <span class="article-card-category-badge"><%= article.category || 'Materi' %></span>
                        </a>

                        <div class="article-card-body">
                            <div class="article-card-meta">
                                <span style="display: inline-flex; align-items: center; gap: 6px;">
                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
                                    <time datetime="<%= article.publishedAt || '2026-03-15' %>"><%= article.publishedAt || '15 Mar 2026' %></time>
                                </span>
                                <span>&bull;</span>
                                <span style="display: inline-flex; align-items: center; gap: 6px;">
                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
                                    <%= article.readingTime || '5 menit baca' %>
                                </span>
                            </div>

                            <h2 class="article-card-title" itemprop="headline">
                                <a href="/article/<%= article.slug %>" style="color: inherit; text-decoration: none;">
                                    <%= article.title %>
                                </a>
                            </h2>

                            <p class="article-card-excerpt" itemprop="description">
                                <%= article.excerpt %>
                            </p>

                            <% if (article.tags && article.tags.length > 0) { %>
                                <div style="display: flex; flex-wrap: wrap; gap: 6px; margin-bottom: 18px;">
                                    <% article.tags.slice(0, 3).forEach(function(tag) { %>
                                        <span style="font-size: 0.72rem; padding: 2px 8px; border-radius: 4px; background: rgba(255, 255, 255, 0.05); color: #94a3b8;">
                                            #<%= tag %>
                                        </span>
                                    <% }); %>
                                </div>
                            <% } %>

                            <div class="article-card-footer">
                                <span style="font-size: 0.75rem; color: #94a3b8;">Oleh: <%= article.author || 'Tim Dents Web' %></span>
                                <a href="/article/<%= article.slug %>" class="article-card-readmore">
                                    Pelajari
                                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"></polyline></svg>
                                </a>
                            </div>
                        </div>
                    </article>
                <% }); %>
            </div>
        <% } else { %>
            <div style="background: rgba(16, 24, 59, 0.6); border: 1px dashed var(--navy-surface-border); border-radius: var(--radius-lg); padding: 60px 20px; text-align: center;">
                <div style="width: 64px; height: 64px; border-radius: 50%; background: rgba(33, 82, 207, 0.15); color: #60a5fa; display: inline-flex; align-items: center; justify-content: center; margin-bottom: 16px;">
                    <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
                </div>
                <h3 style="color: #ffffff; font-size: 1.3rem; margin-bottom: 8px;">Tidak Ada Materi Ditemukan</h3>
                <p style="color: #94a3b8; font-size: 0.95rem; max-width: 440px; margin: 0 auto 24px;">
                    Coba kata kunci pencarian yang berbeda atau pilih kategori lain untuk melihat daftar materi artikel.
                </p>
                <a href="/articles" class="btn btn-primary" style="background: var(--royal-blue); color: #ffffff; text-decoration: none; padding: 10px 20px; border-radius: var(--radius-pill); font-weight: 600;">
                    Tampilkan Semua Artikel
                </a>
            </div>
        <% } %>

    </div>
</main>

<%- include('partials/footer') %>
</body>
</html>
