<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= seo.title %></title>
    <meta name="description" content="<%= seo.desc %>">
    <link rel="canonical" href="<%= settings.siteUrl %><%= seo.path %>">
    <link rel="stylesheet" href="/public/css/style.css">
</head>
<body>
    <header id="main-header">
        <div class="container nav-container">
            <a href="/" class="logo"><span class="logo-mark"></span><%= settings.siteName || 'Dents Web' %></a>
            <div class="hamburger" id="hamburger-btn"><span></span><span></span><span></span></div>
            <nav class="nav-links" id="nav-links">
                <a href="/">Home</a>
                <a href="/services">Services</a>
                <a href="/portfolio">Portfolio</a>
                <a href="/pricing">Pricing</a>
                <a href="/about">About</a>
                <a href="/contact" class="active">Contact</a>
                <a href="/faq">FAQ</a>
            </nav>
        </div>
    </header>

    <main>
        <section class="section section-pt-hero">
            <div class="container grid-2">
                <div>
                    <h1 style="margin-bottom: 24px;">Mari Berdiskusi.</h1>
                    <p style="font-size: 1.1rem; margin-bottom: 40px;">Ceritakan masalah dan target bisnis Anda. Tim engineer kami akan merancang arsitektur yang tepat untuk eksekusi yang optimal.</p>
                    
                    <div style="margin-bottom: 24px;">
                        <h4 style="color: var(--text-secondary);">Email</h4>
                        <p style="font-weight: 500; font-size: 1.1rem;"><%= settings.email %></p>
                    </div>
                    <div>
                        <h4 style="color: var(--text-secondary);">WhatsApp</h4>
                        <p style="font-weight: 500; font-size: 1.1rem;"><%= settings.whatsapp %></p>
                    </div>
                </div>

                <div class="glass-panel glass-panel-p">
                    <form id="contact-form">
                        <div id="form-alert" style="display:none; padding: 16px; border-radius: var(--radius-sm); margin-bottom: 24px; font-weight: 500;"></div>
                        
                        <div class="form-group">
                            <label class="form-label">Nama Lengkap *</label>
                            <input type="text" class="form-control" name="name" required>
                        </div>
                        <div class="form-group">
                            <label class="form-label">Nomor WhatsApp *</label>
                            <input type="tel" class="form-control" name="whatsapp" required>
                        </div>
                        <div class="form-group">
                            <label class="form-label">Email Aktif</label>
                            <input type="email" class="form-control" name="email">
                        </div>
                        <div class="form-group">
                            <label class="form-label">Perusahaan / Brand</label>
                            <input type="text" class="form-control" name="company">
                        </div>
                        <div class="form-group">
                            <label class="form-label">Ceritakan Singkat Project Anda *</label>
                            <textarea class="form-control" name="message" rows="5" required></textarea>
                        </div>
                        <button type="submit" class="btn btn-primary" style="width: 100%;" id="btn-submit">Kirim Pesan Request</button>
                    </form>
                </div>
            </div>
        </section>
    </main>

    <footer class="section" style="border-top: 1px solid var(--glass-border); padding-bottom: 40px;">
        <div class="container text-center" style="color: var(--text-muted); font-size: 0.9rem;">
            &copy; <span id="year"></span> <%= settings.siteName || 'Dents Web' %>. All rights reserved.
        </div>
    </footer>

    <script>
        document.getElementById('year').textContent = new Date().getFullYear();
        window.addEventListener('scroll', () => document.getElementById('main-header').classList.toggle('scrolled', window.scrollY > 20));
        document.getElementById('hamburger-btn').addEventListener('click', () => document.getElementById('nav-links').classList.toggle('mobile-open'));

        document.getElementById('contact-form').addEventListener('submit', async (e) => {
            e.preventDefault();
            const btn = document.getElementById('btn-submit');
            const alertBox = document.getElementById('form-alert');
            btn.textContent = 'Memproses...';
            btn.disabled = true;

            const formData = new FormData(e.target);
            const payload = Object.fromEntries(formData.entries());

            try {
                const res = await fetch('/api/leads', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload)
                });
                const data = await res.json();

                alertBox.style.display = 'block';
                if(res.ok && data.success) {
                    alertBox.style.backgroundColor = 'rgba(16, 185, 129, 0.1)';
                    alertBox.style.color = 'var(--success)';
                    alertBox.style.border = '1px solid var(--success)';
                    alertBox.textContent = data.message;
                    e.target.reset();
                } else {
                    throw new Error(data.message || 'Terjadi kesalahan sistem.');
                }
            } catch (err) {
                alertBox.style.display = 'block';
                alertBox.style.backgroundColor = 'rgba(239, 68, 68, 0.1)';
                alertBox.style.color = 'var(--danger)';
                alertBox.style.border = '1px solid var(--danger)';
                alertBox.textContent = err.message;
            } finally {
                btn.textContent = 'Kirim Pesan Request';
                btn.disabled = false;
            }
        });
    </script>
</body>
</html>