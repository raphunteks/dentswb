<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="theme-color" content="#05081c">
    
    <!-- DYNAMIC SEO GOLD STANDARD -->
    <title><%= typeof seo !== 'undefined' ? seo.title : 'Hubungi Kami | Dents Web' %></title>
    <meta name="description" content="<%= typeof seo !== 'undefined' ? seo.desc : 'Ceritakan ide dan target bisnis lu. Tim arsitek kami siap merancang solusi digital berkelas dengan konversi optimal.' %>">
    <meta name="keywords" content="<%= typeof seo !== 'undefined' ? seo.keywords : 'kontak web developer, jasa website, hubungi pembuat aplikasi, Dents Web' %>">
    <link rel="canonical" href="<%= typeof seo !== 'undefined' ? seo.url : 'https://www.dentsweb.my.id/contact' %>">
    <meta name="referrer" content="origin-when-cross-origin">
    <% if (typeof settings !== 'undefined' && settings.analyticsId) { %>
    <script async src="https://www.googletagmanager.com/gtag/js?id=<%= settings.analyticsId %>"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', '<%= settings.analyticsId %>');
    </script>
    <% } %>
    
    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="article">
    <meta property="og:url" content="<%= typeof seo !== 'undefined' ? seo.url : 'https://www.dentsweb.my.id/contact' %>">
    <meta property="og:title" content="<%= typeof seo !== 'undefined' ? seo.title : 'Hubungi Kami | Dents Web' %>">
    <meta property="og:description" content="<%= typeof seo !== 'undefined' ? seo.desc : '' %>">
    <meta property="og:image" content="<%= typeof seo !== 'undefined' ? seo.image : '/public/img/axalogo.png' %>">
    
    <!-- Twitter Cards -->
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:url" content="<%= typeof seo !== 'undefined' ? seo.url : 'https://www.dentsweb.my.id/contact' %>">
    <meta name="twitter:title" content="<%= typeof seo !== 'undefined' ? seo.title : 'Hubungi Kami | Dents Web' %>">
    <meta name="twitter:description" content="<%= typeof seo !== 'undefined' ? seo.desc : '' %>">
    <meta name="twitter:image" content="<%= typeof seo !== 'undefined' ? seo.image : '/public/img/axalogo.png' %>">

    <!-- Schema.org JSON-LD -->
    <% if (typeof seo !== 'undefined' && seo.schemaString) { %>
    <script type="application/ld+json">
        <%- seo.schemaString %>
    </script>
    <% } %>
    
    <link rel="icon" type="image/png" href="<%= typeof settings !== 'undefined' && settings.favicon ? settings.favicon : '/public/img/axalogo.png' %>">
    <link rel="apple-touch-icon" href="<%= typeof settings !== 'undefined' && settings.logo ? settings.logo : '/public/img/axalogo.png' %>">
    
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Lexend+Deca:wght@500;600;700;800&family=Playfair+Display:ital,wght@1,400;1,500;1,600;1,700&family=Plus+Jakarta+Sans:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
    
    <link rel="stylesheet" href="/public/css/style.css">
</head>
<body>
    
    <%- include('partials/header') %>

    <main>
        <!-- Contact Hero -->
        <section class="section-hero" style="min-height: 48vh; padding-top: 150px; padding-bottom: 60px;">
            <div class="orb-glow-blue" style="top: -10%; left: -5%;"></div>
            <div class="orb-glow-lime" style="bottom: -15%; right: 5%; opacity: 0.1;"></div>

            <div class="container text-center pptx-slide-up" style="position: relative; z-index: 2; max-width: 820px;">
                <div class="badge-tag-lime" style="margin-bottom: 20px;">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path></svg>
                    KONSULTASI GRATIS &bull; RESPON CEPAT
                </div>
                <h1 style="margin-bottom: 20px;">
                    Mulai Sesuatu yang <span class="font-editorial text-lime">Luar Biasa</span>
                </h1>
                <p style="font-size: 1.15rem; color: rgba(255,255,255,0.76); line-height: 1.75;">
                    Ceritakan roadmap dan ekspektasi bisnis lu. Tim kami siap dengerin, analisis kebutuhan teknis, dan kasih solusi konkret tanpa basa-basi.
                </p>
            </div>
        </section>

        <!-- Contact Form & Info (Tactile Grid Layout) -->
        <section class="section-white" style="padding-top: 70px; padding-bottom: 100px;">
            <div class="container">
                <div class="process-grid">
                    <!-- Left Column: Contact Cards -->
                    <div class="sticky-col pptx-swift-right">
                        <div class="badge-tag-royal" style="margin-bottom: 16px;">SALURAN RESMI</div>
                        <h2 style="font-size: clamp(2rem, 3.5vw, 2.6rem); color: var(--navy-text); margin-bottom: 16px; line-height: 1.2;">
                            Terhubung Langsung bareng <span class="font-editorial text-royal">Tim Kami</span>
                        </h2>
                        <p style="font-size: 1rem; color: var(--slate-body); margin-bottom: 32px; line-height: 1.7;">
                            Mau tanya-tanya santai atau butuh proposal kilat? Hubungi saluran resmi kami kapan saja:
                        </p>

                        <div style="display: flex; flex-direction: column; gap: 16px;">
                            <!-- WhatsApp -->
                            <a href="https://wa.me/<%= typeof settings !== 'undefined' && settings.whatsapp ? settings.whatsapp : '6285338922586' %>?text=Halo%20Dents%20Web,%20saya%20tertarik%20untuk%20konsultasi%20proyek%20website." target="_blank" rel="noopener noreferrer" class="tactile-card" style="padding: 20px 24px; display: flex; align-items: center; gap: 20px; text-decoration: none; background: #ffffff;">
                                <div style="width: 48px; height: 48px; border-radius: 12px; background: rgba(37, 211, 102, 0.15); color: #25D366; display: flex; align-items: center; justify-content: center; flex-shrink: 0;">
                                    <svg width="26" height="26" viewBox="0 0 24 24" fill="currentColor"><path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.711 2.598 2.664-.699c.971.53 1.77.78 2.796.78 3.182 0 5.768-2.587 5.768-5.766.001-3.187-2.575-5.766-5.768-5.766zm9.969 5.766c0 5.503-4.469 9.972-9.971 9.972-.1.002-.2 0-.299-.005l-4.729 1.24a1 1 0 0 1-1.22-1.22l1.242-4.73C5.556 15.65 5 13.882 5 11.938 5 6.435 9.469 1.966 14.971 1.966 20.473 1.966 22 6.435 22 11.938z"/></svg>
                                </div>
                                <div>
                                    <div style="font-size: 0.78rem; font-weight: 800; text-transform: uppercase; color: var(--royal-blue); letter-spacing: 1px;">WhatsApp Resmi</div>
                                    <div style="font-size: 1.1rem; font-weight: 700; color: var(--navy-text);"><%= typeof settings !== 'undefined' && settings.whatsapp ? '+' + settings.whatsapp : '+62 853 3892 2586' %></div>
                                </div>
                            </a>

                            <!-- Email -->
                            <a href="mailto:<%= typeof settings !== 'undefined' && settings.email ? settings.email : 'dentswebsitebuilder@gmail.com' %>" class="tactile-card" style="padding: 20px 24px; display: flex; align-items: center; gap: 20px; text-decoration: none; background: #ffffff;">
                                <div style="width: 48px; height: 48px; border-radius: 12px; background: rgba(33, 82, 207, 0.12); color: var(--royal-blue); display: flex; align-items: center; justify-content: center; flex-shrink: 0;">
                                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline></svg>
                                </div>
                                <div>
                                    <div style="font-size: 0.78rem; font-weight: 800; text-transform: uppercase; color: var(--royal-blue); letter-spacing: 1px;">Email Resmi</div>
                                    <div style="font-size: 1.05rem; font-weight: 700; color: var(--navy-text); word-break: break-all;"><%= typeof settings !== 'undefined' && settings.email ? settings.email : 'dentswebsitebuilder@gmail.com' %></div>
                                </div>
                            </a>

                            <!-- Lokasi -->
                            <div class="tactile-card" style="padding: 20px 24px; display: flex; align-items: center; gap: 20px; background: #ffffff;">
                                <div style="width: 48px; height: 48px; border-radius: 12px; background: rgba(217, 255, 66, 0.25); color: #166534; display: flex; align-items: center; justify-content: center; flex-shrink: 0;">
                                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>
                                </div>
                                <div>
                                    <div style="font-size: 0.78rem; font-weight: 800; text-transform: uppercase; color: var(--royal-blue); letter-spacing: 1px;">Lokasi Studio</div>
                                    <div style="font-size: 1.05rem; font-weight: 700; color: var(--navy-text);"><%= typeof settings !== 'undefined' && settings.address ? settings.address : 'Indonesia (Remote-First Studio)' %></div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Right Column: Tactile Form Card -->
                    <div class="pptx-swift-left">
                        <div class="tactile-card tactile-card-heavy" style="background: #ffffff;">
                            <h3 style="font-size: 1.5rem; color: var(--navy-text); margin-bottom: 8px;">Kirim Pesan &amp; Brief Proyek</h3>
                            <p style="font-size: 0.95rem; color: var(--slate-body); margin-bottom: 28px;">
                                Isi data singkat di bawah ini. Tim kami bakal balas secepatnya maksimal dalam 1x24 jam via WhatsApp.
                            </p>

                            <form id="contact-form">
                                <div id="form-alert" style="display:none; padding: 16px; border-radius: var(--radius-md); margin-bottom: 24px; font-weight: 600; font-size: 0.95rem;"></div>

                                <!-- Service Selector Pills -->
                                <div class="form-group">
                                    <label class="form-label">Pilih Layanan Yang Dibutuhkan *</label>
                                    <div class="radio-pill-group">
                                        <input type="radio" id="srv_web" name="service_type" value="Web Development" class="radio-pill-input" checked>
                                        <label for="srv_web" class="radio-pill-label">Web Development</label>

                                        <input type="radio" id="srv_sys" name="service_type" value="Sistem Informasi" class="radio-pill-input">
                                        <label for="srv_sys" class="radio-pill-label">Sistem Informasi</label>

                                        <input type="radio" id="srv_uiux" name="service_type" value="UI/UX Design" class="radio-pill-input">
                                        <label for="srv_uiux" class="radio-pill-label">UI/UX Design</label>

                                        <input type="radio" id="srv_other" name="service_type" value="Lainnya" class="radio-pill-input">
                                        <label for="srv_other" class="radio-pill-label">Konsultasi Custom</label>
                                    </div>
                                </div>

                                <!-- Name & WhatsApp Grid -->
                                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px;">
                                    <div class="form-group">
                                        <label class="form-label">Nama Lengkap *</label>
                                        <input type="text" class="form-control" name="name" placeholder="Cth: Budi Pratama" required>
                                    </div>
                                    <div class="form-group">
                                        <label class="form-label">Nomor WhatsApp *</label>
                                        <input type="tel" class="form-control" name="whatsapp" placeholder="Cth: 08123456789" required>
                                    </div>
                                </div>

                                <div class="form-group">
                                    <label class="form-label">Alamat Email (Opsional)</label>
                                    <input type="email" class="form-control" name="email" placeholder="Cth: budi@perusahaan.com">
                                </div>

                                <div class="form-group">
                                    <label class="form-label">Detail Singkat Proyek *</label>
                                    <textarea class="form-control" name="message" rows="5" placeholder="Ceritakan tujuan proyek, fitur utama yang diinginkan, dan estimasi peluncuran jika ada..." required></textarea>
                                </div>

                                <button type="submit" class="btn-royal" style="width: 100%; display: inline-flex; align-items: center; justify-content: center; gap: 8px;" id="btn-submit">
                                    <span>Kirim Pesan Sekarang</span>
                                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="7" y1="17" x2="17" y2="7"></line><polyline points="7 7 17 7 17 17"></polyline></svg>
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </main>

    <%- include('partials/footer') %>

    <script>
        document.getElementById('contact-form').addEventListener('submit', async (e) => {
            e.preventDefault();
            const btn = document.getElementById('btn-submit');
            const alertBox = document.getElementById('form-alert');
            const originalText = btn.innerHTML;

            btn.innerHTML = '<span>Mengirimkan Pesan...</span>';
            btn.disabled = true;

            const formData = new FormData(e.target);
            const payload = Object.fromEntries(formData.entries());

            // Format message with selected service
            const finalMessage = `[Layanan: ${payload.service_type}] - ${payload.message}`;
            payload.message = finalMessage;
            delete payload.service_type;

            try {
                const res = await fetch('/api/leads', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload)
                });
                const data = await res.json();

                alertBox.style.display = 'block';
                if (res.ok && data.success) {
                    alertBox.style.backgroundColor = 'rgba(0, 200, 83, 0.12)';
                    alertBox.style.color = 'var(--success)';
                    alertBox.style.border = '2px solid var(--success)';
                    alertBox.textContent = 'Pesan Anda berhasil terkirim! Tim kami akan segera menghubungi Anda via WhatsApp.';
                    e.target.reset();
                } else {
                    throw new Error(data.message || 'Terjadi kesalahan saat mengirim pesan.');
                }
            } catch (err) {
                alertBox.style.display = 'block';
                alertBox.style.backgroundColor = 'rgba(239, 68, 68, 0.1)';
                alertBox.style.color = 'var(--danger)';
                alertBox.style.border = '2px solid var(--danger)';
                alertBox.textContent = err.message;
            } finally {
                btn.innerHTML = originalText;
                btn.disabled = false;
            }
        });
    </script>
</body>
</html>
