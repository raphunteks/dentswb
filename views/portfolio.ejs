<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="theme-color" content="#05081c">
    
    <!-- DYNAMIC SEO GOLD STANDARD -->
    <title><%= typeof seo !== 'undefined' ? seo.title : 'Portfolio Kami | Dents Web' %></title>
    <meta name="description" content="<%= typeof seo !== 'undefined' ? seo.desc : 'Kumpulan karya nyata dan studi kasus website performa tinggi yang kami eksekusi buat brand dan bisnis modern.' %>">
    <meta name="keywords" content="<%= typeof seo !== 'undefined' ? seo.keywords : 'portfolio website, contoh desain website, proyek aplikasi mobile, studi kasus Dents Web' %>">
    <link rel="canonical" href="<%= typeof seo !== 'undefined' ? seo.url : 'https://www.dentsweb.my.id/portfolio' %>">
    <meta name="referrer" content="origin-when-cross-origin">
    <% if (typeof settings !== 'undefined' && settings.analyticsId) { %>
    <script async src="https://www.googletagmanager.com/gtag/js?id=<%= settings.analyticsId %>"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', '<%= settings.analyticsId %>');
    </script>
    <% } %>
    
    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="article">
    <meta property="og:url" content="<%= typeof seo !== 'undefined' ? seo.url : 'https://www.dentsweb.my.id/portfolio' %>">
    <meta property="og:title" content="<%= typeof seo !== 'undefined' ? seo.title : 'Portfolio Kami | Dents Web' %>">
    <meta property="og:description" content="<%= typeof seo !== 'undefined' ? seo.desc : '' %>">
    <meta property="og:image" content="<%= typeof seo !== 'undefined' ? seo.image : '/public/img/axalogo.png' %>">
    
    <!-- Twitter Cards -->
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:url" content="<%= typeof seo !== 'undefined' ? seo.url : 'https://www.dentsweb.my.id/portfolio' %>">
    <meta name="twitter:title" content="<%= typeof seo !== 'undefined' ? seo.title : 'Portfolio Kami | Dents Web' %>">
    <meta name="twitter:description" content="<%= typeof seo !== 'undefined' ? seo.desc : '' %>">
    <meta name="twitter:image" content="<%= typeof seo !== 'undefined' ? seo.image : '/public/img/axalogo.png' %>">

    <!-- Schema.org JSON-LD -->
    <% if (typeof seo !== 'undefined' && seo.schemaString) { %>
    <script type="application/ld+json">
        <%- seo.schemaString %>
    </script>
    <% } %>
    
    <link rel="icon" type="image/png" href="<%= typeof settings !== 'undefined' && settings.favicon ? settings.favicon : '/public/img/axalogo.png' %>">
    <link rel="apple-touch-icon" href="<%= typeof settings !== 'undefined' && settings.logo ? settings.logo : '/public/img/axalogo.png' %>">
    
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Lexend+Deca:wght@500;600;700;800&family=Playfair+Display:ital,wght@1,400;1,500;1,600;1,700&family=Plus+Jakarta+Sans:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
    
    <link rel="stylesheet" href="/public/css/style.css">
    <script src="/public/js/tech-icons.js"></script>
</head>
<body>
    
    <%- include('partials/header') %>

    <main>
        <!-- Portfolio Hero -->
        <section class="section-hero" style="min-height: 50vh; padding-top: 150px; padding-bottom: 70px;">
            <div class="orb-glow-blue" style="top: -10%; right: -5%;"></div>
            <div class="orb-glow-lime" style="bottom: -15%; left: 5%; opacity: 0.1;"></div>

            <div class="container text-center pptx-slide-up" style="position: relative; z-index: 2; max-width: 820px;">
                <div class="badge-tag-lime" style="margin-bottom: 20px;">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"></path></svg>
                    SELECTED WORKS &bull; PROVEN IMPACT
                </div>
                <h1 style="margin-bottom: 20px;">
                    Karya &amp; Bukti <span class="font-editorial text-lime">Eksekusi Nyata</span>
                </h1>
                <p style="font-size: 1.15rem; color: rgba(255,255,255,0.76); line-height: 1.75;">
                    Kumpulan web &amp; platform yang kami bangun bukan cuma buat dipajang, tapi benar-benar ngasilin konversi, engagement, dan kredibilitas tinggi buat klien.
                </p>
            </div>
        </section>

        <!-- Portfolio Showcase Grid (Style Tahoe macOS 3-Columns) -->
        <section class="portfolio-section-tahoe">
            <div class="container">
                <div class="portfolio-grid-tahoe">
                    <% if (typeof portfolio !== 'undefined' && portfolio.length > 0) { %>
                        <% portfolio.forEach((item, index) => { %>
                            <article class="portfolio-card-tahoe pptx-scale-in pptx-stagger-<%= (index % 6) + 1 %>" onclick="window.location.href='/portfolio/<%= item.slug %>'" role="button" tabindex="0" onkeydown="if(event.key==='Enter') window.location.href='/portfolio/<%= item.slug %>'">
                                <!-- macOS Browser Window Mockup -->
                                <div class="macos-browser-window">
                                    <div class="macos-window-header">
                                        <div class="macos-traffic-lights" aria-hidden="true">
                                            <span class="traffic-light red"></span>
                                            <span class="traffic-light yellow"></span>
                                            <span class="traffic-light green"></span>
                                        </div>
                                        <div class="macos-address-pill">
                                            <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>
                                            <span>dentsweb.my.id/<%= item.slug %></span>
                                        </div>
                                        <div style="width: 38px;"></div>
                                    </div>
                                    <div class="macos-window-body">
                                        <img src="<%= item.image || '/public/img/axalogo.png' %>" alt="<%= item.title %>" loading="lazy">
                                    </div>
                                </div>

                                <!-- Tahoe Content Body -->
                                <div class="portfolio-tahoe-body">
                                    <div class="portfolio-tahoe-category">
                                        <span><%= item.category %></span>
                                        <span class="portfolio-tahoe-year"><%= item.year || 2026 %></span>
                                    </div>
                                    <h2 class="portfolio-tahoe-title"><%= item.title %></h2>
                                    <p class="portfolio-tahoe-desc">
                                        <%= item.shortDescription || item.description %>
                                    </p>

                                    <!-- Tags Chips (e.g. Landing Page, F&B, Responsive) -->
                                    <% if (item.tags && item.tags.length > 0) { %>
                                        <div class="portfolio-tahoe-tags">
                                            <% (Array.isArray(item.tags) ? item.tags : item.tags.split(',')).forEach(tag => { %>
                                                <span class="tahoe-tag-pill"><%= tag.trim ? tag.trim() : tag %></span>
                                            <% }) %>
                                        </div>
                                    <% } %>

                                    <!-- Tech Stack Badges -->
                                    <% if (item.tools && item.tools.length > 0) { %>
                                        <div class="portfolio-tahoe-tools">
                                            <% item.tools.slice(0, 5).forEach(tId => { %>
                                                <span class="tech-badge-container" data-tool-id="<%= tId %>"></span>
                                            <% }) %>
                                            <% if (item.tools.length > 5) { %>
                                                <span style="font-size: 0.72rem; font-weight: 700; color: #94a3b8; align-self: center; background: rgba(255,255,255,0.08); padding: 2px 7px; border-radius: 999px;">+<%= item.tools.length - 5 %></span>
                                            <% } %>
                                        </div>
                                    <% } %>

                                    <!-- Card Action Footer -->
                                    <div class="portfolio-tahoe-footer">
                                        <span>Buka Studi Kasus Lengkap</span>
                                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
                                    </div>
                                </div>
                            </article>
                        <% }) %>
                    <% } else { %>
                        <div class="tactile-card tactile-card-heavy" style="grid-column: 1 / -1; text-align: center; padding: 80px 20px; background: rgba(16, 26, 61, 0.75); border-color: rgba(255,255,255,0.1);">
                            <div style="width: 64px; height: 64px; margin: 0 auto 20px; border-radius: 50%; background: rgba(255,255,255,0.06); display: flex; align-items: center; justify-content: center; color: #94a3b8;">
                                <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"></path></svg>
                            </div>
                            <h3 style="color: #ffffff; font-size: 1.5rem;">Belum ada portofolio yang dipublikasikan.</h3>
                            <p style="max-width: 500px; margin: 12px auto 0; color: #94a3b8;">Kami sedang menyusun studi kasus dari proyek-proyek terbaru. Silakan pantau terus atau kontak kami langsung.</p>
                        </div>
                    <% } %>
                </div>

                <!-- Bottom CTA Box -->
                <div class="tactile-card tactile-card-heavy pptx-scale-in" style="margin-top: 80px; padding: 60px 40px; text-align: center; background: rgba(16, 26, 61, 0.85); border-color: rgba(255, 255, 255, 0.12); border-bottom-color: var(--lime-accent);">
                    <h2 style="font-size: clamp(1.8rem, 3.5vw, 2.5rem); color: #ffffff; margin-bottom: 16px;">
                        Punya Konsep Proyek Serupa buat <span class="font-editorial text-lime">Bisnis Lu?</span>
                    </h2>
                    <p style="max-width: 620px; margin: 0 auto 32px; color: #cbd5e1; font-size: 1.05rem; line-height: 1.7;">
                        Diskusikan kebutuhan spesifik dan target audiens lu. Tim arsitek kami siap rancang platform yang bikin brand lu langsung diperhitungkan.
                    </p>
                    <a href="/contact" class="btn-lime" style="display: inline-flex; align-items: center; gap: 8px;">
                        Mulai Konsultasi Proyek
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="7" y1="17" x2="17" y2="7"></line><polyline points="7 7 17 7 17 17"></polyline></svg>
                    </a>
                </div>
            </div>
        </section>
    </main>

    <%- include('partials/footer') %>

    <script>
        document.addEventListener('DOMContentLoaded', () => {
            document.querySelectorAll('.tech-badge-container').forEach(el => {
                const id = el.getAttribute('data-tool-id');
                if (window.renderTechBadge) {
                    el.innerHTML = window.renderTechBadge(id, { size: 13, showLabel: true });
                }
            });
        });
    </script>
</body>
</html>
