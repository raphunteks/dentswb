            <svg class="svg-icon svg-icon-sm" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg>
        </button>
    </div>
</div>

<!-- Round Trigger Button -->
<button class="wa-floating-btn" id="wa-floating-trigger" aria-label="Buka Chat WhatsApp Admin" type="button">
    <svg class="svg-icon svg-icon-xl" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.77-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.94-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217l.332.006c.106.005.249-.04.39.298.144.347.491 1.2.534 1.287.043.087.072.188.014.304-.058.116-.087.188-.173.289l-.26.304c-.087.086-.177.18-.076.354.101.174.449.741.964 1.201.662.591 1.221.774 1.394.86s.274.072.376-.043c.101-.116.433-.506.549-.68.116-.173.231-.145.39-.087s1.011.477 1.184.564.289.13.332.202c.045.072.045.419-.1.824zm-3.423-14.416c-6.627 0-12 5.373-12 12 0 2.112.551 4.095 1.517 5.823l-1.517 5.605 5.748-1.507c1.685.918 3.607 1.442 5.652 1.442 6.627 0 12-5.373 12-12 0-6.627-5.373-12-12-12z"/></svg>
</button>

<script>
    // WhatsApp Floating Widget Logic
    (function() {
        const trigger = document.getElementById('wa-floating-trigger');
        const popup = document.getElementById('wa-chat-popup');
        const closeBtn = document.getElementById('wa-close-btn');
        const sendBtn = document.getElementById('wa-send-btn');
        const msgInput = document.getElementById('wa-message-input');
        const waNumber = '<%= typeof settings !== "undefined" && settings.whatsapp ? settings.whatsapp.replace(/[^0-9]/g, "") : "6285338922586" %>';

        if (trigger && popup) {
            trigger.addEventListener('click', (e) => {
                e.stopPropagation();
                popup.classList.toggle('active');
                if (popup.classList.contains('active') && msgInput) {
                    msgInput.focus();
                }
            });
        }

        if (closeBtn && popup) {
            closeBtn.addEventListener('click', (e) => {
                e.stopPropagation();
                popup.classList.remove('active');
            });
        }

        if (sendBtn && msgInput) {
            sendBtn.addEventListener('click', () => {
                const message = msgInput.value.trim();
                const defaultGreeting = "Halo Admin <%= typeof settings !== 'undefined' && settings.brandName ? settings.brandName : 'Dents Web' %>, saya ingin konsultasi mengenai pembuatan website / aplikasi.";
                const finalMsg = message ? message : defaultGreeting;
                const waUrl = `https://wa.me/${waNumber}?text=${encodeURIComponent(finalMsg)}`;
                window.open(waUrl, '_blank');
                popup.classList.remove('active');
                msgInput.value = '';
            });
        }

        // Close on outside click
        document.addEventListener('click', (e) => {
            if (popup && popup.classList.contains('active')) {
                if (!popup.contains(e.target) && !trigger.contains(e.target)) {
                    popup.classList.remove('active');
                }
            }
        });

        // Set Dynamic Year
        const yr = document.getElementById('year');
        if (yr) yr.textContent = new Date().getFullYear();
    })();
</script>

