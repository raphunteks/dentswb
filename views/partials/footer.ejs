<footer class="section" style="border-top: 1px solid var(--glass-border); padding-bottom: 40px; background: rgba(0,0,0,0.3);">
    <div class="container grid-2">
        <div>
            <a href="/" class="logo" style="margin-bottom: 24px;">
                <span class="logo-mark"></span> <%= settings.siteName || 'Dents Web' %>
            </a>
            <p style="max-width: 400px;"><%= settings.tagline || 'Build Your Digital Presence.' %></p>
        </div>
        <div style="display: flex; gap: 60px; justify-content: flex-end; flex-wrap: wrap;">
            <div>
                <h4 style="margin-bottom: 16px;">Agency</h4>
                <ul style="display: flex; flex-direction: column; gap: 8px;">
                    <li><a href="/services" style="color: var(--text-secondary);">Services</a></li>
                    <li><a href="/portfolio" style="color: var(--text-secondary);">Portfolio</a></li>
                    <li><a href="/pricing" style="color: var(--text-secondary);">Pricing</a></li>
                </ul>
            </div>
            <div>
                <h4 style="margin-bottom: 16px;">Company</h4>
                <ul style="display: flex; flex-direction: column; gap: 8px;">
                    <li><a href="/about" style="color: var(--text-secondary);">About Us</a></li>
                    <li><a href="/contact" style="color: var(--text-secondary);">Contact</a></li>
                    <li><a href="/faq" style="color: var(--text-secondary);">FAQ</a></li>
                </ul>
            </div>
        </div>
    </div>
    <div class="container text-center" style="margin-top: 80px; color: var(--text-muted); font-size: 0.9rem;">
        &copy; <span id="year"></span> <%= settings.siteName || 'Dents Web' %>. All rights reserved.
    </div>
</footer>

<script>
    // Dinamis Year
    document.getElementById('year').textContent = new Date().getFullYear();
    
    // Scroll Behavior untuk Navbar
    const header = document.getElementById('main-header');
    if (header) {
        window.addEventListener('scroll', () => {
            header.classList.toggle('scrolled', window.scrollY > 20);
        });
    }
    
    // Mobile Hamburger Menu
    const hamburgerBtn = document.getElementById('hamburger-btn');
    const navLinks = document.getElementById('nav-links');
    if (hamburgerBtn && navLinks) {
        hamburgerBtn.addEventListener('click', () => {
            navLinks.classList.toggle('mobile-open');
        });
    }
</script>

<!-- Security / DevTools Deterrent -->
<script src="/public/js/protect-devtools.js" defer></script>
