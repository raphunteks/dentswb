<script>
    // WhatsApp Floating Widget (Bottom Right)
    (function() {
        const trigger = document.getElementById('wa-floating-trigger');
        const popup = document.getElementById('wa-chat-popup');
        const closeBtn = document.getElementById('wa-close-btn');
        const sendBtn = document.getElementById('wa-send-btn');
        const msgInput = document.getElementById('wa-message-input');
        const waNumber = '<%= typeof settings !== "undefined" && settings.whatsapp ? settings.whatsapp.replace(/[^0-9]/g, "") : "6285338922586" %>';

        if (trigger && popup) {
            trigger.addEventListener('click', (e) => {
                e.stopPropagation();
                popup.classList.toggle('active');
                if (popup.classList.contains('active') && msgInput) {
                    msgInput.focus();
                }
            });
        }

        if (closeBtn && popup) {
            closeBtn.addEventListener('click', (e) => {
                e.stopPropagation();
                popup.classList.remove('active');
            });
        }

        if (sendBtn && msgInput) {
            sendBtn.addEventListener('click', () => {
                const message = msgInput.value.trim();
                const defaultGreeting = "Halo Admin <%= typeof settings !== 'undefined' && settings.brandName ? settings.brandName : 'Dents Web' %>, saya ingin konsultasi mengenai pembuatan website / aplikasi.";
                const finalMsg = message ? message : defaultGreeting;
                const waUrl = `https://wa.me/${waNumber}?text=${encodeURIComponent(finalMsg)}`;
                window.open(waUrl, '_blank');
                popup.classList.remove('active');
                msgInput.value = '';
            });
        }

        // Close on outside click
        document.addEventListener('click', (e) => {
            if (popup && popup.classList.contains('active')) {
                if (!popup.contains(e.target) && !trigger.contains(e.target)) {
                    popup.classList.remove('active');
                }
            }
        });

        // Set Dynamic Year
        const yr = document.getElementById('year');
        if (yr) yr.textContent = new Date().getFullYear();
    })();

    // Interactive Live Chat CS Widget (Bottom Left - Tawk.co Style)
    (function() {
        const triggerBtn = document.getElementById('livechat-trigger');
        const chatWindow = document.getElementById('livechat-window');
        const closeBtn = document.getElementById('livechat-close-btn');
        const resetSessionBtn = document.getElementById('livechat-reset-session-btn');
        const prechatView = document.getElementById('livechat-prechat-view');
        const convView = document.getElementById('livechat-conversation-view');
        const startForm = document.getElementById('livechat-start-form');
        const sendForm = document.getElementById('livechat-send-form');
        const inputText = document.getElementById('livechat-input-text');
        const messagesList = document.getElementById('livechat-messages-list');
        const activeCategoryBadge = document.getElementById('livechat-active-category');
        const activeClientName = document.getElementById('livechat-active-client-name');
        const unreadBadge = document.getElementById('livechat-unread-badge');

        const STORAGE_KEY = 'dents_chat_session_v1';
        const PROFILE_KEY = 'dents_chat_profile_v1';
        let currentSession = null;
        let pollTimer = null;
        let knownMessageCount = 0;

        function escapeHtml(str) {
            if (!str) return '';
            const div = document.createElement('div');
            div.textContent = str;
            return div.innerHTML;
        }

        function getStoredSession() {
            try {
                const data = localStorage.getItem(STORAGE_KEY);
                return data ? JSON.parse(data) : null;
            } catch (err) {
                return null;
            }
        }

        function saveStoredSession(session) {
            try {
                localStorage.setItem(STORAGE_KEY, JSON.stringify(session));
            } catch (err) {}
        }

        function clearStoredSession() {
            try {
                localStorage.removeItem(STORAGE_KEY);
            } catch (err) {}
        }

        function prefillForm() {
            try {
                const profStr = localStorage.getItem(PROFILE_KEY);
                if (!profStr) return;
                const prof = JSON.parse(profStr);
                const nameEl = document.getElementById('lc-name');
                const emailEl = document.getElementById('lc-email');
                const phoneEl = document.getElementById('lc-phone');
                if (nameEl && prof.name && !nameEl.value) nameEl.value = prof.name;
                if (emailEl && prof.email && !emailEl.value) emailEl.value = prof.email;
                if (phoneEl && prof.phone && !phoneEl.value) {
                    let p = prof.phone;
                    if (p.startsWith('+62')) p = p.slice(3);
                    else if (p.startsWith('62')) p = p.slice(2);
                    else if (p.startsWith('0')) p = p.slice(1);
                    phoneEl.value = p;
                }
            } catch (e) {}
        }

        function formatTime(isoStr) {
            try {
                const d = new Date(isoStr);
                return d.toLocaleTimeString('id-ID', { hour: '2-digit', minute: '2-digit' });
            } catch (e) {
                return '';
            }
        }

        function renderMessages(messages) {
            if (!messages || !Array.isArray(messages)) return;
            messagesList.innerHTML = '';
            messages.forEach(msg => {
                const s = String(msg.sender || '').toUpperCase();
                const isCustomer = (s === 'CUSTOMER' || s === 'CLIENT' || s === 'USER');
                const row = document.createElement('div');
                row.className = `livechat-msg-row ${isCustomer ? 'msg-client' : 'msg-admin'}`;
                
                const bubble = document.createElement('div');
                bubble.className = 'livechat-bubble';
                
                const textEl = document.createElement('div');
                textEl.className = 'livechat-msg-text';
                textEl.textContent = msg.text;

                const timeEl = document.createElement('div');
                timeEl.className = 'livechat-msg-time';
                const label = isCustomer ? 'Anda' : (msg.senderName || 'CS Support');
                timeEl.textContent = `${label} • ${formatTime(msg.timestamp)}`;

                bubble.appendChild(textEl);
                bubble.appendChild(timeEl);
                row.appendChild(bubble);
                messagesList.appendChild(row);
            });
            messagesList.scrollTop = messagesList.scrollHeight;
        }

        let clientAudioCtx = null;
        function getClientAudioContext() {
            try {
                const AudioContextClass = window.AudioContext || window.webkitAudioContext;
                if (!AudioContextClass) return null;
                if (!clientAudioCtx) {
                    clientAudioCtx = new AudioContextClass();
                }
                if (clientAudioCtx.state === 'suspended') {
                    clientAudioCtx.resume().catch(() => {});
                }
                return clientAudioCtx;
            } catch (e) {
                return null;
            }
        }

        // Global gesture unlock on click / touch anywhere on the page
        const unlockClientAudioOnGesture = () => {
            const ctx = getClientAudioContext();
            if (ctx && ctx.state === 'suspended') {
                ctx.resume().catch(() => {});
            }
        };
        ['click', 'touchstart', 'keydown'].forEach(ev => {
            document.addEventListener(ev, unlockClientAudioOnGesture, { passive: true });
        });

        function playClientChatChime() {
            try {
                const ctx = getClientAudioContext();
                if (!ctx) return;
                if (ctx.state === 'suspended') {
                    ctx.resume().catch(() => {});
                }
                const now = ctx.currentTime;
                // Rich crystal two-tone chime (G5 -> C6)
                const osc1 = ctx.createOscillator();
                const gain1 = ctx.createGain();
                osc1.type = 'triangle';
                osc1.frequency.setValueAtTime(783.99, now);
                gain1.gain.setValueAtTime(0, now);
                gain1.gain.linearRampToValueAtTime(0.28, now + 0.02);
                gain1.gain.exponentialRampToValueAtTime(0.001, now + 0.22);
                osc1.connect(gain1);
                gain1.connect(ctx.destination);
                osc1.start(now);
                osc1.stop(now + 0.24);

                const osc2 = ctx.createOscillator();
                const gain2 = ctx.createGain();
                osc2.type = 'sine';
                osc2.frequency.setValueAtTime(1046.50, now + 0.12);
                gain2.gain.setValueAtTime(0, now + 0.12);
                gain2.gain.linearRampToValueAtTime(0.32, now + 0.14);
                gain2.gain.exponentialRampToValueAtTime(0.001, now + 0.40);
                osc2.connect(gain2);
                gain2.connect(ctx.destination);
                osc2.start(now + 0.12);
                osc2.stop(now + 0.42);
            } catch (e) {
                console.warn('Client audio chime error:', e);
            }
        }

        async function fetchMessages(sessionId) {
            if (!sessionId) return;
            try {
                const res = await fetch(`/api/chat/messages/${sessionId}`);
                if (!res.ok) return;
                const data = await res.json();
                if (data && data.success) {
                    const messages = data.messages || (data.chat && data.chat.messages) || [];
                    if (messages.length > knownMessageCount) {
                        const newMsgCount = messages.length - knownMessageCount;
                        if (chatWindow.style.display === 'none' && knownMessageCount > 0) {
                            unreadBadge.textContent = newMsgCount;
                            unreadBadge.style.display = 'flex';
                        }
                        // Play pleasant chime on CS / Admin reply
                        if (knownMessageCount > 0) {
                            const latestMsg = messages[messages.length - 1];
                            const s = String(latestMsg?.sender || '').toUpperCase();
                            if (s === 'ADMIN' || s === 'SUPPORT' || s === 'CS') {
                                playClientChatChime();
                            }
                        }
                        knownMessageCount = messages.length;
                        renderMessages(messages);
                    }
                }
            } catch (err) {
                console.warn('Polling chat error:', err);
            }
        }

        function startPolling(sessionId) {
            if (pollTimer) clearInterval(pollTimer);
            pollTimer = setInterval(() => {
                fetchMessages(sessionId);
            }, 3000);
        }

        function stopPolling() {
            if (pollTimer) clearInterval(pollTimer);
            pollTimer = null;
        }

        function showConversationView(session, initialChat) {
            prechatView.style.display = 'none';
            convView.style.display = 'flex';
            resetSessionBtn.style.display = 'inline-flex';
            activeCategoryBadge.textContent = session.category || 'Konsultasi';
            activeClientName.textContent = (session.name || 'Klien') + (session.phone ? ' • +' + session.phone : '');
            
            const messages = (initialChat && initialChat.messages) ? initialChat.messages : [];
            if (messages.length > 0) {
                knownMessageCount = messages.length;
                renderMessages(messages);
            } else {
                fetchMessages(session.sessionId);
            }
            startPolling(session.sessionId);
        }

        function showPrechatView() {
            stopPolling();
            prechatView.style.display = 'block';
            convView.style.display = 'none';
            resetSessionBtn.style.display = 'none';
            messagesList.innerHTML = '';
            knownMessageCount = 0;
            prefillForm();
        }

        // Check if existing session on load
        currentSession = getStoredSession();
        if (currentSession && currentSession.sessionId) {
            fetch(`/api/chat/messages/${currentSession.sessionId}`)
                .then(r => r.json())
                .then(data => {
                    if (data && data.success) {
                        const chatObj = data.chat || {
                            messages: data.messages || [],
                            category: currentSession.category,
                            name: currentSession.name
                        };
                        showConversationView(currentSession, chatObj);
                    } else {
                        // Session expired or not found
                        clearStoredSession();
                        currentSession = null;
                        showPrechatView();
                    }
                })
                .catch(() => {
                    // Temporary network glitch, show existing conversation optimistically
                    showConversationView(currentSession, null);
                });
        } else {
            showPrechatView();
        }

        // Trigger open/close
        if (triggerBtn && chatWindow) {
            triggerBtn.addEventListener('click', (e) => {
                e.stopPropagation();
                const isOpen = (chatWindow.style.display === 'flex');
                if (isOpen) {
                    chatWindow.style.display = 'none';
                } else {
                    chatWindow.style.display = 'flex';
                    unreadBadge.style.display = 'none';
                    unreadBadge.textContent = '0';
                    if (convView.style.display === 'flex' && inputText) {
                        inputText.focus();
                    }
                }
            });
        }

        if (closeBtn && chatWindow) {
            closeBtn.addEventListener('click', (e) => {
                e.stopPropagation();
                chatWindow.style.display = 'none';
            });
        }

        if (resetSessionBtn) {
            resetSessionBtn.addEventListener('click', (e) => {
                e.stopPropagation();
                if (confirm('Akhiri sesi chat ini dan mulai topik baru?')) {
                    clearStoredSession();
                    currentSession = null;
                    showPrechatView();
                }
            });
        }

        // Start Chat Form Submit
        if (startForm) {
            startForm.addEventListener('submit', async (e) => {
                e.preventDefault();
                const submitBtn = document.getElementById('lc-submit-btn');
                const origHtml = submitBtn.innerHTML;
                submitBtn.disabled = true;
                submitBtn.innerHTML = '<span>Menghubungkan...</span>';

                const formData = new FormData(startForm);
                const rawPhone = (formData.get('phone') || '').trim();
                const cleanPhone = rawPhone.startsWith('0') ? '62' + rawPhone.slice(1) : (rawPhone.startsWith('+62') ? rawPhone.slice(1) : (rawPhone.startsWith('62') ? rawPhone : '62' + rawPhone));

                const payload = {
                    name: (formData.get('name') || '').trim(),
                    email: (formData.get('email') || '').trim(),
                    phone: cleanPhone,
                    category: formData.get('category') || 'Jasa Pembuatan Website Baru',
                    message: (formData.get('message') || '').trim()
                };

                try {
                    const res = await fetch('/api/chat/start', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify(payload)
                    });
                    const data = await res.json();
                    if (data && data.success) {
                        currentSession = {
                            sessionId: data.sessionId,
                            name: payload.name,
                            email: payload.email,
                            phone: payload.phone,
                            category: payload.category
                        };
                        saveStoredSession(currentSession);
                        // Save profile persistently so user doesn't re-type next time
                        try {
                            localStorage.setItem(PROFILE_KEY, JSON.stringify({
                                name: payload.name,
                                email: payload.email,
                                phone: payload.phone
                            }));
                        } catch (err) {}

                        showConversationView(currentSession, data.chat || { messages: data.messages });
                    } else {
                        alert(data.message || 'Gagal memulai chat. Silakan coba lagi.');
                    }
                } catch (err) {
                    alert('Terjadi kendala jaringan. Pastikan koneksi internet stabil.');
                } finally {
                    submitBtn.disabled = false;
                    submitBtn.innerHTML = origHtml;
                }
            });
        }

        // Send message in active chat
        if (sendForm) {
            sendForm.addEventListener('submit', async (e) => {
                e.preventDefault();
                if (!currentSession || !currentSession.sessionId) return;
                const text = inputText.value.trim();
                if (!text) return;

                inputText.value = '';
                // Optimistic UI append
                const tempMsg = {
                    sender: 'CUSTOMER',
                    text: text,
                    timestamp: new Date().toISOString()
                };
                const row = document.createElement('div');
                row.className = 'livechat-msg-row msg-client';
                row.innerHTML = `<div class="livechat-bubble"><div class="livechat-msg-text">${escapeHtml(text)}</div><div class="livechat-msg-time">Anda • ${formatTime(tempMsg.timestamp)}</div></div>`;
                messagesList.appendChild(row);
                messagesList.scrollTop = messagesList.scrollHeight;

                try {
                    const res = await fetch('/api/chat/send', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({
                            sessionId: currentSession.sessionId,
                            sender: 'CUSTOMER',
                            senderName: currentSession.name || 'Klien',
                            message: text
                        })
                    });
                    const data = await res.json();
                    if (data && data.success) {
                        fetchMessages(currentSession.sessionId);
                    }
                } catch (err) {
                    console.warn('Gagal kirim pesan:', err);
                }
            });
        }
    })();
</script>

<script>
    // Presentation-Style PPTX Morph & Soft Scroll Reveal System
    (function() {
        const observerOptions = {
            root: null,
            rootMargin: '0px 0px -40px 0px',
            threshold: 0.08
        };

        const pptxObserver = new IntersectionObserver((entries, obs) => {
            entries.forEach(entry => {
                if (entry.isIntersecting) {
                    entry.target.classList.add('pptx-visible');
                    obs.unobserve(entry.target);
                }
            });
        }, observerOptions);

        function initPptxObserver() {
            const targets = document.querySelectorAll(`
                .pptx-reveal, 
                .pptx-slide-up, 
                .pptx-slide-down,
                .pptx-swift-left, 
                .pptx-swift-right, 
                .pptx-scale-in,
                .service-card-kalana,
                .pricing-card-kalana,
                .portfolio-card-kalana,
                .article-card-kalana,
                .faq-card-gbr1,
                .faq-item-kalana,
                .testimonial-card-kalana,
                .tactile-card
            `);

            targets.forEach((el, index) => {
                if (!el.classList.contains('pptx-visible')) {
                    if (!el.classList.contains('pptx-slide-up') && 
                        !el.classList.contains('pptx-slide-down') && 
                        !el.classList.contains('pptx-swift-left') && 
                        !el.classList.contains('pptx-swift-right') && 
                        !el.classList.contains('pptx-scale-in') &&
                        !el.classList.contains('pptx-reveal')) {
                        el.classList.add('pptx-slide-up');
                    }
                    if (!el.className.includes('pptx-stagger-')) {
                        const staggerIdx = (index % 8) + 1;
                        el.classList.add('pptx-stagger-' + staggerIdx);
                    }
                    pptxObserver.observe(el);
                }
            });
        }

        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', initPptxObserver);
        } else {
            initPptxObserver();
        }
    })();
</script>

