<footer class="section" style="border-top: 1px solid var(--glass-border); padding-bottom: 40px; background: rgba(0,0,0,0.3);">
    <div class="container grid-2">
        <div>
            <a href="/" class="logo" style="margin-bottom: 24px; display: flex; align-items: center; gap: 8px;">
                <img src="/public/img/axalogo.png" alt="Logo" style="width: 32px; height: 32px; object-fit: contain; border-radius: 8px;">
                <%= settings && settings.siteName ? settings.siteName : 'Dents Web' %>
            </a>
            <p style="max-width: 400px;"><%= settings && settings.tagline ? settings.tagline : 'Build Your Digital Presence.' %></p>
        </div>
        <div style="display: flex; gap: 60px; justify-content: flex-end; flex-wrap: wrap;">
            <div>
                <h4 style="margin-bottom: 16px;">Agency</h4>
                <ul style="display: flex; flex-direction: column; gap: 8px;">
                    <li><a href="/services" style="color: var(--text-secondary); transition: var(--transition);">Services</a></li>
                    <li><a href="/portfolio" style="color: var(--text-secondary); transition: var(--transition);">Portfolio</a></li>
                    <li><a href="/pricing" style="color: var(--text-secondary); transition: var(--transition);">Pricing</a></li>
                </ul>
            </div>
            <div>
                <h4 style="margin-bottom: 16px;">Company</h4>
                <ul style="display: flex; flex-direction: column; gap: 8px;">
                    <li><a href="/about" style="color: var(--text-secondary); transition: var(--transition);">About Us</a></li>
                    <li><a href="/contact" style="color: var(--text-secondary); transition: var(--transition);">Contact</a></li>
                    <li><a href="/faq" style="color: var(--text-secondary); transition: var(--transition);">FAQ</a></li>
                </ul>
            </div>
        </div>
    </div>
    <div class="container text-center" style="margin-top: 80px; color: var(--text-muted); font-size: 0.9rem;">
        &copy; <span id="year"></span> <%= settings && settings.siteName ? settings.siteName : 'Dents Web' %>. All rights reserved.
    </div>
</footer>

<script>
    // Set dynamically year
    const yearEl = document.getElementById('year');
    if (yearEl) yearEl.textContent = new Date().getFullYear();
    
    // Header Scroll Effect
    const header = document.getElementById('main-header');
    if(header) {
        window.addEventListener('scroll', () => {
            header.classList.toggle('scrolled', window.scrollY > 20);
        });
    }
    
    // Hamburger Menu Logic
    const hamburgerBtn = document.getElementById('hamburger-btn');
    const navLinks = document.getElementById('nav-links');
    if (hamburgerBtn && navLinks) {
        hamburgerBtn.addEventListener('click', () => {
            navLinks.classList.toggle('mobile-open');
            hamburgerBtn.classList.toggle('open');
        });
    }
</script>

<!-- Security / DevTools Deterrent -->
<script src="/public/js/protect-devtools.js" defer></script>
