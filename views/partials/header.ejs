<header id="main-header">
    <div class="container nav-container">
        <a href="/" class="logo">
            <span class="logo-mark"></span>
            <%= settings.siteName || 'Dents Web' %>
        </a>
        <div class="hamburger" id="hamburger-btn">
            <span></span><span></span><span></span>
        </div>
        <nav class="nav-links" id="nav-links">
            <a href="/" class="<%= seo.path === '/' ? 'active' : '' %>">Home</a>
            <a href="/services" class="<%= seo.path === '/services' ? 'active' : '' %>">Services</a>
            <a href="/portfolio" class="<%= seo.path && seo.path.startsWith('/portfolio') ? 'active' : '' %>">Portfolio</a>
            <a href="/pricing" class="<%= seo.path === '/pricing' ? 'active' : '' %>">Pricing</a>
            <a href="/about" class="<%= seo.path === '/about' ? 'active' : '' %>">About</a>
            <a href="/contact" class="<%= seo.path === '/contact' ? 'active' : '' %>">Contact</a>
            <a href="/faq" class="<%= seo.path === '/faq' ? 'active' : '' %>">FAQ</a>
        </nav>
    </div>
</header>
