<div class="kalana-header-wrapper" id="main-header">
    <header class="kalana-nav-capsule" id="nav-capsule">
        <!-- Brand / Logo (Tightly Unified) -->
        <a href="/" class="nav-brand" aria-label="<%= typeof settings !== 'undefined' && settings.brandName ? settings.brandName : 'Dents Web' %>" style="display: inline-flex; align-items: center; gap: 4px;">
            <img src="<%= typeof settings !== 'undefined' && settings.logo ? settings.logo : '/public/img/axalogo.png' %>" alt="Logo" class="nav-brand-logo" width="32" height="32">
            <span class="nav-brand-name"><%= typeof settings !== 'undefined' && settings.siteName ? settings.siteName : 'ents Web' %></span>
        </a>

        <!-- Desktop Pill Navigation with Schema.org SiteNavigationElement -->
        <nav class="nav-links-desktop" itemscope itemtype="https://schema.org/SiteNavigationElement" aria-label="Navigasi Utama">
            <a href="/" itemprop="url" class="nav-pill-link <%= (typeof seo !== 'undefined' && seo.path === '/') ? 'active' : '' %>"><span itemprop="name">Beranda</span></a>
            <a href="/services" itemprop="url" class="nav-pill-link <%= (typeof seo !== 'undefined' && seo.path === '/services') ? 'active' : '' %>"><span itemprop="name">Layanan</span></a>
            <a href="/portfolio" itemprop="url" class="nav-pill-link <%= (typeof seo !== 'undefined' && seo.path && seo.path.startsWith('/portfolio')) ? 'active' : '' %>"><span itemprop="name">Portofolio</span></a>
            <a href="/articles" itemprop="url" class="nav-pill-link <%= (typeof seo !== 'undefined' && seo.path && (seo.path === '/articles' || seo.path.startsWith('/article/'))) ? 'active' : '' %>"><span itemprop="name">Artikel</span></a>
            <a href="/pricing" itemprop="url" class="nav-pill-link <%= (typeof seo !== 'undefined' && seo.path === '/pricing') ? 'active' : '' %>"><span itemprop="name">Harga</span></a>
            <a href="/about" itemprop="url" class="nav-pill-link <%= (typeof seo !== 'undefined' && seo.path === '/about') ? 'active' : '' %>"><span itemprop="name">Tentang Kami</span></a>
            <a href="/faq" itemprop="url" class="nav-pill-link <%= (typeof seo !== 'undefined' && seo.path === '/faq') ? 'active' : '' %>"><span itemprop="name">FAQ</span></a>
        </nav>

        <!-- CTA Action -->
        <div style="display: flex; align-items: center; gap: 10px;">
            <a href="/contact" class="nav-cta-btn" aria-label="Mulai Konsultasi Project">
                <span>Mulai Project</span>
                <svg class="svg-icon svg-icon-sm" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 7h10v10"></path><path d="M7 17 17 7"></path></svg>
            </a>
            <!-- Mobile Toggle -->
            <button class="nav-hamburger" id="hamburger-btn" aria-label="Toggle Buka Menu Mobile">
                <span></span><span></span><span></span>
            </button>
        </div>
    </header>
</div>

<!-- Mobile Dropdown Drawer -->
<nav class="mobile-nav-drawer" id="mobile-drawer" itemscope itemtype="https://schema.org/SiteNavigationElement" aria-label="Navigasi Mobile">
    <a href="/" itemprop="url" class="<%= (typeof seo !== 'undefined' && seo.path === '/') ? 'active' : '' %>"><span itemprop="name">Beranda</span></a>
    <a href="/services" itemprop="url" class="<%= (typeof seo !== 'undefined' && seo.path === '/services') ? 'active' : '' %>"><span itemprop="name">Layanan</span></a>
    <a href="/portfolio" itemprop="url" class="<%= (typeof seo !== 'undefined' && seo.path && seo.path.startsWith('/portfolio')) ? 'active' : '' %>"><span itemprop="name">Portofolio</span></a>
    <a href="/articles" itemprop="url" class="<%= (typeof seo !== 'undefined' && seo.path && (seo.path === '/articles' || seo.path.startsWith('/article/'))) ? 'active' : '' %>"><span itemprop="name">Artikel</span></a>
    <a href="/pricing" itemprop="url" class="<%= (typeof seo !== 'undefined' && seo.path === '/pricing') ? 'active' : '' %>"><span itemprop="name">Harga</span></a>
    <a href="/about" itemprop="url" class="<%= (typeof seo !== 'undefined' && seo.path === '/about') ? 'active' : '' %>"><span itemprop="name">Tentang Kami</span></a>
    <a href="/faq" itemprop="url" class="<%= (typeof seo !== 'undefined' && seo.path === '/faq') ? 'active' : '' %>"><span itemprop="name">FAQ</span></a>
    <a href="/contact" itemprop="url" class="mobile-cta">
        <span itemprop="name">Mulai Project</span>
        <svg class="svg-icon svg-icon-sm" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 7h10v10"></path><path d="M7 17 17 7"></path></svg>
    </a>
</nav>

<script>
    (function() {
        const capsule = document.getElementById('nav-capsule');
        const hamburger = document.getElementById('hamburger-btn');
        const drawer = document.getElementById('mobile-drawer');

        const wrapper = document.getElementById('main-header');

        if (capsule) {
            window.addEventListener('scroll', () => {
                if (window.scrollY > 20) {
                    capsule.classList.add('scrolled');
                    if (wrapper) wrapper.classList.add('scrolled');
                } else {
                    capsule.classList.remove('scrolled');
                    if (wrapper) wrapper.classList.remove('scrolled');
                }
            }, { passive: true });
        }

        if (hamburger && drawer) {
            hamburger.addEventListener('click', (e) => {
                e.stopPropagation();
                drawer.classList.toggle('active');
                hamburger.classList.toggle('open');
            });

            document.addEventListener('click', (e) => {
                if (!drawer.contains(e.target) && !hamburger.contains(e.target)) {
                    drawer.classList.remove('active');
                    hamburger.classList.remove('open');
                }
            });
        }
    })();
</script>
