    <script>
        function toggleFaqGbr1(btn) {
            const card = btn.closest('.faq-card-gbr1');
            const isActive = card.classList.contains('active');
            
            document.querySelectorAll('.faq-card-gbr1').forEach(c => {
                c.classList.remove('active');
                const b = c.querySelector('.faq-btn-gbr1');
                if (b) b.setAttribute('aria-expanded', 'false');
                const char = c.querySelector('.faq-toggle-char');
                if (char) char.textContent = '+';
            });
            
            if (!isActive) {
                card.classList.add('active');
                btn.setAttribute('aria-expanded', 'true');
                const char = card.querySelector('.faq-toggle-char');
                if (char) char.textContent = '−';
            }
        }

        document.addEventListener('DOMContentLoaded', () => {
            document.querySelectorAll('.tech-badge-container').forEach(el => {
                const id = el.getAttribute('data-tool-id');
                if (window.renderTechBadge) {
                    el.innerHTML = window.renderTechBadge(id, { size: 12, showLabel: true });
                }
            });
        });
    </script>
