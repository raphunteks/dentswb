<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= typeof seo !== 'undefined' ? seo.title : 'Dents Web | Premium Digital Agency' %></title>
    <meta name="description" content="<%= typeof seo !== 'undefined' ? seo.desc : 'Jasa pembuatan website dan aplikasi profesional.' %>">
    <link rel="canonical" href="<%= (typeof settings !== 'undefined' && settings.siteUrl ? settings.siteUrl : '') %><%= typeof seo !== 'undefined' ? seo.path : '' %>">
    
    <meta property="og:title" content="<%= typeof seo !== 'undefined' ? seo.title : 'Dents Web' %>">
    <meta property="og:description" content="<%= typeof seo !== 'undefined' ? seo.desc : '' %>">
    <meta property="og:type" content="website">
    <meta property="og:url" content="<%= (typeof settings !== 'undefined' && settings.siteUrl ? settings.siteUrl : '') %><%= typeof seo !== 'undefined' ? seo.path : '' %>">
    
    <link rel="icon" type="image/png" href="/public/img/axalogo.png">
    <link rel="apple-touch-icon" href="/public/img/axalogo.png">
    
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    
    <link rel="stylesheet" href="/public/css/style.css">
</head>
<body>
    
    <%- include('partials/header') %>

    <main>
        <!-- PAGE 1: HERO SECTION -->
        <section class="section section-pt-hero" style="min-height: 100vh; display: flex; align-items: center;">
            <div class="container grid-2">
                <div style="z-index: 2;">
                    <div class="tag" style="margin-bottom: 24px;">🚀 Agensi Digital No. 1</div>
                    <h1>Jasa Pembuatan <br><span class="text-holo">Website & Aplikasi</span><br> Professional</h1>
                    <p style="font-size: 1.2rem; margin-bottom: 40px; max-width: 500px; color: var(--text-secondary);">
                        Kembangkan bisnis Anda di era digital bersama <strong><%= typeof settings !== 'undefined' ? settings.siteName : 'Dents Web' %></strong>. Mulai dari landing page, website perusahaan, hingga sistem informasi kustom.
                    </p>
                    <div style="display: flex; gap: 16px; flex-wrap: wrap;">
                        <a href="/contact" class="btn btn-primary">Konsultasi WhatsApp &nearr;</a>
                        <a href="#portfolio" class="btn btn-secondary">Lihat Portofolio Kami</a>
                    </div>
                </div>
                <!-- Hero Visual (Glassmorphism Adaption) -->
                <div style="position: relative; perspective: 1000px;">
                    <div class="glass-panel" style="padding: 30px; transform: rotateY(-10deg) rotateX(5deg); box-shadow: var(--shadow-glow-holo);">
                        <img src="/public/img/axalogo.png" alt="Dents Web Logo" style="width: 80px; border-radius: 20px; margin-bottom: 20px;">
                        <h3 style="color: var(--text-primary);">Trusted by Multiple Clients</h3>
                        <p style="color: var(--success); font-weight: 700; font-size: 1.2rem;">★ 4.9/5 Feedback</p>
                        <div style="margin-top: 20px; padding-top: 20px; border-top: 1px solid var(--glass-border-light); display: flex; gap: 10px;">
                            <span class="tag">24/7 SUPPORT</span>
                            <span class="tag">CUSTOM BRAND</span>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- PAGE 2: ABOUT SECTION -->
        <section id="about" class="section">
            <div class="container">
                <div class="text-center" style="margin-bottom: 60px;">
                    <h2>Tentang <span class="text-holo"><%= typeof settings !== 'undefined' ? settings.siteName : 'Dents Web' %></span></h2>
                    <p style="max-width: 800px; margin: 0 auto;">Kami hadir sebagai studio teknologi dan mitra strategis yang berdedikasi membangun website profesional, aplikasi mobile kustom, serta produk digital inovatif yang dirancang khusus untuk mempercepat pertumbuhan bisnis Anda.</p>
                </div>
                <div class="grid-3">
                    <div class="glass-panel" style="grid-column: span 1; background: url('https://images.unsplash.com/photo-1498050108023-c5249f4df085?ixlib=rb-4.0.3&auto=format&fit=crop&w=600&q=80') center/cover; min-height: 350px;">
                    </div>
                    <div class="glass-panel glass-panel-p">
                        <h3 style="color: var(--primary);">Solusi Digital Bisnis Anda</h3>
                        <p style="margin-top: 16px;">Kami menghadirkan pembuatan website kustom mulai dari Landing Page, Company Profile, hingga E-Commerce yang cepat, responsif, aman, dan teroptimasi SEO untuk memaksimalkan kehadiran digital bisnis Anda.</p>
                    </div>
                    <div class="glass-panel glass-panel-p">
                        <h3 style="color: var(--warning);">Transparansi & Dukungan</h3>
                        <p style="margin-top: 16px;">Kami memberikan transparansi penuh mulai dari progres mingguan hingga penyerahan proyek secara utuh. Dukungan pasca-rilis selalu tersedia untuk menjaga aset digital Anda tetap prima.</p>
                    </div>
                </div>
            </div>
        </section>

        <!-- PAGE 3: PROBLEM & SOLUTION -->
        <section class="section">
            <div class="container grid-2">
                <div>
                    <div class="tag">PROBLEM & SOLUTION</div>
                    <h2>Mengapa Website adalah <span class="text-holo">Wajib</span> untuk Bisnis?</h2>
                    <p style="margin-bottom: 32px;">Di era digital, tidak memiliki website berarti membiarkan potensi pelanggan Anda pergi ke kompetitor. Website bukan sekadar gaya hidup, tapi infrastruktur fundamental bisnis modern.</p>
                    <div class="glass-panel" style="border-left: 4px solid var(--primary); padding: 24px; border-radius: 0 var(--radius-sm) var(--radius-sm) 0;">
                        <p style="font-style: italic; margin: 0; color: var(--text-primary); font-weight: 600;">"Website adalah kantor pusat digital Anda. Tanpa itu, bisnis Anda tidak terlihat di peta pencarian pelanggan."</p>
                    </div>
                </div>
                <div style="display: grid; grid-template-columns: repeat(2, 1fr); gap: 24px;">
                    <div class="glass-panel" style="padding: 24px;">
                        <h3 style="color: var(--primary); margin-bottom: 8px;">🛡️ Kredibilitas</h3>
                        <p style="font-size: 0.9rem; margin: 0;">Dianggap lebih terpercaya oleh 84% calon konsumen digital.</p>
                    </div>
                    <div class="glass-panel" style="padding: 24px;">
                        <h3 style="color: var(--warning); margin-bottom: 8px;">🌍 Market Reach</h3>
                        <p style="font-size: 0.9rem; margin: 0;">Tembus batasan geografis di seluruh Indonesia bahkan global.</p>
                    </div>
                    <div class="glass-panel" style="padding: 24px;">
                        <h3 style="color: var(--success); margin-bottom: 8px;">⏰ Buka 24/7</h3>
                        <p style="font-size: 0.9rem; margin: 0;">Tetap dapat diakses pelanggan kapan saja tanpa henti.</p>
                    </div>
                    <div class="glass-panel" style="padding: 24px;">
                        <h3 style="color: var(--primary); margin-bottom: 8px;">📈 Investasi</h3>
                        <p style="font-size: 0.9rem; margin: 0;">Aset digital yang jauh lebih hemat dibanding iklan tradisional.</p>
                    </div>
                </div>
            </div>
        </section>

        <!-- PAGE 4: SERVICES -->
        <section id="services" class="section">
            <div class="container">
                <div class="text-center" style="margin-bottom: 60px;">
                    <div class="tag">LAYANAN KAMI</div>
                    <h2>Jasa Buat Website & <br>Solusi Digital UMKM</h2>
                    <p style="max-width: 600px; margin: 0 auto;">Fokus pada pertumbuhan bisnis Anda melalui solusi teknologi yang tepat guna.</p>
                </div>
                <div class="grid-3">
                    <% if(typeof services !== 'undefined' && services.length > 0) { %>
                        <% services.forEach(service => { %>
                            <div class="glass-panel glass-panel-p">
                                <h3 style="color: var(--text-primary);"><%= service.title %></h3>
                                <ul style="margin-top: 24px;">
                                    <% 
                                        // ==========================================
                                        // VERCEL CRASH FIX: SAFE SPLIT HANDLING
                                        // ==========================================
                                        let featureList = [];
                                        if (service.features) {
                                            if (Array.isArray(service.features)) {
                                                featureList = service.features;
                                            } else if (typeof service.features === 'string') {
                                                featureList = service.features.split(',');
                                            }
                                        }
                                    %>
                                    <% if (featureList.length > 0) { %>
                                        <% featureList.forEach(f => { %>
                                            <li style="margin-bottom: 12px; color: var(--text-secondary); display: flex; gap: 8px; font-size: 0.95rem;">
                                                <span style="color: var(--primary);">✓</span> <%= typeof f === 'string' ? f.trim() : f %>
                                            </li>
                                        <% }) %>
                                    <% } else { %>
                                        <p style="color: var(--text-secondary); line-height: 1.6;"><%= service.shortDescription || service.description || 'Deskripsi layanan belum tersedia.' %></p>
                                    <% } %>
                                </ul>
                            </div>
                        <% }) %>
                    <% } else { %>
                        <!-- Fallback / Default Services if DB is empty -->
                        <div class="glass-panel glass-panel-p">
                            <h3 style="color: var(--text-primary);">Landing Page & Profile</h3>
                            <ul style="margin-top: 24px;">
                                <li style="margin-bottom: 12px; color: var(--text-secondary); display: flex; gap: 8px;"><span style="color: var(--primary);">✓</span> Desain modern & premium</li>
                                <li style="margin-bottom: 12px; color: var(--text-secondary); display: flex; gap: 8px;"><span style="color: var(--primary);">✓</span> Mobile-first responsive</li>
                                <li style="margin-bottom: 12px; color: var(--text-secondary); display: flex; gap: 8px;"><span style="color: var(--primary);">✓</span> Optimasi SEO on-page</li>
                                <li style="margin-bottom: 12px; color: var(--text-secondary); display: flex; gap: 8px;"><span style="color: var(--primary);">✓</span> Integrasi WhatsApp</li>
                            </ul>
                        </div>
                        <div class="glass-panel glass-panel-p">
                            <h3 style="color: var(--text-primary);">Sistem Custom & Web App</h3>
                            <ul style="margin-top: 24px;">
                                <li style="margin-bottom: 12px; color: var(--text-secondary); display: flex; gap: 8px;"><span style="color: var(--primary);">✓</span> Dashboard admin interaktif</li>
                                <li style="margin-bottom: 12px; color: var(--text-secondary); display: flex; gap: 8px;"><span style="color: var(--primary);">✓</span> Manajemen data & inventori</li>
                                <li style="margin-bottom: 12px; color: var(--text-secondary); display: flex; gap: 8px;"><span style="color: var(--primary);">✓</span> Sistem CRM / Kasir Online</li>
                                <li style="margin-bottom: 12px; color: var(--text-secondary); display: flex; gap: 8px;"><span style="color: var(--primary);">✓</span> Keamanan data terjamin</li>
                            </ul>
                        </div>
                        <div class="glass-panel glass-panel-p">
                            <h3 style="color: var(--text-primary);">UI/UX Design & Branding</h3>
                            <ul style="margin-top: 24px;">
                                <li style="margin-bottom: 12px; color: var(--text-secondary); display: flex; gap: 8px;"><span style="color: var(--primary);">✓</span> User journey yang intuitif</li>
                                <li style="margin-bottom: 12px; color: var(--text-secondary); display: flex; gap: 8px;"><span style="color: var(--primary);">✓</span> Mockup desain hi-fidelity</li>
                                <li style="margin-bottom: 12px; color: var(--text-secondary); display: flex; gap: 8px;"><span style="color: var(--primary);">✓</span> Identitas visual & logo</li>
                                <li style="margin-bottom: 12px; color: var(--text-secondary); display: flex; gap: 8px;"><span style="color: var(--primary);">✓</span> Prototype interaktif</li>
                            </ul>
                        </div>
                    <% } %>
                </div>
            </div>
        </section>

        <!-- PAGE 5: PORTFOLIO -->
        <section id="portfolio" class="section">
            <div class="container text-center" style="margin-bottom: 60px;">
                <div class="tag">PROYEK KAMI</div>
                <h2>Karya <span class="text-holo">Terbaik</span></h2>
                <p>Portfolio proyek digital yang telah kami eksekusi dengan standar industri terbaik.</p>
            </div>
            <div class="container grid-2">
                <% if(typeof portfolio !== 'undefined' && portfolio.length > 0) { %>
                    <% portfolio.forEach(item => { %>
                        <div class="portfolio-card" onclick="window.location.href='/portfolio/<%= item.slug %>'">
                            <div class="portfolio-img" style="background-image: url('<%= item.image || '/public/img/placeholder.png' %>')"></div>
                            <div class="portfolio-info">
                                <span class="tag"><%= item.category %></span>
                                <h3 style="margin-top: 12px; margin-bottom: 8px;"><%= item.title %></h3>
                                <p style="font-size: 0.95rem; margin-bottom: 0;">Klien: <span style="color: var(--text-primary);"><%= item.client %></span></p>
                            </div>
                        </div>
                    <% }) %>
                <% } else { %>
                    <p class="text-center" style="grid-column: 1 / -1;">Belum ada portfolio unggulan saat ini.</p>
                <% } %>
            </div>
            <div class="container text-center" style="margin-top: 60px;">
                <a href="/portfolio" class="btn btn-secondary">Lihat Semua Karya</a>
            </div>
        </section>

        <!-- PAGE 6: STEPS -->
        <section class="section">
            <div class="container grid-2">
                <div>
                    <h2>4 Langkah Mudah<br>Memulai <span class="text-holo">Proyek</span></h2>
                    <p style="margin-top: 24px; margin-bottom: 32px;">Ingin mulai membangun proyek Anda? Kami akan memandu Anda secara transparan dari briefing kebutuhan hingga serah terima melalui 4 langkah praktis berikut.</p>
                    <ul style="margin-bottom: 40px;">
                        <li style="margin-bottom: 16px; font-weight: 600;"><span style="color: var(--success); margin-right: 12px;">✔</span> Alur kerja adaptif & fleksibel</li>
                        <li style="margin-bottom: 16px; font-weight: 600;"><span style="color: var(--success); margin-right: 12px;">✔</span> Diskusi & konsultasi berkala</li>
                        <li style="margin-bottom: 16px; font-weight: 600;"><span style="color: var(--success); margin-right: 12px;">✔</span> Revisi solutif sesuai kesepakatan</li>
                        <li style="margin-bottom: 16px; font-weight: 600;"><span style="color: var(--success); margin-right: 12px;">✔</span> Dukungan penuh setelah rilis</li>
                    </ul>
                    <a href="/contact" class="btn btn-primary">Mulai Konsultasi &nearr;</a>
                </div>
                <div style="display: flex; flex-direction: column; gap: 20px;">
                    <div class="glass-panel" style="padding: 24px; display: flex; gap: 20px; align-items: flex-start;">
                        <div style="width: 45px; height: 45px; background: var(--holo-gradient); border-radius: 12px; display: flex; align-items: center; justify-content: center; font-weight: 800; font-size: 1.2rem; flex-shrink: 0; box-shadow: var(--shadow-glow-holo);">1</div>
                        <div>
                            <h4 style="color: var(--text-primary);">Konsultasi & Briefing</h4>
                            <p style="font-size: 0.95rem; margin-top: 8px; margin-bottom: 0;">Sampaikan kebutuhan bisnis Anda kepada kami, mulai dari jenis platform, fitur-fitur, hingga target audiens.</p>
                        </div>
                    </div>
                    <div class="glass-panel" style="padding: 24px; display: flex; gap: 20px; align-items: flex-start;">
                        <div style="width: 45px; height: 45px; background: var(--holo-gradient); border-radius: 12px; display: flex; align-items: center; justify-content: center; font-weight: 800; font-size: 1.2rem; flex-shrink: 0; box-shadow: var(--shadow-glow-holo);">2</div>
                        <div>
                            <h4 style="color: var(--text-primary);">Rekomendasi & Paket</h4>
                            <p style="font-size: 0.95rem; margin-top: 8px; margin-bottom: 0;">Tim kami akan menyarankan jenis website/aplikasi serta paket investasi terbaik yang paling tepat guna.</p>
                        </div>
                    </div>
                    <div class="glass-panel" style="padding: 24px; display: flex; gap: 20px; align-items: flex-start;">
                        <div style="width: 45px; height: 45px; background: var(--holo-gradient); border-radius: 12px; display: flex; align-items: center; justify-content: center; font-weight: 800; font-size: 1.2rem; flex-shrink: 0; box-shadow: var(--shadow-glow-holo);">3</div>
                        <div>
                            <h4 style="color: var(--text-primary);">Deal & Aset Digital</h4>
                            <p style="font-size: 0.95rem; margin-top: 8px; margin-bottom: 0;">Setelah DP dilakukan, Anda dapat menyerahkan aset materi (logo, teks, gambar) yang ingin ditampilkan.</p>
                        </div>
                    </div>
                    <div class="glass-panel" style="padding: 24px; display: flex; gap: 20px; align-items: flex-start;">
                        <div style="width: 45px; height: 45px; background: var(--holo-gradient); border-radius: 12px; display: flex; align-items: center; justify-content: center; font-weight: 800; font-size: 1.2rem; flex-shrink: 0; box-shadow: var(--shadow-glow-holo);">4</div>
                        <div>
                            <h4 style="color: var(--text-primary);">Eksekusi & Rilis</h4>
                            <p style="font-size: 0.95rem; margin-top: 8px; margin-bottom: 0;">Proses development dimulai. Setelah melalui revisi, pelunasan dilakukan dan project live/diserahkan.</p>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- PAGE 7: TESTIMONIALS -->
        <section class="section">
            <div class="container text-center" style="margin-bottom: 60px;">
                <h2>Apa Kata <span class="text-holo">Klien Kami</span></h2>
                <p>Testimoni jujur dari para pemilik bisnis yang telah bekerja sama dengan tim <%= typeof settings !== 'undefined' ? settings.siteName : 'Dents Web' %>.</p>
            </div>
            <!-- Gunakan grid-3 agar responsif dari CSS Anda -->
            <div class="container grid-3">
                <div class="glass-panel glass-panel-p">
                    <p style="font-style: italic; font-weight: 500; font-size: 1.05rem; margin-bottom: 24px; color: var(--text-primary);">"I've been using this service for my UMKM and it is very cool! The website is user friendly and the service quality to hear the instruction is very good job."</p>
                    <div style="color: var(--warning); margin-bottom: 16px; font-size: 1.2rem; letter-spacing: 2px;">★★★★★</div>
                    <div style="display: flex; align-items: center; gap: 16px;">
                        <div style="width: 45px; height: 45px; background: rgba(255,255,255,0.1); border: 1px solid var(--glass-border-light); color: var(--text-primary); border-radius: 50%; display: flex; align-items: center; justify-content: center; font-weight: bold;">AW</div>
                        <div>
                            <h4 style="margin: 0; font-size: 1rem;">Adhi Wicaksono</h4>
                            <p style="margin: 0; font-size: 0.85rem;">Dapoer Niknik</p>
                        </div>
                    </div>
                </div>
                <div class="glass-panel glass-panel-p">
                    <p style="font-style: italic; font-weight: 500; font-size: 1.05rem; margin-bottom: 24px; color: var(--text-primary);">"Sangat professional dan sesuai harapan. Sebagai client saya puas dengan projectnya. Saya akan rekomendasikan ke teman saya yang butuh jasa website juga. Thankyou <3"</p>
                    <div style="color: var(--warning); margin-bottom: 16px; font-size: 1.2rem; letter-spacing: 2px;">★★★★★</div>
                    <div style="display: flex; align-items: center; gap: 16px;">
                        <div style="width: 45px; height: 45px; background: rgba(255,255,255,0.1); border: 1px solid var(--glass-border-light); color: var(--text-primary); border-radius: 50%; display: flex; align-items: center; justify-content: center; font-weight: bold;">RD</div>
                        <div>
                            <h4 style="margin: 0; font-size: 1rem;">Ratih Dewi</h4>
                            <p style="margin: 0; font-size: 0.85rem;">Kopi Bintang</p>
                        </div>
                    </div>
                </div>
                <div class="glass-panel glass-panel-p">
                    <p style="font-style: italic; font-weight: 500; font-size: 1.05rem; margin-bottom: 24px; color: var(--text-primary);">"Mantap, Hasilnya memuaskan. Akhirnya punya website buat branding kami! Sangat adaptif dengan revisi-revisi yang kami minta di tengah jalan."</p>
                    <div style="color: var(--warning); margin-bottom: 16px; font-size: 1.2rem; letter-spacing: 2px;">★★★★★</div>
                    <div style="display: flex; align-items: center; gap: 16px;">
                        <div style="width: 45px; height: 45px; background: rgba(255,255,255,0.1); border: 1px solid var(--glass-border-light); color: var(--text-primary); border-radius: 50%; display: flex; align-items: center; justify-content: center; font-weight: bold;">AN</div>
                        <div>
                            <h4 style="margin: 0; font-size: 1rem;">Akmal Adhi Nugroho</h4>
                            <p style="margin: 0; font-size: 0.85rem;">Anggana Project</p>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- PAGE 8: FAQ -->
        <section id="faq" class="section">
            <div class="container grid-2" style="align-items: flex-start;">
                <div>
                    <h2>Ada yang Ingin<br><span class="text-holo">Ditanyakan?</span></h2>
                    <p style="margin-top: 24px; margin-bottom: 40px;">Pertanyaan yang paling sering kami terima dari calon klien. Tidak menemukan jawaban yang Anda cari? Langsung hubungi kami.</p>
                    <a href="/contact" class="btn btn-secondary">Hubungi Kami &nearr;</a>
                </div>
                <div>
                    <% if(typeof faq !== 'undefined' && faq.length > 0) { %>
                        <% faq.forEach((item, index) => { %>
                            <details class="glass-panel" style="margin-bottom: 16px; padding: 20px; cursor: pointer;">
                                <summary style="font-weight: 700; font-size: 1.1rem; list-style: none; display: flex; justify-content: space-between; align-items: center; outline: none;">
                                    <span style="display: flex; gap: 16px; align-items: center;">
                                        <span style="color: var(--primary); font-size: 0.9rem;">0<%= index+1 %></span> 
                                        <%= item.question %>
                                    </span>
                                    <span style="color: var(--primary);">+</span>
                                </summary>
                                <p style="margin-top: 16px; margin-bottom: 0; font-size: 0.95rem; border-top: 1px solid var(--glass-border-dark); padding-top: 16px;"><%= item.answer %></p>
                            </details>
                        <% }) %>
                    <% } else { %>
                        <details class="glass-panel" style="margin-bottom: 16px; padding: 20px; cursor: pointer;">
                            <summary style="font-weight: 700; font-size: 1.1rem; list-style: none; display: flex; justify-content: space-between; align-items: center; outline: none;">
                                <span style="display: flex; gap: 16px; align-items: center;"><span style="color: var(--primary); font-size: 0.9rem;">01</span> Berapa lama waktu pengerjaan proyek?</span>
                                <span style="color: var(--primary);">+</span>
                            </summary>
                            <p style="margin-top: 16px; margin-bottom: 0; font-size: 0.95rem; border-top: 1px solid var(--glass-border-dark); padding-top: 16px;">Tergantung jenis layanannya. Landing page 3-5 hari kerja. Company profile 7-14 hari. Sistem informasi 2-6 minggu. Kami akan memberikan timeline detail di awal.</p>
                        </details>
                        <details class="glass-panel" style="margin-bottom: 16px; padding: 20px; cursor: pointer;">
                            <summary style="font-weight: 700; font-size: 1.1rem; list-style: none; display: flex; justify-content: space-between; align-items: center; outline: none;">
                                <span style="display: flex; gap: 16px; align-items: center;"><span style="color: var(--primary); font-size: 0.9rem;">02</span> Apakah ada biaya revisi?</span>
                                <span style="color: var(--primary);">+</span>
                            </summary>
                            <p style="margin-top: 16px; margin-bottom: 0; font-size: 0.95rem; border-top: 1px solid var(--glass-border-dark); padding-top: 16px;">Revisi minor pada masa development tidak dikenakan biaya. Revisi mayor yang merubah struktur di luar kesepakatan awal akan disesuaikan harganya.</p>
                        </details>
                        <details class="glass-panel" style="margin-bottom: 16px; padding: 20px; cursor: pointer;">
                            <summary style="font-weight: 700; font-size: 1.1rem; list-style: none; display: flex; justify-content: space-between; align-items: center; outline: none;">
                                <span style="display: flex; gap: 16px; align-items: center;"><span style="color: var(--primary); font-size: 0.9rem;">03</span> Domain dan hosting sudah termasuk?</span>
                                <span style="color: var(--primary);">+</span>
                            </summary>
                            <p style="margin-top: 16px; margin-bottom: 0; font-size: 0.95rem; border-top: 1px solid var(--glass-border-dark); padding-top: 16px;">Ya, untuk paket pembuatan website komplit, kami sudah memasukkan biaya domain (.com/.id) dan cloud hosting untuk tahun pertama.</p>
                        </details>
                    <% } %>
                </div>
            </div>
        </section>

        <!-- PAGE 9: CONTACT -->
        <section class="section" style="padding-bottom: 160px;">
            <div class="container grid-2" style="align-items: flex-start;">
                <div>
                    <h2>Mari Mulai Sesuatu <br>yang <span class="text-holo">Luar Biasa</span></h2>
                    <p style="margin-top: 24px; margin-bottom: 40px;">Ceritakan kebutuhan bisnis Anda. Tim ahli kami siap mendengarkan, menganalisis, dan memberikan solusi terbaik untuk pertumbuhan digital Anda.</p>
                    
                    <div style="display: flex; flex-direction: column; gap: 20px;">
                        <div class="glass-panel" style="padding: 24px; display: flex; align-items: center; gap: 20px;">
                            <div style="width: 50px; height: 50px; background: rgba(255,255,255,0.05); border: 1px solid var(--glass-border-light); border-radius: 12px; display: flex; justify-content: center; align-items: center; font-size: 1.5rem;">✉️</div>
                            <div>
                                <p style="font-size: 0.8rem; font-weight: 700; text-transform: uppercase; margin: 0; color: var(--primary);">Email</p>
                                <h4 style="margin: 0; font-size: 1.1rem;"><%= typeof settings !== 'undefined' ? settings.email : 'hello@dentsweb.com' %></h4>
                            </div>
                        </div>
                        <div class="glass-panel" style="padding: 24px; display: flex; align-items: center; gap: 20px;">
                            <div style="width: 50px; height: 50px; background: rgba(255,255,255,0.05); border: 1px solid var(--glass-border-light); border-radius: 12px; display: flex; justify-content: center; align-items: center; font-size: 1.5rem;">💬</div>
                            <div>
                                <p style="font-size: 0.8rem; font-weight: 700; text-transform: uppercase; margin: 0; color: var(--primary);">WhatsApp</p>
                                <h4 style="margin: 0; font-size: 1.1rem;"><%= typeof settings !== 'undefined' ? settings.whatsapp : '+62 812 3456 7890' %></h4>
                            </div>
                        </div>
                        <div class="glass-panel" style="padding: 24px; display: flex; align-items: center; gap: 20px;">
                            <div style="width: 50px; height: 50px; background: rgba(255,255,255,0.05); border: 1px solid var(--glass-border-light); border-radius: 12px; display: flex; justify-content: center; align-items: center; font-size: 1.5rem;">📍</div>
                            <div>
                                <p style="font-size: 0.8rem; font-weight: 700; text-transform: uppercase; margin: 0; color: var(--primary);">Lokasi</p>
                                <h4 style="margin: 0; font-size: 1.1rem;">Indonesia</h4>
                            </div>
                        </div>
                    </div>
                </div>
                
                <div class="glass-panel glass-panel-p">
                    <h3 style="margin-bottom: 8px; color: var(--text-primary);">Ceritakan Kebutuhan Anda</h3>
                    <p style="font-size: 0.95rem; margin-bottom: 32px;">Isi form di bawah ini dan kami akan segera menghubungi Anda via WhatsApp.</p>
                    
                    <form id="contactForm">
                        <div class="form-group">
                            <label class="form-label">Nama Lengkap *</label>
                            <input type="text" id="name" class="form-control" placeholder="Cth: Budi Santoso" required>
                        </div>
                        <div class="form-group">
                            <label class="form-label">Nomor WhatsApp *</label>
                            <input type="tel" id="whatsapp" class="form-control" placeholder="Cth: 08123456789" required>
                        </div>
                        <div class="form-group">
                            <label class="form-label">Alamat Email</label>
                            <input type="email" id="email" class="form-control" placeholder="Cth: budi@perusahaan.com">
                        </div>
                        <div class="form-group">
                            <label class="form-label">Detail Proyek *</label>
                            <textarea id="message" class="form-control" rows="4" placeholder="Ceritakan gambaran singkat proyek Anda, tujuan yang ingin dicapai, dan estimasi waktu jika ada..." required></textarea>
                        </div>
                        <button type="submit" class="btn btn-primary" style="width: 100%;">Kirim Pesan Sekarang</button>
                        <div id="formFeedback" style="margin-top: 20px; text-align: center; font-weight: 700; letter-spacing: 0.5px;"></div>
                    </form>
                </div>
            </div>
        </section>
    </main>

    <%- include('partials/footer') %>

    <!-- Logic API Form -->
    <script>
        const form = document.getElementById('contactForm');
        if(form) {
            form.addEventListener('submit', async (e) => {
                e.preventDefault();
                const btn = e.target.querySelector('button');
                const feedback = document.getElementById('formFeedback');
                btn.disabled = true;
                btn.textContent = 'MENGIRIM...';

                try {
                    const res = await fetch('/api/leads', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({
                            name: document.getElementById('name').value,
                            whatsapp: document.getElementById('whatsapp').value,
                            email: document.getElementById('email').value,
                            message: document.getElementById('message').value
                        })
                    });
                    const data = await res.json();
                    
                    if(data.success) {
                        feedback.innerHTML = '<span style="color: var(--success);">Pesan berhasil dikirim! Tim kami akan segera menghubungi Anda.</span>';
                        e.target.reset();
                    } else {
                        feedback.innerHTML = `<span style="color: var(--danger);">${data.message}</span>`;
                    }
                } catch (err) {
                    feedback.innerHTML = '<span style="color: var(--danger);">Gagal menghubungi server. Silakan coba lagi.</span>';
                } finally {
                    btn.disabled = false;
                    btn.textContent = 'KIRIM PESAN SEKARANG';
                }
            });
        }
    </script>
</body>
</html>
