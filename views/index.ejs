<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="theme-color" content="#05081c">
    
    <!-- DYNAMIC SEO GOLD STANDARD -->
    <title><%= typeof seo !== 'undefined' ? seo.title : 'Dents Web | Studio Rekayasa Website & Solusi Digital Performa Tinggi' %></title>
    <meta name="description" content="<%= typeof seo !== 'undefined' ? seo.desc : 'Studio rekayasa website kustom, landing page konversi tinggi, dan sistem informasi berkinerja tinggi. Dirancang khusus membangun otoritas bisnis dan konversi maksimal.' %>">
    <meta name="keywords" content="<%= typeof seo !== 'undefined' ? seo.keywords : 'jasa pembuatan website, jasa web developer, arsitektur web modern, sistem informasi kustom, website cepat SEO, Dents Web' %>">
    <link rel="canonical" href="<%= typeof seo !== 'undefined' ? seo.url : 'https://dentsweb.my.id/' %>">
    
    <!-- Google Site Verification -->
    <% if (typeof settings !== 'undefined' && settings.googleVerification) { %>
    <meta name="google-site-verification" content="<%= settings.googleVerification %>" />
    <% } %>
    
    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website">
    <meta property="og:url" content="<%= typeof seo !== 'undefined' ? seo.url : 'https://dentsweb.my.id/' %>">
    <meta property="og:title" content="<%= typeof seo !== 'undefined' ? seo.title : 'Dents Web | Studio Rekayasa Website & Solusi Digital Performa Tinggi' %>">
    <meta property="og:description" content="<%= typeof seo !== 'undefined' ? seo.desc : '' %>">
    <meta property="og:image" content="<%= typeof seo !== 'undefined' ? seo.image : '/public/img/axalogo.png' %>">
    
    <!-- Twitter Cards -->
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:url" content="<%= typeof seo !== 'undefined' ? seo.url : 'https://dentsweb.my.id/' %>">
    <meta name="twitter:title" content="<%= typeof seo !== 'undefined' ? seo.title : 'Dents Web | Studio Rekayasa Website & Solusi Digital Performa Tinggi' %>">
    <meta name="twitter:description" content="<%= typeof seo !== 'undefined' ? seo.desc : '' %>">
    <meta name="twitter:image" content="<%= typeof seo !== 'undefined' ? seo.image : '/public/img/axalogo.png' %>">

    <!-- Schema.org JSON-LD (Verified Google Search Console Rich Results) -->
    <% if (typeof seo !== 'undefined' && seo.schemaString) { %>
    <script type="application/ld+json">
        <%- seo.schemaString %>
    </script>
    <% } %>
    
    <link rel="icon" type="image/png" href="<%= typeof settings !== 'undefined' && settings.favicon ? settings.favicon : '/public/img/axalogo.png' %>">
    <link rel="apple-touch-icon" href="<%= typeof settings !== 'undefined' && settings.logo ? settings.logo : '/public/img/axalogo.png' %>">
    
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Lexend+Deca:wght@500;600;700;800&family=Playfair+Display:ital,wght@1,400;1,500;1,600;1,700&family=Plus+Jakarta+Sans:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
    
    <link rel="stylesheet" href="/public/css/style.css">
</head>
<body>
    
    <%- include('partials/header') %>

    <main>
        <!-- ==========================================
             1. HERO SECTION (PROFESIONAL DIGITAL STUDIO)
             ========================================== -->
        <section class="section-hero">
            <!-- Ambient Glow Orbs -->
            <div class="orb-glow-blue" style="top: -10%; left: -10%;"></div>
            <div class="orb-glow-lime" style="top: 25%; right: -5%;"></div>
            <div class="orb-glow-blue" style="bottom: -20%; right: 15%; width: 500px; height: 500px;"></div>

            <div class="container" style="position: relative; z-index: 10;">
                <div class="grid-2" style="align-items: center;">
                    <!-- Left Column: Copy & Actions -->
                    <div>
                        <div class="badge-tag-lime" style="margin-bottom: 24px;">
                            <svg class="svg-icon svg-icon-sm" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>
                            <span>STUDIO REKAYASA DIGITAL &bull; HIGH PERFORMANCE &amp; SCALABLE</span>
                        </div>
                        
                        <h1>
                            <span style="display: block;">Arsitektur Web Presisi Tinggi,</span>
                            <span style="display: block; margin-top: 6px;">
                                <span class="font-editorial text-lime" style="font-size: 1.08em; display: inline-block;">Cepat</span> &amp; <span class="font-editorial text-lime" style="font-size: 1.08em; display: inline-block;">Berdampak Nyata</span>
                            </span>
                            <span style="display: block; margin-top: 6px;">Untuk Skala Bisnis Anda.</span>
                        </h1>

                        <p style="font-size: 1.15rem; color: rgba(255,255,255,0.8); max-width: 560px; margin-bottom: 36px; font-weight: 500; line-height: 1.8;">
                            Kami merekayasa website kustom, landing page konversi tinggi, dan sistem informasi berkinerja tinggi bersama <strong class="font-logo text-white"><%= typeof settings !== 'undefined' && settings.brandName ? settings.brandName : 'Dents Web' %></strong>. Dirancang khusus untuk membangun otoritas industri, mempercepat retensi pengguna, dan melipatgandakan pertumbuhan bisnis Anda.
                        </p>

                        <div style="display: flex; gap: 16px; flex-wrap: wrap;">
                            <a href="https://wa.me/<%= typeof settings !== 'undefined' && settings.whatsapp ? settings.whatsapp : '6285338922586' %>?text=Halo%20Admin%20Dents%20Web,%20saya%20ingin%20konsultasi%20mengenai%20proyek%20website." target="_blank" rel="noopener" class="btn-lime" style="display: inline-flex; align-items: center; gap: 8px;">
                                <span>Konsultasi Proyek Gratis</span>
                                <svg class="svg-icon svg-icon-sm" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 7h10v10"></path><path d="M7 17 17 7"></path></svg>
                            </a>
                            <a href="#portfolio" class="btn-ghost-white">
                                <span>Lihat Karya Pilihan</span>
                            </a>
                        </div>
                    </div>

                    <!-- Right Column: Tactile Hero Showcase Card -->
                    <div style="display: flex; justify-content: center;">
                        <div class="tactile-card tactile-card-heavy" style="max-width: 440px; width: 100%; padding: 36px 30px; background: #ffffff; border-color: #e2e8f0; border-bottom-color: #cbd5e1; box-shadow: 0 30px 60px -15px rgba(0,0,0,0.35);">
                            <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 24px;">
                                <div style="display: flex; align-items: center; gap: 4px;">
                                    <img src="<%= typeof settings !== 'undefined' && settings.logo ? settings.logo : '/public/img/axalogo.png' %>" alt="Logo" style="width: 34px; height: 34px; object-fit: contain;">
                                    <span style="font-family: 'Lexend Deca', sans-serif; font-weight: 800; font-size: 1.15rem; color: var(--navy-text); letter-spacing: -0.5px;">ents Web</span>
                                </div>
                                <div class="badge-tag-royal">
                                    <svg class="svg-icon svg-icon-sm" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
                                    <span>5.0/5 RATING</span>
                                </div>
                            </div>

                            <h3 style="font-size: 1.35rem; color: var(--navy-text); margin-bottom: 8px;">Arsitektur Web Modern</h3>
                            <p style="font-size: 0.925rem; color: var(--slate-body); margin-bottom: 24px; line-height: 1.65;">
                                Waktu muat Core Web Vitals instan (&lt; 1 detik), SEO-ready sejak baris pertama, dan ramah pengguna di semua ukuran gawai.
                            </p>

                            <div style="display: flex; flex-direction: column; gap: 12px; border-top: 2px solid var(--border-light); padding-top: 18px;">
                                <div style="display: flex; align-items: center; justify-content: space-between; font-size: 0.9rem;">
                                    <span style="color: var(--slate-body); font-weight: 600;">Core Web Vitals Skor</span>
                                    <span style="color: var(--success); font-weight: 800; display: inline-flex; align-items: center; gap: 4px;">
                                        <span>99 / 100</span>
                                        <svg class="svg-icon svg-icon-sm" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>
                                    </span>
                                </div>
                                <div style="display: flex; align-items: center; justify-content: space-between; font-size: 0.9rem;">
                                    <span style="color: var(--slate-body); font-weight: 600;">Kepemilikan Kode</span>
                                    <span style="color: var(--royal-blue); font-weight: 800;">100% Hak Penuh</span>
                                </div>
                                <div style="display: flex; align-items: center; justify-content: space-between; font-size: 0.9rem;">
                                    <span style="color: var(--slate-body); font-weight: 600;">Dukungan Teknis</span>
                                    <span style="color: var(--navy-text); font-weight: 800;">Direct WhatsApp</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- ==========================================
             2. ABOUT STUDIO SECTION (ARCHITECTURAL WHITE TACTILE)
             ========================================== -->
        <section id="about" class="section-white">
            <div class="container">
                <div class="section-header text-center">
                    <div class="badge-tag-royal" style="margin-bottom: 16px;">TENTANG KAMI</div>
                    <h2>Bukan Sekadar Estetik. Kami Bangun <span class="font-editorial text-royal">Mesin Pertumbuhan Bisnis</span></h2>
                    <p>
                        <strong><%= typeof settings !== 'undefined' && settings.brandName ? settings.brandName : 'Dents Web' %></strong> adalah studio teknologi dan rekayasa web kustom. Kami membantu para pemilik bisnis membangun aset digital berstandar global—tangguh, berkecepatan tinggi, dan terbukti menghasilkan ROI terukur.
                    </p>
                </div>

                <div class="grid-3" style="align-items: stretch;">
                    <!-- Visual Card -->
                    <div class="tactile-card tactile-card-heavy" style="padding: 0; overflow: hidden; display: flex; flex-direction: column; background: #ffffff;">
                        <div style="width: 100%; height: 240px; background: url('https://images.unsplash.com/photo-1498050108023-c5249f4df085?auto=format&fit=crop&w=700&q=80') center/cover;"></div>
                        <div style="padding: 28px; flex: 1; display: flex; flex-direction: column; justify-content: space-between;">
                            <div>
                                <span class="badge-tag-royal" style="margin-bottom: 12px;">ENGINEERING FIRST</span>
                                <h3 style="font-size: 1.25rem; color: var(--navy-text); margin-bottom: 8px;">Rekayasa Kode Berstandar Tinggi</h3>
                                <p style="font-size: 0.95rem; color: var(--slate-body); margin: 0; line-height: 1.65;">Kami menolak template instan lambat. Kode ditulis bersih, modular, dan siap diskalakan sesuai akselerasi pertumbuhan bisnis Anda.</p>
                            </div>
                        </div>
                    </div>

                    <!-- Solusi Digital -->
                    <div class="tactile-card tactile-card-heavy" style="background: #ffffff;">
                        <div style="width: 52px; height: 52px; border-radius: 14px; background: rgba(33, 82, 207, 0.1); color: var(--royal-blue); display: flex; align-items: center; justify-content: center; margin-bottom: 20px;">
                            <svg class="svg-icon svg-icon-lg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"/><path d="M2 12h20"/></svg>
                        </div>
                        <h3 style="font-size: 1.25rem; color: var(--navy-text); margin-bottom: 12px;">Solusi Digital Strategis</h3>
                        <p style="font-size: 0.95rem; color: var(--slate-body); line-height: 1.7; margin-bottom: 0;">
                            Mulai dari Landing Page konversi, Company Profile korporat, hingga Web App sistem operasional yang dirancang responsif di seluruh perangkat dan SEO-ready dari awal.
                        </p>
                    </div>

                    <!-- Transparansi & Dukungan -->
                    <div class="tactile-card tactile-card-heavy" style="background: #ffffff;">
                        <div style="width: 52px; height: 52px; border-radius: 14px; background: rgba(0, 200, 83, 0.12); color: var(--success); display: flex; align-items: center; justify-content: center; margin-bottom: 20px;">
                            <svg class="svg-icon svg-icon-lg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
                        </div>
                        <h3 style="font-size: 1.25rem; color: var(--navy-text); margin-bottom: 12px;">Transparan &amp; Full Hak Akses</h3>
                        <p style="font-size: 0.95rem; color: var(--slate-body); line-height: 1.7; margin-bottom: 0;">
                            Bebas drama vendor-lock. Setelah selesai, seluruh source code, akses domain, dan server diserahkan seutuhnya ke Anda, didukung panduan dan garansi bug-free.
                        </p>
                    </div>
                </div>
            </div>
        </section>

        <!-- ==========================================
             3. MISSION STATEMENT CALLOUT
             ========================================== -->
        <section class="section-soft" style="border-top: 1px solid var(--border-light); border-bottom: 1px solid var(--border-light);">
            <div class="container">
                <div class="grid-2" style="align-items: center;">
                    <div>
                        <h2 style="font-size: clamp(1.8rem, 3.5vw, 2.6rem); line-height: 1.3; color: var(--navy-text);">
                            <%= typeof settings !== 'undefined' && settings.brandName ? settings.brandName : 'Dents Web' %> adalah <span class="font-editorial text-royal">partner teknologi</span> yang memastikan aset digital Anda kredibel dan mengonversi pengunjung menjadi pembeli.
                        </h2>
                    </div>
                    <div style="display: flex; justify-content: flex-end;">
                        <a href="/about" class="btn-royal" style="display: inline-flex; align-items: center; gap: 8px;">
                            <span>Pelajari Filosofi Kami</span>
                            <svg class="svg-icon svg-icon-sm" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg>
                        </a>
                    </div>
                </div>
            </div>
        </section>

        <!-- ==========================================
             4. SERVICES PREVIEW SECTION
             ========================================== -->
        <section id="services" class="section-white">
            <div class="container">
                <div class="section-header text-center">
                    <div class="badge-tag-royal" style="margin-bottom: 16px;">LAYANAN UNGGULAN</div>
                    <h2>Solusi Kustom Sesuai <span class="font-editorial text-royal">Kebutuhan Nyata</span></h2>
                    <p>Pilih paket solusi teknologi yang paling pas dengan skala dan target bisnis Anda.</p>
                </div>

                <div class="grid-3">
                    <% if (typeof services !== 'undefined' && services.length > 0) { %>
                        <% services.forEach(service => { %>
                            <div class="tactile-card" style="display: flex; flex-direction: column; background: #ffffff;">
                                <div style="width: 52px; height: 52px; border-radius: 14px; background: rgba(33, 82, 207, 0.1); color: var(--royal-blue); display: flex; align-items: center; justify-content: center; margin-bottom: 20px;">
                                    <svg class="svg-icon svg-icon-lg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="20" height="14" x="2" y="3" rx="2"/><line x1="8" x2="16" y1="21" y2="21"/><line x1="12" x2="12" y1="17" y2="21"/></svg>
                                </div>
                                <h3 style="font-size: 1.35rem; color: var(--navy-text); margin-bottom: 8px;"><%= service.title %></h3>
                                <p style="font-size: 0.95rem; color: var(--slate-body); margin-bottom: 24px; flex-grow: 1; line-height: 1.65;">
                                    <%= service.shortDescription || service.description %>
                                </p>

                                <% 
                                    let feats = [];
                                    if (service.features) {
                                        feats = Array.isArray(service.features) ? service.features : service.features.split(',');
                                    }
                                %>
                                <% if (feats.length > 0) { %>
                                    <ul class="feature-check-list" style="margin-top: 0; margin-bottom: 24px;">
                                        <% feats.slice(0, 4).forEach(feat => { %>
                                            <li class="feature-check-item">
                                                <span class="check-icon-circle">
                                                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
                                                </span>
                                                <span><%= typeof feat === 'string' ? feat.trim() : feat %></span>
                                            </li>
                                        <% }) %>
                                    </ul>
                                <% } %>

                                <div style="border-top: 2px solid var(--border-light); padding-top: 20px; margin-top: auto;">
                                    <div style="font-size: 0.78rem; text-transform: uppercase; color: var(--slate-muted); font-weight: 800; letter-spacing: 0.05em;">Investasi Mulai</div>
                                    <div style="font-size: 1.6rem; font-weight: 900; color: var(--navy-text); margin-bottom: 16px; line-height: 1.1; margin-top: 4px;"><%= service.startingPrice || 'Hubungi Kami' %></div>
                                    <a href="/contact?service=<%= service.slug || 'web' %>" class="btn-ghost-navy" style="width: 100%; text-align: center; display: inline-flex; align-items: center; justify-content: center; gap: 6px;">
                                        <span>Konsultasi Layanan</span>
                                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="7" y1="17" x2="17" y2="7"></line><polyline points="7 7 17 7 17 17"></polyline></svg>
                                    </a>
                                </div>
                            </div>
                        <% }) %>
                    <% } %>
                </div>

                <div class="text-center" style="margin-top: 48px;">
                    <a href="/services" class="btn-royal" style="display: inline-flex; align-items: center; gap: 8px;">
                        <span>Lihat Semua Layanan</span>
                        <svg class="svg-icon svg-icon-sm" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg>
                    </a>
                </div>
            </div>
        </section>

        <!-- ==========================================
             5. STICKY 4-STEP PROCESS
             ========================================== -->
        <section class="section-soft" style="border-top: 1px solid var(--border-light);">
            <div class="container">
                <div class="process-grid">
                    <!-- Left Sticky Column -->
                    <div class="sticky-col">
                        <div class="badge-tag-royal" style="margin-bottom: 16px;">ALUR PENGERJAAN</div>
                        <h2 style="font-size: clamp(2rem, 4vw, 3rem); line-height: 1.2; color: var(--navy-text); margin-bottom: 20px;">
                            4 Langkah Praktis. Dari Ide Jadi <span class="font-editorial text-royal">Website Live</span>
                        </h2>
                        <p style="font-size: 1.05rem; line-height: 1.7; margin-bottom: 32px; color: var(--slate-body);">
                            Kami memandu Anda secara transparan dari sesi briefing santai hingga serah terima domain dan source code.
                        </p>
                        
                        <div style="display: flex; flex-direction: column; gap: 14px; margin-bottom: 36px;">
                            <div style="display: flex; align-items: center; gap: 12px; font-size: 0.95rem; font-weight: 600; color: var(--navy-text);">
                                <span style="width: 22px; height: 22px; border-radius: 50%; background: var(--lime-accent); display: flex; align-items: center; justify-content: center; color: #05081c;">
                                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
                                </span>
                                Alur kerja terstruktur, adaptif &amp; transparan
                            </div>
                            <div style="display: flex; align-items: center; gap: 12px; font-size: 0.95rem; font-weight: 600; color: var(--navy-text);">
                                <span style="width: 22px; height: 22px; border-radius: 50%; background: var(--lime-accent); display: flex; align-items: center; justify-content: center; color: #05081c;">
                                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
                                </span>
                                Bebas biaya langganan sistem tersembunyi
                            </div>
                            <div style="display: flex; align-items: center; gap: 12px; font-size: 0.95rem; font-weight: 600; color: var(--navy-text);">
                                <span style="width: 22px; height: 22px; border-radius: 50%; background: var(--lime-accent); display: flex; align-items: center; justify-content: center; color: #05081c;">
                                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
                                </span>
                                Serah terima 100% source code &amp; domain
                            </div>
                        </div>

                        <a href="https://wa.me/<%= typeof settings !== 'undefined' && settings.whatsapp ? settings.whatsapp : '6285338922586' %>" target="_blank" rel="noopener" class="btn-lime" style="display: inline-flex; align-items: center; gap: 8px;">
                            <span>Konsultasi Sekarang</span>
                            <svg class="svg-icon svg-icon-sm" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 7h10v10"></path><path d="M7 17 17 7"></path></svg>
                        </a>
                    </div>

                    <!-- Right Steps Column -->
                    <div>
                        <div class="step-card">
                            <div class="step-number">01</div>
                            <div>
                                <h3 style="font-size: 1.2rem; color: var(--navy-text); margin-bottom: 8px;">Konsultasi &amp; Briefing Singkat</h3>
                                <p style="font-size: 0.95rem; color: var(--slate-body); margin: 0; line-height: 1.6;">Ceritakan target bisnis, fitur yang Anda butuhkan, serta referensi tampilan impian via WhatsApp.</p>
                            </div>
                        </div>

                        <div class="step-card">
                            <div class="step-number">02</div>
                            <div>
                                <h3 style="font-size: 1.2rem; color: var(--navy-text); margin-bottom: 8px;">Rekomendasi Solusi &amp; Penawaran</h3>
                                <p style="font-size: 0.95rem; color: var(--slate-body); margin: 0; line-height: 1.6;">Kami susun arsitektur teknis yang efisien, timeline kerja konkret, dan skema investasi yang transparan.</p>
                            </div>
                        </div>

                        <div class="step-card">
                            <div class="step-number">03</div>
                            <div>
                                <h3 style="font-size: 1.2rem; color: var(--navy-text); margin-bottom: 8px;">Pengerjaan &amp; Update Berkala</h3>
                                <p style="font-size: 0.95rem; color: var(--slate-body); margin: 0; line-height: 1.6;">Engineer kami mengeksekusi kode secara rapi dengan update berkala agar Anda bisa memantau setiap tahap.</p>
                            </div>
                        </div>

                        <div class="step-card">
                            <div class="step-number">04</div>
                            <div>
                                <h3 style="font-size: 1.2rem; color: var(--navy-text); margin-bottom: 8px;">Peluncuran &amp; Serah Terima Penuh</h3>
                                <p style="font-size: 0.95rem; color: var(--slate-body); margin: 0; line-height: 1.6;">Website resmi rilis ke publik dengan domain Anda, integrasi Google Search Console, dan panduan lengkap.</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- ==========================================
             6. PORTFOLIO SHOWCASE SECTION
             ========================================== -->
        <section id="portfolio" class="section-white">
            <div class="container">
                <div class="section-header text-center">
                    <div class="badge-tag-royal" style="margin-bottom: 16px;">STUDI KASUS</div>
                    <h2>Portofolio &amp; <span class="font-editorial text-royal">Hasil Eksekusi Nyata</span></h2>
                    <p>Bukan sekadar portofolio pajangan. Ini karya arsitektur digital yang terbukti memicu akselerasi bisnis klien kami.</p>
                </div>

                <div class="grid-2">
                    <% if (typeof portfolio !== 'undefined' && portfolio.length > 0) { %>
                        <% portfolio.forEach(item => { %>
                            <div class="portfolio-card-kalana" onclick="window.location.href='/portfolio/<%= item.slug %>'">
                                <div class="portfolio-img-cover">
                                    <img src="<%= item.image || '/public/img/axalogo.png' %>" alt="<%= item.title %>" loading="lazy">
                                </div>
                                <div class="portfolio-body">
                                    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px;">
                                        <span class="badge-tag-royal"><%= item.category %></span>
                                        <span style="font-size: 0.85rem; font-weight: 700; color: var(--slate-muted);"><%= item.year %></span>
                                    </div>
                                    <h3 style="font-size: 1.35rem; color: var(--navy-text); margin-bottom: 8px;"><%= item.title %></h3>
                                    <p style="font-size: 0.925rem; color: var(--slate-body); margin-bottom: 16px; line-height: 1.6;">
                                        <%= item.shortDescription || item.description %>
                                    </p>
                                    <div style="margin-top: auto; display: flex; align-items: center; gap: 8px; color: var(--royal-blue); font-weight: 700; font-size: 0.9rem;">
                                        <span>Buka Studi Kasus</span>
                                        <svg class="svg-icon svg-icon-sm" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg>
                                    </div>
                                </div>
                            </div>
                        <% }) %>
                    <% } %>
                </div>

                <div class="text-center" style="margin-top: 48px;">
                    <a href="/portfolio" class="btn-royal" style="display: inline-flex; align-items: center; gap: 8px;">
                        <span>Jelajahi Semua Portofolio</span>
                        <svg class="svg-icon svg-icon-sm" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg>
                    </a>
                </div>
            </div>
        </section>

        <!-- ==========================================
             7. TESTIMONIALS (INFINITE MARQUEE WITH REDIS DATA)
             ========================================== -->
        <section class="section-dark">
            <div class="orb-glow-blue" style="top: -100px; right: -100px; opacity: 0.35;"></div>
            <div class="orb-glow-lime" style="bottom: -80px; left: -80px; opacity: 0.08;"></div>

            <div class="container text-center" style="margin-bottom: 48px; position: relative; z-index: 2;">
                <div class="badge-tag-lime" style="margin-bottom: 16px;">TESTIMONI REKAN BISNIS</div>
                <h2 style="font-size: clamp(2rem, 4vw, 3rem); color: #ffffff;">
                    Apa Kata <span class="font-editorial text-lime">Klien Kami</span>
                </h2>
                <p style="color: rgba(255, 255, 255, 0.72); max-width: 600px; margin: 12px auto 0; font-size: 1.05rem;">
                    Ulasan nyata dari para founder dan pengambil keputusan yang mempercayakan platform digital mereka kepada kami.
                </p>
            </div>

            <div class="marquee-container">
                <div class="marquee-mask-left"></div>
                <div class="marquee-mask-right"></div>
                
                <div class="marquee-track-kalana">
                    <% 
                        const reviewList = (typeof testimonials !== 'undefined' && testimonials.length > 0) ? testimonials : [];
                        const doubledReviews = reviewList.length > 0 ? [...reviewList, ...reviewList] : [];
                    %>

                    <% doubledReviews.forEach(rev => { %>
                        <div class="testimonial-card-kalana">
                            <div>
                                <div style="color: #f59e0b; font-size: 1rem; margin-bottom: 12px; display: flex; gap: 3px;">
                                    <% for(let i=0; i < (rev.rating || 5); i++) { %>
                                        <svg class="svg-icon svg-icon-sm" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
                                    <% } %>
                                </div>
                                <p style="font-size: 0.95rem; color: var(--navy-text); line-height: 1.7; font-weight: 500; margin-bottom: 20px;">
                                    "<%= rev.content %>"
                                </p>
                            </div>
                            <div style="display: flex; align-items: center; gap: 12px; border-top: 1px solid var(--border-light); padding-top: 14px;">
                                <div style="width: 40px; height: 40px; border-radius: 50%; background: var(--royal-blue); color: #ffffff; display: flex; align-items: center; justify-content: center; font-weight: 700;">
                                    <%= rev.name ? rev.name.charAt(0) : 'K' %>
                                </div>
                                <div>
                                    <h4 style="font-size: 0.95rem; color: var(--navy-text); margin: 0;"><%= rev.name %></h4>
                                    <p style="font-size: 0.8rem; color: var(--slate-muted); margin: 0;"><%= rev.role %>, <%= rev.company %></p>
                                </div>
                            </div>
                        </div>
                    <% }) %>
                </div>
            </div>
        </section>

        <!-- ==========================================
             8. FAQ SECTION (KALANA STICKY 2-COL ACCORDION)
             ========================================== -->
        <section id="faq" class="section-white">
            <div class="container">
                <div class="process-grid">
                    <div class="sticky-col">
                        <div class="badge-tag-royal" style="margin-bottom: 16px;">FAQ &bull; PUSAT BANTUAN</div>
                        <h2 style="font-size: clamp(2rem, 4vw, 3rem); line-height: 1.2; color: var(--navy-text); margin-bottom: 16px;">
                            Ada yang Ingin <span class="font-editorial text-royal">Ditanyakan?</span>
                        </h2>
                        <p style="font-size: 1.05rem; line-height: 1.7; margin-bottom: 32px; color: var(--slate-body);">
                            Pertanyaan yang paling sering kami terima dari calon klien. Butuh penjelasan khusus mengenai proyek Anda? Langsung diskusikan via WhatsApp resmi kami.
                        </p>
                        <a href="/contact" class="btn-royal" style="display: inline-flex; align-items: center; gap: 8px;">
                            <span>Hubungi Kami Langsung</span>
                            <svg class="svg-icon svg-icon-sm" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 7h10v10"></path><path d="M7 17 17 7"></path></svg>
                        </a>
                    </div>

                    <div>
                        <div class="faq-accordion">
                            <div class="faq-item-kalana active">
                                <button class="faq-question-btn" onclick="toggleFaq(this)" aria-expanded="true">
                                    <span>Berapa lama proses pengerjaan website hingga siap rilis?</span>
                                    <span class="faq-arrow-icon">
                                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg>
                                    </span>
                                </button>
                                <div class="faq-answer-body">
                                    Landing page selesai dalam 3-5 hari kerja. Company profile 7-14 hari kerja. Sistem web kustom 2-4 minggu kerja, tergantung kompleksitas fitur dan kesiapan materi brief.
                                </div>
                            </div>

                            <div class="faq-item-kalana">
                                <button class="faq-question-btn" onclick="toggleFaq(this)" aria-expanded="false">
                                    <span>Apakah website dijamin cepat dan ramah SEO Google?</span>
                                    <span class="faq-arrow-icon">
                                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg>
                                    </span>
                                </button>
                                <div class="faq-answer-body">
                                    Mutlak ya. Kami bangun menggunakan fondasi Server-Side Rendering (SSR) Node.js dan meta tag Schema.org JSON-LD otomatis agar cepat terindeks Google dan punya skor Core Web Vitals tinggi.
                                </div>
                            </div>

                            <div class="faq-item-kalana">
                                <button class="faq-question-btn" onclick="toggleFaq(this)" aria-expanded="false">
                                    <span>Apakah saya dapat akses penuh ke source code dan domain?</span>
                                    <span class="faq-arrow-icon">
                                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg>
                                    </span>
                                </button>
                                <div class="faq-answer-body">
                                    Tentu saja. Setelah pelunasan, 100% kepemilikan source code, akses domain, dan server diserahkan sepenuhnya kepada Anda tanpa biaya sewa sistem tersembunyi.
                                </div>
                            </div>

                            <div class="faq-item-kalana">
                                <button class="faq-question-btn" onclick="toggleFaq(this)" aria-expanded="false">
                                    <span>Bagaimana jika ada kendala atau bug setelah serah terima?</span>
                                    <span class="faq-arrow-icon">
                                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg>
                                    </span>
                                </button>
                                <div class="faq-answer-body">
                                    Kami menyediakan garansi pemeliharaan dan perbaikan bug gratis selama masa garansi untuk menjamin platform digital Anda selalu aktif dan prima.
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- ==========================================
             9. BIG CTA BANNER (KALANA SECTION 8)
             ========================================== -->
        <section class="section-dark" style="padding: 80px 0;">
            <div class="orb-glow-blue" style="top: 0; left: 0; opacity: 0.25;"></div>
            <div class="orb-glow-lime" style="bottom: 0; right: 0; opacity: 0.1;"></div>

            <div class="container text-center" style="position: relative; z-index: 2; max-width: 760px;">
                <h2 style="font-size: clamp(2.2rem, 4.5vw, 3.2rem); color: #ffffff; margin-bottom: 20px;">
                    Siap Membangun Platform Digital yang <span class="font-editorial text-lime">Kredibel &amp; Berkelas?</span>
                </h2>
                <p style="color: rgba(255, 255, 255, 0.76); font-size: 1.15rem; line-height: 1.8; margin-bottom: 36px;">
                    Kami siap membantu Anda merancang dan merekayasa solusi digital yang cepat, tangguh, dan menghasilkan dampak terukur.
                </p>
                <div style="display: flex; gap: 16px; justify-content: center; flex-wrap: wrap;">
                    <a href="/contact" class="btn-lime" style="display: inline-flex; align-items: center; gap: 8px;">
                        <span>Konsultasi Proyek Gratis</span>
                        <svg class="svg-icon svg-icon-sm" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 7h10v10"></path><path d="M7 17 17 7"></path></svg>
                    </a>
                </div>
            </div>
        </section>
    </main>

    <%- include('partials/footer') %>

    <!-- Vercel Speed Insights client telemetry -->
    <script defer src="https://va.vercel-scripts.com/v1/speed-insights/script.js"></script>

    <script>
        function toggleFaq(btn) {
            const item = btn.closest('.faq-item-kalana');
            const isActive = item.classList.contains('active');
            
            document.querySelectorAll('.faq-item-kalana').forEach(i => {
                i.classList.remove('active');
                const b = i.querySelector('.faq-question-btn');
                if (b) b.setAttribute('aria-expanded', 'false');
            });
            
            if (!isActive) {
                item.classList.add('active');
                btn.setAttribute('aria-expanded', 'true');
            }
        }
    </script>
</body>
</html>
