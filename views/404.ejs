<%- include('partials/header') %>

<main class="main-content" style="background: var(--navy-deep); min-height: 85vh; display: flex; align-items: center; justify-content: center; position: relative; overflow: hidden; padding: 60px 20px;">
    <!-- Background Ambient Glow & Grid -->
    <div style="position: absolute; width: 600px; height: 600px; border-radius: 50%; background: radial-gradient(circle, rgba(33, 82, 207, 0.25) 0%, rgba(217, 255, 66, 0.05) 50%, transparent 70%); top: 50%; left: 50%; transform: translate(-50%, -50%); filter: blur(60px); pointer-events: none;"></div>
    <div style="position: absolute; inset: 0; background-image: linear-gradient(rgba(255, 255, 255, 0.03) 1px, transparent 1px), linear-gradient(90deg, rgba(255, 255, 255, 0.03) 1px, transparent 1px); background-size: 40px 40px; pointer-events: none;"></div>

    <div class="container" style="position: relative; z-index: 2; max-width: 720px; text-align: center;">
        <div class="error-404-card" style="background: rgba(16, 24, 59, 0.75); backdrop-filter: blur(16px); border: 1px solid rgba(255, 255, 255, 0.12); border-radius: var(--radius-xl); padding: 48px 32px; box-shadow: 0 25px 60px rgba(0, 0, 0, 0.5);">
            
            <!-- Cyber Broken Connection SVG -->
            <div style="display: inline-flex; align-items: center; justify-content: center; width: 96px; height: 96px; border-radius: 50%; background: rgba(33, 82, 207, 0.15); border: 1px solid rgba(56, 189, 248, 0.3); margin-bottom: 24px; color: var(--lime-accent); box-shadow: 0 0 30px rgba(217, 255, 66, 0.2);">
                <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="10"></circle>
                    <line x1="4.93" y1="4.93" x2="19.07" y2="19.07"></line>
                </svg>
            </div>

            <div class="error-404-code">404</div>
            <h1 class="error-404-title" style="font-size: 1.85rem; font-weight: 800; color: #ffffff; letter-spacing: -0.02em; margin-bottom: 12px;">Sinyal Terputus: Halaman Tidak Ditemukan</h1>
            <p class="error-404-desc" style="color: #cbd5e1; font-size: 1rem; line-height: 1.65; max-width: 540px; margin: 0 auto 32px;">
                Tautan yang Anda tuju mungkin sudah dipindahkan ke arsitektur baru, dihapus, atau terjadi salah ketik pada URL peramban Anda.
            </p>

            <div class="error-404-actions">
                <a href="/" class="btn btn-primary" style="background: var(--lime-accent); color: #0d1230; font-weight: 700; padding: 12px 24px; border-radius: var(--radius-pill); text-decoration: none; display: inline-flex; align-items: center; gap: 8px; box-shadow: var(--lime-glow);">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path><polyline points="9 22 9 12 15 12 15 22"></polyline></svg>
                    Kembali ke Beranda
                </a>
                <a href="/portfolio" class="btn btn-secondary" style="background: rgba(255, 255, 255, 0.08); color: #ffffff; border: 1px solid rgba(255, 255, 255, 0.15); font-weight: 600; padding: 12px 22px; border-radius: var(--radius-pill); text-decoration: none; display: inline-flex; align-items: center; gap: 8px;">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="7" width="20" height="14" rx="2" ry="2"></rect><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"></path></svg>
                    Lihat Portofolio
                </a>
                <a href="/articles" class="btn btn-secondary" style="background: rgba(33, 82, 207, 0.15); color: #93c5fd; border: 1px solid rgba(59, 130, 246, 0.3); font-weight: 600; padding: 12px 22px; border-radius: var(--radius-pill); text-decoration: none; display: inline-flex; align-items: center; gap: 8px;">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path></svg>
                    Baca Materi Artikel
                </a>
            </div>

            <!-- Quick Recovery Search Suggestion -->
            <div style="margin-top: 36px; padding-top: 24px; border-top: 1px solid rgba(255, 255, 255, 0.1); font-size: 0.85rem; color: #94a3b8;">
                Butuh bantuan langsung? <a href="https://wa.me/<%= (settings.whatsapp || '6285338922586').replace(/[^0-9]/g, '') %>?text=Halo%20Admin%20Dents%20Web%2C%20saya%20mengalami%20kendala%20halaman%20404" target="_blank" rel="noopener noreferrer" style="color: var(--lime-accent); font-weight: 700; text-decoration: none;">Hubungi Admin via WhatsApp &rarr;</a>
            </div>
        </div>
    </div>
</main>

<%- include('partials/footer') %>
