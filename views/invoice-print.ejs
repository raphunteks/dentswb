<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Invoice_<%= invoice.number %></title>
    <link rel="icon" type="image/png" href="/img/axalogo.png">
    <link rel="stylesheet" href="/css/invoice-app.css">
    <link rel="stylesheet" href="/css/invoice.css">
</head>
<body onload="window.print()">
    <div class="invoice-box" style="box-shadow: none; max-width: 100%; margin: 0; padding: 0; position: relative;">

        <div class="flex justify-between items-start">
            <div>
                <img src="/img/axalogo.png" alt="DENTS WEB Logo" class="doc-logo">
                <h1 class="text-3xl font-bold mb-2 text-primary">INVOICE</h1>
                <p class="text-gray-500 text-lg">#<%= invoice.number %></p>
            </div>
            <div class="text-right">
                <h2 class="font-bold text-xl"><%= settings.businessName || 'DENTS WEB' %></h2>
                <p class="text-sm text-gray-500"><%= settings.businessAddress || '' %></p>
                <p class="text-sm text-gray-500"><%= settings.businessEmail || '' %></p>
                <p class="text-sm text-gray-500"><%= settings.businessPhone || '' %></p>
                <% if(settings.npwp) { %><p class="text-sm text-gray-500">NPWP: <%= settings.npwp %></p><% } %>
            </div>
        </div>

        <!-- Header divider line -->
        <div class="header-divider"></div>

        <div class="flex justify-between mb-8">
            <div>
                <h3 class="font-bold text-gray-600 border-b mb-2 pb-1">BILL TO:</h3>
                <p class="font-bold"><%= customer.companyName %></p>
                <p class="text-sm"><%= customer.address || '' %></p>
                <p class="text-sm"><%= customer.city || '' %> <%= customer.postalCode || '' %></p>
                <p class="text-sm"><%= customer.email || '' %></p>
            </div>
            <div class="text-right">
                <table class="text-sm ml-auto">
                    <tr>
                        <td class="font-bold pr-4">Status:</td>
                        <td><span class="badge badge-<%= (invoice.status || 'draft').toLowerCase() %>"><%= invoice.status %></span></td>
                    </tr>
                    <tr>
                        <td class="font-bold pr-4">Invoice Date:</td>
                        <td><%= formatDate(invoice.invoiceDate) %></td>
                    </tr>
                    <tr>
                        <td class="font-bold pr-4">Due Date:</td>
                        <td><%= formatDate(invoice.dueDate) %></td>
                    </tr>
                </table>
            </div>
        </div>

        <table class="invoice-table mb-8">
            <thead>
                <tr>
                    <th style="width: 50%; text-align: left;">Description</th>
                    <th class="text-center" style="width: 10%;">Qty</th>
                    <th class="text-right" style="width: 20%;">Price</th>
                    <th class="text-right" style="width: 20%;">Total</th>
                </tr>
            </thead>
            <tbody>
                <% invoice.items.forEach(item => { %>
                <tr>
                    <td>
                        <b><%= item.description %></b>
                        <% if(item.period) { %><div class="text-xs text-gray-500 mt-1"><%= item.period %></div><% } %>
                    </td>
                    <td class="text-center"><%= item.quantity %></td>
                    <td class="text-right"><%= formatRupiah(item.price) %></td>
                    <td class="text-right font-medium"><%= formatRupiah(item.total) %></td>
                </tr>
                <% }) %>
            </tbody>
        </table>

        <div class="flex justify-between mb-8 gap-8">
            <div class="w-1/2 p-4 bg-gray-50 rounded border">
                <h4 class="font-bold mb-2 text-primary text-sm">Payment Details</h4>
                <div class="text-sm text-gray-700 mb-3">
                    <p><b>Bank Transfer:</b></p>
                    <p><%= settings.bankName || 'BNI' %> - <%= settings.bankAccount || '' %></p>
                    <p>A/N: <%= settings.bankAccountName || '' %></p>
                </div>
                
                <% if(invoice.notes || settings.notes) { %>
                    <div class="mt-2 pt-2 border-t text-xs text-gray-600">
                        <b>Notes:</b><br>
                        <p class="whitespace-pre-wrap"><%= invoice.notes || settings.notes %></p>
                    </div>
                <% } %>

                <% if(settings.terms) { %>
                    <div class="mt-2 pt-2 border-t text-xs text-gray-500">
                        <b>Terms & Conditions:</b><br>
                        <p class="whitespace-pre-wrap"><%= settings.terms %></p>
                    </div>
                <% } %>

                <% if(invoice.status === 'PAID') { %>
                    <img src="/public/img/axapaid.png" onerror="this.onerror=null; this.src='/img/axapaid.png';" alt="PAID STAMP" class="stamp-lunas" style="width: 130px; margin-top: 1.5rem; opacity: 0.9;">
                <% } %>
            </div>

            <div class="w-1/2 right-summary-block">
                <table class="w-full text-right summary-table">
                    <tr>
                        <td class="py-1 text-gray-600">Subtotal</td>
                        <td class="py-1 font-medium"><%= formatRupiah(invoice.subtotal) %></td>
                    </tr>
                    <% const discRate = Number(invoice.discountRate || 0); %>
                    <% const discVal = Number(invoice.discountAmount || invoice.discount || (discRate > 0 ? Math.round((invoice.subtotal * discRate) / 100) : 0)); %>
                    <% if(discVal > 0 || discRate > 0) { %>
                        <tr>
                            <td class="py-1 text-gray-600">Discount (<%= discRate %>%)</td>
                            <td class="py-1 text-red-500 font-medium">- <%= formatRupiah(discVal) %></td>
                        </tr>
                    <% } %>
                    <tr>
                        <td class="py-1 text-gray-600"><%= settings.defaultTaxName || 'PPN' %> (<%= invoice.taxRate || 0 %>%)</td>
                        <td class="py-1 font-medium"><%= formatRupiah(invoice.tax || 0) %></td>
                    </tr>
                    <tr class="text-lg font-bold border-t">
                        <td class="py-2">Grand Total</td>
                        <td class="py-2 text-primary"><%= formatRupiah(invoice.total) %></td>
                    </tr>
                    <tr>
                        <td class="py-1 text-gray-600">Amount Paid</td>
                        <td class="py-1 text-green-700 font-medium"><%= formatRupiah(invoice.amountPaid || 0) %></td>
                    </tr>
                    <tr class="font-bold text-xl">
                        <td class="py-2">Balance Due</td>
                        <td class="py-2 <%= invoice.balance > 0 ? 'text-red-600' : 'text-gray-400' %>"><%= formatRupiah(invoice.balance || 0) %></td>
                    </tr>
                </table>

                <!-- QR CODE VERIFIKASI SAH DIBAWAH BALANCE DUE -->
                <% const invoiceVerifyUrl = `${(typeof settings !== 'undefined' && settings.siteUrl ? settings.siteUrl : 'https://www.dentsweb.my.id').replace(/\/$/, '')}/invoice/${invoice.publicId || invoice.id}`; %>
                <div class="qr-verify-container" style="display: flex; justify-content: flex-end; margin-top: 14px; text-align: right;">
                    <div style="display: inline-block; background: #ffffff; padding: 6px 8px; border: 1.5px solid #bae6fd; border-radius: 12px; text-align: center; box-shadow: 0 2px 8px rgba(2, 132, 199, 0.08);">
                        <img src="https://api.qrserver.com/v1/create-qr-code/?size=110x110&margin=2&data=<%= encodeURIComponent(invoiceVerifyUrl) %>" alt="QR Code Verifikasi Sah" width="90" height="90" style="display: block; margin: 0 auto; border-radius: 6px;">
                        <div style="font-size: 0.65rem; font-weight: 800; color: #0284c7; margin-top: 4px; text-transform: uppercase; letter-spacing: 0.4px;">
                            Scan Verifikasi Sah
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</body>
</html>
