<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Official Receipt <%= invoice.number %> - <%= settings.businessName || 'DENTS WEB' %></title>
    <link rel="icon" type="image/png" href="/img/axalogo.png">
    <link rel="stylesheet" href="/css/invoice-app.css">
    <link rel="stylesheet" href="/css/receipt.css">
</head>
<body class="min-h-screen bg-gray-50">
    <!-- Navbar Minimalis untuk Publik (Ini yang disembunyikan saat print) -->
    <div class="bg-white border-b py-3 px-6 mb-8 hide-print shadow-sm">
        <div class="container flex justify-between items-center">
            <div class="font-bold text-primary flex items-center gap-2">
                <span>🛡️ Official Validation & Receipt</span>
            </div>
            <a href="/receipt/<%= invoice.publicId %>/print" target="_blank" class="btn btn-primary btn-sm">🖨️ Print / Save PDF</a>
        </div>
    </div>

    <!-- HAPUS CLASS 'hide-print' DARI CONTAINER INI AGAR TIDAK BLANK SAAT DICETAK -->
    <div class="container mb-12 flex justify-center">
        <div class="w-full max-w-4xl">
            
            <!-- HAPUS INLINE STYLE AGAR @MEDIA PRINT DI RECEIPT.CSS MENGAMBIL ALIH SEPENUHNYA -->
            <div class="receipt-box">
                
                <div class="flex justify-between items-start">
                    <div>
                        <img src="/img/axalogo.png" alt="DENTS WEB Logo" class="doc-logo">
                        <h1 class="text-3xl font-bold mb-2" style="color: var(--success);">OFFICIAL RECEIPT</h1>
                        <p class="text-gray-500 text-lg">No. Kuitansi: #KW-<%= invoice.number || invoice.invoiceNumber %><br><span class="text-sm">Ref. Faktur: #<%= invoice.number || invoice.invoiceNumber %></span></p>
                    </div>
                    <div class="text-right">
                        <h2 class="font-bold text-xl"><%= settings.businessName || 'DENTS WEB' %></h2>
                        <p class="text-sm text-gray-500"><%= settings.businessAddress || '' %></p>
                        <p class="text-sm text-gray-500"><%= settings.businessEmail || '' %></p>
                        <p class="text-sm text-gray-500"><%= settings.businessPhone || '' %></p>
                        <% if(settings.npwp) { %><p class="text-sm text-gray-500">NPWP: <%= settings.npwp %></p><% } %>
                    </div>
                </div>

                <div class="header-divider"></div>

                <div class="flex justify-between mb-8">
                    <div>
                        <h3 class="font-bold text-gray-600 border-b mb-2 pb-1">RECEIVED FROM:</h3>
                        <p class="font-bold"><%= customer.companyName %></p>
                        <p class="text-sm"><%= customer.address || '' %></p>
                        <p class="text-sm"><%= customer.city || '' %> <%= customer.postalCode || '' %></p>
                        <p class="text-sm"><%= customer.email || '' %></p>
                    </div>
                    <div class="text-right">
                        <table class="text-sm ml-auto">
                            <tr><td class="font-bold pr-4">Status:</td><td><span class="badge badge-paid" style="background-color: #dcfce7; color: #15803d; padding: 4px 8px; border-radius: 999px; font-weight: bold; font-size: 10px;">PAID IN FULL</span></td></tr>
                            <tr><td class="font-bold pr-4">Invoice Date:</td><td><%= formatDate(invoice.invoiceDate) %></td></tr>
                            <% 
                                let receiptDate = invoice.invoiceDate;
                                if(invoice.payments && invoice.payments.length > 0) {
                                    receiptDate = invoice.payments[invoice.payments.length - 1].paidAt;
                                }
                            %>
                            <tr><td class="font-bold pr-4">Receipt Date:</td><td><%= formatDate(receiptDate) %></td></tr>
                        </table>
                    </div>
                </div>

                <table class="receipt-table mb-8">
                    <thead>
                        <tr>
                            <th style="width: 50%; text-align: left;">Description</th>
                            <th class="text-center" style="width: 10%;">Qty</th>
                            <th class="text-right" style="width: 20%;">Price</th>
                            <th class="text-right" style="width: 20%;">Total</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% invoice.items.forEach(item => { %>
                        <tr>
                            <td>
                                <b><%= item.description %></b>
                                <% if(item.period) { %><div class="text-xs text-gray-500 mt-1"><%= item.period %></div><% } %>
                            </td>
                            <td class="text-center"><%= item.quantity %></td>
                            <td class="text-right"><%= formatRupiah(item.price) %></td>
                            <td class="text-right"><%= formatRupiah(item.total) %></td>
                        </tr>
                        <% }) %>
                    </tbody>
                </table>

                <div class="flex justify-between mb-8 gap-8">
                    <div class="w-1/2 p-4 bg-gray-50 rounded border">
                        <h4 class="font-bold mb-2 text-green-700">Payment Verified</h4>
                        <p class="text-sm">Thank you for your business. This document serves as official proof of payment.</p>
                        
                        <% if(invoice.payments && invoice.payments.length > 0) { %>
                            <div class="mt-2 pt-2 border-t text-xs text-gray-600">
                                <b>Transaction History:</b><br>
                                <% invoice.payments.forEach(p => { %>
                                    &bull; <%= formatDate(p.paidAt) %> - <%= formatRupiah(p.amount) %> (<%= p.method %>)<br>
                                <% }) %>
                            </div>
                        <% } %>

                        <img src="/public/img/axapaid.png" onerror="this.onerror=null; this.src='/img/axapaid.png';" alt="PAID STAMP" class="stamp-lunas">
                    </div>

                    <div class="w-1/2 right-summary-block">
                        <table class="w-full text-right receipt-summary">
                            <tr><td class="py-1 text-gray-600">Subtotal</td><td class="py-1 font-medium"><%= formatRupiah(invoice.subtotal) %></td></tr>
                            
                            <% const discRatePub = Number(invoice.discountRate || 0); %>
                            <% const discValPub = Number(invoice.discountAmount || invoice.discount || (discRatePub > 0 ? Math.round((invoice.subtotal * discRatePub) / 100) : 0)); %>
                            <% if(discValPub > 0 || discRatePub > 0) { %>
                                <tr><td class="py-1 text-gray-600">Discount (<%= discRatePub %>%)</td><td class="py-1 font-medium text-red-500">- <%= formatRupiah(discValPub) %></td></tr>
                            <% } %>
                            <tr><td class="py-1 text-gray-600"><%= settings.defaultTaxName || 'PPN' %> (<%= invoice.taxRate || 0 %>%)</td><td class="py-1 font-medium"><%= formatRupiah(invoice.tax || 0) %></td></tr>
                            
                            <tr class="text-lg font-bold border-t"><td class="py-2">Grand Total</td><td class="py-2"><%= formatRupiah(invoice.total) %></td></tr>
                            <tr class="text-lg font-bold"><td class="py-2 text-green-700">Amount Paid</td><td class="py-2 text-green-700"><%= formatRupiah(invoice.amountPaid) %></td></tr>
                            <tr class="font-bold text-xl"><td class="py-2">Balance Due</td><td class="py-2 text-gray-400">Rp 0</td></tr>
                        </table>

                        <!-- QR CODE VERIFIKASI SAH DIBAWAH BALANCE DUE -->
                        <% const receiptVerifyUrl = `${(typeof settings !== 'undefined' && settings.siteUrl ? settings.siteUrl : 'https://www.dentsweb.my.id').replace(/\/$/, '')}/receipt/${invoice.publicId || invoice.id}`; %>
                        <div class="qr-verify-container" style="display: flex; justify-content: flex-end; margin-top: 14px; text-align: right;">
                            <div style="display: inline-block; background: #ffffff; padding: 6px 8px; border: 1.5px solid #86efac; border-radius: 12px; text-align: center; box-shadow: 0 2px 8px rgba(22, 163, 74, 0.08);">
                                <img src="https://api.qrserver.com/v1/create-qr-code/?size=110x110&margin=2&data=<%= encodeURIComponent(receiptVerifyUrl) %>" alt="QR Code Verifikasi Sah" width="90" height="90" style="display: block; margin: 0 auto; border-radius: 6px;">
                                <div style="font-size: 0.65rem; font-weight: 800; color: #15803d; margin-top: 4px; text-transform: uppercase; letter-spacing: 0.4px;">
                                    Scan Verifikasi Sah
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</body>
</html>
