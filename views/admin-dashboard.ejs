<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="theme-color" content="#05081c">
    <title>Admin Console | Dents Web</title>
    <link rel="icon" type="image/png" href="/public/img/axalogo.png">
    <meta name="robots" content="noindex, nofollow">
    
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Lexend+Deca:wght@500;600;700;800&family=Plus+Jakarta+Sans:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
    
    <link rel="stylesheet" href="/public/css/style.css">
    <style>
        .admin-stat-card {
            background: var(--navy-surface);
            border: 2px solid var(--navy-surface-border);
            border-bottom: 5px solid #1441a5;
            border-radius: var(--radius-lg);
            padding: 24px;
        }
        .toast-box {
            position: fixed;
            bottom: 24px;
            right: 24px;
            z-index: 9999;
            display: flex;
            flex-direction: column;
            gap: 10px;
        }
        .toast-item {
            padding: 14px 20px;
            border-radius: var(--radius-md);
            font-size: 0.9rem;
            font-weight: 600;
            color: #ffffff;
            box-shadow: 0 10px 30px rgba(0,0,0,0.4);
            animation: slideInToast 0.3s ease;
        }
        .toast-success { background: #00c853; }
        .toast-error { background: #ef4444; }
        @keyframes slideInToast {
            from { opacity: 0; transform: translateY(20px); }
            to { opacity: 1; transform: translateY(0); }
        }
        .btn-action-edit {
            background: rgba(33, 82, 207, 0.2);
            color: #60a5fa;
            border: 1px solid #3b82f6;
            padding: 5px 12px;
            border-radius: 6px;
            cursor: pointer;
            font-size: 0.8rem;
            font-weight: 700;
            display: inline-flex;
            align-items: center;
            gap: 4px;
            margin-right: 6px;
            transition: all 0.2s ease;
        }
        .btn-action-edit:hover {
            background: #2563eb;
            color: #ffffff;
        }
        .btn-action-delete {
            background: rgba(239, 68, 68, 0.2);
            color: var(--danger);
            border: 1px solid var(--danger);
            padding: 5px 12px;
            border-radius: 6px;
            cursor: pointer;
            font-size: 0.8rem;
            font-weight: 700;
            display: inline-flex;
            align-items: center;
            gap: 4px;
            transition: all 0.2s ease;
        }
        .btn-action-delete:hover {
            background: var(--danger);
            color: #ffffff;
        }
    </style>
</head>
<body>

    <!-- Topbar Mobile for Drawer Toggle -->
    <div class="admin-mobile-topbar">
        <div style="display: flex; align-items: center; gap: 4px;">
            <img src="/public/img/axalogo.png" alt="Dents Logo" style="height: 28px; width: auto; object-fit: contain;">
            <span style="font-family: 'Lexend Deca', sans-serif; font-size: 1.05rem; font-weight: 800; color: #ffffff; letter-spacing: -0.5px;">ents Console</span>
        </div>
        <button id="admin-menu-toggle" type="button" aria-label="Buka Menu" style="background: var(--navy-surface); border: 1px solid var(--navy-surface-border); color: #ffffff; padding: 6px 10px; border-radius: 6px; cursor: pointer; display: flex; align-items: center; justify-content: center;">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="3" y1="12" x2="21" y2="12"></line><line x1="3" y1="6" x2="21" y2="6"></line><line x1="3" y1="18" x2="21" y2="18"></line></svg>
        </button>
    </div>
    <div class="admin-drawer-overlay" id="admin-drawer-overlay"></div>

    <div class="admin-layout-kalana">
        <!-- Sidebar Navigation -->
        <aside class="admin-sidebar-kalana">
            <div style="display: flex; align-items: center; gap: 4px; margin-bottom: 32px; padding-bottom: 20px; border-bottom: 1px solid var(--navy-surface-border);">
                <img src="/public/img/axalogo.png" alt="Dents Logo" style="height: 32px; width: auto; object-fit: contain;">
                <span style="font-family: 'Lexend Deca', sans-serif; font-size: 1.15rem; font-weight: 800; color: #ffffff; letter-spacing: -0.5px;">ents Console</span>
            </div>

            <div style="margin-bottom: 24px;">
                <div class="badge-tag-lime" style="font-size: 0.75rem; padding: 4px 12px; display: inline-flex; align-items: center; gap: 6px;">
                    <span style="display: inline-block; width: 6px; height: 6px; border-radius: 50%; background: #05081c;"></span> Sesi Admin Aktif
                </div>
            </div>

            <nav style="display: flex; flex-direction: column; flex-grow: 1;">
                <div class="admin-nav-item active" data-tab="leads">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline></svg>
                    <span>Leads Masuk</span>
                </div>
                <div class="admin-nav-item" data-tab="portfolio">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"></path></svg>
                    <span>Portofolio</span>
                </div>
                <div class="admin-nav-item" data-tab="services">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 2 7 12 12 22 7 12 2"></polygon><polyline points="2 17 12 22 22 17"></polyline><polyline points="2 12 12 12 22 12"></polyline></svg>
                    <span>Layanan</span>
                </div>
                <div class="admin-nav-item" data-tab="pricing">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="1" y="4" width="22" height="16" rx="2" ry="2"></rect><line x1="1" y1="10" x2="23" y2="10"></line></svg>
                    <span>Paket Harga</span>
                </div>
                <div class="admin-nav-item" data-tab="testimonials">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path></svg>
                    <span>Testimoni Klien</span>
                </div>
                <div class="admin-nav-item" data-tab="faq">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"></path><line x1="12" y1="17" x2="12.01" y2="17"></line></svg>
                    <span>FAQ</span>
                </div>
                <div class="admin-nav-item" data-tab="settings">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"></circle><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"></path></svg>
                    <span>Pengaturan Web</span>
                </div>

                <div style="margin-top: auto; padding-top: 20px; border-top: 1px solid var(--navy-surface-border);">
                    <a href="/" target="_blank" class="admin-nav-item" style="color: var(--slate-muted); text-decoration: none;">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path><polyline points="15 3 21 3 21 9"></polyline><line x1="10" y1="14" x2="21" y2="3"></line></svg>
                        <span>Kunjungi Situs</span>
                    </a>
                    <div class="admin-nav-item" style="color: var(--danger); cursor: pointer;" onclick="handleLogout()">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path><polyline points="16 17 21 12 16 7"></polyline><line x1="21" y1="12" x2="9" y2="12"></line></svg>
                        <span>Keluar Sesi</span>
                    </div>
                </div>
            </nav>
        </aside>

        <!-- Main Dashboard Content -->
        <main class="admin-content-kalana">

            <!-- TAB 1: LEADS -->
            <div id="panel-leads" class="admin-panel">
                <div style="margin-bottom: 28px;">
                    <h2 style="font-size: 1.8rem; color: #ffffff; margin-bottom: 6px;">Prospek &amp; Leads Masuk</h2>
                    <p style="color: var(--slate-muted); font-size: 0.95rem;">Daftar pesan konsultasi dari formulir kontak publik.</p>
                </div>

                <div class="tactile-card-dark admin-table-responsive" style="padding: 0;">
                    <table class="admin-table" id="table-leads">
                        <thead>
                            <tr>
                                <th>Tanggal</th>
                                <th>Nama Lengkap</th>
                                <th>WhatsApp</th>
                                <th>Email</th>
                                <th>Pesan</th>
                                <th>Status</th>
                                <th style="text-align: right;">Aksi</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr><td colspan="7" style="text-align: center; color: var(--slate-muted); padding: 30px;">Memuat data leads...</td></tr>
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- TAB 2: PORTFOLIO -->
            <div id="panel-portfolio" class="admin-panel" style="display: none;">
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 28px; flex-wrap: wrap; gap: 16px;">
                    <div>
                        <h2 style="font-size: 1.8rem; color: #ffffff; margin-bottom: 6px;">Manajemen Portofolio</h2>
                        <p style="color: var(--slate-muted); font-size: 0.95rem;">Kelola proyek dan studi kasus yang tampil di halaman portofolio.</p>
                    </div>
                    <button class="btn-royal" onclick="openModal('modal-portfolio')">+ Tambah Proyek Baru</button>
                </div>

                <div class="tactile-card-dark admin-table-responsive" style="padding: 0;">
                    <table class="admin-table" id="table-portfolio">
                        <thead>
                            <tr>
                                <th>Judul Proyek</th>
                                <th>Klien</th>
                                <th>Kategori</th>
                                <th>Tahun</th>
                                <th>Status</th>
                                <th style="text-align: right;">Aksi</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr><td colspan="6" style="text-align: center; color: var(--slate-muted); padding: 30px;">Memuat data portofolio...</td></tr>
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- TAB 3: SERVICES -->
            <div id="panel-services" class="admin-panel" style="display: none;">
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 28px; flex-wrap: wrap; gap: 16px;">
                    <div>
                        <h2 style="font-size: 1.8rem; color: #ffffff; margin-bottom: 6px;">Manajemen Layanan</h2>
                        <p style="color: var(--slate-muted); font-size: 0.95rem;">Kelola daftar layanan dan paket solusi digital.</p>
                    </div>
                    <button class="btn-royal" onclick="openModal('modal-services')">+ Tambah Layanan</button>
                </div>

                <div class="tactile-card-dark admin-table-responsive" style="padding: 0;">
                    <table class="admin-table" id="table-services">
                        <thead>
                            <tr>
                                <th>Icon</th>
                                <th>Nama Layanan</th>
                                <th>Harga Mulai</th>
                                <th>Status</th>
                                <th style="text-align: right;">Aksi</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr><td colspan="5" style="text-align: center; color: var(--slate-muted); padding: 30px;">Memuat data layanan...</td></tr>
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- TAB 4: PRICING -->
            <div id="panel-pricing" class="admin-panel" style="display: none;">
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 28px; flex-wrap: wrap; gap: 16px;">
                    <div>
                        <h2 style="font-size: 1.8rem; color: #ffffff; margin-bottom: 6px;">Manajemen Paket Harga</h2>
                        <p style="color: var(--slate-muted); font-size: 0.95rem;">Atur paket investasi dan fasilitas yang didapatkan dari tiap paket.</p>
                    </div>
                    <button class="btn-royal" onclick="openModal('modal-pricing')">+ Tambah Paket</button>
                </div>

                <div class="tactile-card-dark admin-table-responsive" style="padding: 0;">
                    <table class="admin-table" id="table-pricing">
                        <thead>
                            <tr>
                                <th>Nama Paket</th>
                                <th>Biaya Investasi</th>
                                <th>Populer</th>
                                <th>Status</th>
                                <th style="text-align: right;">Aksi</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr><td colspan="5" style="text-align: center; color: var(--slate-muted); padding: 30px;">Memuat data paket harga...</td></tr>
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- TAB 5: TESTIMONIALS -->
            <div id="panel-testimonials" class="admin-panel" style="display: none;">
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 28px; flex-wrap: wrap; gap: 16px;">
                    <div>
                        <h2 style="font-size: 1.8rem; color: #ffffff; margin-bottom: 6px;">Manajemen Testimoni Klien</h2>
                        <p style="color: var(--slate-muted); font-size: 0.95rem;">Kelola ulasan, nama klien, peran bisnis, rating, dan testimoni nyata.</p>
                    </div>
                    <button class="btn-royal" onclick="openModal('modal-testimonials')">+ Tambah Testimoni</button>
                </div>

                <div class="tactile-card-dark admin-table-responsive" style="padding: 0;">
                    <table class="admin-table" id="table-testimonials">
                        <thead>
                            <tr>
                                <th>Nama Klien</th>
                                <th>Role / Perusahaan</th>
                                <th>Rating</th>
                                <th>Ulasan / Testimoni</th>
                                <th>Status</th>
                                <th style="text-align: right;">Aksi</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr><td colspan="6" style="text-align: center; color: var(--slate-muted); padding: 30px;">Memuat data testimoni...</td></tr>
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- TAB 6: FAQ -->
            <div id="panel-faq" class="admin-panel" style="display: none;">
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 28px; flex-wrap: wrap; gap: 16px;">
                    <div>
                        <h2 style="font-size: 1.8rem; color: #ffffff; margin-bottom: 6px;">Manajemen FAQ</h2>
                        <p style="color: var(--slate-muted); font-size: 0.95rem;">Daftar pertanyaan dan jawaban di halaman bantuan.</p>
                    </div>
                    <button class="btn-royal" onclick="openModal('modal-faq')">+ Tambah FAQ</button>
                </div>

                <div class="tactile-card-dark admin-table-responsive" style="padding: 0;">
                    <table class="admin-table" id="table-faq">
                        <thead>
                            <tr>
                                <th>Pertanyaan</th>
                                <th>Jawaban Singkat</th>
                                <th style="text-align: right;">Aksi</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr><td colspan="3" style="text-align: center; color: var(--slate-muted); padding: 30px;">Memuat data FAQ...</td></tr>
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- TAB 7: SETTINGS -->
            <div id="panel-settings" class="admin-panel" style="display: none;">
                <div style="margin-bottom: 28px;">
                    <h2 style="font-size: 1.8rem; color: #ffffff; margin-bottom: 6px;">Pengaturan Global Situs &amp; Brand</h2>
                    <p style="color: var(--slate-muted); font-size: 0.95rem;">Perbarui identitas studio, nomor WhatsApp admin, dan default SEO metadata.</p>
                </div>

                <div class="tactile-card-dark" style="max-width: 720px;">
                    <form id="form-settings">
                        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px;">
                            <div class="form-group">
                                <label class="form-label" style="color: #ffffff;">Nama Situs (Site Name)</label>
                                <input type="text" class="form-control" name="siteName" id="set-siteName" style="background: var(--navy-surface); color: #ffffff; border-color: var(--navy-surface-border);">
                            </div>
                            <div class="form-group">
                                <label class="form-label" style="color: #ffffff;">Nama Brand (Brand Name)</label>
                                <input type="text" class="form-control" name="brandName" id="set-brandName" style="background: var(--navy-surface); color: #ffffff; border-color: var(--navy-surface-border);">
                            </div>
                        </div>

                        <div class="form-group">
                            <label class="form-label" style="color: #ffffff;">Tagline Brand</label>
                            <input type="text" class="form-control" name="tagline" id="set-tagline" style="background: var(--navy-surface); color: #ffffff; border-color: var(--navy-surface-border);">
                        </div>

                        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px;">
                            <div class="form-group">
                                <label class="form-label" style="color: #ffffff;">Email Kontak Resmi</label>
                                <input type="email" class="form-control" name="email" id="set-email" style="background: var(--navy-surface); color: #ffffff; border-color: var(--navy-surface-border);">
                            </div>
                            <div class="form-group">
                                <label class="form-label" style="color: #ffffff;">Nomor WhatsApp (Cth: 6285338922586)</label>
                                <input type="text" class="form-control" name="whatsapp" id="set-whatsapp" style="background: var(--navy-surface); color: #ffffff; border-color: var(--navy-surface-border);">
                            </div>
                        </div>

                        <div class="form-group">
                            <label class="form-label" style="color: #ffffff;">Lokasi / Alamat Studio</label>
                            <input type="text" class="form-control" name="address" id="set-address" style="background: var(--navy-surface); color: #ffffff; border-color: var(--navy-surface-border);">
                        </div>

                        <div class="form-group">
                            <label class="form-label" style="color: #ffffff;">Default SEO Title</label>
                            <input type="text" class="form-control" name="defaultSeoTitle" id="set-seoTitle" style="background: var(--navy-surface); color: #ffffff; border-color: var(--navy-surface-border);">
                        </div>

                        <div class="form-group">
                            <label class="form-label" style="color: #ffffff;">Default SEO Description</label>
                            <textarea class="form-control" name="defaultSeoDescription" id="set-seoDesc" rows="3" style="background: var(--navy-surface); color: #ffffff; border-color: var(--navy-surface-border);"></textarea>
                        </div>

                        <button type="submit" class="btn-lime" style="width: 100%; display: inline-flex; align-items: center; justify-content: center; gap: 8px;">
                            <span>Simpan Pengaturan Global</span>
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
                        </button>
                    </form>
                </div>
            </div>

        </main>
    </div>

    <!-- ==========================================
         MODALS FORM CRUD (PORTFOLIO, SERVICES, PRICING, TESTIMONIALS, FAQ)
         ========================================== -->

    <!-- Modal Portfolio -->
    <div class="modal-overlay-kalana" id="modal-portfolio">
        <div class="modal-card-kalana">
            <div class="modal-header-kalana">
                <h3 id="modal-title-portfolio" style="color: #ffffff; font-size: 1.35rem; margin: 0;">Form Portofolio Proyek</h3>
                <button type="button" class="modal-close-btn" onclick="closeModal('modal-portfolio')" aria-label="Tutup">&times;</button>
            </div>
            <form onsubmit="handleFormSubmit(event, 'portfolio')">
                <input type="hidden" name="id">
                <div class="form-group">
                    <label class="form-label" style="color: #ffffff;">Judul Proyek *</label>
                    <input type="text" class="form-control" name="title" required style="background: var(--navy-surface); color: #ffffff; border-color: var(--navy-surface-border);">
                </div>
                <div class="form-group">
                    <label class="form-label" style="color: #ffffff;">Slug URL (cth: beresin-app) *</label>
                    <input type="text" class="form-control" name="slug" required style="background: var(--navy-surface); color: #ffffff; border-color: var(--navy-surface-border);">
                </div>
                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px;">
                    <div class="form-group">
                        <label class="form-label" style="color: #ffffff;">Nama Klien *</label>
                        <input type="text" class="form-control" name="client" required style="background: var(--navy-surface); color: #ffffff; border-color: var(--navy-surface-border);">
                    </div>
                    <div class="form-group">
                        <label class="form-label" style="color: #ffffff;">Tahun *</label>
