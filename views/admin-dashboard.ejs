        // CRUD Handler for POST & PUT
        async function handleFormSubmit(e, endpoint) {
            e.preventDefault();
            const form = e.target;
            const payload = Object.fromEntries(new FormData(form).entries());
            const id = payload.id;

            if (payload.isPublished !== undefined) payload.isPublished = payload.isPublished === 'true';
            if (payload.isFeatured !== undefined) payload.isFeatured = payload.isFeatured === 'true';
            if (payload.rating) payload.rating = parseInt(payload.rating, 10);
            if (payload.year) payload.year = parseInt(payload.year, 10);

            // If features string, split into clean array
            if (payload.features && typeof payload.features === 'string') {
                payload.features = payload.features.split(',').map(f => f.trim()).filter(Boolean);
            }

            // If tags string, split into clean array
            if (payload.tags && typeof payload.tags === 'string') {
                payload.tags = payload.tags.split(',').map(t => t.trim()).filter(Boolean);
            }

            // If tools string, split into clean array
            if (payload.tools && typeof payload.tools === 'string') {
                payload.tools = payload.tools.split(',').map(t => t.trim()).filter(Boolean);
            }

            const method = id ? 'PUT' : 'POST';
            const url = id ? `/api/admin/${endpoint}/${id}` : `/api/admin/${endpoint}`;

            // Remove empty id on create
            if (!id) delete payload.id;

            try {
                await api(url, method, payload);
                showToast(id ? 'Perubahan berhasil disimpan!' : 'Data baru berhasil ditambahkan!', 'success');
                closeModal(`modal-${endpoint}`);
                loadData(endpoint);
            } catch (err) {}
        }

        // Delete Record
        async function deleteRecord(endpoint, id) {
            if (!confirm('Yakin ingin menghapus data ini secara permanen?')) return;
            try {
                await api(`/api/admin/${endpoint}/${id}`, 'DELETE');
                showToast('Data berhasil dihapus.', 'success');
                loadData(endpoint);
            } catch (err) {}
        }

        // Settings Submit
        document.getElementById('form-settings').addEventListener('submit', async (e) => {
            e.preventDefault();
            const payload = Object.fromEntries(new FormData(e.target).entries());
            try {
                await api('/api/admin/settings', 'PUT', payload);
                showToast('Pengaturan global berhasil disimpan!', 'success');
            } catch (err) {}
        });

