        // Safe HTML String Escape
        function escapeHtml(str) {
            if (!str) return '';
            return String(str)
                .replace(/&/g, '&amp;')
                .replace(/</g, '&lt;')
                .replace(/>/g, '&gt;')
                .replace(/"/g, '&quot;')
                .replace(/'/g, '&#039;');
        }

        // ==========================================
        // LIVE CHAT CUSTOMER SUPPORT ADMIN LOGIC (TAWK.TO PARITY)
        // ==========================================
        let currentAdminChatId = null;
        let currentChatFilter = 'all';

        function getCust(c) {
            if (!c) return { name: 'Klien', email: '-', phone: '-', category: 'Konsultasi' };
            const cust = c.customer || {};
            return {
                name: c.name || cust.name || 'Klien',
                email: c.email || cust.email || '-',
                phone: c.phone || cust.phone || '-',
                category: c.category || cust.category || 'Konsultasi'
            };
        }

        function isClientMsg(m) {
            if (!m || !m.sender) return false;
            const s = String(m.sender).toUpperCase();
            return s === 'CLIENT' || s === 'CUSTOMER' || s === 'USER';
        }

        // Live Chat Sound Notification Engine (Dual-Tone Web Audio API Synthesizer with Autoplay Gesture Unlock)
        let prevTotalClientMessages = -1;
        let isChatSoundEnabled = localStorage.getItem('dents_chat_sound') !== 'false';
        let sharedAudioCtx = null;

        function getUnlockedAudioContext() {
            try {
                const AudioContextClass = window.AudioContext || window.webkitAudioContext;
                if (!AudioContextClass) return null;
                if (!sharedAudioCtx) {
                    sharedAudioCtx = new AudioContextClass();
                }
                if (sharedAudioCtx.state === 'suspended') {
                    sharedAudioCtx.resume().catch(() => {});
                }
                return sharedAudioCtx;
            } catch (e) {
                console.warn('AudioContext error:', e);
                return null;
            }
        }

        // Global unlock on click / touch / keydown anywhere on the page
        const unlockAdminAudioOnGesture = () => {
            const ctx = getUnlockedAudioContext();
            if (ctx && ctx.state === 'suspended') {
                ctx.resume().catch(() => {});
            }
        };
        ['click', 'touchstart', 'keydown'].forEach(ev => {
            document.addEventListener(ev, unlockAdminAudioOnGesture, { passive: true });
        });

        function updateSoundToggleBtnUI() {
            const soundLabel = document.getElementById('sound-label');
            const iconOn = document.getElementById('sound-icon-on');
            const iconOff = document.getElementById('sound-icon-off');
            const soundHeaderLabel = document.getElementById('chat-header-sound-label');
            const soundHeaderIconOn = document.getElementById('chat-header-sound-icon-on');
            const soundHeaderIconOff = document.getElementById('chat-header-sound-icon-off');
            
            if (soundLabel) soundLabel.textContent = isChatSoundEnabled ? 'Suara: ON' : 'Suara: OFF';
            if (iconOn) iconOn.style.display = isChatSoundEnabled ? 'block' : 'none';
            if (iconOff) iconOff.style.display = isChatSoundEnabled ? 'none' : 'block';

            if (soundHeaderLabel) soundHeaderLabel.textContent = isChatSoundEnabled ? 'Suara: ON' : 'Suara: OFF';
            if (soundHeaderIconOn) soundHeaderIconOn.style.display = isChatSoundEnabled ? 'block' : 'none';
            if (soundHeaderIconOff) soundHeaderIconOff.style.display = isChatSoundEnabled ? 'none' : 'block';
        }

        function toggleChatSound() {
            isChatSoundEnabled = !isChatSoundEnabled;
            localStorage.setItem('dents_chat_sound', isChatSoundEnabled ? 'true' : 'false');
            updateSoundToggleBtnUI();
            if (isChatSoundEnabled) {
                playChatChime(true);
                showToast('Notifikasi suara Live Chat aktif.', 'success');
            } else {
                showToast('Notifikasi suara Live Chat dimatikan.', 'error');
            }
        }

        function playChatChime(force = false) {
            if (!force && !isChatSoundEnabled) return;
            try {
                const ctx = getUnlockedAudioContext();
                if (!ctx) return;
                if (ctx.state === 'suspended') {
                    ctx.resume().catch(() => {});
                }
                const now = ctx.currentTime;
                
                // Tone 1: E5 (659.25 Hz) - Triangle attack for punchy presence
                const osc1 = ctx.createOscillator();
                const gain1 = ctx.createGain();
                osc1.type = 'triangle';
                osc1.frequency.setValueAtTime(659.25, now);
                gain1.gain.setValueAtTime(0, now);
                gain1.gain.linearRampToValueAtTime(0.35, now + 0.02);
                gain1.gain.exponentialRampToValueAtTime(0.001, now + 0.22);
                osc1.connect(gain1);
                gain1.connect(ctx.destination);
                osc1.start(now);
                osc1.stop(now + 0.24);

                // Tone 2: C6 (1046.50 Hz) - Crystal Sine Resonance chime
                const osc2 = ctx.createOscillator();
                const gain2 = ctx.createGain();
                osc2.type = 'sine';
                osc2.frequency.setValueAtTime(1046.50, now + 0.12);
                gain2.gain.setValueAtTime(0, now + 0.12);
                gain2.gain.linearRampToValueAtTime(0.38, now + 0.14);
                gain2.gain.exponentialRampToValueAtTime(0.001, now + 0.45);
                osc2.connect(gain2);
                gain2.connect(ctx.destination);
                osc2.start(now + 0.12);
                osc2.stop(now + 0.48);
            } catch (e) {
                console.warn('Audio play error:', e);
            }
        }

        function testAdminChatSound() {
            getUnlockedAudioContext();
            playChatChime(true);
            showToast('🔊 Tes nada notifikasi live chat berhasil diputar!', 'success');
        }

        function checkClientMessageChime() {
            const chats = window.cacheData.livechat || [];
            let currentTotalClientMsgs = 0;
            chats.forEach(c => {
                (c.messages || []).forEach(m => {
                    if (isClientMsg(m)) currentTotalClientMsgs++;
                });
            });

            if (prevTotalClientMessages !== -1 && currentTotalClientMsgs > prevTotalClientMessages) {
                playChatChime();
            }
            prevTotalClientMessages = currentTotalClientMsgs;
        }

        async function loadAdminChats(silent = false) {
            try {
                const res = await api('/api/admin/chats');
                window.cacheData.livechat = res.data || [];
                renderAdminChatThreads();
                updateAdminUnreadBadge();
                checkClientMessageChime();

                if (currentAdminChatId) {
                    const activeChat = (window.cacheData.livechat || []).find(c => c.id === currentAdminChatId || c.sessionId === currentAdminChatId);
                    if (activeChat) {
                        renderAdminChatMessages(activeChat);
                    }
                }
            } catch (err) {
                if (!silent) console.warn('Failed to load admin chats:', err);
            }
        }

        function updateAdminUnreadBadge() {
            const chats = window.cacheData.livechat || [];
            let unreadCount = 0;
            chats.forEach(c => {
                if (c.status !== 'closed') {
                    if (c.unreadByAdmin && c.unreadByAdmin > 0) {
                        unreadCount += c.unreadByAdmin;
                    } else if (c.messages && c.messages.length > 0) {
                        const lastMsg = c.messages[c.messages.length - 1];
                        if (isClientMsg(lastMsg)) unreadCount++;
                    }
                }
            });
            const badge = document.getElementById('admin-unread-chat-count');
            if (badge) {
                if (unreadCount > 0) {
                    badge.textContent = unreadCount;
                    badge.style.display = 'inline-block';
                } else {
                    badge.style.display = 'none';
                }
            }
        }

        function filterAdminChats(filter) {
            currentChatFilter = filter;
            document.querySelectorAll('.admin-chat-filter-btn').forEach(b => {
                b.classList.toggle('active', b.getAttribute('data-filter') === filter);
            });
            renderAdminChatThreads();
        }

        function renderAdminChatThreads() {
            const listEl = document.getElementById('admin-chat-threads-list');
            if (!listEl) return;
            const searchVal = (document.getElementById('admin-chat-search')?.value || '').toLowerCase().trim();
            let chats = window.cacheData.livechat || [];

            if (currentChatFilter !== 'all') {
                chats = chats.filter(c => (c.status || 'open') === currentChatFilter);
            }
            if (searchVal) {
                chats = chats.filter(c => {
                    const cust = getCust(c);
                    return (cust.name && cust.name.toLowerCase().includes(searchVal)) ||
                           (cust.email && cust.email.toLowerCase().includes(searchVal)) ||
                           (cust.phone && cust.phone.toLowerCase().includes(searchVal)) ||
                           (cust.category && cust.category.toLowerCase().includes(searchVal));
                });
            }

            if (!chats.length) {
                listEl.innerHTML = '<div style="text-align: center; color: var(--slate-muted); padding: 30px; font-size: 0.85rem;">Tidak ada percakapan ditemukan.</div>';
                return;
            }

            listEl.innerHTML = chats.map(c => {
                const cust = getCust(c);
                const chatId = c.id || c.sessionId;
                const isActive = (chatId === currentAdminChatId);
                const lastMsg = (c.messages && c.messages.length > 0) ? c.messages[c.messages.length - 1] : null;
                const snippet = lastMsg ? escapeHtml(lastMsg.text) : 'Percakapan baru dimulai';
                const time = lastMsg ? new Date(lastMsg.timestamp).toLocaleTimeString('id-ID', { hour: '2-digit', minute: '2-digit' }) : '';
                const isClientLast = lastMsg && isClientMsg(lastMsg);
                const isClosed = (c.status === 'closed');
                const hasUnread = (c.unreadByAdmin > 0) || (isClientLast && !isClosed);

                return `
                    <div class="admin-chat-thread-item ${isActive ? 'active' : ''}" onclick="selectAdminChat('${chatId}')" style="padding: 12px 14px; border-radius: 10px; margin-bottom: 6px; cursor: pointer; transition: all 0.2s; border: 1px solid ${isActive ? 'var(--royal-blue)' : 'transparent'}; background: ${isActive ? 'rgba(33, 82, 207, 0.18)' : 'rgba(255, 255, 255, 0.03)'};">
                        <div style="display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 4px;">
                            <span style="font-weight: 700; color: #ffffff; font-size: 0.92rem; display: flex; align-items: center; gap: 6px;">
                                ${escapeHtml(cust.name)}
                                ${hasUnread ? '<span style="width: 8px; height: 8px; border-radius: 50%; background: #ef4444; display: inline-block;" title="Pesan Baru"></span>' : ''}
                            </span>
                            <span style="font-size: 0.72rem; color: var(--slate-muted);">${time}</span>
                        </div>
                        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 4px; font-size: 0.75rem;">
                            <span style="color: var(--lime-accent); font-weight: 600;">${escapeHtml(cust.category)}</span>
                            <span style="color: var(--slate-muted); font-size: 0.72rem;">${cust.phone !== '-' ? '+' + cust.phone : ''}</span>
                        </div>
                        <div style="font-size: 0.82rem; color: ${isClientLast ? '#ffffff' : 'var(--slate-muted)'}; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; font-weight: ${isClientLast ? '600' : '400'};">
                            ${isClientLast ? '<strong style="color: #60a5fa;">Klien:</strong> ' : '<strong style="color: var(--lime-accent);">CS (Anda):</strong> '}${snippet}
                        </div>
                    </div>
                `;
            }).join('');
        }

        function selectAdminChat(chatId) {
            currentAdminChatId = chatId;
            renderAdminChatThreads();
            const chat = (window.cacheData.livechat || []).find(c => (c.id === chatId || c.sessionId === chatId));
            if (!chat) return;

            const cust = getCust(chat);

            document.getElementById('admin-chat-empty-state').style.display = 'none';
            const activeBox = document.getElementById('admin-chat-active-box');
            activeBox.style.display = 'flex';

            document.getElementById('act-client-name').textContent = cust.name;
            document.getElementById('act-category-badge').textContent = cust.category;
            document.getElementById('act-client-email').textContent = cust.email;
            document.getElementById('act-client-phone').textContent = cust.phone !== '-' ? '+' + cust.phone : '-';
            
            const statusBadge = document.getElementById('act-status-badge');
            const toggleBtn = document.getElementById('act-toggle-status-btn');
            if (chat.status === 'closed') {
                statusBadge.textContent = 'Selesai';
                statusBadge.style.background = 'rgba(148, 163, 184, 0.2)';
                statusBadge.style.color = '#94a3b8';
                toggleBtn.textContent = 'Buka Kembali';
            } else {
                statusBadge.textContent = 'Open';
                statusBadge.style.background = 'rgba(16, 185, 129, 0.2)';
                statusBadge.style.color = '#34d399';
                toggleBtn.textContent = 'Tandai Selesai';
            }

            const waLink = document.getElementById('act-wa-link');
            if (cust.phone && cust.phone !== '-') {
                const cleanWa = cust.phone.replace(/[^0-9]/g, '');
                waLink.href = `https://wa.me/${cleanWa}?text=${encodeURIComponent('Halo ' + cust.name + ', terima kasih telah menghubungi Dents Web.')}`;
                waLink.style.display = 'inline-flex';
            } else {
                waLink.style.display = 'none';
            }

            const startedDate = chat.createdAt ? new Date(chat.createdAt).toLocaleString('id-ID', { dateStyle: 'short', timeStyle: 'short' }) : '';
            document.getElementById('act-started-at').textContent = startedDate;

            renderAdminChatMessages(chat);
            setTimeout(() => {
                document.getElementById('admin-chat-reply-input')?.focus();
            }, 100);
        }

        function renderAdminChatMessages(chat) {
            const container = document.getElementById('admin-chat-messages-container');
            if (!container) return;
            const messages = chat.messages || [];
            const cust = getCust(chat);

            if (!messages.length) {
                container.innerHTML = '<div style="text-align: center; color: var(--slate-muted); padding: 40px;">Belum ada riwayat pesan.</div>';
                return;
            }

            // TAWK.TO PARITY FOR ADMIN:
            // Client messages on LEFT (dark bubble, client name header)
            // Admin CS messages on RIGHT (royal blue gradient bubble, CS Support header)
            container.innerHTML = messages.map(m => {
                const isClient = isClientMsg(m);
                const time = m.timestamp ? new Date(m.timestamp).toLocaleTimeString('id-ID', { hour: '2-digit', minute: '2-digit' }) : '';
                
                if (isClient) {
                    return `
                        <div style="display: flex; flex-direction: column; align-items: flex-start; margin-bottom: 6px;">
                            <div style="display: flex; align-items: center; gap: 6px; font-size: 0.72rem; color: #94a3b8; margin-bottom: 4px; padding-left: 4px;">
