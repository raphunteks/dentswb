        function openPakasirModalById(id) {
            const found = (window.cacheData.pakasir || []).find(t => t.id === id || t.txn_id === id);
            if (found) openPakasirModal(found);
        }

        // Live Poll Status from Modal
        async function checkCurrentModalStatus() {
            if (!window.currentViewingTxn) return;
            const btn = document.getElementById('modal-pakasir-btn-check');
            btn.disabled = true;
            btn.innerHTML = '<span>Memeriksa ke Pakasir...</span>';

            try {
                const res = await api(`/api/admin/pakasir/transactions/${window.currentViewingTxn.id}/status`);
                if (res && res.success && res.data) {
                    showToast(res.message || 'Status berhasil diperbarui!', 'success');
                    openPakasirModal(res.data);
                    await loadPakasirData();
                }
            } catch (e) {
                // error handled
            } finally {
                btn.disabled = false;
                btn.innerHTML = '<span>🔄 Cek Status Realtime</span>';
            }
        }

        // Cancel Current Modal Transaction
        async function cancelCurrentModalTxn() {
            if (!window.currentViewingTxn) return;
            if (!confirm(`Batalkan transaksi ${window.currentViewingTxn.order_id} di Pakasir?`)) return;

            const btn = document.getElementById('modal-pakasir-btn-cancel');
            btn.disabled = true;

            try {
                const res = await api(`/api/admin/pakasir/transactions/${window.currentViewingTxn.id}/cancel`, 'POST');
                if (res && res.success) {
                    showToast(res.message || 'Transaksi berhasil dibatalkan!', 'success');
                    closeModal('modal-pakasir-detail');
                    await loadPakasirData();
                }
            } catch (e) {
                // error handled
            } finally {
                btn.disabled = false;
            }
        }

