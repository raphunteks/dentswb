    </div>

    <!-- Toast Notifications -->
    <div class="toast-box" id="toast-container"></div>

    <script>
        // Global in-memory cache for fast pre-filling during Edit
        window.cacheData = {
            leads: [],
            portfolio: [],
            articles: [],
            services: [],
            pricing: [],
            testimonials: [],
            faq: [],
            livechat: []
        };

        // UI Helpers
        function showToast(message, type = 'success') {
            const container = document.getElementById('toast-container');
            const toast = document.createElement('div');
            toast.className = `toast-item ${type === 'success' ? 'toast-success' : 'toast-error'}`;
            toast.textContent = message;
            container.appendChild(toast);
            setTimeout(() => toast.remove(), 3500);
        }

        // Client-side Canvas Image Compressor (PNG, JPG, WEBP, HEIC to WebP/JPEG Base64)
        function compressImage(file, maxWidth = 1600, quality = 0.82) {
            return new Promise((resolve, reject) => {
                if (!file || !file.type.startsWith('image/')) {
                    return reject(new Error('File yang dipilih bukan berkas gambar valid.'));
                }
                const reader = new FileReader();
                reader.onload = function(e) {
                    const img = new Image();
                    img.onload = function() {
                        let width = img.width;
                        let height = img.height;
                        if (width > maxWidth) {
                            height = Math.round((height * maxWidth) / width);
                            width = maxWidth;
                        }
                        const canvas = document.createElement('canvas');
                        canvas.width = width;
                        canvas.height = height;
                        const ctx = canvas.getContext('2d');
                        ctx.drawImage(img, 0, 0, width, height);

                        let dataUrl = canvas.toDataURL('image/webp', quality);
                        if (!dataUrl.startsWith('data:image/webp')) {
                            dataUrl = canvas.toDataURL('image/jpeg', quality);
                        }
                        resolve(dataUrl);
                    };
                    img.onerror = () => reject(new Error('Gagal memproses berkas gambar.'));
                    img.src = e.target.result;
                };
                reader.onerror = () => reject(new Error('Gagal membaca berkas.'));
                reader.readAsDataURL(file);
            });
        }

        // Image Dropzone Setup
        function setupDropzone(dropzoneId, fileInputId, previewBoxId, previewImgId, hiddenInputId, removeBtnId) {
            const dropzone = document.getElementById(dropzoneId);
            const fileInput = document.getElementById(fileInputId);
            const previewBox = document.getElementById(previewBoxId);
            const previewImg = document.getElementById(previewImgId);
            const hiddenInput = document.getElementById(hiddenInputId);
            const removeBtn = document.getElementById(removeBtnId);

            if (!dropzone || !fileInput || !previewBox || !previewImg || !hiddenInput) return;

            function handleFile(file) {
                if (!file) return;
                showToast('Mengompres gambar ke format WebP...', 'success');
                compressImage(file)
                    .then(dataUrl => {
                        hiddenInput.value = dataUrl;
                        previewImg.src = dataUrl;
                        previewBox.classList.add('active');
                        showToast('Gambar berhasil diunggah & dikompres!', 'success');
                    })
                    .catch(err => {
                        showToast(err.message, 'error');
                    });
            }

            fileInput.addEventListener('change', (e) => {
                if (e.target.files && e.target.files[0]) {
                    handleFile(e.target.files[0]);
                }
            });

            ['dragenter', 'dragover'].forEach(evt => {
                dropzone.addEventListener(evt, (e) => {
                    e.preventDefault();
                    e.stopPropagation();
                    dropzone.classList.add('dragover');
                });
            });

            ['dragleave', 'drop'].forEach(evt => {
                dropzone.addEventListener(evt, (e) => {
                    e.preventDefault();
                    e.stopPropagation();
                    dropzone.classList.remove('dragover');
                });
            });

            dropzone.addEventListener('drop', (e) => {
                if (e.dataTransfer.files && e.dataTransfer.files[0]) {
                    handleFile(e.dataTransfer.files[0]);
                }
            });

            if (removeBtn) {
                removeBtn.addEventListener('click', (e) => {
                    e.stopPropagation();
                    hiddenInput.value = '';
                    previewImg.src = '';
                    previewBox.classList.remove('active');
                    fileInput.value = '';
                });
            }

            hiddenInput.addEventListener('input', (e) => {
                const val = e.target.value.trim();
                if (val) {
                    previewImg.src = val;
                    previewBox.classList.add('active');
                } else {
                    previewBox.classList.remove('active');
                }
            });
        }

        // Tech Stack Multi-Selector Controller (116 Authentic Brand SVGs)
        let selectedTechTools = new Set();

        function initTechSelector() {
            const grid = document.getElementById('tech-grid-portfolio');
            const searchInput = document.getElementById('tech-search-portfolio');
            const tabBtns = document.querySelectorAll('#tech-tabs-portfolio .tech-tab-btn');
            const countEl = document.getElementById('tech-count-portfolio');
            const chipsEl = document.getElementById('tech-chips-portfolio');
            const hiddenInput = document.getElementById('input-tools-portfolio');

            if (!grid || !window.TECH_CATALOG) return;

            let currentCategory = 'all';
            let searchQuery = '';

            function renderTools() {
                const filtered = window.TECH_CATALOG.filter(t => {
                    const matchesCat = (currentCategory === 'all' || t.category === currentCategory);
                    const matchesSearch = (!searchQuery || 
                        t.name.toLowerCase().includes(searchQuery) || 
                        t.desc.toLowerCase().includes(searchQuery)
                    );
                    return matchesCat && matchesSearch;
                });

                if (!filtered.length) {
                    grid.innerHTML = '<div style="grid-column: 1/-1; text-align: center; color: #64748b; padding: 20px; font-size: 0.85rem;">Tidak ada tools yang cocok dengan pencarian.</div>';
                    return;
                }

                grid.innerHTML = filtered.map(t => {
                    const isSelected = selectedTechTools.has(t.id);
                    return `
                        <div class="tech-tool-card ${isSelected ? 'selected' : ''}" data-id="${t.id}" title="${t.name}: ${t.desc}">
                            <input type="checkbox" class="tech-tool-checkbox" ${isSelected ? 'checked' : ''} onclick="event.stopPropagation(); toggleTool('${t.id}')">
                            <div class="tech-tool-card-icon" style="color: ${t.color};">
                                ${t.svg}
                            </div>
                            <div class="tech-tool-card-info">
                                <div class="tech-tool-card-name">${t.name}</div>
                                <div class="tech-tool-card-desc">${t.desc}</div>
                            </div>
                        </div>
                    `;
                }).join('');

                grid.querySelectorAll('.tech-tool-card').forEach(card => {
                    card.addEventListener('click', () => {
                        const id = card.getAttribute('data-id');
                        toggleTool(id);
                    });
                });
            }

            function updateChips() {
                const arr = Array.from(selectedTechTools);
                if (hiddenInput) hiddenInput.value = arr.join(',');
                if (countEl) countEl.textContent = `${arr.length} dipilih`;

                if (!arr.length) {
                    chipsEl.innerHTML = '<span style="font-size: 0.75rem; color: #64748b; font-style: italic;">Belum ada teknologi yang dipilih.</span>';
                    return;
                }

                chipsEl.innerHTML = arr.map(id => {
                    const tool = window.getTechTool ? window.getTechTool(id) : null;
                    const name = tool ? tool.name : id;
                    return `
                        <span class="tech-chip-item">
                            <span>${name}</span>
                            <button type="button" class="tech-chip-remove" onclick="toggleTool('${id}')">&times;</button>
                        </span>
                    `;
                }).join('');
            }

            window.toggleTool = function(id) {
                if (selectedTechTools.has(id)) {
                    selectedTechTools.delete(id);
                } else {
                    selectedTechTools.add(id);
                }
                updateChips();
                renderTools();
            };

            window.setPortfolioTools = function(toolIds) {
                selectedTechTools.clear();
                if (toolIds) {
                    const arr = Array.isArray(toolIds) ? toolIds : String(toolIds).split(',');
                    arr.map(s => s.trim().toLowerCase()).filter(Boolean).forEach(id => selectedTechTools.add(id));
                }
                updateChips();
                renderTools();
            };

            tabBtns.forEach(btn => {
                btn.addEventListener('click', () => {
                    tabBtns.forEach(b => b.classList.remove('active'));
                    btn.classList.add('active');
                    currentCategory = btn.getAttribute('data-cat');
                    renderTools();
                });
            });

            searchInput.addEventListener('input', (e) => {
                searchQuery = e.target.value.trim().toLowerCase();
                renderTools();
            });

            renderTools();
            updateChips();
        }

        // Slug Auto Generator Helper
        function setupSlugAutoGenerator(titleId, slugId) {
            const titleEl = document.getElementById(titleId);
            const slugEl = document.getElementById(slugId);
            if (!titleEl || !slugEl) return;
            titleEl.addEventListener('input', () => {
                if (!slugEl.dataset.manual) {
                    slugEl.value = titleEl.value
                        .toLowerCase()
                        .trim()
                        .replace(/[^\w\s-]/g, '')
                        .replace(/[\s_-]+/g, '-')
                        .replace(/^-+|-+$/g, '');
                }
            });
            slugEl.addEventListener('input', () => {
                slugEl.dataset.manual = 'true';
            });
        }

        function openModal(id) { 
            const m = document.getElementById(id);
            if (!m) return;
            const form = m.querySelector('form');
            if (form) {
                form.reset();
                const idInput = form.querySelector('input[name="id"]');
                if (idInput) idInput.value = '';
            }
            
            // Clear dropzone previews & tools on new create
            if (id === 'modal-portfolio') {
                const previewBox = document.getElementById('preview-box-portfolio');
                if (previewBox) previewBox.classList.remove('active');
                if (window.setPortfolioTools) window.setPortfolioTools([]);
                const slugInput = document.getElementById('port-slug');
                if (slugInput) delete slugInput.dataset.manual;
            } else if (id === 'modal-articles') {
                const previewBox = document.getElementById('preview-box-articles');
                if (previewBox) previewBox.classList.remove('active');
                const slugInput = document.getElementById('art-slug');
                if (slugInput) delete slugInput.dataset.manual;
            } else if (id === 'modal-testimonials') {
                const previewBox = document.getElementById('preview-box-testimonials');
                const previewImg = document.getElementById('preview-img-testimonials');
                if (previewBox) previewBox.classList.remove('active');
                if (previewImg) previewImg.src = '';
            }

            // Set title back to Add
            const entity = id.replace('modal-', '');
            const titleEl = document.getElementById(`modal-title-${entity}`);
            if (titleEl) {
                const entityNames = {
                    portfolio: 'Portofolio Proyek',
                    articles: 'Artikel & Materi',
                    services: 'Layanan',
                    pricing: 'Paket Harga',
                    testimonials: 'Testimoni Klien',
                    faq: 'FAQ'
                };
                titleEl.textContent = `Tambah ${entityNames[entity] || entity}`;
            }
            m.classList.add('active');
            m.style.display = 'flex'; 
        }

        function closeModal(id) { 
            const m = document.getElementById(id);
            if (m) {
                m.classList.remove('active');
                m.style.display = 'none'; 
                const form = m.querySelector('form');
                if (form) {
                    form.reset();
                    const idInput = form.querySelector('input[name="id"]');
                    if (idInput) idInput.value = '';
                }
            }
        }

        // Open Edit Modal with Pre-filled Form Values
        function openEditModal(entity, id) {
            const list = window.cacheData[entity] || [];
            const item = list.find(x => String(x.id) === String(id));
            if (!item) {
                showToast('Data tidak ditemukan.', 'error');
                return;
            }

            const modal = document.getElementById(`modal-${entity}`);
            if (!modal) {
                showToast('Modal tidak ditemukan: ' + entity, 'error');
                return;
            }
            const form = modal.querySelector('form');
            if (!form) return;

            form.reset();

            // Explicit safe field value setter
            const setVal = (name, val) => {
                const el = form.elements[name];
                if (el) {
                    el.value = (val !== undefined && val !== null) ? val : '';
                }
            };

            setVal('id', item.id);

            if (entity === 'portfolio') {
                setVal('title', item.title);
                setVal('slug', item.slug);
                setVal('client', item.client);
                setVal('year', item.year);
                setVal('category', item.category);
                setVal('tags', Array.isArray(item.tags) ? item.tags.join(', ') : (item.tags || ''));
                setVal('image', item.image);
                setVal('projectUrl', item.projectUrl);
                setVal('shortDescription', item.shortDescription);
                setVal('description', item.description);
                setVal('isPublished', item.isPublished ? 'true' : 'false');

                // Update Image Preview
                const previewBox = document.getElementById('preview-box-portfolio');
                const previewImg = document.getElementById('preview-img-portfolio');
                if (item.image && previewBox && previewImg) {
                    previewImg.src = item.image;
                    previewBox.classList.add('active');
                } else if (previewBox) {
                    previewBox.classList.remove('active');
                }

                // Update Tech Tools
                if (window.setPortfolioTools) {
                    window.setPortfolioTools(item.tools || item.techStack || []);
                }
            } else if (entity === 'articles') {
                setVal('title', item.title);
                setVal('slug', item.slug);
                setVal('category', item.category);
                setVal('coverImage', item.coverImage);
                setVal('excerpt', item.excerpt);
                setVal('readingTime', item.readingTime || '5 menit baca');
                setVal('author', item.author || 'Dents Web Engineering');
                setVal('tags', Array.isArray(item.tags) ? item.tags.join(', ') : (item.tags || ''));
                setVal('content', item.content);
                setVal('isPublished', item.isPublished !== false ? 'true' : 'false');

                // Update Cover Preview
                const previewBox = document.getElementById('preview-box-articles');
                const previewImg = document.getElementById('preview-img-articles');
                if (item.coverImage && previewBox && previewImg) {
                    previewImg.src = item.coverImage;
                    previewBox.classList.add('active');
                } else if (previewBox) {
                    previewBox.classList.remove('active');
                }
            } else if (entity === 'services') {
                setVal('title', item.title);
                setVal('slug', item.slug);
                setVal('startingPrice', item.startingPrice);
                setVal('description', item.description);
                setVal('features', Array.isArray(item.features) ? item.features.join(', ') : (item.features || ''));
                setVal('isPublished', item.isPublished !== false ? 'true' : 'false');
            } else if (entity === 'pricing') {
                setVal('name', item.name);
                setVal('price', item.price);
                setVal('description', item.description);
                setVal('features', Array.isArray(item.features) ? item.features.join(', ') : (item.features || ''));
                setVal('isFeatured', item.isFeatured ? 'true' : 'false');
                setVal('isPublished', item.isPublished !== false ? 'true' : 'false');
            } else if (entity === 'testimonials') {
                setVal('name', item.name);
                setVal('role', item.role);
                setVal('company', item.company);
                setVal('rating', item.rating || 5);
                setVal('content', item.content);
                setVal('avatar', item.avatar || '');
                setVal('isPublished', item.isPublished !== false ? 'true' : 'false');

                // Update Avatar Preview
                const previewBox = document.getElementById('preview-box-testimonials');
                const previewImg = document.getElementById('preview-img-testimonials');
                if (item.avatar && previewBox && previewImg) {
                    previewImg.src = item.avatar;
                    previewBox.classList.add('active');
                } else if (previewBox) {
                    previewBox.classList.remove('active');
                }
            } else if (entity === 'faq') {
                setVal('question', item.question);
                setVal('answer', item.answer);
                setVal('isPublished', item.isPublished !== false ? 'true' : 'false');
            }

            // Set Title to Edit
            const titleEl = document.getElementById(`modal-title-${entity}`);
            if (titleEl) {
                const entityNames = {
                    portfolio: 'Portofolio Proyek',
                    articles: 'Artikel & Materi',
                    services: 'Layanan',
                    pricing: 'Paket Harga',
                    testimonials: 'Testimoni Klien',
                    faq: 'FAQ'
                };
                titleEl.textContent = `Edit ${entityNames[entity] || entity}`;
            }

            modal.classList.add('active');
            modal.style.display = 'flex';
        }

        // Sidebar Collapse Toggle (< and >) - Sesuai Gambar 1 & 2
        function toggleSidebarCollapse() {
            const sidebar = document.getElementById('admin-sidebar');
            if (!sidebar) return;
            sidebar.classList.toggle('collapsed');
            const isCollapsed = sidebar.classList.contains('collapsed');
            localStorage.setItem('dents_admin_sidebar_collapsed', isCollapsed ? 'true' : 'false');
            
            const toggleIcon = document.getElementById('sidebar-toggle-icon');
            if (toggleIcon) {
                if (isCollapsed) {
                    toggleIcon.innerHTML = '<polyline points="9 18 15 12 9 6"></polyline>'; // >
                } else {
                    toggleIcon.innerHTML = '<polyline points="15 18 9 12 15 6"></polyline>'; // <
                }
            }
        }

        // Quick Create Modal Dispatcher (+ Buat)
        function openQuickCreateModal() {
            openModal('modal-quick-create');
        }

        function quickCreateTarget(type) {
            closeModal('modal-quick-create');
            if (type === 'portfolio') {
                switchTab('portfolio');
                setTimeout(() => openModal('modal-portfolio'), 120);
            } else if (type === 'article') {
                switchTab('articles');
                setTimeout(() => openModal('modal-articles'), 120);
            } else if (type === 'testimonial') {
                switchTab('testimonials');
                setTimeout(() => openModal('modal-testimonials'), 120);
            } else if (type === 'faq') {
                switchTab('faq');
                setTimeout(() => openModal('modal-faq'), 120);
            } else if (type === 'service') {
                switchTab('services');
                setTimeout(() => openModal('modal-services'), 120);
            } else if (type === 'livechat') {
                switchTab('livechat');
            }
        }

        // Tab Switcher
        function switchTab(tab) {
            if (!tab) return;
            document.querySelectorAll('.admin-nav-item').forEach(i => {
                if (i.getAttribute('data-tab') === tab) {
                    i.classList.add('active');
                } else if (i.getAttribute('data-tab')) {
                    i.classList.remove('active');
                }
            });

            document.querySelectorAll('.admin-panel').forEach(p => p.style.display = 'none');
            const targetPanel = document.getElementById(`panel-${tab}`);
            if (targetPanel) targetPanel.style.display = 'block';

            loadData(tab);
        }

        document.querySelectorAll('.admin-nav-item').forEach(item => {
            const tab = item.getAttribute('data-tab');
            if (!tab) return;
            item.addEventListener('click', () => {
                switchTab(tab);
            });
        });

        // API Fetcher
        async function api(url, method = 'GET', body = null) {
            const options = { method, headers: { 'Content-Type': 'application/json' } };
            if (body) options.body = JSON.stringify(body);
            try {
                const res = await fetch(url, options);
                if (res.status === 401) { window.location.href = '/admin-login'; return; }
                const data = await res.json();
                if (!res.ok) throw new Error(data.message || 'Server error');
                return data;
            } catch (err) {
                showToast(err.message, 'error');
                throw err;
            }
        }

        // Loaders
        async function loadData(tab) {
            if (tab === 'leads') {
                const res = await api('/api/admin/leads');
                window.cacheData.leads = res.data || [];
                const tb = document.querySelector('#table-leads tbody');
                tb.innerHTML = (res.data && res.data.length) ? res.data.map(l => `
                    <tr>
                        <td style="color: var(--slate-muted); font-size: 0.85rem;">${new Date(l.createdAt).toLocaleDateString('id-ID')}</td>
                        <td style="font-weight: 700; color: #ffffff;">${escapeHtml(l.name)}</td>
                        <td><a href="https://wa.me/${l.whatsapp.replace(/[^0-9]/g, '')}" target="_blank" style="color: var(--lime-accent); font-weight: 600; text-decoration: none;">${escapeHtml(l.whatsapp)} &nearr;</a></td>
                        <td style="color: var(--slate-muted);">${escapeHtml(l.email || '-')}</td>
                        <td style="max-width: 260px; font-size: 0.85rem; line-height: 1.5;">${escapeHtml(l.message)}</td>
                        <td><span class="badge-tag-royal" style="font-size: 0.75rem;">${escapeHtml(l.status || 'Baru')}</span></td>
                        <td style="text-align: right; white-space: nowrap;">
                            <button class="btn-action-delete" data-action="delete" data-entity="leads" data-id="${l.id}" onclick="deleteRecord('leads', '${l.id}')">Hapus</button>
                        </td>
                    </tr>
                `).join('') : '<tr><td colspan="7" style="text-align: center; padding: 30px; color: var(--slate-muted);">Belum ada pesan leads masuk.</td></tr>';
            }

            if (tab === 'portfolio') {
                const res = await api('/api/admin/portfolio');
                window.cacheData.portfolio = res.data || [];
                const tb = document.querySelector('#table-portfolio tbody');
                tb.innerHTML = (res.data && res.data.length) ? res.data.map(p => {
                    const toolsCount = p.tools ? (Array.isArray(p.tools) ? p.tools.length : p.tools.split(',').length) : 0;
                    return `
                    <tr>
                        <td style="font-weight: 700; color: #ffffff;">
                            ${escapeHtml(p.title)}
                            ${toolsCount > 0 ? `<div style="font-size:0.72rem;color:var(--lime-accent);font-weight:normal;">${toolsCount} tools terpasang</div>` : ''}
                        </td>
                        <td style="color: var(--slate-muted);">${escapeHtml(p.client)}</td>
                        <td><span class="badge-tag-royal" style="font-size: 0.75rem;">${escapeHtml(p.category)}</span></td>
                        <td style="color: var(--slate-muted);">${p.year}</td>
