        window.loadInvoiceSettings = loadInvoiceSettings;
        window.saveInvoiceSettings = saveInvoiceSettings;
        window.saveSmtpSettings = saveSmtpSettings;
        window.runSmtpDiagnostic = runSmtpDiagnostic;
    </script>
