            document.getElementById('modal-pakasir-subtitle').textContent = `Order ID: ${txn.order_id}`;
            document.getElementById('modal-pakasir-amount').textContent = `Rp ${(txn.total_payment || txn.amount || 0).toLocaleString('id-ID')}`;
            document.getElementById('modal-pakasir-fee-info').textContent = txn.fee ? `Termasuk biaya layanan: Rp ${txn.fee.toLocaleString('id-ID')}` : 'Bebas biaya tambahan';

            // Status Badge
            const st = (txn.status || 'pending').toLowerCase();
