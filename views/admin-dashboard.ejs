            }
        }

        function filterCustomerTable() {
            const q = (document.getElementById('search-customers')?.value || '').toLowerCase().trim();
            if (!q) {
                renderCustomerTable(window.cacheData.customers || []);
                return;
            }
            const filtered = (window.cacheData.customers || []).filter(c =>
                (c.companyName && c.companyName.toLowerCase().includes(q)) ||
                (c.contactPerson && c.contactPerson.toLowerCase().includes(q)) ||
                (c.email && c.email.toLowerCase().includes(q)) ||
                (c.phone && c.phone.toLowerCase().includes(q)) ||
                (c.city && c.city.toLowerCase().includes(q))
            );
            renderCustomerTable(filtered);
        }

        function updateCustomerDropdown() {
            const sel = document.getElementById('inv-form-customer');
            if (!sel) return;
            const currentVal = sel.value;
            const customers = window.cacheData.customers || [];
            let opts = '<option value="">Pilih Klien Terdaftar...</option>';
            customers.forEach(c => {
                opts += `<option value="${c.id}">${escapeHtml(c.companyName)} (${escapeHtml(c.contactPerson || c.email)})</option>`;
            });
            sel.innerHTML = opts;
            if (currentVal) sel.value = currentVal;
        }

        function openCustomerModal(id = null) {
            const title = document.getElementById('modal-title-customer');
            const form = document.querySelector('#modal-customer form');
            if (form) form.reset();

            if (id) {
                const c = (window.cacheData.customers || []).find(x => x.id === id);
                if (c) {
                    if (title) title.textContent = 'Edit Data Pelanggan';
                    document.getElementById('cus-id').value = c.id || '';
                    document.getElementById('cus-company').value = c.companyName || '';
                    document.getElementById('cus-contact').value = c.contactPerson || '';
                    document.getElementById('cus-email').value = c.email || '';
                    document.getElementById('cus-phone').value = c.phone || '';
                    document.getElementById('cus-npwp').value = c.npwp || '';
                    document.getElementById('cus-address').value = c.address || '';
                    document.getElementById('cus-city').value = c.city || '';
                    document.getElementById('cus-province').value = c.province || '';
                    document.getElementById('cus-postal').value = c.postalCode || '';
                    document.getElementById('cus-notes').value = c.notes || '';
                }
            } else {
                if (title) title.textContent = 'Tambah Pelanggan Baru';
                document.getElementById('cus-id').value = '';
            }
            openModal('modal-customer');
        }

        async function handleCustomerSubmit(e) {
            e.preventDefault();
            const id = document.getElementById('cus-id').value.trim();
            const payload = {
                companyName: document.getElementById('cus-company').value.trim(),
                contactPerson: document.getElementById('cus-contact').value.trim(),
                email: document.getElementById('cus-email').value.trim(),
                phone: document.getElementById('cus-phone').value.trim(),
                npwp: document.getElementById('cus-npwp').value.trim(),
                address: document.getElementById('cus-address').value.trim(),
                city: document.getElementById('cus-city').value.trim(),
                province: document.getElementById('cus-province').value.trim(),
                postalCode: document.getElementById('cus-postal').value.trim(),
                notes: document.getElementById('cus-notes').value.trim()
            };

            try {
                const method = id ? 'PUT' : 'POST';
                const url = id ? `/api/admin/customers/${id}` : '/api/admin/customers';
                await api(url, method, payload);
                showToast(id ? 'Data pelanggan berhasil diperbarui!' : 'Pelanggan baru berhasil ditambahkan!', 'success');
                closeModal('modal-customer');
                await loadCustomers();
            } catch (e) {}
        }

        async function deleteCustomer(id) {
            if (!confirm('Yakin ingin menghapus data pelanggan ini?')) return;
            try {
                await api(`/api/admin/customers/${id}`, 'DELETE');
                showToast('Data pelanggan berhasil dihapus.', 'success');
                await loadCustomers();
            } catch (e) {}
        }

        // --- 3. INVOICES MANAGEMENT ---
        let currentInvoiceFilterStatus = 'ALL';
        window.currentSelectedInvoice = null;

        async function loadInvoices() {
            try {
                const res = await api('/api/admin/invoices');
                window.cacheData.invoices = res.data || [];
                filterInvoiceByStatus(currentInvoiceFilterStatus);
            } catch (e) {
                console.error('loadInvoices error:', e);
            }
        }

        function filterInvoiceByStatus(status, btnElement = null) {
            currentInvoiceFilterStatus = status || 'ALL';
            if (btnElement) {
                btnElement.parentElement.querySelectorAll('.btn-subnav').forEach(b => b.classList.remove('active'));
                btnElement.classList.add('active');
            }
            filterInvoiceTable();
        }

        function filterInvoiceTable() {
            const q = (document.getElementById('search-invoices')?.value || '').toLowerCase().trim();
            let list = window.cacheData.invoices || [];

            if (currentInvoiceFilterStatus !== 'ALL') {
                list = list.filter(inv => {
                    const s = (inv.status || '').toUpperCase();
                    if (currentInvoiceFilterStatus === 'UNPAID') return s === 'UNPAID' || s === 'PARTIALLY_PAID';
                    return s === currentInvoiceFilterStatus;
                });
            }

            if (q) {
                list = list.filter(inv =>
                    (inv.invoiceNumber && inv.invoiceNumber.toLowerCase().includes(q)) ||
                    (inv.customerName && inv.customerName.toLowerCase().includes(q)) ||
                    (inv.customer && inv.customer.companyName && inv.customer.companyName.toLowerCase().includes(q))
                );
            }

            renderInvoiceTable(list);
        }

