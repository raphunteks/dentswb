        // Open Edit Modal with Pre-filled Form Values
        function openEditModal(entity, id) {
            const list = window.cacheData[entity] || [];
            const item = list.find(x => String(x.id) === String(id));
            if (!item) {
                showToast('Data tidak ditemukan.', 'error');
                return;
            }

            const modal = document.getElementById(`modal-${entity}`);
            if (!modal) {
                showToast('Modal tidak ditemukan: ' + entity, 'error');
                return;
            }
            const form = modal.querySelector('form');
            if (!form) return;

            form.reset();

            // Explicit safe field value setter
            const setVal = (name, val) => {
                const el = form.elements[name];
                if (el) {
                    el.value = (val !== undefined && val !== null) ? val : '';
                }
            };

            setVal('id', item.id);

            if (entity === 'portfolio') {
                setVal('title', item.title);
                setVal('slug', item.slug);
                setVal('client', item.client);
                setVal('year', item.year);
                setVal('category', item.category);
                setVal('tags', Array.isArray(item.tags) ? item.tags.join(', ') : (item.tags || ''));
                setVal('image', item.image);
                setVal('projectUrl', item.projectUrl);
                setVal('shortDescription', item.shortDescription);
                setVal('description', item.description);
                setVal('isPublished', item.isPublished ? 'true' : 'false');

                // Update Image Preview
                const previewBox = document.getElementById('preview-box-portfolio');
                const previewImg = document.getElementById('preview-img-portfolio');
                if (item.image && previewBox && previewImg) {
                    previewImg.src = item.image;
                    previewBox.classList.add('active');
                } else if (previewBox) {
                    previewBox.classList.remove('active');
                }

                // Update Tech Tools
                if (window.setPortfolioTools) {
                    window.setPortfolioTools(item.tools || item.techStack || []);
                }
            } else if (entity === 'articles') {
                setVal('title', item.title);
                setVal('slug', item.slug);
                setVal('category', item.category);
                setVal('coverImage', item.coverImage);
                setVal('excerpt', item.excerpt);
                setVal('readingTime', item.readingTime || '5 menit baca');
                setVal('author', item.author || 'Dents Web Engineering');
                setVal('tags', Array.isArray(item.tags) ? item.tags.join(', ') : (item.tags || ''));
                setVal('content', item.content);
                setVal('isPublished', item.isPublished !== false ? 'true' : 'false');

                // Update Cover Preview
                const previewBox = document.getElementById('preview-box-articles');
                const previewImg = document.getElementById('preview-img-articles');
                if (item.coverImage && previewBox && previewImg) {
                    previewImg.src = item.coverImage;
                    previewBox.classList.add('active');
                } else if (previewBox) {
                    previewBox.classList.remove('active');
                }
            } else if (entity === 'services') {
                setVal('title', item.title);
                setVal('slug', item.slug);
                setVal('startingPrice', item.startingPrice);
                setVal('description', item.description);
                setVal('features', Array.isArray(item.features) ? item.features.join(', ') : (item.features || ''));
                setVal('isPublished', item.isPublished !== false ? 'true' : 'false');
            } else if (entity === 'pricing') {
                setVal('name', item.name);
                setVal('price', item.price);
                setVal('description', item.description);
                setVal('features', Array.isArray(item.features) ? item.features.join(', ') : (item.features || ''));
                setVal('isFeatured', item.isFeatured ? 'true' : 'false');
                setVal('isPublished', item.isPublished !== false ? 'true' : 'false');
            } else if (entity === 'testimonials') {
                setVal('name', item.name);
                setVal('role', item.role);
                setVal('company', item.company);
                setVal('rating', item.rating || 5);
                setVal('content', item.content);
                setVal('avatar', item.avatar || '');
                setVal('isPublished', item.isPublished !== false ? 'true' : 'false');

                // Update Avatar Preview
                const previewBox = document.getElementById('preview-box-testimonials');
                const previewImg = document.getElementById('preview-img-testimonials');
                if (item.avatar && previewBox && previewImg) {
                    previewImg.src = item.avatar;
                    previewBox.classList.add('active');
                } else if (previewBox) {
                    previewBox.classList.remove('active');
                }
            } else if (entity === 'faq') {
                setVal('question', item.question);
                setVal('answer', item.answer);
                setVal('isPublished', item.isPublished !== false ? 'true' : 'false');
            }

            // Set Title to Edit
            const titleEl = document.getElementById(`modal-title-${entity}`);
            if (titleEl) {
                const entityNames = {
                    portfolio: 'Portofolio Proyek',
                    articles: 'Artikel & Materi',
                    services: 'Layanan',
                    pricing: 'Paket Harga',
                    testimonials: 'Testimoni Klien',
                    faq: 'FAQ'
