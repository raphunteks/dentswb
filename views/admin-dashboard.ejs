        function searchPakasirHistory() {
            const q = (document.getElementById('pakasir-search-input')?.value || '').toLowerCase().trim();
            if (!q) {
                renderPakasirHistory(window.cacheData.pakasir);
                return;
            }
            const filtered = (window.cacheData.pakasir || []).filter(t => {
                return (t.order_id && t.order_id.toLowerCase().includes(q)) ||
                       (t.txn_id && t.txn_id.toLowerCase().includes(q)) ||
                       (t.customer_name && t.customer_name.toLowerCase().includes(q)) ||
                       (t.customer_email && t.customer_email.toLowerCase().includes(q)) ||
                       (t.method && t.method.toLowerCase().includes(q));
            });
            renderPakasirHistory(filtered);
        }

        // Handle Create Transaction Submit
        async function handleCreatePakasirTxn(e) {
            e.preventDefault();
            const btn = document.getElementById('btn-submit-create-pakasir');
            const originalText = btn.innerHTML;
            btn.disabled = true;
            btn.innerHTML = '<span>Membuat transaksi di Pakasir...</span>';

            const order_id = document.getElementById('pakasir-order-id').value.trim();
            const amount = parseInt(document.getElementById('pakasir-amount').value, 10);
            const method = document.getElementById('pakasir-method').value;
            const customer_name = document.getElementById('pakasir-customer-name').value.trim();
            const customer_email = document.getElementById('pakasir-customer-email').value.trim();
            const notes = document.getElementById('pakasir-notes').value.trim();
            const auto_send_email = document.getElementById('pakasir-auto-send-email')?.checked !== false;

            try {
                const res = await api('/api/admin/pakasir/transactions', 'POST', {
                    order_id,
                    amount,
                    method,
                    customer_name,
                    customer_email,
                    notes,
                    auto_send_email
                });

                if (res && res.success) {
                    showToast(res.message || 'Transaksi Pakasir berhasil dibuat!', 'success');
                    // Reset form & generate new Order ID
                    document.getElementById('form-create-pakasir').reset();
                    const chk = document.getElementById('pakasir-auto-send-email');
                    if (chk) chk.checked = true;
                    generateRandomOrderId();

                    // Open transaction detail modal
                    if (res.data) {
                        openPakasirModal(res.data);
                    }

                    // Reload transactions list
                    await loadPakasirData();
                }
            } catch (err) {
                // error toast handled by api()
            } finally {
                btn.disabled = false;
                btn.innerHTML = originalText;
            }
        }

        // Open Transaction Detail Modal by Object
        function openPakasirModal(txn) {
            if (!txn) return;
            window.currentViewingTxn = txn;

            document.getElementById('modal-pakasir-title').textContent = txn.method_name || 'Transaksi Pakasir';
            document.getElementById('modal-pakasir-subtitle').textContent = `Order ID: ${txn.order_id}`;
            document.getElementById('modal-pakasir-amount').textContent = `Rp ${(txn.total_payment || txn.amount || 0).toLocaleString('id-ID')}`;
            document.getElementById('modal-pakasir-fee-info').textContent = txn.fee ? `Termasuk biaya layanan: Rp ${txn.fee.toLocaleString('id-ID')}` : 'Bebas biaya tambahan';

            // Status Badge
            const st = (txn.status || 'pending').toLowerCase();
            const badgeContainer = document.getElementById('modal-pakasir-status-badge');
            if (st === 'completed') {
                badgeContainer.innerHTML = '<span class="badge-status-completed">COMPLETED</span>';
            } else if (st === 'canceled') {
                badgeContainer.innerHTML = '<span class="badge-status-canceled">CANCELED</span>';
            } else {
                badgeContainer.innerHTML = '<span class="badge-status-pending">PENDING</span>';
            }

            // Meta Info
            document.getElementById('modal-pakasir-order-id').textContent = txn.order_id || '-';
            document.getElementById('modal-pakasir-txn-id').textContent = txn.txn_id || '-';
            document.getElementById('modal-pakasir-method').textContent = txn.method_name || txn.method || '-';
            document.getElementById('modal-pakasir-expired').textContent = txn.expired_at ? new Date(txn.expired_at).toLocaleString('id-ID') : '1x24 Jam';

            // Completion Status & Email Button visibility
            const complStatusEl = document.getElementById('modal-pakasir-completion-status');
            if (complStatusEl) {
                if (txn.completionEmailSent) {
                    complStatusEl.innerHTML = `<span style="color: var(--lime-bright); font-size: 0.8rem;">✅ Terkirim (${escapeHtml(txn.customer_email || '-')})</span>`;
                } else if (st === 'completed') {
                    complStatusEl.innerHTML = `<span style="color: #facc15; font-size: 0.8rem;">⏳ Belum Terkirim</span>`;
                } else {
                    complStatusEl.textContent = '-';
                }
            }

            const completionBtn = document.getElementById('modal-pakasir-btn-completion-email');
