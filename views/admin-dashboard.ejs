<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="theme-color" content="#05081c">
    <title>Admin Console | Dents Web</title>
    <link rel="icon" type="image/png" href="/public/img/axalogo.png">
    <meta name="robots" content="noindex, nofollow">
    
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Lexend+Deca:wght@500;600;700;800&family=Plus+Jakarta+Sans:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
    
    <link rel="stylesheet" href="/public/css/style.css">
    <script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.min.js"></script>
    <script src="/public/js/tech-icons.js"></script>
    <script src="/public/js/protect-devtools.js" defer></script>
</head>
<body>

    <!-- Topbar Mobile for Drawer Toggle -->
    <div class="admin-mobile-topbar">
        <div style="display: flex; align-items: center; gap: 4px;">
            <img src="/public/img/axalogo.png" alt="Dents Logo" style="height: 28px; width: auto; object-fit: contain;">
            <span style="font-family: 'Lexend Deca', sans-serif; font-size: 1.05rem; font-weight: 800; color: #ffffff; letter-spacing: -0.5px;">ents Console</span>
        </div>
        <button id="admin-menu-toggle" type="button" aria-label="Buka Menu" style="background: var(--navy-surface); border: 1px solid var(--navy-surface-border); color: #ffffff; padding: 6px 10px; border-radius: 6px; cursor: pointer; display: flex; align-items: center; justify-content: center;">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="3" y1="12" x2="21" y2="12"></line><line x1="3" y1="6" x2="21" y2="6"></line><line x1="3" y1="18" x2="21" y2="18"></line></svg>
        </button>
    </div>
    <div class="admin-drawer-overlay" id="admin-drawer-overlay"></div>

    <div class="admin-layout-kalana">
        <!-- Sidebar Navigation -->
        <!-- Sidebar Navigation (Collapsible with < and >) -->
        <aside class="admin-sidebar-kalana" id="admin-sidebar">
            <div class="admin-sidebar-brand" style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 20px; padding-bottom: 14px; border-bottom: 1px solid var(--navy-surface-border);">
                <div style="display: flex; align-items: center; gap: 8px; overflow: hidden;">
                    <img src="/public/img/axalogo.png" alt="Dents Logo" style="height: 28px; width: auto; object-fit: contain; flex-shrink: 0;">
                    <span class="admin-sidebar-brand-title" style="font-family: 'Lexend Deca', sans-serif; font-size: 1.1rem; font-weight: 800; color: #ffffff; letter-spacing: -0.5px; white-space: nowrap;">Dents Console</span>
                </div>
                <button type="button" id="sidebar-collapse-toggle" class="admin-sidebar-toggle-btn" onclick="toggleSidebarCollapse()" title="Ciutkan / Perluas Navigasi" aria-label="Ciutkan / Perluas Navigasi">
                    <svg id="sidebar-toggle-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"></polyline></svg>
                </button>
            </div>

            <!-- Prominent Action Button (+ Buat) - Matches Gambar 1 & 2 -->
            <button type="button" class="btn-sidebar-create" id="btn-quick-create" onclick="openQuickCreateModal()" title="Buat / Tambah Data Baru">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.8" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
                <span class="btn-sidebar-create-text">Buat</span>
            </button>

            <nav style="display: flex; flex-direction: column; flex-grow: 1;">
                <!-- Section 1: Komunikasi & CS -->
                <div class="admin-nav-category-title">Komunikasi &amp; CS</div>
                <div class="admin-nav-item active" data-tab="leads" data-title="Leads Masuk">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline></svg>
                    <span>Leads Masuk</span>
                </div>
                <div class="admin-nav-item" data-tab="livechat" data-title="Live Chat CS">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path></svg>
                    <span>Live Chat CS</span>
                    <span class="badge-unread-chat" id="admin-unread-chat-count" style="display: none; background: #ef4444; color: #fff; border-radius: 999px; padding: 2px 7px; font-size: 0.72rem; font-weight: 800; margin-left: auto;">0</span>
                </div>

                <!-- Section 2: Konten & Website -->
                <div class="admin-nav-category-title">Konten &amp; Website</div>
                <div class="admin-nav-item" data-tab="portfolio" data-title="Portofolio Proyek">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"></path></svg>
                    <span>Portofolio</span>
                </div>
                <div class="admin-nav-item" data-tab="articles" data-title="Artikel & Materi">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path></svg>
                    <span>Artikel &amp; Materi</span>
                </div>
                <div class="admin-nav-item" data-tab="services" data-title="Layanan & Solusi">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 2 7 12 12 22 7 12 2"></polygon><polyline points="2 17 12 22 22 17"></polyline><polyline points="2 12 12 12 22 12"></polyline></svg>
                    <span>Layanan</span>
                </div>
                <div class="admin-nav-item" data-tab="pricing" data-title="Paket Harga">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="1" y="4" width="22" height="16" rx="2" ry="2"></rect><line x1="1" y1="10" x2="23" y2="10"></line></svg>
                    <span>Paket Harga</span>
                </div>
                <div class="admin-nav-item" data-tab="testimonials" data-title="Testimoni Klien">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path></svg>
                    <span>Testimoni Klien</span>
                </div>
                <div class="admin-nav-item" data-tab="faq" data-title="Tanya Jawab FAQ">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"></path><line x1="12" y1="17" x2="12.01" y2="17"></line></svg>
                    <span>FAQ</span>
                </div>

                <!-- Section 3: Keuangan & Faktur (Invoicing & Billing) -->
                <div class="admin-nav-category-title">Keuangan &amp; Faktur</div>
                <div class="admin-nav-item" data-tab="overview-invoice" data-title="Overview (Chart Analytics)">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="20" x2="18" y2="10"></line><line x1="12" y1="20" x2="12" y2="4"></line><line x1="6" y1="20" x2="6" y2="14"></line></svg>
                    <span>Overview Analytics</span>
                    <span class="badge-tag-lime" style="font-size: 0.65rem; padding: 2px 6px; margin-left: auto;">Chart</span>
                </div>
                <div class="admin-nav-item" data-tab="customers" data-title="Pelanggan (Clients)">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>
                    <span>Customers</span>
                </div>
                <div class="admin-nav-item" data-tab="invoices" data-title="Faktur &amp; Tagihan">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line></svg>
                    <span>Invoices</span>
                </div>
                <div class="admin-nav-item" data-tab="receipts" data-title="Kuitansi Pembayaran">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg>
                    <span>Receipts</span>
                </div>
                <div class="admin-nav-item" data-tab="invoice-settings" data-title="Pengaturan Invoice &amp; SMTP">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"></circle><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"></path></svg>
                    <span>Settings Invoice</span>
                </div>
                <div class="admin-nav-item" data-tab="pakasir" data-title="Pakasir Payment">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="1" y="4" width="22" height="16" rx="2" ry="2"></rect><line x1="1" y1="10" x2="23" y2="10"></line></svg>
                    <span>Pakasir Payment</span>
                    <span class="badge-tag-lime" style="font-size: 0.65rem; padding: 2px 6px; margin-left: auto;">API v2</span>
                </div>

                <!-- Section 4: Pengaturan -->
                <div class="admin-nav-category-title">Pengaturan</div>
                <div class="admin-nav-item" data-tab="settings" data-title="Pengaturan Web">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"></circle><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"></path></svg>
                    <span>Pengaturan Web</span>
                </div>

                <div style="margin-top: auto; padding-top: 20px; border-top: 1px solid var(--navy-surface-border);">
                    <a href="/" target="_blank" class="admin-nav-item" data-title="Kunjungi Situs" style="color: var(--slate-muted); text-decoration: none;">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path><polyline points="15 3 21 3 21 9"></polyline><line x1="10" y1="14" x2="21" y2="3"></line></svg>
                        <span>Kunjungi Situs</span>
                    </a>
                    <div class="admin-nav-item" data-title="Keluar Sesi" style="color: var(--danger); cursor: pointer;" onclick="handleLogout()">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path><polyline points="16 17 21 12 16 7"></polyline><line x1="21" y1="12" x2="9" y2="12"></line></svg>
                        <span>Keluar Sesi</span>
                    </div>
                </div>
            </nav>
        </aside>

        <!-- Main Dashboard Content -->
        <main class="admin-content-kalana">

            <!-- TAB 1: LEADS -->
            <div id="panel-leads" class="admin-panel">
                <div style="margin-bottom: 28px;">
                    <h2 style="font-size: 1.8rem; color: #ffffff; margin-bottom: 6px;">Prospek &amp; Leads Masuk</h2>
                    <p style="color: var(--slate-muted); font-size: 0.95rem;">Daftar pesan konsultasi dari formulir kontak publik.</p>
                </div>

                <div class="tactile-card-dark admin-table-responsive" style="padding: 0;">
                    <table class="admin-table" id="table-leads">
                        <thead>
                            <tr>
                                <th>Tanggal</th>
                                <th>Nama Lengkap</th>
                                <th>WhatsApp</th>
                                <th>Email</th>
                                <th>Pesan</th>
                                <th>Status</th>
                                <th style="text-align: right;">Aksi</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr><td colspan="7" style="text-align: center; color: var(--slate-muted); padding: 30px;">Memuat data leads...</td></tr>
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- TAB 2: PORTFOLIO -->
            <div id="panel-portfolio" class="admin-panel" style="display: none;">
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 28px; flex-wrap: wrap; gap: 16px;">
                    <div>
                        <h2 style="font-size: 1.8rem; color: #ffffff; margin-bottom: 6px;">Manajemen Portofolio</h2>
                        <p style="color: var(--slate-muted); font-size: 0.95rem;">Kelola proyek dan studi kasus yang tampil di halaman portofolio.</p>
                    </div>
                    <button class="btn-royal" onclick="openModal('modal-portfolio')">+ Tambah Proyek Baru</button>
                </div>

                <div class="tactile-card-dark admin-table-responsive" style="padding: 0;">
                    <table class="admin-table" id="table-portfolio">
                        <thead>
                            <tr>
                                <th>Judul Proyek</th>
                                <th>Klien</th>
                                <th>Kategori</th>
                                <th>Tahun</th>
                                <th>Status</th>
                                <th style="text-align: right;">Aksi</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr><td colspan="6" style="text-align: center; color: var(--slate-muted); padding: 30px;">Memuat data portofolio...</td></tr>
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- TAB ARTICLES & MATERI -->
            <div id="panel-articles" class="admin-panel" style="display: none;">
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 28px; flex-wrap: wrap; gap: 16px;">
                    <div>
                        <h2 style="font-size: 1.8rem; color: #ffffff; margin-bottom: 6px;">Manajemen Artikel &amp; Materi</h2>
                        <p style="color: var(--slate-muted); font-size: 0.95rem;">Publikasikan materi teknis, tutorial pemrograman, dan wawasan industri web modern.</p>
                    </div>
                    <button class="btn-royal" onclick="openModal('modal-articles')">+ Tulis Artikel Baru</button>
                </div>

                <div class="tactile-card-dark admin-table-responsive" style="padding: 0;">
                    <table class="admin-table" id="table-articles">
                        <thead>
                            <tr>
                                <th>Cover</th>
                                <th>Judul Artikel</th>
                                <th>Kategori</th>
                                <th>Waktu Baca</th>
                                <th>Status</th>
                                <th style="text-align: right;">Aksi</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr><td colspan="6" style="text-align: center; color: var(--slate-muted); padding: 30px;">Memuat data artikel...</td></tr>
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- TAB 3: SERVICES -->
            <div id="panel-services" class="admin-panel" style="display: none;">
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 28px; flex-wrap: wrap; gap: 16px;">
                    <div>
                        <h2 style="font-size: 1.8rem; color: #ffffff; margin-bottom: 6px;">Manajemen Layanan</h2>
                        <p style="color: var(--slate-muted); font-size: 0.95rem;">Kelola daftar layanan dan paket solusi digital.</p>
                    </div>
                    <button class="btn-royal" onclick="openModal('modal-services')">+ Tambah Layanan</button>
                </div>

                <div class="tactile-card-dark admin-table-responsive" style="padding: 0;">
                    <table class="admin-table" id="table-services">
                        <thead>
                            <tr>
                                <th>Icon</th>
                                <th>Nama Layanan</th>
                                <th>Harga Mulai</th>
                                <th>Status</th>
                                <th style="text-align: right;">Aksi</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr><td colspan="5" style="text-align: center; color: var(--slate-muted); padding: 30px;">Memuat data layanan...</td></tr>
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- TAB 4: PRICING -->
            <div id="panel-pricing" class="admin-panel" style="display: none;">
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 28px; flex-wrap: wrap; gap: 16px;">
                    <div>
                        <h2 style="font-size: 1.8rem; color: #ffffff; margin-bottom: 6px;">Manajemen Paket Harga</h2>
                        <p style="color: var(--slate-muted); font-size: 0.95rem;">Atur paket investasi dan fasilitas yang didapatkan dari tiap paket.</p>
                    </div>
                    <button class="btn-royal" onclick="openModal('modal-pricing')">+ Tambah Paket</button>
                </div>

                <div class="tactile-card-dark admin-table-responsive" style="padding: 0;">
                    <table class="admin-table" id="table-pricing">
                        <thead>
                            <tr>
                                <th>Nama Paket</th>
                                <th>Biaya Investasi</th>
                                <th>Populer</th>
                                <th>Status</th>
                                <th style="text-align: right;">Aksi</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr><td colspan="5" style="text-align: center; color: var(--slate-muted); padding: 30px;">Memuat data paket harga...</td></tr>
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- TAB 5: TESTIMONIALS -->
            <div id="panel-testimonials" class="admin-panel" style="display: none;">
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 28px; flex-wrap: wrap; gap: 16px;">
                    <div>
                        <h2 style="font-size: 1.8rem; color: #ffffff; margin-bottom: 6px;">Manajemen Testimoni Klien</h2>
                        <p style="color: var(--slate-muted); font-size: 0.95rem;">Kelola ulasan, nama klien, peran bisnis, rating, dan testimoni nyata.</p>
                    </div>
                    <button class="btn-royal" onclick="openModal('modal-testimonials')">+ Tambah Testimoni</button>
                </div>

                <div class="tactile-card-dark admin-table-responsive" style="padding: 0;">
                    <table class="admin-table" id="table-testimonials">
                        <thead>
                            <tr>
                                <th>Nama Klien</th>
                                <th>Role / Perusahaan</th>
                                <th>Rating</th>
                                <th>Ulasan / Testimoni</th>
                                <th>Status</th>
                                <th style="text-align: right;">Aksi</th>
                            </tr>
