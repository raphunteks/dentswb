            const tb = document.querySelector('#table-invoices tbody');
            if (!tb) return;
            if (invoices && invoices.length) {
                tb.innerHTML = invoices.map(inv => {
                    const customerName = inv.customerName || (inv.customer && inv.customer.companyName) || '-';
                    const isUnpaid = (inv.status || '').toUpperCase() !== 'PAID';
                    return `
                        <tr>
                            <td style="font-weight: 800; color: #ffffff;">${escapeHtml(inv.invoiceNumber)}</td>
                            <td style="color: #cbd5e1; font-weight: 600;">${escapeHtml(customerName)}</td>
                            <td style="color: var(--slate-muted); font-size: 0.85rem;">${formatDateIndo(inv.invoiceDate)}</td>
                            <td style="color: var(--slate-muted); font-size: 0.85rem;">${formatDateIndo(inv.dueDate)}</td>
                            <td style="font-weight: 800; color: #fff;">${formatRupiah(inv.total)}</td>
                            <td style="font-weight: 700; color: ${(inv.balanceDue || 0) > 0 ? '#facc15' : '#4ade80'};">${formatRupiah(inv.balanceDue)}</td>
                            <td>${getInvoiceStatusBadge(inv.status)}</td>
                            <td style="text-align: right; white-space: nowrap;">
                                ${isUnpaid ? `
                                    <button type="button" class="btn-lime" style="font-size: 0.76rem; padding: 4px 8px; margin-right: 4px;" onclick="quickMarkPaid('${inv.id}')" title="Ubah langsung jadi LUNAS (PAID)">✓ Lunas</button>
                                ` : ''}
                                <button type="button" class="btn-royal" style="font-size: 0.78rem; padding: 4px 10px; margin-right: 4px;" onclick="openInvoiceDetail('${inv.id}')">Detail</button>
                                <button type="button" class="btn-action-edit" onclick="openInvoiceModal('${inv.id}')">Edit</button>
                                <button type="button" class="btn-action-delete" onclick="deleteInvoice('${inv.id}')">Hapus</button>
                            </td>
                        </tr>
                    `;
                }).join('');
            } else {
                tb.innerHTML = '<tr><td colspan="8" style="text-align: center; padding: 30px; color: var(--slate-muted);">Tidak ada data tagihan yang sesuai kriteria.</td></tr>';
            }
        }

        function addInvoiceItemRow(item = {}) {
            const tbody = document.getElementById('invoice-items-tbody');
            if (!tbody) return;
            const itemDesc = item.description || '';
            const itemPeriod = item.period || '';
            const itemQty = item.quantity !== undefined ? item.quantity : 1;
            const itemPrice = item.unitPrice !== undefined ? item.unitPrice : (item.price !== undefined ? item.price : 0);
            const tr = document.createElement('tr');
            tr.className = 'invoice-item-row';
            tr.innerHTML = `
                <td style="padding: 6px;">
                    <input type="text" class="form-control item-desc" placeholder="Contoh: Pembuatan Website Bisnis Elegan" value="${escapeHtml(itemDesc)}" required style="background: var(--navy-surface); color: #fff; border-color: var(--navy-surface-border); font-size: 0.85rem; padding: 6px 10px;">
                </td>
                <td style="padding: 6px;">
                    <input type="text" class="form-control item-period" placeholder="1 Bulan / 1 Tahun" value="${escapeHtml(itemPeriod)}" style="background: var(--navy-surface); color: #fff; border-color: var(--navy-surface-border); font-size: 0.85rem; padding: 6px 10px;">
                </td>
                <td style="padding: 6px;">
                    <input type="number" min="1" step="1" class="form-control item-qty" value="${itemQty}" oninput="calcInvoiceTotals()" style="text-align: center; background: var(--navy-surface); color: #fff; border-color: var(--navy-surface-border); font-size: 0.85rem; padding: 6px 8px;">
                </td>
                <td style="padding: 6px;">
                    <input type="number" min="0" step="1000" class="form-control item-price" placeholder="0" value="${itemPrice}" oninput="calcInvoiceTotals()" style="text-align: right; background: var(--navy-surface); color: #fff; border-color: var(--navy-surface-border); font-size: 0.85rem; padding: 6px 10px;">
                </td>
                <td style="padding: 6px; text-align: right; font-weight: 700; color: #fff;" class="item-subtotal">
                    ${formatRupiah(itemQty * itemPrice)}
                </td>
                <td style="padding: 6px; text-align: center;">
                    <button type="button" onclick="removeInvoiceItemRow(this)" style="background: none; border: none; color: #f87171; font-size: 1.1rem; cursor: pointer; line-height: 1;">&times;</button>
                </td>
            `;
            tbody.appendChild(tr);
            calcInvoiceTotals();
        }

        function removeInvoiceItemRow(btn) {
            const tbody = document.getElementById('invoice-items-tbody');
            const row = btn.closest('tr');
            if (tbody.querySelectorAll('tr').length <= 1) {
                showToast('Minimal harus ada 1 baris item layanan!', 'error');
                return;
            }
            row.remove();
            calcInvoiceTotals();
        }

        function calcInvoiceTotals() {
            const tbody = document.getElementById('invoice-items-tbody');
            if (!tbody) return;
            const rows = tbody.querySelectorAll('tr');
            let subtotal = 0;

            rows.forEach(r => {
                const qty = parseFloat(r.querySelector('.item-qty')?.value) || 0;
                const price = parseFloat(r.querySelector('.item-price')?.value) || 0;
                const itemTot = qty * price;
                const subtotalEl = r.querySelector('.item-subtotal');
                if (subtotalEl) subtotalEl.textContent = formatRupiah(itemTot);
                subtotal += itemTot;
            });

            const discRate = parseFloat(document.getElementById('inv-form-disc')?.value) || 0;
            const taxRate = parseFloat(document.getElementById('inv-form-tax')?.value) || 0;

            const discountAmount = subtotal * (discRate / 100);
            const taxable = subtotal - discountAmount;
            const taxAmount = taxable * (taxRate / 100);
            const total = Math.max(0, taxable + taxAmount);

            const subEl = document.getElementById('inv-calc-subtotal');
            const totEl = document.getElementById('inv-calc-total');
            if (subEl) subEl.textContent = formatRupiah(subtotal);
            if (totEl) totEl.textContent = formatRupiah(total);
        }

        async function openInvoiceModal(id = null) {
            const m = document.getElementById('modal-invoice');
            if (!m) return;
            const form = m.querySelector('form');
            if (form) form.reset();

            // Pastikan data klien selalu dimuat terlebih dahulu
            if (!window.cacheData.customers || !window.cacheData.customers.length) {
                await loadCustomers();
            }
            updateCustomerDropdown();

            const title = document.getElementById('modal-title-invoice');
            const btnSubmit = document.getElementById('btn-save-invoice');
            const tbody = document.getElementById('invoice-items-tbody');
            if (tbody) tbody.innerHTML = '';

            const safeDate = (val) => {
                if (!val) return '';
                if (typeof val === 'string' && val.length >= 10 && /^\d{4}-\d{2}-\d{2}/.test(val)) {
                    return val.substring(0, 10);
                }
                const d = new Date(val);
                return isNaN(d.getTime()) ? '' : d.toISOString().substring(0, 10);
            };

            if (id) {
                let inv = (window.cacheData.invoices || []).find(x => String(x.id) === String(id));
                if (!inv) {
                    try {
                        const res = await api(`/api/admin/invoices/${id}`);
                        inv = res.data && (res.data.invoice || res.data);
                    } catch (e) {}
                }

                if (inv) {
                    const invNumber = inv.invoiceNumber || inv.number || id;
                    if (title) title.textContent = 'Edit Faktur Tagihan #' + invNumber;
                    if (btnSubmit) btnSubmit.textContent = 'Simpan Perubahan Faktur';

                    const idInput = document.getElementById('inv-form-id');
                    if (idInput) idInput.value = inv.id || '';
                    
                    // Pastikan klien terpilih di dropdown
                    const cusSelect = document.getElementById('inv-form-customer');
                    if (cusSelect && inv.customerId) {
                        const exists = Array.from(cusSelect.options).some(o => o.value === inv.customerId);
                        if (!exists) {
                            const opt = document.createElement('option');
                            opt.value = inv.customerId;
                            opt.textContent = `${inv.customerName || 'Klien'} (${inv.customerEmail || ''})`;
                            cusSelect.appendChild(opt);
                        }
                        cusSelect.value = inv.customerId;
                    }

                    const dateInput = document.getElementById('inv-form-date');
                    if (dateInput) dateInput.value = safeDate(inv.invoiceDate);

                    const dueInput = document.getElementById('inv-form-duedate');
                    if (dueInput) dueInput.value = safeDate(inv.dueDate);

                    const statusSelect = document.getElementById('inv-form-status');
                    if (statusSelect) {
                        statusSelect.value = (inv.status || 'UNPAID').toUpperCase();
                    }

                    const notesInput = document.getElementById('inv-form-notes');
                    if (notesInput) notesInput.value = inv.notes || '';

                    const discInput = document.getElementById('inv-form-disc');
                    if (discInput) discInput.value = inv.discountRate || 0;

                    const taxInput = document.getElementById('inv-form-tax');
                    if (taxInput) taxInput.value = inv.taxRate || 0;

                    if (inv.items && inv.items.length) {
                        inv.items.forEach(it => addInvoiceItemRow(it));
                    } else {
                        addInvoiceItemRow();
                    }
                }
            } else {
                if (title) title.textContent = 'Buat Faktur & Tagihan Baru';
                if (btnSubmit) btnSubmit.textContent = 'Simpan & Proses Tagihan';

                const idInput = document.getElementById('inv-form-id');
                if (idInput) idInput.value = '';
                
                // Pastikan Tanggal Faktur & Jatuh Tempo (Due Date) KOSONG untuk invoice baru
                const dateInput = document.getElementById('inv-form-date');
                if (dateInput) dateInput.value = '';

                const dueInput = document.getElementById('inv-form-duedate');
                if (dueInput) dueInput.value = '';

                const statusSelect = document.getElementById('inv-form-status');
                if (statusSelect) statusSelect.value = 'UNPAID';

                const defaultOfficialNotes = "Terima kasih telah mempercayakan proyek website Anda kepada Dents Web. Pembayaran dapat ditransfer ke rekening resmi kami di atas.";
                const notesInput = document.getElementById('inv-form-notes');
                if (notesInput) {
                    let setNotes = (window.cacheData.invoiceSettings && window.cacheData.invoiceSettings.invoiceNotes) || defaultOfficialNotes;
                    if (setNotes.includes('Virtual Account resmi kami')) {
                        setNotes = defaultOfficialNotes;
                    }
                    notesInput.value = setNotes;
                }

                const discInput = document.getElementById('inv-form-disc');
                if (discInput) discInput.value = (window.cacheData.invoiceSettings && window.cacheData.invoiceSettings.defaultDiscRate) || 0;

                const taxInput = document.getElementById('inv-form-tax');
                if (taxInput) taxInput.value = (window.cacheData.invoiceSettings && window.cacheData.invoiceSettings.defaultTaxRate) || 0;

                addInvoiceItemRow();
            }

            calcInvoiceTotals();
            m.classList.add('active');
            m.style.display = 'flex';
        }

        async function handleInvoiceSubmit(e) {
            e.preventDefault();
            const id = document.getElementById('inv-form-id').value.trim();
            const customerId = document.getElementById('inv-form-customer').value;
            const invoiceDate = document.getElementById('inv-form-date').value;
            const dueDate = document.getElementById('inv-form-duedate').value;
            const status = document.getElementById('inv-form-status')?.value || 'UNPAID';
            const notes = document.getElementById('inv-form-notes').value.trim();
            const globalDiscountRate = parseFloat(document.getElementById('inv-form-disc').value) || 0;
            const globalTaxRate = parseFloat(document.getElementById('inv-form-tax').value) || 0;
            const auto_send_email = document.getElementById('inv-form-autosend')?.checked || false;

            const rows = document.querySelectorAll('#invoice-items-tbody tr');
            const items = [];
            rows.forEach(r => {
                const desc = r.querySelector('.item-desc')?.value.trim();
                const period = r.querySelector('.item-period')?.value.trim();
                const qty = parseFloat(r.querySelector('.item-qty')?.value) || 1;
                const price = parseFloat(r.querySelector('.item-price')?.value) || 0;
                if (desc) {
                    items.push({ description: desc, period, quantity: qty, unitPrice: price });
                }
            });

            if (!items.length) {
                showToast('Mohon masukkan minimal 1 deskripsi layanan!', 'error');
                return;
            }

            const payload = {
                customerId,
                invoiceDate,
                dueDate,
                status,
                notes,
                globalDiscountRate,
                discountRate: globalDiscountRate,
                globalTaxRate,
                items,
                auto_send_email
            };

            try {
                const method = id ? 'PUT' : 'POST';
                const url = id ? `/api/admin/invoices/${id}` : '/api/admin/invoices';
                const res = await api(url, method, payload);

                if (res && res.emailResult && res.emailResult.success) {
                    showToast('Faktur berhasil disimpan & email PDF tagihan terkirim ke klien!', 'success');
                } else {
                    showToast(id ? 'Faktur tagihan berhasil diperbarui!' : 'Faktur baru berhasil dibuat!', 'success');
                }

                closeModal('modal-invoice');
                await loadInvoices();
                if (id && window.currentSelectedInvoice && window.currentSelectedInvoice.id === id) {
                    openInvoiceDetail(id);
                }
            } catch (e) {}
        }

        async function openInvoiceDetail(id) {
            let inv = (window.cacheData.invoices || []).find(x => x.id === id);
            if (!inv) {
                try {
                    const res = await api(`/api/admin/invoices`);
                    window.cacheData.invoices = res.data || [];
                    inv = window.cacheData.invoices.find(x => x.id === id);
                } catch (e) {}
            }
            if (!inv) return;
            window.currentSelectedInvoice = inv;

            document.getElementById('inv-detail-number').textContent = inv.invoiceNumber || inv.number;
            document.getElementById('inv-detail-status-badge').innerHTML = getInvoiceStatusBadge(inv.status);
            const custName = inv.customerName || (inv.customer && inv.customer.companyName) || '-';
            document.getElementById('inv-detail-customer-name').textContent = custName;

            const c = inv.customer || {};
            document.getElementById('inv-detail-customer-box').innerHTML = `
                <div style="font-weight: 700; color: #fff;">${escapeHtml(custName)}</div>
                <div style="font-size: 0.8rem; color: var(--slate-muted);">${escapeHtml(c.contactPerson || '-')}</div>
                <div style="font-size: 0.8rem; color: #38bdf8;">${escapeHtml(c.email || inv.customerEmail || '-')}</div>
                <div style="font-size: 0.8rem; color: var(--slate-muted);">${escapeHtml(c.phone || '-')}</div>
            `;

            // Render Detail Finansial Termasuk Subtotal & Diskon
            const discRate = Number(inv.discountRate || 0);
            const discVal = Number(inv.discountAmount || inv.discount || (discRate > 0 ? Math.round((inv.subtotal * discRate) / 100) : 0));
            const subtotalVal = inv.subtotal !== undefined ? inv.subtotal : inv.total;
            const finTable = document.getElementById('inv-detail-financial-table');
            if (finTable) {
                let finRows = `
                    <tr><td style="color: var(--slate-muted);">Tgl Terbit:</td><td style="text-align: right;" id="inv-detail-date">${formatDateIndo(inv.invoiceDate)}</td></tr>
                    <tr><td style="color: var(--slate-muted);">Jatuh Tempo:</td><td style="text-align: right; color: #f87171;" id="inv-detail-duedate">${formatDateIndo(inv.dueDate)}</td></tr>
                    <tr><td style="color: var(--slate-muted);">Subtotal:</td><td style="text-align: right; color: #cbd5e1;">${formatRupiah(subtotalVal)}</td></tr>
                `;
                if (discVal > 0 || discRate > 0) {
                    finRows += `<tr><td style="color: #f87171;">Discount (${discRate}%):</td><td style="text-align: right; color: #f87171; font-weight: 700;">-${formatRupiah(discVal)}</td></tr>`;
                }
                if (inv.tax || inv.taxAmount) {
                    finRows += `<tr><td style="color: var(--slate-muted);">PPN (${inv.taxRate || 0}%):</td><td style="text-align: right; color: #cbd5e1;">+${formatRupiah(inv.tax || inv.taxAmount)}</td></tr>`;
                }
                finRows += `
                    <tr style="border-top: 1px solid var(--navy-surface-border);"><td style="padding-top: 4px; font-weight: 800; color: #fff;">Total Tagihan:</td><td style="padding-top: 4px; text-align: right; font-weight: 800; color: #fff;" id="inv-detail-total">${formatRupiah(inv.total)}</td></tr>
                    <tr><td style="color: var(--slate-muted);">Sudah Dibayar:</td><td style="text-align: right; font-weight: 700; color: #4ade80;" id="inv-detail-paid">${formatRupiah(inv.amountPaid || 0)}</td></tr>
                    <tr style="border-top: 1px solid var(--navy-surface-border);"><td style="padding-top: 4px; font-weight: 800; color: #facc15;">Sisa Tagihan:</td><td style="padding-top: 4px; text-align: right; font-weight: 800; color: #facc15;" id="inv-detail-balance">${formatRupiah(inv.balanceDue || inv.balance || 0)}</td></tr>
                `;
                finTable.innerHTML = finRows;
            } else {
                const dDate = document.getElementById('inv-detail-date'); if (dDate) dDate.textContent = formatDateIndo(inv.invoiceDate);
                const dDue = document.getElementById('inv-detail-duedate'); if (dDue) dDue.textContent = formatDateIndo(inv.dueDate);
                const dTot = document.getElementById('inv-detail-total'); if (dTot) dTot.textContent = formatRupiah(inv.total);
                const dPaid = document.getElementById('inv-detail-paid'); if (dPaid) dPaid.textContent = formatRupiah(inv.amountPaid || 0);
                const dBal = document.getElementById('inv-detail-balance'); if (dBal) dBal.textContent = formatRupiah(inv.balanceDue || inv.balance || 0);
            }

            const itemsTb = document.getElementById('inv-detail-items-body');
            if (itemsTb) {
                itemsTb.innerHTML = (inv.items || []).map(it => `
                    <tr style="border-bottom: 1px solid rgba(255,255,255,0.05);">
                        <td style="padding: 6px; color: #fff;">${escapeHtml(it.description)}${it.period ? `<br><small style="color: var(--slate-muted);">${escapeHtml(it.period)}</small>` : ''}</td>
                        <td style="padding: 6px; text-align: center; color: var(--slate-muted);">${it.quantity}</td>
                        <td style="padding: 6px; text-align: right; color: var(--slate-muted);">${formatRupiah(it.unitPrice || it.price)}</td>
                        <td style="padding: 6px; text-align: right; color: #fff; font-weight: 700;">${formatRupiah(it.total || (it.quantity * (it.unitPrice || it.price)))}</td>
                    </tr>
                `).join('');
            }

            const btnIssue = document.getElementById('btn-action-issue');
            const btnPay = document.getElementById('btn-action-record-payment');
            const btnMarkPaid = document.getElementById('btn-action-quick-paid');
            const isUnpaid = (inv.status || '').toUpperCase() !== 'PAID';
            const isPaid = (inv.status || '').toUpperCase() === 'PAID';

            if (btnIssue) btnIssue.style.display = (inv.status === 'DRAFT') ? 'inline-flex' : 'none';
            if (btnPay) btnPay.style.display = ((inv.balanceDue || inv.balance || 0) > 0) ? 'inline-flex' : 'none';
            if (btnMarkPaid) btnMarkPaid.style.display = isUnpaid ? 'inline-flex' : 'none';

            // Jika status PAID (LUNAS), arahkan tombol ke /receipt/:publicId bukan ke /invoice/:publicId
            const publicUrl = isPaid ? ('/receipt/' + (inv.publicId || inv.id)) : ('/invoice/' + (inv.publicId || inv.id));
            const printUrl = isPaid ? ('/receipt/' + (inv.publicId || inv.id) + '/print') : ('/invoice/' + (inv.publicId || inv.id) + '/print');
            const btnViewPub = document.getElementById('btn-action-view-public');
            const btnPrint = document.getElementById('btn-action-print');
            if (btnViewPub) {
                btnViewPub.href = publicUrl;
                btnViewPub.innerHTML = isPaid 
                    ? `<svg style="width: 14px; height: 14px;" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg> Tautan Publik (Kuitansi) ↗`
                    : `<svg style="width: 14px; height: 14px;" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path></svg> Tautan Publik ↗`;
            }
            if (btnPrint) {
                btnPrint.href = printUrl;
                btnPrint.innerHTML = isPaid 
                    ? `<svg style="width: 14px; height: 14px;" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z"></path></svg> Cetak Kuitansi PDF`
                    : `<svg style="width: 14px; height: 14px;" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z"></path></svg> Cetak PDF`;
            }

            openModal('modal-invoice-detail');
        }

        async function quickMarkPaid(id) {
            if (!id) return;
            const inv = (window.cacheData.invoices || []).find(x => x.id === id);
            const invNum = inv ? (inv.invoiceNumber || inv.number) : id;

            const confirmMsg = `Ubah status Faktur #${invNum} menjadi LUNAS (PAID) secara manual?\n\nDokumen Kuitansi Resmi (.PDF) juga otomatis dibuat & dikirimkan ke Gmail klien.`;
            if (!confirm(confirmMsg)) return;

            try {
                const res = await api(`/api/admin/invoices/${id}/mark-paid`, 'POST', {
                    method: 'Transfer Bank Manual (Diverifikasi Admin)',
                    send_receipt: true
                });
                showToast(res.message || 'Faktur berhasil ditandai LUNAS!', 'success');
                await loadInvoices();
                await loadReceipts();
                if (window.currentSelectedInvoice && window.currentSelectedInvoice.id === id) {
                    openInvoiceDetail(id);
                }
            } catch (err) {
                showToast('Gagal menandai lunas: ' + err.message, 'error');
            }
        }

        async function issueCurrentInvoice() {
            if (!window.currentSelectedInvoice) return;
            try {
                const res = await api(`/api/admin/invoices/${window.currentSelectedInvoice.id}/issue`, 'POST');
                showToast('Faktur resmi diterbitkan (Status: UNPAID)!', 'success');
                await loadInvoices();
                await openInvoiceDetail(window.currentSelectedInvoice.id);
            } catch (e) {}
        }

        async function sendCurrentInvoiceEmail() {
            if (!window.currentSelectedInvoice) return;
            const inv = window.currentSelectedInvoice;
            const targetEmail = prompt('Kirim email tagihan Glassmorphism ke alamat:', inv.customerEmail || (inv.customer && inv.customer.email) || '');
            if (!targetEmail) return;

            try {
                showToast('Mengirim email faktur via Gmail SMTP...', 'info');
                await api(`/api/admin/invoices/${inv.id}/send-email`, 'POST', { email: targetEmail });
                showToast('Email tagihan berhasil terkirim ke ' + targetEmail + '!', 'success');
            } catch (e) {}
        }

        async function deleteInvoice(id) {
            if (!confirm('Yakin ingin menghapus faktur ini? Semua data pembayaran dan kuitansi terkait juga akan dihapus.')) return;
            try {
                await api(`/api/admin/invoices/${id}`, 'DELETE');
                showToast('Faktur berhasil dihapus.', 'success');
                closeModal('modal-invoice-detail');
                await loadInvoices();
            } catch (e) {}
        }

        // --- 4. RECORD PAYMENTS ---
        function openPaymentFromCurrentInvoice() {
            if (!window.currentSelectedInvoice) return;
            const inv = window.currentSelectedInvoice;
            document.getElementById('pay-invoice-id').value = inv.id;
            document.getElementById('pay-modal-invoice-num').textContent = `Faktur: ${inv.invoiceNumber} • Pelanggan: ${inv.customerName || (inv.customer && inv.customer.companyName) || '-'}`;
            document.getElementById('pay-amount').value = Math.max(0, inv.balanceDue || 0);
            document.getElementById('pay-balance-hint').textContent = `Sisa tagihan yang harus dibayar: ${formatRupiah(inv.balanceDue || 0)}`;
            document.getElementById('pay-ref').value = '';
            openModal('modal-payment');
        }

        async function handlePaymentSubmit(e) {
            e.preventDefault();
            const invoiceId = document.getElementById('pay-invoice-id').value;
            const amount = parseFloat(document.getElementById('pay-amount').value) || 0;
            const method = document.getElementById('pay-method').value;
            const reference = document.getElementById('pay-ref').value.trim();
            const send_receipt = document.getElementById('pay-send-receipt')?.checked || false;

            if (amount <= 0) {
                showToast('Nominal pembayaran harus lebih besar dari 0!', 'error');
                return;
            }

            try {
                const res = await api(`/api/admin/invoices/${invoiceId}/payment`, 'POST', {
                    amount,
                    method,
                    reference,
                    send_receipt
                });

                if (res && res.emailResult && res.emailResult.success) {
                    showToast('Pembayaran dicatat & Kuitansi Resmi terkirim ke Gmail klien!', 'success');
                } else {
                    showToast('Pembayaran berhasil dicatat!', 'success');
                }

                closeModal('modal-payment');
                await loadInvoices();
                if (window.currentSelectedInvoice && window.currentSelectedInvoice.id === invoiceId) {
                    await openInvoiceDetail(invoiceId);
                }
            } catch (e) {}
        }

        // --- 5. RECEIPTS (KUITANSI RESMI) ---
        window.currentSelectedReceipt = null;

        async function loadReceipts() {
            try {
                const res = await api('/api/admin/receipts');
                window.cacheData.receipts = res.data || [];
                renderReceiptTable(window.cacheData.receipts);
            } catch (e) {
                console.error('loadReceipts error:', e);
            }
        }

        function renderReceiptTable(receipts) {
            const badge = document.getElementById('receipts-count-badge');
            if (badge) badge.textContent = `${receipts.length} Kuitansi Lunas`;

            const tb = document.querySelector('#table-receipts tbody');
            if (!tb) return;
            if (receipts && receipts.length) {
                tb.innerHTML = receipts.map(r => `
                    <tr>
                        <td style="font-weight: 800; color: #ffffff;">${escapeHtml(r.receiptNumber)}</td>
                        <td style="color: #cbd5e1; font-weight: 600;">${escapeHtml(r.customerName || (r.customer && r.customer.companyName) || '-')}</td>
                        <td style="font-weight: 800; color: var(--lime-bright);">${formatRupiah(r.amountPaid)}</td>
                        <td style="color: var(--slate-muted); font-size: 0.85rem;">${escapeHtml(r.paymentMethod || 'Transfer')}</td>
                        <td style="color: var(--slate-muted); font-size: 0.85rem;">${formatDateIndo(r.paymentDate)}</td>
                        <td><span class="badge-tag-lime">✓ LUNAS</span></td>
                        <td style="text-align: right; white-space: nowrap;">
                            <button type="button" class="btn-royal" style="font-size: 0.78rem; padding: 4px 10px;" onclick="openReceiptDetail('${r.id}')">Lihat Kuitansi</button>
                        </td>
                    </tr>
                `).join('');
            } else {
                tb.innerHTML = '<tr><td colspan="7" style="text-align: center; padding: 30px; color: var(--slate-muted);">Belum ada kuitansi pembayaran resmi yang diterbitkan.</td></tr>';
            }
        }

        function filterReceiptTable() {
            const q = (document.getElementById('search-receipts')?.value || '').toLowerCase().trim();
            if (!q) {
                renderReceiptTable(window.cacheData.receipts || []);
                return;
            }
            const filtered = (window.cacheData.receipts || []).filter(r =>
                (r.receiptNumber && r.receiptNumber.toLowerCase().includes(q)) ||
                (r.customerName && r.customerName.toLowerCase().includes(q)) ||
                (r.reference && r.reference.toLowerCase().includes(q)) ||
                (r.paymentMethod && r.paymentMethod.toLowerCase().includes(q))
            );
            renderReceiptTable(filtered);
        }

        function openReceiptDetail(id) {
            const r = (window.cacheData.receipts || []).find(x => x.id === id);
            if (!r) return;
            window.currentSelectedReceipt = r;

            document.getElementById('receipt-detail-number').textContent = r.receiptNumber;
            const custName = r.customerName || (r.customer && r.customer.companyName) || '-';
            document.getElementById('receipt-detail-customer-name').textContent = custName;
            document.getElementById('receipt-d-from').textContent = custName;
            document.getElementById('receipt-d-amount').textContent = formatRupiah(r.amountPaid);
            document.getElementById('receipt-d-method').textContent = r.paymentMethod || 'Transfer';
            document.getElementById('receipt-d-ref').textContent = r.reference || '-';
            document.getElementById('receipt-d-date').textContent = formatDateIndo(r.paymentDate);

            const pubUrl = '/receipt/' + (r.publicId || r.id);
            const printUrl = '/receipt/' + (r.publicId || r.id) + '/print';
            const btnPub = document.getElementById('btn-receipt-view-public');
            const btnPrint = document.getElementById('btn-receipt-print');
            if (btnPub) btnPub.href = pubUrl;
            if (btnPrint) btnPrint.href = printUrl;

            openModal('modal-receipt-detail');
        }

        async function sendCurrentReceiptEmail() {
            if (!window.currentSelectedReceipt) return;
            const r = window.currentSelectedReceipt;
            const targetEmail = prompt('Kirim Kuitansi Resmi ke alamat Gmail klien:', r.customerEmail || (r.customer && r.customer.email) || '');
            if (!targetEmail) return;

            try {
                showToast('Mengirim Kuitansi Resmi via Gmail SMTP...', 'info');
                await api(`/api/admin/invoices/${r.invoiceId}/send-receipt`, 'POST', {
                    paymentId: r.paymentId,
                    email: targetEmail
                });
                showToast('Kuitansi Resmi berhasil terkirim ke ' + targetEmail + '!', 'success');
            } catch (e) {}
        }

        // --- 6. SETTINGS & GMAIL SMTP DIAGNOSTIC ---
        async function loadInvoiceSettings() {
            try {
                const res = await api('/api/admin/invoice/settings');
                if (!res || !res.data) return;
                window.cacheData.invoiceSettings = res.data;
                const s = res.data;

                const formId = document.getElementById('form-invoice-settings');
                if (formId) {
                    if (formId.elements['businessName']) formId.elements['businessName'].value = s.businessName || '';
                    if (formId.elements['npwp']) formId.elements['npwp'].value = s.npwp || '';
                    if (formId.elements['invoicePrefix']) formId.elements['invoicePrefix'].value = s.invoicePrefix || 'DENTSWEB';
                    if (formId.elements['businessEmail']) formId.elements['businessEmail'].value = s.businessEmail || '';
                    if (formId.elements['businessPhone']) formId.elements['businessPhone'].value = s.businessPhone || '';
                    if (formId.elements['businessAddress']) formId.elements['businessAddress'].value = s.businessAddress || '';
                    if (formId.elements['bankName']) formId.elements['bankName'].value = s.bankName || '';
                    if (formId.elements['bankAccount']) formId.elements['bankAccount'].value = s.bankAccount || '';
                    if (formId.elements['bankAccountName']) formId.elements['bankAccountName'].value = s.bankAccountName || '';
                    if (formId.elements['defaultDiscRate']) formId.elements['defaultDiscRate'].value = s.defaultDiscRate || 0;
                    if (formId.elements['defaultTaxRate']) formId.elements['defaultTaxRate'].value = s.defaultTaxRate || 0;
                    if (formId.elements['invoiceNotes']) formId.elements['invoiceNotes'].value = s.invoiceNotes || '';
                }

                const formSmtp = document.getElementById('form-smtp-settings');
                if (formSmtp) {
                    if (formSmtp.elements['smtpUser']) formSmtp.elements['smtpUser'].value = s.smtpUser || '';
                    if (formSmtp.elements['smtpPass']) formSmtp.elements['smtpPass'].value = s.smtpPass || '';
                    if (formSmtp.elements['senderName']) formSmtp.elements['senderName'].value = s.senderName || 'Dents Web Billing & Invoicing';
                    if (formSmtp.elements['autoSendReceipt']) formSmtp.elements['autoSendReceipt'].checked = s.autoSendReceipt !== false;
                }

                const testDest = document.getElementById('test-email-destination');
                if (testDest && !testDest.value) {
                    testDest.value = s.businessEmail || s.smtpUser || '';
                }
            } catch (e) {
                console.error('loadInvoiceSettings error:', e);
            }
        }

        async function saveInvoiceSettings(e) {
            e.preventDefault();
            const form = e.target;
            const payload = {
                businessName: form.elements['businessName'].value.trim(),
                npwp: form.elements['npwp'].value.trim(),
                invoicePrefix: form.elements['invoicePrefix'].value.trim(),
                businessEmail: form.elements['businessEmail'].value.trim(),
                businessPhone: form.elements['businessPhone'].value.trim(),
                businessAddress: form.elements['businessAddress'].value.trim(),
                bankName: form.elements['bankName'].value.trim(),
                bankAccount: form.elements['bankAccount'].value.trim(),
                bankAccountName: form.elements['bankAccountName'].value.trim(),
                defaultDiscRate: parseFloat(form.elements['defaultDiscRate'].value) || 0,
                defaultTaxRate: parseFloat(form.elements['defaultTaxRate'].value) || 0,
                invoiceNotes: form.elements['invoiceNotes'].value.trim()
            };

            try {
                await api('/api/admin/invoice/settings', 'PUT', payload);
                showToast('Pengaturan identitas bisnis & rekening bank berhasil disimpan!', 'success');
                await loadInvoiceSettings();
            } catch (e) {}
        }

        async function saveSmtpSettings(e) {
            e.preventDefault();
            const form = e.target;
            const payload = {
                smtpUser: form.elements['smtpUser'].value.trim(),
                smtpPass: form.elements['smtpPass'].value.trim(),
                senderName: form.elements['senderName'].value.trim(),
                autoSendReceipt: form.elements['autoSendReceipt'].checked
            };

            try {
                await api('/api/admin/invoice/settings', 'PUT', payload);
                showToast('Kredensial Gmail SMTP & notifikasi berhasil disimpan!', 'success');
                await loadInvoiceSettings();
            } catch (e) {}
        }

        async function runSmtpDiagnostic() {
            const dest = document.getElementById('test-email-destination')?.value.trim();
            const resBox = document.getElementById('smtp-test-result');
            const btn = document.getElementById('btn-test-smtp');

            if (!dest) {
                showToast('Mohon masukkan email penerima test!', 'error');
                return;
            }

            if (btn) {
                btn.disabled = true;
                btn.textContent = 'Menguji Koneksi...';
            }
            if (resBox) {
                resBox.style.display = 'block';
                resBox.innerHTML = '<span style="color: #60a5fa;">Sedang mencoba login ke Gmail SMTP dan mengirim email diagnostik...</span>';
            }

            try {
                const res = await api('/api/admin/invoice/settings/test-email', 'POST', { targetEmail: dest });
                if (resBox) {
                    resBox.innerHTML = `
                        <div style="background: rgba(34, 197, 94, 0.1); border: 1px solid rgba(34, 197, 94, 0.3); border-radius: 8px; padding: 10px; color: #4ade80;">
                            <strong>✓ Sukses Terkirim!</strong> Server Gmail menerima pesan diagnostik.<br>
                            <small style="color: #cbd5e1;">Pesan ID: ${escapeHtml(res.data?.messageId || '-')}. Silakan periksa Inbox ${escapeHtml(dest)}.</small>
                        </div>
                    `;
                }
                showToast('Email diagnostik berhasil terkirim ke ' + dest, 'success');
            } catch (err) {
                if (resBox) {
                    resBox.innerHTML = `
                        <div style="background: rgba(239, 68, 68, 0.1); border: 1px solid rgba(239, 68, 68, 0.3); border-radius: 8px; padding: 10px; color: #f87171;">
                            <strong>✕ Pengiriman Gagal:</strong> ${escapeHtml(err.message)}<br>
                            <div style="font-size: 0.78rem; color: #cbd5e1; margin-top: 6px; line-height: 1.4;">
                                <strong>Saran Perbaikan:</strong><br>
                                1. Pastikan Anda menggunakan <strong>Sandi Aplikasi (Google App Password)</strong> 16 digit, BUKAN sandi login biasa.<br>
                                2. Aktifkan Verifikasi 2 Langkah pada akun Google &rarr; Masuk ke <em>myaccount.google.com/apppasswords</em>.
                            </div>
                        </div>
                    `;
                }
            } finally {
                if (btn) {
                    btn.disabled = false;
                    btn.textContent = 'Kirim Uji Coba';
                }
            }
        }

        // Global functions exposure
