            if (!tb) return;
            if (customers && customers.length) {
                tb.innerHTML = customers.map(c => `
                    <tr>
                        <td>
                            <div style="font-weight: 700; color: #ffffff;">${escapeHtml(c.companyName || '-')}</div>
                            <div style="font-size: 0.78rem; color: var(--slate-muted);">${escapeHtml(c.address || '')}</div>
                        </td>
                        <td style="color: #cbd5e1;">${escapeHtml(c.contactPerson || '-')}</td>
                        <td><a href="mailto:${escapeHtml(c.email)}" style="color: #38bdf8; text-decoration: none;">${escapeHtml(c.email)}</a></td>
                        <td style="color: #cbd5e1;">${escapeHtml(c.phone || '-')}</td>
                        <td style="color: var(--slate-muted); font-size: 0.85rem;">${escapeHtml(c.city || '')}${c.city && c.province ? ', ' : ''}${escapeHtml(c.province || '')}</td>
