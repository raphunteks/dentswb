        // Send / Resend Payment Instructions Email from Modal
        async function sendPakasirModalEmail() {
            if (!window.currentViewingTxn) return;
            const txn = window.currentViewingTxn;
            const defaultEmail = txn.customer_email || '';
            const targetEmail = prompt('Kirim rincian instruksi bayar (QRIS / VA / Link) ke Gmail klien:', defaultEmail);
            if (!targetEmail || !targetEmail.trim()) return;

            const btn = document.getElementById('modal-pakasir-btn-email');
            const originalText = btn ? btn.innerHTML : '';
            if (btn) {
                btn.disabled = true;
                btn.innerHTML = '<span>Mengirim email...</span>';
            }

            try {
                const res = await api(`/api/admin/pakasir/transactions/${txn.id || txn.order_id}/send-email`, 'POST', {
                    email: targetEmail.trim()
                });
                if (res && res.success) {
                    showToast(res.message || `Instruksi pembayaran berhasil dikirim ke ${targetEmail}!`, 'success');
                    txn.customer_email = targetEmail.trim();
                    txn.emailSent = true;
                    txn.emailRecipient = targetEmail.trim();
                    await loadPakasirData();
                }
            } catch (err) {
                // error handled by api()
            } finally {
                if (btn) {
                    btn.disabled = false;
                    btn.innerHTML = originalText;
                }
            }
        }

