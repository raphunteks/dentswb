                    <div style="background: rgba(33, 82, 207, 0.1); border: 1px solid rgba(59, 130, 246, 0.3); border-radius: 12px; padding: 20px; text-align: center;">
                        <div style="color: var(--slate-muted); font-size: 0.85rem; margin-bottom: 6px;">Nomor Virtual Account (${escapeHtml(txn.method_name)})</div>
