        // ==========================================
        // INVOICE, CUSTOMER & RECEIPT SUITE
        // ==========================================

        function formatRupiah(amount) {
            const num = Number(amount) || 0;
            return 'Rp ' + Math.round(num).toLocaleString('id-ID');
        }

        function formatDateIndo(dateStr) {
            if (!dateStr) return '-';
            try {
                const d = new Date(dateStr);
                if (isNaN(d.getTime())) return dateStr;
                return d.toLocaleDateString('id-ID', { day: 'numeric', month: 'short', year: 'numeric' });
            } catch (e) {
                return dateStr;
            }
        }

        function getInvoiceStatusBadge(status) {
            const s = String(status || '').toUpperCase();
            if (s === 'PAID') return '<span class="badge-tag-lime">✓ LUNAS</span>';
            if (s === 'UNPAID') return '<span style="background: rgba(234, 179, 8, 0.15); color: #facc15; border: 1px solid rgba(234, 179, 8, 0.3); padding: 3px 8px; border-radius: 6px; font-size: 0.75rem; font-weight: 700;">UNPAID</span>';
            if (s === 'PARTIALLY_PAID') return '<span style="background: rgba(56, 189, 248, 0.15); color: #38bdf8; border: 1px solid rgba(56, 189, 248, 0.3); padding: 3px 8px; border-radius: 6px; font-size: 0.75rem; font-weight: 700;">SEBAGIAN</span>';
            if (s === 'OVERDUE') return '<span class="badge-tag-coral">OVERDUE</span>';
            if (s === 'CANCELLED') return '<span style="background: rgba(148, 163, 184, 0.15); color: #94a3b8; border: 1px solid rgba(148, 163, 184, 0.3); padding: 3px 8px; border-radius: 6px; font-size: 0.75rem; font-weight: 700;">BATAL</span>';
            return '<span class="badge-tag-royal">DRAFT</span>';
        }

        // --- 1. OVERVIEW & ANALYTICS ---
        let chartRevenueInstance = null;
        let chartStatusInstance = null;

        // ========================================================
        // KONFIGURASI PERIODE TREN GRAFIK (Bisa diubah di sini)
        // Nilai yang didukung:
        // - 'this_month' : Default sebulan penuh (harian di bulan berjalan)
        // - '3_months'   : 3 Bulan Terakhir
        // - '6_months'   : 6 Bulan Terakhir
        // - '12_months'  : 12 Bulan Terakhir (1 Tahun)
        // - 'yearly'     : Tiap Tahun (Tahunan)
        // Atau angka 1 - 12 (jumlah bulan)
        // ========================================================
        window.CHART_CONFIG = {
            defaultPeriod: 'this_month',
            currentPeriod: 'this_month'
        };

        window.analyticsCache = {
            stats: null,
            statusCounts: null,
            invoices: [],
            recentInvoices: []
        };

        function calculateChartBuckets(invoices, period) {
            const p = String(period || window.CHART_CONFIG.defaultPeriod).toLowerCase();
            const now = new Date();
            const buckets = [];

            if (p === 'this_month' || p === 'month' || p === '1_month' || p === '1') {
                const year = now.getFullYear();
                const month = now.getMonth();
                const daysInMonth = new Date(year, month + 1, 0).getDate();
                const monthShort = now.toLocaleDateString('id-ID', { month: 'short' });

                for (let d = 1; d <= daysInMonth; d++) {
                    const dayStr = String(d).padStart(2, '0');
                    const key = `${year}-${String(month + 1).padStart(2, '0')}-${dayStr}`;
                    const label = `${dayStr} ${monthShort}`;
                    buckets.push({ key, label, billed: 0, paid: 0 });
                }

                (invoices || []).forEach(inv => {
                    const dateStr = (inv.invoiceDate || inv.createdAt || '').substring(0, 10);
                    const b = buckets.find(item => item.key === dateStr);
                    if (b) {
                        const status = (inv.status || '').toUpperCase();
                        if (status !== 'DRAFT') b.billed += Number(inv.total) || 0;
                        b.paid += Number(inv.amountPaid) || 0;
                    }
                });
            } else if (p === 'yearly' || p === 'years') {
                const curYear = now.getFullYear();
                for (let y = curYear - 2; y <= curYear; y++) {
                    const key = String(y);
                    const label = `Thn ${y}`;
                    buckets.push({ key, label, billed: 0, paid: 0 });
                }

                (invoices || []).forEach(inv => {
                    const dateStr = (inv.invoiceDate || inv.createdAt || '').substring(0, 4);
                    const b = buckets.find(item => item.key === dateStr);
                    if (b) {
                        const status = (inv.status || '').toUpperCase();
                        if (status !== 'DRAFT') b.billed += Number(inv.total) || 0;
                        b.paid += Number(inv.amountPaid) || 0;
                    }
                });
            } else {
                let numMonths = 6;
                if (p === '3_months' || p === '3') numMonths = 3;
                else if (p === '12_months' || p === '12' || p === '1_year') numMonths = 12;
                else if (!isNaN(parseInt(p))) numMonths = Math.min(Math.max(parseInt(p), 1), 24);

                for (let i = numMonths - 1; i >= 0; i--) {
                    const d = new Date(now.getFullYear(), now.getMonth() - i, 1);
                    const key = `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}`;
                    const label = d.toLocaleDateString('id-ID', { month: 'short', year: '2-digit' });
                    buckets.push({ key, label, billed: 0, paid: 0 });
                }

                (invoices || []).forEach(inv => {
                    const dateStr = (inv.invoiceDate || inv.createdAt || '').substring(0, 7);
                    const b = buckets.find(item => item.key === dateStr);
                    if (b) {
                        const status = (inv.status || '').toUpperCase();
                        if (status !== 'DRAFT') b.billed += Number(inv.total) || 0;
                        b.paid += Number(inv.amountPaid) || 0;
                    }
                });
            }

            return {
                labels: buckets.map(b => b.label),
                billed: buckets.map(b => b.billed),
                paid: buckets.map(b => b.paid),
                period: p
            };
        }

        function onChartPeriodChange(period) {
            window.CHART_CONFIG.currentPeriod = period;
            
            const subtitleEl = document.getElementById('chart-period-subtitle');
            if (subtitleEl) {
                if (period === 'this_month') subtitleEl.innerHTML = 'Bulan Ini &bull; Rupiah (IDR)';
                else if (period === '3_months') subtitleEl.innerHTML = '3 Bulan Terakhir &bull; Rupiah (IDR)';
                else if (period === '6_months') subtitleEl.innerHTML = '6 Bulan Terakhir &bull; Rupiah (IDR)';
                else if (period === '12_months') subtitleEl.innerHTML = '12 Bulan Terakhir (1 Tahun) &bull; Rupiah (IDR)';
                else if (period === 'yearly') subtitleEl.innerHTML = 'Tahunan &bull; Rupiah (IDR)';
                else subtitleEl.innerHTML = `${period} Bulan &bull; Rupiah (IDR)`;
            }

            const chartData = calculateChartBuckets(window.analyticsCache.invoices, period);
            if (chartRevenueInstance) {
                chartRevenueInstance.data.labels = chartData.labels;
                chartRevenueInstance.data.datasets[0].data = chartData.billed;
                chartRevenueInstance.data.datasets[1].data = chartData.paid;
                chartRevenueInstance.update();
            } else {
                renderInvoiceCharts(chartData, window.analyticsCache.statusCounts);
            }
        }

        async function loadInvoiceAnalytics() {
            try {
                const currentPeriod = window.CHART_CONFIG.currentPeriod || window.CHART_CONFIG.defaultPeriod;
                const res = await api(`/api/admin/invoice/analytics?period=${encodeURIComponent(currentPeriod)}`);
                if (!res || !res.data) return;
                
                const { stats, statusCounts, monthlyChart, chart, invoices, recentInvoices } = res.data;
                const safeStats = stats || {};
                const safeCounts = statusCounts || safeStats.statusCounts || {};
                const safeInvoices = invoices || [];

                window.analyticsCache.stats = safeStats;
                window.analyticsCache.statusCounts = safeCounts;
                window.analyticsCache.invoices = safeInvoices;
                window.analyticsCache.recentInvoices = recentInvoices || [];

                const totalInvEl = document.getElementById('inv-stat-total-invoices');
                const totalBilledEl = document.getElementById('inv-stat-total-billed');
                const totalPaidEl = document.getElementById('inv-stat-total-paid');
                const outstandingEl = document.getElementById('inv-stat-outstanding');
                const overdueEl = document.getElementById('inv-stat-overdue');

                if (totalInvEl) totalInvEl.textContent = safeStats.totalInvoices || safeInvoices.length || 0;
                if (totalBilledEl) totalBilledEl.textContent = formatRupiah(safeStats.totalBilled);
                if (totalPaidEl) totalPaidEl.textContent = formatRupiah(safeStats.totalPaid);
                if (outstandingEl) outstandingEl.textContent = formatRupiah(safeStats.outstanding !== undefined ? safeStats.outstanding : safeStats.totalOutstanding);
                if (overdueEl) overdueEl.textContent = formatRupiah(safeStats.overdue !== undefined ? safeStats.overdue : safeStats.totalOverdue);

                // Sinkronkan dropdown selector
                const periodSelect = document.getElementById('chart-period-select');
                if (periodSelect && periodSelect.value !== currentPeriod) {
                    periodSelect.value = currentPeriod;
                }

                // Kalkulasi data tren grafik untuk periode aktif
                const activeChartData = calculateChartBuckets(safeInvoices, currentPeriod);
                renderInvoiceCharts(activeChartData, safeCounts);

                const tb = document.querySelector('#table-recent-invoices tbody');
                if (tb) {
                    if (recentInvoices && recentInvoices.length) {
                        tb.innerHTML = recentInvoices.map(inv => `
                            <tr>
                                <td style="font-weight: 800; color: #ffffff;">${escapeHtml(inv.invoiceNumber)}</td>
                                <td style="color: #cbd5e1; font-weight: 600;">${escapeHtml(inv.customerName || (inv.customer && inv.customer.companyName) || '-')}</td>
                                <td style="color: var(--slate-muted); font-size: 0.85rem;">${formatDateIndo(inv.invoiceDate)}</td>
                                <td style="color: var(--slate-muted); font-size: 0.85rem;">${formatDateIndo(inv.dueDate)}</td>
                                <td style="font-weight: 800; color: #fff;">${formatRupiah(inv.total)}</td>
                                <td>${getInvoiceStatusBadge(inv.status)}</td>
                                <td style="text-align: right; white-space: nowrap;">
                                    <button type="button" class="btn-ghost-white" style="font-size: 0.78rem; padding: 4px 10px;" onclick="openInvoiceDetail('${inv.id}')">Lihat Detail</button>
                                </td>
                            </tr>
                        `).join('');
                    } else {
                        tb.innerHTML = '<tr><td colspan="7" style="text-align: center; color: var(--slate-muted); padding: 30px;">Belum ada tagihan dibuat.</td></tr>';
                    }
                }
            } catch (e) {
                console.error('loadInvoiceAnalytics error:', e);
            }
        }

        function renderInvoiceCharts(monthlyData, statusCounts) {
            if (typeof Chart === 'undefined') return;

            // 1. BAR CHART: Tren Penagihan & Pembayaran
            const revCanvas = document.getElementById('chart-monthly-revenue');
            if (revCanvas) {
                if (chartRevenueInstance) chartRevenueInstance.destroy();
                const ctx = revCanvas.getContext('2d');
                chartRevenueInstance = new Chart(ctx, {
                    type: 'bar',
                    data: {
                        labels: monthlyData && monthlyData.labels ? monthlyData.labels : [],
                        datasets: [
                            {
                                label: 'Nilai Tertagih (Billed)',
                                data: monthlyData && monthlyData.billed ? monthlyData.billed : [],
                                backgroundColor: 'rgba(56, 189, 248, 0.85)',
                                borderColor: '#38bdf8',
                                borderWidth: 1.5,
                                borderRadius: 6,
                                maxBarThickness: 32
                            },
                            {
                                label: 'Dana Diterima (Paid)',
                                data: monthlyData && (monthlyData.paid || monthlyData.revenue) ? (monthlyData.paid || monthlyData.revenue) : [],
                                backgroundColor: 'rgba(190, 242, 100, 0.85)',
                                borderColor: '#bef264',
                                borderWidth: 1.5,
                                borderRadius: 6,
                                maxBarThickness: 32
                            }
                        ]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        interaction: {
                            intersect: false,
                            mode: 'index'
                        },
                        plugins: {
                            legend: {
                                labels: {
                                    color: '#94a3b8',
                                    font: { family: 'Plus Jakarta Sans', size: 12, weight: 600 },
                                    usePointStyle: true,
                                    pointStyle: 'circle',
                                    padding: 16
                                }
                            },
                            tooltip: {
                                backgroundColor: 'rgba(10, 13, 38, 0.95)',
                                titleColor: '#ffffff',
                                bodyColor: '#cbd5e1',
                                borderColor: 'rgba(190, 242, 100, 0.3)',
                                borderWidth: 1,
                                padding: 12,
                                boxPadding: 6,
                                usePointStyle: true,
                                callbacks: {
                                    label: function(c) {
                                        return ' ' + c.dataset.label + ': ' + formatRupiah(c.raw);
                                    }
                                }
                            }
                        },
                        scales: {
                            x: {
                                grid: { color: 'rgba(255,255,255,0.04)' },
                                ticks: {
                                    color: '#94a3b8',
                                    font: { family: 'Plus Jakarta Sans', size: 11 },
                                    maxRotation: 45,
                                    autoSkip: true,
                                    maxTicksLimit: 15
                                }
                            },
                            y: {
                                grid: { color: 'rgba(255,255,255,0.06)' },
                                ticks: {
                                    color: '#94a3b8',
                                    font: { family: 'Plus Jakarta Sans', size: 11 },
                                    callback: function(v) {
                                        if (v >= 1000000) return 'Rp ' + (v / 1000000).toFixed(1) + 'M';
                                        if (v >= 1000) return 'Rp ' + (v / 1000).toFixed(0) + 'K';
                                        return 'Rp ' + v;
                                    }
                                }
                            }
                        }
                    }
                });
            }

            // 2. DOUGHNUT / PIE CHART: Proporsi Status Faktur
            const statusCanvas = document.getElementById('chart-status-pie');
            if (statusCanvas) {
                if (chartStatusInstance) chartStatusInstance.destroy();
                const ctx2 = statusCanvas.getContext('2d');
                const counts = statusCounts || {};
                const paidCount = counts.PAID || 0;
                const unpaidCount = (counts.UNPAID || 0) + (counts.PARTIALLY_PAID || 0);
                const overdueCount = counts.OVERDUE || 0;
                const draftCount = counts.DRAFT || 0;
                const totalInvoices = paidCount + unpaidCount + overdueCount + draftCount;

                const pieBadge = document.getElementById('pie-total-invoices-badge');
                if (pieBadge) {
                    pieBadge.textContent = `${totalInvoices} Faktur`;
                }

                if (totalInvoices === 0) {
                    // Placeholder saat data faktur masih kosong
                    chartStatusInstance = new Chart(ctx2, {
                        type: 'doughnut',
                        data: {
                            labels: ['Belum Ada Faktur'],
                            datasets: [{
                                data: [1],
                                backgroundColor: ['rgba(148, 163, 184, 0.2)'],
                                borderColor: 'transparent'
                            }]
                        },
                        options: {
                            responsive: true,
                            maintainAspectRatio: false,
                            plugins: {
                                legend: {
                                    position: 'bottom',
                                    labels: { color: '#64748b', font: { family: 'Plus Jakarta Sans', size: 11 } }
                                },
                                tooltip: { enabled: false }
                            },
                            cutout: '70%'
                        }
                    });
                } else {
                    chartStatusInstance = new Chart(ctx2, {
                        type: 'doughnut',
                        data: {
                            labels: ['Lunas', 'Belum Lunas', 'Overdue', 'Draft'],
                            datasets: [{
                                data: [paidCount, unpaidCount, overdueCount, draftCount],
                                backgroundColor: [
                                    '#bef264', // Lime Dents Web (Lunas)
                                    '#facc15', // Amber (Belum Lunas)
                                    '#f87171', // Coral Red (Overdue)
                                    '#60a5fa'  // Sky Blue (Draft)
                                ],
                                borderColor: '#0a0d26',
                                borderWidth: 3,
                                hoverOffset: 6
                            }]
                        },
                        options: {
                            responsive: true,
                            maintainAspectRatio: false,
                            plugins: {
                                legend: {
                                    position: 'bottom',
                                    labels: {
                                        color: '#cbd5e1',
                                        font: { family: 'Plus Jakarta Sans', size: 11, weight: 600 },
                                        padding: 14,
                                        usePointStyle: true,
                                        pointStyle: 'circle'
                                    }
                                },
                                tooltip: {
                                    backgroundColor: 'rgba(10, 13, 38, 0.95)',
                                    titleColor: '#ffffff',
                                    bodyColor: '#cbd5e1',
                                    borderColor: 'rgba(190, 242, 100, 0.3)',
                                    borderWidth: 1,
                                    padding: 10,
                                    callbacks: {
                                        label: function(c) {
                                            const val = Number(c.raw) || 0;
                                            const pct = totalInvoices > 0 ? Math.round((val / totalInvoices) * 100) : 0;
                                            return ` ${c.label}: ${val} Faktur (${pct}%)`;
                                        }
                                    }
                                }
                            },
                            cutout: '66%'
                        }
                    });
                }
            }
        }

        // --- 2. CUSTOMERS MANAGEMENT ---
