    <!-- Toast Notifications -->
    <div class="toast-box" id="toast-container"></div>

    <script>
        // Global in-memory cache for fast pre-filling during Edit
        window.cacheData = {
            leads: [],
            portfolio: [],
            services: [],
            pricing: [],
            testimonials: [],
            faq: []
        };

        // UI Helpers
        function showToast(message, type = 'success') {
            const container = document.getElementById('toast-container');
            const toast = document.createElement('div');
            toast.className = `toast-item ${type === 'success' ? 'toast-success' : 'toast-error'}`;
            toast.textContent = message;
            container.appendChild(toast);
            setTimeout(() => toast.remove(), 3500);
        }

        function openModal(id) { 
            const m = document.getElementById(id);
            if (!m) return;
            const form = m.querySelector('form');
            if (form) {
                form.reset();
                const idInput = form.querySelector('input[name="id"]');
                if (idInput) idInput.value = '';
            }
            
            // Set title back to Add
            const entity = id.replace('modal-', '');
            const titleEl = document.getElementById(`modal-title-${entity}`);
            if (titleEl) {
                const entityNames = {
                    portfolio: 'Portofolio Proyek',
                    services: 'Layanan',
                    pricing: 'Paket Harga',
                    testimonials: 'Testimoni Klien',
                    faq: 'FAQ'
                };
                titleEl.textContent = `Tambah ${entityNames[entity] || entity}`;
            }
            m.classList.add('active');
            m.style.display = 'flex'; 
        }

        function closeModal(id) { 
            const m = document.getElementById(id);
            if (m) {
                m.classList.remove('active');
                m.style.display = 'none'; 
                const form = m.querySelector('form');
                if (form) {
                    form.reset();
                    const idInput = form.querySelector('input[name="id"]');
                    if (idInput) idInput.value = '';
                }
            }
        }

        // Open Edit Modal with Pre-filled Form Values
        function openEditModal(entity, id) {
            const list = window.cacheData[entity] || [];
            const item = list.find(x => String(x.id) === String(id));
            if (!item) {
                showToast('Data tidak ditemukan.', 'error');
                return;
            }

            const modal = document.getElementById(`modal-${entity}`);
            if (!modal) {
                showToast('Modal tidak ditemukan: ' + entity, 'error');
                return;
            }
            const form = modal.querySelector('form');
            if (!form) return;

            form.reset();

            // Explicit safe field value setter
            const setVal = (name, val) => {
                const el = form.elements[name];
                if (el) {
                    el.value = (val !== undefined && val !== null) ? val : '';
                }
            };

            setVal('id', item.id);

            if (entity === 'portfolio') {
                setVal('title', item.title);
                setVal('slug', item.slug);
                setVal('client', item.client);
                setVal('year', item.year);
                setVal('category', item.category);
                setVal('image', item.image);
                setVal('projectUrl', item.projectUrl);
                setVal('shortDescription', item.shortDescription);
                setVal('description', item.description);
                setVal('isPublished', item.isPublished ? 'true' : 'false');
            } else if (entity === 'services') {
                setVal('title', item.title);
                setVal('slug', item.slug);
                setVal('startingPrice', item.startingPrice);
                setVal('description', item.description);
                setVal('features', Array.isArray(item.features) ? item.features.join(', ') : (item.features || ''));
                setVal('isPublished', item.isPublished !== false ? 'true' : 'false');
            } else if (entity === 'pricing') {
                setVal('name', item.name);
                setVal('price', item.price);
                setVal('description', item.description);
                setVal('features', Array.isArray(item.features) ? item.features.join(', ') : (item.features || ''));
                setVal('isFeatured', item.isFeatured ? 'true' : 'false');
                setVal('isPublished', item.isPublished !== false ? 'true' : 'false');
            } else if (entity === 'testimonials') {
                setVal('name', item.name);
                setVal('role', item.role);
                setVal('company', item.company);
                setVal('rating', item.rating || 5);
                setVal('content', item.content);
                setVal('isPublished', item.isPublished !== false ? 'true' : 'false');
            } else if (entity === 'faq') {
                setVal('question', item.question);
                setVal('answer', item.answer);
                setVal('isPublished', item.isPublished !== false ? 'true' : 'false');
            }

            // Set Title to Edit
            const titleEl = document.getElementById(`modal-title-${entity}`);
            if (titleEl) {
                const entityNames = {
                    portfolio: 'Portofolio Proyek',
                    services: 'Layanan',
                    pricing: 'Paket Harga',
                    testimonials: 'Testimoni Klien',
                    faq: 'FAQ'
                };
                titleEl.textContent = `Edit ${entityNames[entity] || entity}`;
            }

            modal.classList.add('active');
            modal.style.display = 'flex';
        }

        // Tab Switcher
        document.querySelectorAll('.admin-nav-item').forEach(item => {
            const tab = item.getAttribute('data-tab');
            if (!tab) return;
            item.addEventListener('click', () => {
                document.querySelectorAll('.admin-nav-item').forEach(i => i.classList.remove('active'));
                item.classList.add('active');

                document.querySelectorAll('.admin-panel').forEach(p => p.style.display = 'none');
                const targetPanel = document.getElementById(`panel-${tab}`);
                if (targetPanel) targetPanel.style.display = 'block';

                loadData(tab);
            });
        });

        // API Fetcher
        async function api(url, method = 'GET', body = null) {
            const options = { method, headers: { 'Content-Type': 'application/json' } };
            if (body) options.body = JSON.stringify(body);
            try {
                const res = await fetch(url, options);
                if (res.status === 401) { window.location.href = '/admin-login'; return; }
                const data = await res.json();
                if (!res.ok) throw new Error(data.message || 'Server error');
                return data;
            } catch (err) {
                showToast(err.message, 'error');
                throw err;
            }
        }

        // Loaders
        async function loadData(tab) {
            if (tab === 'leads') {
                const res = await api('/api/admin/leads');
                window.cacheData.leads = res.data || [];
                const tb = document.querySelector('#table-leads tbody');
                tb.innerHTML = (res.data && res.data.length) ? res.data.map(l => `
                    <tr>
                        <td style="color: var(--slate-muted); font-size: 0.85rem;">${new Date(l.createdAt).toLocaleDateString('id-ID')}</td>
                        <td style="font-weight: 700; color: #ffffff;">${escapeHtml(l.name)}</td>
                        <td><a href="https://wa.me/${l.whatsapp.replace(/[^0-9]/g, '')}" target="_blank" style="color: var(--lime-accent); font-weight: 600; text-decoration: none;">${escapeHtml(l.whatsapp)} &nearr;</a></td>
                        <td style="color: var(--slate-muted);">${escapeHtml(l.email || '-')}</td>
                        <td style="max-width: 260px; font-size: 0.85rem; line-height: 1.5;">${escapeHtml(l.message)}</td>
                        <td><span class="badge-tag-royal" style="font-size: 0.75rem;">${escapeHtml(l.status || 'Baru')}</span></td>
                        <td style="text-align: right; white-space: nowrap;">
                            <button class="btn-action-delete" data-action="delete" data-entity="leads" data-id="${l.id}" onclick="deleteRecord('leads', '${l.id}')">Hapus</button>
                        </td>
                    </tr>
                `).join('') : '<tr><td colspan="7" style="text-align: center; padding: 30px; color: var(--slate-muted);">Belum ada pesan leads masuk.</td></tr>';
            }

            if (tab === 'portfolio') {
                const res = await api('/api/admin/portfolio');
                window.cacheData.portfolio = res.data || [];
                const tb = document.querySelector('#table-portfolio tbody');
                tb.innerHTML = (res.data && res.data.length) ? res.data.map(p => `
                    <tr>
                        <td style="font-weight: 700; color: #ffffff;">${escapeHtml(p.title)}</td>
                        <td style="color: var(--slate-muted);">${escapeHtml(p.client)}</td>
                        <td><span class="badge-tag-royal" style="font-size: 0.75rem;">${escapeHtml(p.category)}</span></td>
                        <td style="color: var(--slate-muted);">${p.year}</td>
                        <td><span class="badge-tag-lime" style="font-size: 0.75rem;">${p.isPublished ? 'Published' : 'Draft'}</span></td>
                        <td style="text-align: right; white-space: nowrap;">
                            <button class="btn-action-edit" data-action="edit" data-entity="portfolio" data-id="${p.id}" onclick="openEditModal('portfolio', '${p.id}')">Edit</button>
                            <button class="btn-action-delete" data-action="delete" data-entity="portfolio" data-id="${p.id}" onclick="deleteRecord('portfolio', '${p.id}')">Hapus</button>
                        </td>
                    </tr>
                `).join('') : '<tr><td colspan="6" style="text-align: center; padding: 30px; color: var(--slate-muted);">Belum ada portofolio di database.</td></tr>';
            }

            if (tab === 'services') {
                const res = await api('/api/admin/services');
                window.cacheData.services = res.data || [];
                const tb = document.querySelector('#table-services tbody');
                tb.innerHTML = (res.data && res.data.length) ? res.data.map(s => `
                    <tr>
                        <td>
                            <div style="width: 32px; height: 32px; border-radius: 8px; background: rgba(33,82,207,0.2); color: var(--royal-blue); display: flex; align-items: center; justify-content: center;">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="12 2 2 7 12 12 22 7 12 2"></polygon><polyline points="2 17 12 22 22 17"></polyline><polyline points="2 12 12 12 22 12"></polyline></svg>
                            </div>
                        </td>
                        <td style="font-weight: 700; color: #ffffff;">${escapeHtml(s.title)}</td>
                        <td style="color: var(--lime-accent); font-weight: 700;">${escapeHtml(s.startingPrice || '-')}</td>
                        <td><span class="badge-tag-lime" style="font-size: 0.75rem;">${s.isPublished !== false ? 'Published' : 'Draft'}</span></td>
                        <td style="text-align: right; white-space: nowrap;">
                            <button class="btn-action-edit" data-action="edit" data-entity="services" data-id="${s.id}" onclick="openEditModal('services', '${s.id}')">Edit</button>
                            <button class="btn-action-delete" data-action="delete" data-entity="services" data-id="${s.id}" onclick="deleteRecord('services', '${s.id}')">Hapus</button>
                        </td>
                    </tr>
                `).join('') : '<tr><td colspan="5" style="text-align: center; padding: 30px; color: var(--slate-muted);">Belum ada data layanan di database.</td></tr>';
            }

            if (tab === 'pricing') {
                const res = await api('/api/admin/pricing');
                window.cacheData.pricing = res.data || [];
                const tb = document.querySelector('#table-pricing tbody');
                tb.innerHTML = (res.data && res.data.length) ? res.data.map(pkg => `
                    <tr>
                        <td style="font-weight: 700; color: #ffffff;">${escapeHtml(pkg.name)}</td>
                        <td style="color: var(--lime-accent); font-weight: 700;">${escapeHtml(pkg.price)}</td>
                        <td>${pkg.isFeatured ? '<span class="badge-tag-lime" style="font-size: 0.75rem;">Populer</span>' : '<span style="color: var(--slate-muted); font-size: 0.85rem;">Standar</span>'}</td>
                        <td><span class="badge-tag-lime" style="font-size: 0.75rem;">${pkg.isPublished !== false ? 'Published' : 'Draft'}</span></td>
                        <td style="text-align: right; white-space: nowrap;">
                            <button class="btn-action-edit" data-action="edit" data-entity="pricing" data-id="${pkg.id}" onclick="openEditModal('pricing', '${pkg.id}')">Edit</button>
                            <button class="btn-action-delete" data-action="delete" data-entity="pricing" data-id="${pkg.id}" onclick="deleteRecord('pricing', '${pkg.id}')">Hapus</button>
                        </td>
                    </tr>
                `).join('') : '<tr><td colspan="5" style="text-align: center; padding: 30px; color: var(--slate-muted);">Belum ada paket harga di database.</td></tr>';
            }

            if (tab === 'testimonials') {
                const res = await api('/api/admin/testimonials');
                window.cacheData.testimonials = res.data || [];
                const tb = document.querySelector('#table-testimonials tbody');
                tb.innerHTML = (res.data && res.data.length) ? res.data.map(t => `
                    <tr>
                        <td style="font-weight: 700; color: #ffffff;">${escapeHtml(t.name)}</td>
                        <td style="color: var(--slate-muted);">${escapeHtml(t.role)} &bull; ${escapeHtml(t.company || '')}</td>
                        <td style="color: #fbbf24; font-weight: 700;">${'★'.repeat(t.rating || 5)}</td>
                        <td style="max-width: 300px; font-size: 0.85rem; line-height: 1.5; color: var(--slate-body);">${escapeHtml(t.content)}</td>
                        <td><span class="badge-tag-lime" style="font-size: 0.75rem;">${t.isPublished !== false ? 'Published' : 'Draft'}</span></td>
                        <td style="text-align: right; white-space: nowrap;">
                            <button class="btn-action-edit" data-action="edit" data-entity="testimonials" data-id="${t.id}" onclick="openEditModal('testimonials', '${t.id}')">Edit</button>
                            <button class="btn-action-delete" data-action="delete" data-entity="testimonials" data-id="${t.id}" onclick="deleteRecord('testimonials', '${t.id}')">Hapus</button>
                        </td>
                    </tr>
                `).join('') : '<tr><td colspan="6" style="text-align: center; padding: 30px; color: var(--slate-muted);">Belum ada testimoni klien di database.</td></tr>';
            }

            if (tab === 'faq') {
                const res = await api('/api/admin/faq');
                window.cacheData.faq = res.data || [];
                const tb = document.querySelector('#table-faq tbody');
                tb.innerHTML = (res.data && res.data.length) ? res.data.map(f => `
                    <tr>
                        <td style="font-weight: 700; color: #ffffff;">${escapeHtml(f.question)}</td>
                        <td style="color: var(--slate-muted); font-size: 0.85rem; max-width: 320px;">${escapeHtml(f.answer)}</td>
                        <td style="text-align: right; white-space: nowrap;">
                            <button class="btn-action-edit" data-action="edit" data-entity="faq" data-id="${f.id}" onclick="openEditModal('faq', '${f.id}')">Edit</button>
                            <button class="btn-action-delete" data-action="delete" data-entity="faq" data-id="${f.id}" onclick="deleteRecord('faq', '${f.id}')">Hapus</button>
                        </td>
                    </tr>
                `).join('') : '<tr><td colspan="3" style="text-align: center; padding: 30px; color: var(--slate-muted);">Belum ada data FAQ di database.</td></tr>';
            }

            if (tab === 'settings') {
                const res = await api('/api/admin/settings');
                if (res.data) {
                    document.getElementById('set-siteName').value = res.data.siteName || '';
                    document.getElementById('set-brandName').value = res.data.brandName || '';
                    document.getElementById('set-tagline').value = res.data.tagline || '';
                    document.getElementById('set-email').value = res.data.email || '';
                    document.getElementById('set-whatsapp').value = res.data.whatsapp || '';
                    document.getElementById('set-address').value = res.data.address || '';
                    document.getElementById('set-seoTitle').value = res.data.defaultSeoTitle || '';
                    document.getElementById('set-seoDesc').value = res.data.defaultSeoDescription || '';
                }
            }
        }

        // CRUD Handler for POST & PUT
        async function handleFormSubmit(e, endpoint) {
            e.preventDefault();
            const form = e.target;
            const payload = Object.fromEntries(new FormData(form).entries());
            const id = payload.id;

            if (payload.isPublished !== undefined) payload.isPublished = payload.isPublished === 'true';
            if (payload.isFeatured !== undefined) payload.isFeatured = payload.isFeatured === 'true';
            if (payload.rating) payload.rating = parseInt(payload.rating, 10);
            if (payload.year) payload.year = parseInt(payload.year, 10);

            // If features string, split into clean array
            if (payload.features && typeof payload.features === 'string') {
                payload.features = payload.features.split(',').map(f => f.trim()).filter(Boolean);
            }

            const method = id ? 'PUT' : 'POST';
            const url = id ? `/api/admin/${endpoint}/${id}` : `/api/admin/${endpoint}`;

            // Remove empty id on create
            if (!id) delete payload.id;

            try {
                await api(url, method, payload);
                showToast(id ? 'Perubahan berhasil disimpan!' : 'Data baru berhasil ditambahkan!', 'success');
                closeModal(`modal-${endpoint}`);
                loadData(endpoint);
            } catch (err) {}
        }

        // Delete Record
        async function deleteRecord(endpoint, id) {
            if (!confirm('Yakin ingin menghapus data ini secara permanen?')) return;
            try {
                await api(`/api/admin/${endpoint}/${id}`, 'DELETE');
                showToast('Data berhasil dihapus.', 'success');
                loadData(endpoint);
            } catch (err) {}
        }

        // Settings Submit
        document.getElementById('form-settings').addEventListener('submit', async (e) => {
            e.preventDefault();
            const payload = Object.fromEntries(new FormData(e.target).entries());
            try {
                await api('/api/admin/settings', 'PUT', payload);
                showToast('Pengaturan global berhasil disimpan!', 'success');
            } catch (err) {}
        });

        // Logout
        async function handleLogout() {
            if (!confirm('Akhiri sesi admin Anda sekarang?')) return;
            try {
                await api('/admin/logout', 'POST');
                window.location.href = '/admin-login';
            } catch (err) {}
        }

        // Safe HTML String Escape
        function escapeHtml(str) {
            if (!str) return '';
            return String(str)
                .replace(/&/g, '&amp;')
                .replace(/</g, '&lt;')
                .replace(/>/g, '&gt;')
                .replace(/"/g, '&quot;')
                .replace(/'/g, '&#039;');
        }

        // Initialize & Event Bindings
        document.addEventListener('DOMContentLoaded', () => {
            loadData('leads');

            // Mobile Drawer Toggle
            const menuToggle = document.getElementById('admin-menu-toggle');
            const sidebar = document.querySelector('.admin-sidebar-kalana');
            const drawerOverlay = document.getElementById('admin-drawer-overlay');

            if (menuToggle && sidebar && drawerOverlay) {
                menuToggle.addEventListener('click', () => {
                    sidebar.classList.toggle('active');
                    drawerOverlay.classList.toggle('active');
                });

                drawerOverlay.addEventListener('click', () => {
                    sidebar.classList.remove('active');
                    drawerOverlay.classList.remove('active');
                });
            }

            // Close drawer when clicking nav items on mobile
            document.querySelectorAll('.admin-nav-item').forEach(item => {
                item.addEventListener('click', () => {
                    if (sidebar && drawerOverlay && window.innerWidth <= 1024) {
                        sidebar.classList.remove('active');
                        drawerOverlay.classList.remove('active');
                    }
                });
            });

            // Close modal when clicking outside card (on overlay backdrop)
            document.querySelectorAll('.modal-overlay-kalana').forEach(overlay => {
                overlay.addEventListener('click', (e) => {
                    if (e.target === overlay) {
                        closeModal(overlay.id);
                    }
                });
            });

            // Delegated click handler for Edit and Delete action buttons
            document.addEventListener('click', (e) => {
                const btn = e.target.closest('button[data-action]');
                if (!btn) return;
                const action = btn.getAttribute('data-action');
                const entity = btn.getAttribute('data-entity');
                const id = btn.getAttribute('data-id');

                if (action === 'edit' && entity && id) {
                    e.preventDefault();
                    openEditModal(entity, id);
                } else if (action === 'delete' && entity && id) {
                    e.preventDefault();
                    deleteRecord(entity, id);
                }
            });

            // Escape key closes modals & drawer
            document.addEventListener('keydown', (e) => {
                if (e.key === 'Escape') {
                    document.querySelectorAll('.modal-overlay-kalana.active').forEach(m => closeModal(m.id));
                    if (sidebar && drawerOverlay) {
                        sidebar.classList.remove('active');
                        drawerOverlay.classList.remove('active');
                    }
                }
            });
        });

        // Global functions exposure
        window.openModal = openModal;
        window.closeModal = closeModal;
        window.openEditModal = openEditModal;
        window.deleteRecord = deleteRecord;
        window.handleLogout = handleLogout;
        window.handleFormSubmit = handleFormSubmit;
        window.showToast = showToast;
        window.loadData = loadData;
    </script>
</body>
</html>
