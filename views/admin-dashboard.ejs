        function copyText(text, successMsg) {
            if (navigator.clipboard && navigator.clipboard.writeText) {
                navigator.clipboard.writeText(text).then(() => {
                    showToast(successMsg, 'success');
                }).catch(() => {
                    prompt('Salin teks berikut:', text);
                });
            } else {
                prompt('Salin teks berikut:', text);
            }
