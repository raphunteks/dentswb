    <!-- Toast Notifications -->
    <div class="toast-box" id="toast-container"></div>

    <script>
        // Global in-memory cache for fast pre-filling during Edit
        window.cacheData = {
            leads: [],
            portfolio: [],
            articles: [],
            services: [],
            pricing: [],
            testimonials: [],
            faq: [],
            livechat: []
        };

        // UI Helpers
        function showToast(message, type = 'success') {
            const container = document.getElementById('toast-container');
            const toast = document.createElement('div');
            toast.className = `toast-item ${type === 'success' ? 'toast-success' : 'toast-error'}`;
            toast.textContent = message;
            container.appendChild(toast);
            setTimeout(() => toast.remove(), 3500);
        }

        // Client-side Canvas Image Compressor (PNG, JPG, WEBP, HEIC to WebP/JPEG Base64)
        function compressImage(file, maxWidth = 1600, quality = 0.82) {
            return new Promise((resolve, reject) => {
                if (!file || !file.type.startsWith('image/')) {
                    return reject(new Error('File yang dipilih bukan berkas gambar valid.'));
                }
                const reader = new FileReader();
                reader.onload = function(e) {
                    const img = new Image();
                    img.onload = function() {
                        let width = img.width;
                        let height = img.height;
                        if (width > maxWidth) {
                            height = Math.round((height * maxWidth) / width);
                            width = maxWidth;
                        }
                        const canvas = document.createElement('canvas');
                        canvas.width = width;
                        canvas.height = height;
                        const ctx = canvas.getContext('2d');
                        ctx.drawImage(img, 0, 0, width, height);

                        let dataUrl = canvas.toDataURL('image/webp', quality);
                        if (!dataUrl.startsWith('data:image/webp')) {
                            dataUrl = canvas.toDataURL('image/jpeg', quality);
                        }
                        resolve(dataUrl);
                    };
                    img.onerror = () => reject(new Error('Gagal memproses berkas gambar.'));
                    img.src = e.target.result;
                };
                reader.onerror = () => reject(new Error('Gagal membaca berkas.'));
                reader.readAsDataURL(file);
            });
        }

        // Image Dropzone Setup
        function setupDropzone(dropzoneId, fileInputId, previewBoxId, previewImgId, hiddenInputId, removeBtnId) {
            const dropzone = document.getElementById(dropzoneId);
            const fileInput = document.getElementById(fileInputId);
            const previewBox = document.getElementById(previewBoxId);
            const previewImg = document.getElementById(previewImgId);
            const hiddenInput = document.getElementById(hiddenInputId);
            const removeBtn = document.getElementById(removeBtnId);

            if (!dropzone || !fileInput || !previewBox || !previewImg || !hiddenInput) return;

            function handleFile(file) {
                if (!file) return;
                showToast('Mengompres gambar ke format WebP...', 'success');
                compressImage(file)
                    .then(dataUrl => {
                        hiddenInput.value = dataUrl;
                        previewImg.src = dataUrl;
                        previewBox.classList.add('active');
                        showToast('Gambar berhasil diunggah & dikompres!', 'success');
                    })
                    .catch(err => {
                        showToast(err.message, 'error');
                    });
            }

            fileInput.addEventListener('change', (e) => {
                if (e.target.files && e.target.files[0]) {
                    handleFile(e.target.files[0]);
                }
            });

            ['dragenter', 'dragover'].forEach(evt => {
                dropzone.addEventListener(evt, (e) => {
                    e.preventDefault();
                    e.stopPropagation();
                    dropzone.classList.add('dragover');
                });
            });

            ['dragleave', 'drop'].forEach(evt => {
                dropzone.addEventListener(evt, (e) => {
                    e.preventDefault();
                    e.stopPropagation();
                    dropzone.classList.remove('dragover');
                });
            });

            dropzone.addEventListener('drop', (e) => {
                if (e.dataTransfer.files && e.dataTransfer.files[0]) {
                    handleFile(e.dataTransfer.files[0]);
                }
            });

            if (removeBtn) {
                removeBtn.addEventListener('click', (e) => {
                    e.stopPropagation();
                    hiddenInput.value = '';
                    previewImg.src = '';
                    previewBox.classList.remove('active');
                    fileInput.value = '';
                });
            }

            hiddenInput.addEventListener('input', (e) => {
                const val = e.target.value.trim();
                if (val) {
                    previewImg.src = val;
                    previewBox.classList.add('active');
                } else {
                    previewBox.classList.remove('active');
                }
            });
        }

        // Tech Stack Multi-Selector Controller (116 Authentic Brand SVGs)
        let selectedTechTools = new Set();

        function initTechSelector() {
            const grid = document.getElementById('tech-grid-portfolio');
            const searchInput = document.getElementById('tech-search-portfolio');
            const tabBtns = document.querySelectorAll('#tech-tabs-portfolio .tech-tab-btn');
            const countEl = document.getElementById('tech-count-portfolio');
            const chipsEl = document.getElementById('tech-chips-portfolio');
            const hiddenInput = document.getElementById('input-tools-portfolio');

            if (!grid || !window.TECH_CATALOG) return;

            let currentCategory = 'all';
            let searchQuery = '';

            function renderTools() {
                const filtered = window.TECH_CATALOG.filter(t => {
                    const matchesCat = (currentCategory === 'all' || t.category === currentCategory);
                    const matchesSearch = (!searchQuery || 
                        t.name.toLowerCase().includes(searchQuery) || 
                        t.desc.toLowerCase().includes(searchQuery)
                    );
                    return matchesCat && matchesSearch;
                });

                if (!filtered.length) {
                    grid.innerHTML = '<div style="grid-column: 1/-1; text-align: center; color: #64748b; padding: 20px; font-size: 0.85rem;">Tidak ada tools yang cocok dengan pencarian.</div>';
                    return;
                }

                grid.innerHTML = filtered.map(t => {
                    const isSelected = selectedTechTools.has(t.id);
                    return `
                        <div class="tech-tool-card ${isSelected ? 'selected' : ''}" data-id="${t.id}" title="${t.name}: ${t.desc}">
                            <input type="checkbox" class="tech-tool-checkbox" ${isSelected ? 'checked' : ''} onclick="event.stopPropagation(); toggleTool('${t.id}')">
                            <div class="tech-tool-card-icon" style="color: ${t.color};">
                                ${t.svg}
                            </div>
                            <div class="tech-tool-card-info">
                                <div class="tech-tool-card-name">${t.name}</div>
                                <div class="tech-tool-card-desc">${t.desc}</div>
                            </div>
                        </div>
                    `;
                }).join('');

                grid.querySelectorAll('.tech-tool-card').forEach(card => {
                    card.addEventListener('click', () => {
                        const id = card.getAttribute('data-id');
                        toggleTool(id);
                    });
                });
            }

            function updateChips() {
                const arr = Array.from(selectedTechTools);
                if (hiddenInput) hiddenInput.value = arr.join(',');
                if (countEl) countEl.textContent = `${arr.length} dipilih`;

                if (!arr.length) {
                    chipsEl.innerHTML = '<span style="font-size: 0.75rem; color: #64748b; font-style: italic;">Belum ada teknologi yang dipilih.</span>';
                    return;
                }

                chipsEl.innerHTML = arr.map(id => {
                    const tool = window.getTechTool ? window.getTechTool(id) : null;
                    const name = tool ? tool.name : id;
                    return `
                        <span class="tech-chip-item">
                            <span>${name}</span>
                            <button type="button" class="tech-chip-remove" onclick="toggleTool('${id}')">&times;</button>
                        </span>
                    `;
                }).join('');
            }

            window.toggleTool = function(id) {
                if (selectedTechTools.has(id)) {
                    selectedTechTools.delete(id);
                } else {
                    selectedTechTools.add(id);
                }
                updateChips();
                renderTools();
            };

            window.setPortfolioTools = function(toolIds) {
                selectedTechTools.clear();
                if (toolIds) {
                    const arr = Array.isArray(toolIds) ? toolIds : String(toolIds).split(',');
                    arr.map(s => s.trim().toLowerCase()).filter(Boolean).forEach(id => selectedTechTools.add(id));
                }
                updateChips();
                renderTools();
            };

            tabBtns.forEach(btn => {
                btn.addEventListener('click', () => {
                    tabBtns.forEach(b => b.classList.remove('active'));
                    btn.classList.add('active');
                    currentCategory = btn.getAttribute('data-cat');
                    renderTools();
                });
            });

            searchInput.addEventListener('input', (e) => {
                searchQuery = e.target.value.trim().toLowerCase();
                renderTools();
            });

            renderTools();
            updateChips();
        }

        // Slug Auto Generator Helper
        function setupSlugAutoGenerator(titleId, slugId) {
            const titleEl = document.getElementById(titleId);
            const slugEl = document.getElementById(slugId);
            if (!titleEl || !slugEl) return;
            titleEl.addEventListener('input', () => {
                if (!slugEl.dataset.manual) {
                    slugEl.value = titleEl.value
                        .toLowerCase()
                        .trim()
                        .replace(/[^\w\s-]/g, '')
                        .replace(/[\s_-]+/g, '-')
                        .replace(/^-+|-+$/g, '');
                }
            });
            slugEl.addEventListener('input', () => {
                slugEl.dataset.manual = 'true';
            });
        }

        function openModal(id) { 
            const m = document.getElementById(id);
            if (!m) return;
            const form = m.querySelector('form');
            if (form) {
                form.reset();
                const idInput = form.querySelector('input[name="id"]');
                if (idInput) idInput.value = '';
            }
            
            // Clear dropzone previews & tools on new create
            if (id === 'modal-portfolio') {
                const previewBox = document.getElementById('preview-box-portfolio');
                if (previewBox) previewBox.classList.remove('active');
                if (window.setPortfolioTools) window.setPortfolioTools([]);
                const slugInput = document.getElementById('port-slug');
                if (slugInput) delete slugInput.dataset.manual;
            } else if (id === 'modal-articles') {
                const previewBox = document.getElementById('preview-box-articles');
                if (previewBox) previewBox.classList.remove('active');
                const slugInput = document.getElementById('art-slug');
                if (slugInput) delete slugInput.dataset.manual;
            } else if (id === 'modal-testimonials') {
                const previewBox = document.getElementById('preview-box-testimonials');
                const previewImg = document.getElementById('preview-img-testimonials');
                if (previewBox) previewBox.classList.remove('active');
                if (previewImg) previewImg.src = '';
            }

            // Set title back to Add
            const entity = id.replace('modal-', '');
            const titleEl = document.getElementById(`modal-title-${entity}`);
            if (titleEl) {
                const entityNames = {
                    portfolio: 'Portofolio Proyek',
                    articles: 'Artikel & Materi',
                    services: 'Layanan',
                    pricing: 'Paket Harga',
                    testimonials: 'Testimoni Klien',
                    faq: 'FAQ'
                };
                titleEl.textContent = `Tambah ${entityNames[entity] || entity}`;
            }
            m.classList.add('active');
            m.style.display = 'flex'; 
        }

        function closeModal(id) { 
            const m = document.getElementById(id);
            if (m) {
                m.classList.remove('active');
                m.style.display = 'none'; 
                const form = m.querySelector('form');
                if (form) {
