                const res = await api('/api/admin/customers');
                window.cacheData.customers = res.data || [];
                renderCustomerTable(window.cacheData.customers);
                updateCustomerDropdown();
            } catch (e) {
                console.error('loadCustomers error:', e);
            }
        }

