        // Live Fee Estimation with Debounce
        function updateLiveFeeEstimation() {
            clearTimeout(feeEstimateTimeout);
            feeEstimateTimeout = setTimeout(async () => {
                const amountInput = document.getElementById('pakasir-amount');
                const methodSelect = document.getElementById('pakasir-method');
                if (!amountInput || !methodSelect) return;

                const amount = parseInt(amountInput.value, 10) || 0;
                const method = methodSelect.value;
                const methodName = methodSelect.options[methodSelect.selectedIndex]?.text || method;

                const previewMethod = document.getElementById('preview-method-name');
                const previewNominal = document.getElementById('preview-nominal');
                const previewFee = document.getElementById('preview-fee');
                const previewTotal = document.getElementById('preview-total');

                if (previewMethod) previewMethod.textContent = methodName.split('[')[0].trim();
                if (previewNominal) previewNominal.textContent = `Rp ${amount.toLocaleString('id-ID')}`;

                if (amount <= 0) {
                    if (previewFee) previewFee.textContent = '-';
                    if (previewTotal) previewTotal.textContent = 'Rp 0';
                    return;
                }

                try {
                    const res = await api(`/api/admin/pakasir/fee-calculator?amount=${amount}`);
                    if (res && res.data) {
                        const fee = res.data[method] !== undefined ? res.data[method] : (method === 'qris' ? Math.round(amount * 0.007) : 3500);
                        const total = amount + fee;
                        if (previewFee) previewFee.textContent = `+ Rp ${fee.toLocaleString('id-ID')}`;
                        if (previewTotal) previewTotal.textContent = `Rp ${total.toLocaleString('id-ID')}`;
                    }
                } catch (e) {
                    // Fallback local estimation if offline
                    let estFee = 0;
                    if (method === 'qris') estFee = Math.round(amount * 0.007);
                    else if (method.endsWith('_va')) estFee = (method === 'artha_graha_va' || method === 'sampoerna_va') ? 2000 : 3500;
                    else estFee = 2500;
                    if (previewFee) previewFee.textContent = `~ Rp ${estFee.toLocaleString('id-ID')}`;
                    if (previewTotal) previewTotal.textContent = `Rp ${(amount + estFee).toLocaleString('id-ID')}`;
                }
            }, 300);
        }

        // Load All Pakasir Data
        async function loadPakasirData() {
            try {
                const [txnsRes, configRes, whRes] = await Promise.allSettled([
                    api('/api/admin/pakasir/transactions'),
                    api('/api/admin/pakasir/config'),
                    api('/api/admin/pakasir/webhook-logs')
                ]);

                if (txnsRes.status === 'fulfilled' && txnsRes.value?.data) {
                    window.cacheData.pakasir = txnsRes.value.data;
                    renderPakasirHistory(window.cacheData.pakasir);
                }

                if (whRes.status === 'fulfilled' && whRes.value?.data) {
                    window.cacheData.pakasir_wh = whRes.value.data;
                    const whCountEl = document.getElementById('pakasir-wh-count');
                    if (whCountEl) whCountEl.textContent = window.cacheData.pakasir_wh.length;
                    renderPakasirWebhookTable(window.cacheData.pakasir_wh);
                }

                if (configRes.status === 'fulfilled' && configRes.value?.data) {
                    const cfg = configRes.value.data;
                    const slugEl = document.getElementById('pakasir-cfg-slug');
                    const keyEl = document.getElementById('pakasir-cfg-apikey');
                    const secretEl = document.getElementById('pakasir-cfg-secret');
                    const urlPreviewEl = document.getElementById('pakasir-cfg-url-preview');
                    const urlDisplayEl = document.getElementById('pakasir-webhook-url-display');

                    if (slugEl) slugEl.value = cfg.slug || '';
                    if (keyEl) keyEl.value = cfg.apiKey || '';
                    if (secretEl) secretEl.value = cfg.webhookSecret || '';
                    if (urlPreviewEl) urlPreviewEl.value = cfg.webhookUrl || '';
                    if (urlDisplayEl) urlDisplayEl.value = cfg.webhookUrl || '';
                }
            } catch (err) {
                console.error('Error loading Pakasir data:', err);
            }
        }

        // Render History Table & Metric Cards
        function renderPakasirHistory(list) {
            const data = Array.isArray(list) ? list : [];
            let totalOmzet = 0;
            let countCompleted = 0;
            let countPending = 0;
            let countCanceled = 0;

            data.forEach(t => {
                const st = (t.status || '').toLowerCase();
                if (st === 'completed') {
                    countCompleted++;
                    totalOmzet += (Number(t.amount) || 0);
                } else if (st === 'pending') {
                    countPending++;
                } else if (st === 'canceled') {
                    countCanceled++;
                }
            });

            // Update stats
            const omzetEl = document.getElementById('pakasir-stat-omzet');
            const totalEl = document.getElementById('pakasir-stat-total');
            const compEl = document.getElementById('pakasir-stat-completed');
            const pendEl = document.getElementById('pakasir-stat-pending');
            const cancEl = document.getElementById('pakasir-stat-canceled');

            if (omzetEl) omzetEl.textContent = `Rp ${totalOmzet.toLocaleString('id-ID')}`;
            if (totalEl) totalEl.textContent = data.length;
            if (compEl) compEl.textContent = countCompleted;
            if (pendEl) pendEl.textContent = countPending;
            if (cancEl) cancEl.textContent = countCanceled;

            // Update filter counts
            const cntAll = document.getElementById('count-hist-all');
            const cntComp = document.getElementById('count-hist-completed');
            const cntPend = document.getElementById('count-hist-pending');
            const cntCanc = document.getElementById('count-hist-canceled');
            if (cntAll) cntAll.textContent = data.length;
            if (cntComp) cntComp.textContent = countCompleted;
            if (cntPend) cntPend.textContent = countPending;
            if (cntCanc) cntCanc.textContent = countCanceled;

            // Filter by active status
            let filtered = data;
            if (window.pakasirCurrentFilter && window.pakasirCurrentFilter !== 'all') {
                filtered = data.filter(t => (t.status || '').toLowerCase() === window.pakasirCurrentFilter);
            }

            const tb = document.querySelector('#table-pakasir tbody');
            if (!tb) return;

            if (!filtered.length) {
                tb.innerHTML = '<tr><td colspan="7" style="text-align: center; padding: 30px; color: var(--slate-muted);">Tidak ada transaksi yang cocok.</td></tr>';
                return;
            }

            tb.innerHTML = filtered.map(t => {
                const st = (t.status || 'pending').toLowerCase();
                let badgeClass = 'badge-status-pending';
                let badgeText = 'PENDING';
                if (st === 'completed') { badgeClass = 'badge-status-completed'; badgeText = 'COMPLETED'; }
                else if (st === 'canceled') { badgeClass = 'badge-status-canceled'; badgeText = 'CANCELED'; }

                const isSandboxBadge = t.is_sandbox ? `<span style="font-size:0.65rem; background:rgba(59,130,246,0.2); color:#60a5fa; border:1px solid rgba(59,130,246,0.3); padding:1px 5px; border-radius:4px; margin-left:4px;">SANDBOX</span>` : '';
                const dateStr = t.createdAt ? new Date(t.createdAt).toLocaleString('id-ID', { dateStyle: 'short', timeStyle: 'short' }) : '-';

                return `
                    <tr>
                        <td style="color: var(--slate-muted); font-size: 0.82rem; white-space: nowrap;">${dateStr}</td>
                        <td>
                            <strong style="color: #ffffff; font-family: monospace; font-size: 0.88rem;">${escapeHtml(t.order_id || '-')}</strong>
                            <div style="font-size: 0.72rem; color: var(--slate-muted); font-family: monospace;">Txn: ${escapeHtml(t.txn_id || '-')}</div>
                        </td>
                        <td>
                            <span class="badge-tag-royal" style="font-size: 0.75rem; font-weight: 700;">${escapeHtml(t.method_name || t.method || '-')}</span>
                        </td>
                        <td>
                            <strong style="color: var(--lime-bright); font-size: 0.95rem;">Rp ${(t.amount || 0).toLocaleString('id-ID')}</strong>
                            ${t.fee ? `<div style="font-size:0.72rem; color:var(--slate-muted);">Fee: Rp ${t.fee.toLocaleString('id-ID')}</div>` : ''}
                        </td>
                        <td>
                            <span class="${badgeClass}">${badgeText}</span>
                            ${isSandboxBadge}
                        </td>
                        <td style="font-size: 0.82rem; color: var(--slate-muted); max-width: 180px;">
                            ${t.customer_name ? `<div style="color:#ffffff; font-weight:600;">${escapeHtml(t.customer_name)}</div>` : ''}
                            ${t.customer_email ? `<div style="font-size:0.72rem; color:#38bdf8; word-break:break-all;">${escapeHtml(t.customer_email)}</div>` : ''}
                            ${t.notes ? `<div style="font-size:0.75rem; line-height:1.3; margin-top:2px;">${escapeHtml(t.notes)}</div>` : (!t.customer_name && !t.customer_email ? '-' : '')}
                            ${t.completionEmailSent ? `<div style="font-size:0.7rem; color:#4ade80; margin-top:3px; display:inline-flex; align-items:center; gap:3px;">🧾 Bukti Lunas Terkirim</div>` : (t.emailSent ? `<div style="font-size:0.7rem; color:#38bdf8; margin-top:3px; display:inline-flex; align-items:center; gap:3px;">✉️ Terkirim ke Email</div>` : '')}
                        </td>
                        <td style="text-align: right; white-space: nowrap;">
                            <button type="button" class="btn-royal" onclick="openPakasirModalById('${t.id}')" style="padding: 5px 10px; font-size: 0.8rem; margin-right: 4px;">Lihat / Bayar</button>
                            <button type="button" class="btn-ghost-white" onclick="checkPakasirStatus('${t.id}')" title="Cek Status Realtime" style="padding: 5px 8px; font-size: 0.8rem; margin-right: 4px;">🔄</button>
                            ${st === 'pending' ? `<button type="button" class="btn-action-delete" onclick="cancelPakasirTxn('${t.id}')" title="Batalkan Transaksi" style="padding: 5px 8px; font-size: 0.8rem; margin-right: 4px;">Batalkan</button>` : ''}
                            <button type="button" class="btn-action-delete" onclick="deletePakasirTxn('${t.id}')" title="Hapus Riwayat Lokal" style="padding: 5px 8px; font-size: 0.8rem;">🗑️</button>
                        </td>
                    </tr>
                `;
            }).join('');
        }

        function filterPakasirHistory(status, btnEl) {
            window.pakasirCurrentFilter = status;
            document.querySelectorAll('#pakasir-view-history .btn-subnav').forEach(b => b.classList.remove('active'));
