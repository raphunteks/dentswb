                        ${qrImgUrl ? `<img src="${qrImgUrl}" alt="QRIS QR Code" style="width: 220px; height: 220px; display: block; margin: 0 auto 10px auto; border-radius: 8px;">` : '<div style="padding: 40px; color:#64748b;">QR Code tidak tersedia</div>'}
                        <div style="font-size: 0.75rem; color: #475569; font-weight: 600;">Scan dengan GoPay, OVO, Dana, ShopeePay, BCA, Mandiri, BRI, dll.</div>
                    </div>
                    <div style="display: flex; gap: 8px; justify-content: center; flex-wrap: wrap;">
                        ${qrString ? `<button type="button" class="btn-ghost-white" onclick="copyText('${escapeHtml(qrString)}', 'String QRIS berhasil disalin!')" style="font-size: 0.8rem; padding: 6px 12px;">📋 Salin String QR</button>` : ''}
                        ${qrImgUrl ? `<a href="${qrImgUrl}" target="_blank" download="QRIS_${txn.order_id}.png" class="btn-ghost-white" style="font-size: 0.8rem; padding: 6px 12px; text-decoration: none;">📥 Unduh QR Image</a>` : ''}
                    </div>
                `;
            } else if (txn.method && txn.method.endsWith('_va')) {
                const vaNumber = txn.va_number || '-';
