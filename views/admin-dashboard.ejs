        async function clearPakasirWebhookLogs() {
            if (!confirm('Bersihkan seluruh catatan log webhook?')) return;
            try {
                const res = await api('/api/admin/pakasir/webhook-logs', 'DELETE');
                if (res && res.success) {
                    showToast('Log webhook dibersihkan.', 'success');
                    await loadPakasirWebhookLogs();
                }
            } catch (e) {}
        }

