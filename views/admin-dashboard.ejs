<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Console | Dents Web</title>
    <meta name="robots" content="noindex, nofollow">
    <link rel="stylesheet" href="/public/css/style.css">
</head>
<body>
    <!-- Topbar for Mobile Admin -->
    <header id="main-header" style="border-bottom: 1px solid var(--glass-border); background: var(--bg-surface);">
        <div class="container nav-container" style="max-width: 100%;">
            <div class="logo"><span class="logo-mark"></span> Console</div>
            <div class="hamburger" id="admin-hamburger"><span></span><span></span><span></span></div>
        </div>
    </header>

    <div class="admin-layout">
        <aside class="admin-sidebar" id="admin-sidebar">
            <div style="margin-bottom: 32px;">
                <div class="tag" style="border-color: var(--success); color: var(--success);">Session Active</div>
            </div>
            <nav class="admin-menu">
                <a class="admin-menu-item active" data-tab="leads">Leads</a>
                <a class="admin-menu-item" data-tab="portfolio">Portfolio</a>
                <a class="admin-menu-item" data-tab="services">Services</a>
                <a class="admin-menu-item" data-tab="pricing">Pricing</a>
                <a class="admin-menu-item" data-tab="faq">FAQ</a>
                <a class="admin-menu-item" data-tab="settings">Settings</a>
                <a class="admin-menu-item" style="color: var(--danger); margin-top: 24px;" onclick="handleLogout()">Logout</a>
            </nav>
        </aside>

        <main class="admin-content">
            <!-- PANEL: LEADS -->
            <div id="panel-leads" class="admin-panel">
                <h2>Incoming Leads</h2>
                <div class="glass-panel table-responsive" style="margin-top: 24px;">
                    <table class="data-table" id="table-leads">
                        <thead><tr><th>Tanggal</th><th>Nama</th><th>WhatsApp</th><th>Status</th><th>Aksi</th></tr></thead>
                        <tbody><tr><td colspan="5">Loading data...</td></tr></tbody>
                    </table>
                </div>
            </div>

            <!-- PANEL: PORTFOLIO -->
            <div id="panel-portfolio" class="admin-panel" style="display: none;">
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px;">
                    <h2>Portfolio</h2>
                    <button class="btn btn-primary" onclick="openModal('modal-portfolio')">+ Add Project</button>
                </div>
                <div class="glass-panel table-responsive">
                    <table class="data-table" id="table-portfolio">
                        <thead><tr><th>Judul</th><th>Klien</th><th>Status</th><th>Aksi</th></tr></thead>
                        <tbody><tr><td colspan="4">Loading data...</td></tr></tbody>
                    </table>
                </div>
            </div>

            <!-- PANEL: SERVICES -->
            <div id="panel-services" class="admin-panel" style="display: none;">
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px;">
                    <h2>Services</h2>
                    <button class="btn btn-primary" onclick="openModal('modal-service')">+ Add Service</button>
                </div>
                <div class="glass-panel table-responsive">
                    <table class="data-table" id="table-services">
                        <thead><tr><th>Layanan</th><th>Harga</th><th>Status</th><th>Aksi</th></tr></thead>
                        <tbody><tr><td colspan="4">Loading data...</td></tr></tbody>
                    </table>
                </div>
            </div>

            <!-- PANEL: PRICING -->
            <div id="panel-pricing" class="admin-panel" style="display: none;">
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px;">
                    <h2>Pricing</h2>
                    <button class="btn btn-primary" onclick="openModal('modal-pricing')">+ Add Package</button>
                </div>
                <div class="glass-panel table-responsive">
                    <table class="data-table" id="table-pricing">
                        <thead><tr><th>Paket</th><th>Harga</th><th>Featured</th><th>Aksi</th></tr></thead>
                        <tbody><tr><td colspan="4">Loading data...</td></tr></tbody>
                    </table>
                </div>
            </div>

            <!-- PANEL: FAQ -->
            <div id="panel-faq" class="admin-panel" style="display: none;">
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px;">
                    <h2>FAQ</h2>
                    <button class="btn btn-primary" onclick="openModal('modal-faq')">+ Add FAQ</button>
                </div>
                <div class="glass-panel table-responsive">
                    <table class="data-table" id="table-faq">
                        <thead><tr><th>Pertanyaan</th><th>Aksi</th></tr></thead>
                        <tbody><tr><td colspan="2">Loading data...</td></tr></tbody>
                    </table>
                </div>
            </div>

            <!-- PANEL: SETTINGS -->
            <div id="panel-settings" class="admin-panel" style="display: none;">
                <h2>Settings</h2>
                <div class="glass-panel glass-panel-p" style="margin-top: 24px; max-width: 600px;">
                    <form id="form-settings">
                        <div class="form-group">
                            <label class="form-label">Site Name</label>
                            <input type="text" class="form-control" name="siteName" id="set-siteName">
                        </div>
                        <div class="form-group">
                            <label class="form-label">Email Kontak</label>
                            <input type="email" class="form-control" name="email" id="set-email">
                        </div>
                        <div class="form-group">
                            <label class="form-label">WhatsApp (+62...)</label>
                            <input type="text" class="form-control" name="whatsapp" id="set-wa">
                        </div>
                        <div class="form-group">
                            <label class="form-label">SEO Title Default</label>
                            <input type="text" class="form-control" name="defaultSeoTitle" id="set-seoTitle">
                        </div>
                        <div class="form-group">
                            <label class="form-label">SEO Description Default</label>
                            <textarea class="form-control" name="defaultSeoDescription" id="set-seoDesc" rows="3"></textarea>
                        </div>
                        <button type="submit" class="btn btn-primary">Save Settings</button>
                    </form>
                </div>
            </div>
        </main>
    </div>

    <!-- PORTFOLIO MODAL -->
    <div class="modal-overlay" id="modal-portfolio">
        <div class="modal-content">
            <h3 style="margin-bottom: 24px;">Project Form</h3>
            <form onsubmit="handleFormSubmit(event, 'portfolio')">
                <input type="hidden" name="id" id="port-id">
                <div class="form-group"><label class="form-label">Title</label><input type="text" class="form-control" name="title" required></div>
                <div class="form-group"><label class="form-label">Slug (URL friendly)</label><input type="text" class="form-control" name="slug" required></div>
                <div class="form-group"><label class="form-label">Client Name</label><input type="text" class="form-control" name="client" required></div>
                <div class="form-group"><label class="form-label">Category</label><input type="text" class="form-control" name="category" required></div>
                <div class="form-group"><label class="form-label">Year</label><input type="number" class="form-control" name="year" required></div>
                <div class="form-group"><label class="form-label">Image URL</label><input type="text" class="form-control" name="image" placeholder="https://..." required></div>
                <div class="form-group"><label class="form-label">Description</label><textarea class="form-control" name="description" rows="4"></textarea></div>
                <div class="form-group">
                    <label class="form-label">Status</label>
                    <select class="form-control" name="isPublished">
                        <option value="true">Published</option>
                        <option value="false">Draft</option>
                    </select>
                </div>
                <div style="display: flex; gap: 16px; margin-top: 32px;">
                    <button type="button" class="btn btn-secondary" onclick="closeModal('modal-portfolio')">Cancel</button>
                    <button type="submit" class="btn btn-primary">Save Project</button>
                </div>
            </form>
        </div>
    </div>

    <!-- TOAST NOTIFICATION -->
    <div class="toast-container" id="toast-container"></div>

    <script>
        // --- UI UTILS ---
        function showToast(message, type = 'success') {
            const container = document.getElementById('toast-container');
            const toast = document.createElement('div');
            toast.className = `toast`;
            toast.style.borderLeftColor = type === 'success' ? 'var(--success)' : 'var(--danger)';
            toast.textContent = message;
            container.appendChild(toast);
            setTimeout(() => toast.remove(), 3000);
        }

        function openModal(id) { document.getElementById(id).style.display = 'flex'; }
        function closeModal(id) { 
            const m = document.getElementById(id);
            m.style.display = 'none'; 
            m.querySelector('form').reset();
            m.querySelector('input[name="id"]').value = '';
        }

        // --- TAB SWITCHER ---
        document.querySelectorAll('.admin-menu-item').forEach(item => {
            if(item.textContent === 'Logout') return;
            item.addEventListener('click', (e) => {
                document.querySelectorAll('.admin-menu-item').forEach(i => i.classList.remove('active'));
                e.target.classList.add('active');
                
                document.querySelectorAll('.admin-panel').forEach(p => p.style.display = 'none');
                const tab = e.target.getAttribute('data-tab');
                document.getElementById(`panel-${tab}`).style.display = 'block';
                
                loadData(tab);
                
                // mobile menu auto close
                if(window.innerWidth <= 768) {
                    document.getElementById('admin-sidebar').style.display = 'none';
                }
            });
        });

        // Mobile menu toggle
        document.getElementById('admin-hamburger').addEventListener('click', () => {
            const sb = document.getElementById('admin-sidebar');
            sb.style.display = sb.style.display === 'block' ? 'none' : 'block';
        });

        // --- CORE API FETCHER ---
        async function api(url, method = 'GET', body = null) {
            const options = { method, headers: { 'Content-Type': 'application/json' } };
            if (body) options.body = JSON.stringify(body);
            try {
                const res = await fetch(url, options);
                if (res.status === 401) { window.location.href = '/admin-login'; return; }
                const data = await res.json();
                if(!res.ok) throw new Error(data.message || 'Server error');
                return data;
            } catch (err) {
                showToast(err.message, 'error');
                throw err;
            }
        }

        // --- DATA LOADERS (KISS approach) ---
        async function loadData(tab) {
            if (tab === 'leads') {
                const res = await api('/api/admin/leads');
                const tb = document.querySelector('#table-leads tbody');
                tb.innerHTML = res.data.length ? res.data.map(l => `
                    <tr>
                        <td>${new Date(l.createdAt).toLocaleDateString('id-ID')}</td>
                        <td>${l.name}</td>
                        <td>${l.whatsapp}</td>
                        <td><span class="tag">${l.status}</span></td>
                        <td><button class="tag" style="background:var(--danger); color:white; border:none;" onclick="deleteRecord('leads', '${l.id}')">Del</button></td>
                    </tr>
                `).join('') : '<tr><td colspan="5">No leads yet.</td></tr>';
            }
            
            if (tab === 'portfolio') {
                const res = await api('/api/admin/portfolio');
                const tb = document.querySelector('#table-portfolio tbody');
                tb.innerHTML = res.data.length ? res.data.map(p => `
                    <tr>
                        <td style="font-weight: 500; color: white;">${p.title}</td>
                        <td>${p.client}</td>
                        <td><span class="tag">${p.isPublished ? 'Published' : 'Draft'}</span></td>
                        <td>
                            <!-- Edit logic omitted for brevity in MVP, implementing delete only -->
                            <button class="tag" style="background:var(--danger); color:white; border:none;" onclick="deleteRecord('portfolio', '${p.id}')">Del</button>
                        </td>
                    </tr>
                `).join('') : '<tr><td colspan="4">No portfolio items.</td></tr>';
            }

            if (tab === 'settings') {
                const res = await api('/api/admin/settings');
                if(res.data) {
                    document.getElementById('set-siteName').value = res.data.siteName || '';
                    document.getElementById('set-email').value = res.data.email || '';
                    document.getElementById('set-wa').value = res.data.whatsapp || '';
                    document.getElementById('set-seoTitle').value = res.data.defaultSeoTitle || '';
                    document.getElementById('set-seoDesc').value = res.data.defaultSeoDescription || '';
                }
            }

            // Implement other tabs (services, pricing, faq) similar to portfolio.
            // Placeholder for demonstration
            ['services', 'pricing', 'faq'].forEach(t => {
                if(tab === t) {
                    const tb = document.querySelector(`#table-${t} tbody`);
                    if(tb) tb.innerHTML = `<tr><td colspan="4">Data loader for ${t} active.</td></tr>`;
                }
            })
        }

        // --- CRUD ACTIONS ---
        async function handleFormSubmit(e, endpoint) {
            e.preventDefault();
            const form = e.target;
            const payload = Object.fromEntries(new FormData(form).entries());
            const id = payload.id;
            
            // convert string to boolean for publish status
            if(payload.isPublished) payload.isPublished = payload.isPublished === 'true';
            
            const method = id ? 'PUT' : 'POST';
            const url = id ? `/api/admin/${endpoint}/${id}` : `/api/admin/${endpoint}`;
            
            try {
                await api(url, method, payload);
                showToast('Success saved!');
                closeModal(`modal-${endpoint}`);
                loadData(endpoint);
            } catch(err) { /* handled by api() */ }
        }

        async function deleteRecord(endpoint, id) {
            if(!confirm('Are you sure you want to delete this record?')) return;
            try {
                await api(`/api/admin/${endpoint}/${id}`, 'DELETE');
                showToast('Record deleted.');
                loadData(endpoint);
            } catch(err) {}
        }

        // --- SETTINGS SUBMIT ---
        document.getElementById('form-settings').addEventListener('submit', async(e) => {
            e.preventDefault();
            const payload = Object.fromEntries(new FormData(e.target).entries());
            try {
                await api('/api/admin/settings', 'PUT', payload);
                showToast('Settings Updated!');
            } catch(err) {}
        });

        // --- AUTH ---
        async function handleLogout() {
            if(!confirm('Logout from secure session?')) return;
            try {
                await api('/admin/logout', 'POST');
                window.location.href = '/admin-login';
            } catch(err) {}
        }

        // Init
        document.addEventListener('DOMContentLoaded', () => loadData('leads'));
    </script>
</body>
</html>