        }

        function copyWebhookUrl() {
            const url = document.getElementById('pakasir-webhook-url-display')?.value || '';
            copyText(url, 'URL Webhook Pakasir berhasil disalin!');
        }

        function copyText(text, successMsg) {
            if (navigator.clipboard && navigator.clipboard.writeText) {
                navigator.clipboard.writeText(text).then(() => {
                    showToast(successMsg, 'success');
                }).catch(() => {
                    prompt('Salin teks berikut:', text);
                });
            } else {
                prompt('Salin teks berikut:', text);
            }
        }

        // Live Fee Calculator Runner
        async function runFeeCalculator() {
            const amountInput = document.getElementById('pakasir-calc-amount-input');
            const tbody = document.getElementById('pakasir-calc-tbody');
            if (!amountInput || !tbody) return;

            const amount = parseInt(amountInput.value, 10);
            if (isNaN(amount) || amount <= 0) {
                showToast('Masukkan nominal valid.', 'error');
                return;
            }

            tbody.innerHTML = '<tr><td colspan="5" style="text-align: center; color: var(--slate-muted); padding: 20px;">Mengambil data kalkulator fee dari Pakasir...</td></tr>';

            const methodNames = {
                qris: 'QRIS (Semua E-Wallet & Bank)',
                payment_link: 'Payment Link Checkout',
                bni_va: 'BNI Virtual Account',
                bri_va: 'BRI Virtual Account',
                cimb_niaga_va: 'CIMB Niaga Virtual Account',
                permata_va: 'Permata Virtual Account',
                maybank_va: 'Maybank Virtual Account',
                bnc_va: 'Bank Neo Commerce (BNC) VA',
                artha_graha_va: 'Artha Graha Virtual Account',
                sampoerna_va: 'Bank Sahabat Sampoerna VA',
                atm_bersama_va: 'ATM Bersama Virtual Account'
            };

            try {
                const res = await api(`/api/admin/pakasir/fee-calculator?amount=${amount}`);
                if (res && res.data) {
                    const rows = Object.entries(res.data).map(([key, fee]) => {
                        const name = methodNames[key] || key;
                        const total = amount + fee;
                        const net = amount;
                        return `
                            <tr>
                                <td style="font-weight: 700; color: #ffffff;">${escapeHtml(name)}</td>
                                <td style="color: var(--slate-muted);">Rp ${amount.toLocaleString('id-ID')}</td>
                                <td style="color: #facc15; font-weight: 600;">+ Rp ${fee.toLocaleString('id-ID')}</td>
                                <td style="color: var(--lime-bright); font-weight: 800;">Rp ${total.toLocaleString('id-ID')}</td>
                                <td style="color: #4ade80;">Rp ${net.toLocaleString('id-ID')}</td>
                            </tr>
                        `;
                    }).join('');
                    tbody.innerHTML = rows;
                }
            } catch (e) {
                tbody.innerHTML = '<tr><td colspan="5" style="text-align: center; color: #f87171; padding: 20px;">Gagal mengambil data kalkulator fee dari server Pakasir.</td></tr>';
            }
        }

        // Save Pakasir Config Submit
        async function handleSavePakasirConfig(e) {
            e.preventDefault();
            const slug = document.getElementById('pakasir-cfg-slug').value.trim();
            const apiKey = document.getElementById('pakasir-cfg-apikey').value.trim();
            const webhookSecret = document.getElementById('pakasir-cfg-secret').value.trim();

            try {
                const res = await api('/api/admin/pakasir/config', 'PUT', { slug, apiKey, webhookSecret });
                if (res && res.success) {
                    showToast('Konfigurasi Pakasir berhasil diperbarui!', 'success');
                    await loadPakasirData();
                }
            } catch (e) {}
        }

