<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="theme-color" content="#05081c">
    
    <!-- DYNAMIC SEO GOLD STANDARD -->
    <title><%= typeof seo !== 'undefined' ? seo.title : 'Investasi Digital & Paket Harga | Dents Web' %></title>
    <meta name="description" content="<%= typeof seo !== 'undefined' ? seo.desc : 'Harga pasti, scope tertulis, dan upgrade tanpa rebuild. Landing page, company profile, e-commerce berkinerja tinggi.' %>">
    <meta name="keywords" content="<%= typeof seo !== 'undefined' ? seo.keywords : 'harga website, paket landing page, harga company profile, jasa web profesional, biaya pembuatan website' %>">
    <link rel="canonical" href="<%= typeof seo !== 'undefined' ? seo.url : 'https://www.dentsweb.my.id/pricing' %>">
    <meta name="referrer" content="origin-when-cross-origin">
    <% if (typeof settings !== 'undefined' && settings.analyticsId) { %>
    <script async src="https://www.googletagmanager.com/gtag/js?id=<%= settings.analyticsId %>"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', '<%= settings.analyticsId %>');
    </script>
    <% } %>
    
    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="article">
    <meta property="og:url" content="<%= typeof seo !== 'undefined' ? seo.url : 'https://www.dentsweb.my.id/pricing' %>">
    <meta property="og:title" content="<%= typeof seo !== 'undefined' ? seo.title : 'Investasi Digital Transparan | Dents Web' %>">
    <meta property="og:description" content="<%= typeof seo !== 'undefined' ? seo.desc : '' %>">
    <meta property="og:image" content="<%= typeof seo !== 'undefined' ? seo.image : '/public/img/axalogo.png' %>">
    
    <!-- Twitter Cards -->
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:url" content="<%= typeof seo !== 'undefined' ? seo.url : 'https://www.dentsweb.my.id/pricing' %>">
    <meta name="twitter:title" content="<%= typeof seo !== 'undefined' ? seo.title : 'Investasi Digital Transparan | Dents Web' %>">
    <meta name="twitter:description" content="<%= typeof seo !== 'undefined' ? seo.desc : '' %>">
    <meta name="twitter:image" content="<%= typeof seo !== 'undefined' ? seo.image : '/public/img/axalogo.png' %>">

    <!-- Schema.org JSON-LD -->
    <% if (typeof seo !== 'undefined' && seo.schemaString) { %>
    <script type="application/ld+json">
        <%- seo.schemaString %>
    </script>
    <% } %>
    
    <link rel="icon" type="image/png" href="<%= typeof settings !== 'undefined' && settings.favicon ? settings.favicon : '/public/img/axalogo.png' %>">
    <link rel="apple-touch-icon" href="<%= typeof settings !== 'undefined' && settings.logo ? settings.logo : '/public/img/axalogo.png' %>">
    
    <!-- Ultra High-Speed Non-Blocking Web Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Lexend+Deca:wght@500;600;700;800&family=Playfair+Display:ital,wght@1,400;1,500;1,600;1,700&family=Plus+Jakarta+Sans:wght@400;500;600;700;800;900&display=swap">
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Lexend+Deca:wght@500;600;700;800&family=Playfair+Display:ital,wght@1,400;1,500;1,600;1,700&family=Plus+Jakarta+Sans:wght@400;500;600;700;800;900&display=swap" media="print" onload="this.media='all'">
    <noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Lexend+Deca:wght@500;600;700;800&family=Playfair+Display:ital,wght@1,400;1,500;1,600;1,700&family=Plus+Jakarta+Sans:wght@400;500;600;700;800;900&display=swap"></noscript>
    
    <link rel="stylesheet" href="/public/css/style.css?v=4.2.1">

    <!-- Agentic Web Discovery (ARD 1.0 & llmstxt.org Gold Standard) -->
    <link rel="ai-catalog" href="/.well-known/ai-catalog.json">
    <link rel="alternate" type="text/markdown" href="/llms.txt" title="Ringkasan Markdown LLM">
    <script src="/public/js/webmcp.js?v=4.2.1" defer></script>

    <!-- GSAP 3 & ScrollTrigger Engine (Deferred) -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js" defer></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/ScrollTrigger.min.js" defer></script>
    <script src="/public/js/animations.js?v=4.2.1" defer></script>
</head>
<body>
    
    <%- include('partials/header') %>

    <main>
        <!-- ==========================================
             PRICING HERO (Philosophy from solvdlayanan.html)
             ========================================== -->
        <section class="section-hero" style="min-height: 52vh; padding-top: 150px; padding-bottom: 60px;">
            <div class="orb-glow-blue" style="top: -10%; left: -5%;"></div>
            <div class="orb-glow-lime" style="bottom: -15%; right: 5%; opacity: 0.12;"></div>

            <div class="container text-center pptx-slide-up" style="position: relative; z-index: 2; max-width: 860px;">
                <div class="badge-tag-lime" style="margin-bottom: 20px;">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg>
                    <span>LAYANAN &amp; HARGA PASTI &bull; NO HIDDEN COST</span>
                </div>
                <h1 style="margin-bottom: 20px; font-size: clamp(2.2rem, 5vw, 3.8rem); line-height: 1.15;">
                    Harga Jelas. Scope Jelas. <span class="font-editorial text-lime">Selesai Cepat.</span>
                </h1>
                <p style="font-size: 1.15rem; color: rgba(255,255,255,0.8); line-height: 1.8; max-width: 740px; margin: 0 auto 28px auto;">
                    Setiap paket punya harga pasti dan cakupan yang tertulis lengkap. Kalau budget terbatas, yang kami sesuaikan cakupannya, bukan margin pengerjaan. Mulai dari Core, upgrade kapan saja tanpa rebuild.
                </p>

                <!-- Value Pillars -->
                <div style="display: flex; gap: 12px; justify-content: center; flex-wrap: wrap;">
                    <span style="background: rgba(255,255,255,0.06); border: 1px solid rgba(255,255,255,0.14); padding: 6px 16px; border-radius: 999px; font-size: 0.85rem; color: rgba(255,255,255,0.9); font-weight: 600;">
                        ✓ Harga Pasti
                    </span>
                    <span style="background: rgba(255,255,255,0.06); border: 1px solid rgba(255,255,255,0.14); padding: 6px 16px; border-radius: 999px; font-size: 0.85rem; color: rgba(255,255,255,0.9); font-weight: 600;">
                        ✓ Scope Tertulis
                    </span>
                    <span style="background: rgba(255,255,255,0.06); border: 1px solid rgba(255,255,255,0.14); padding: 6px 16px; border-radius: 999px; font-size: 0.85rem; color: rgba(255,255,255,0.9); font-weight: 600;">
                        ✓ Upgrade Tanpa Rebuild
                    </span>
                </div>
            </div>
        </section>

        <!-- ==========================================
             PRICING MAIN SECTION WITH CATEGORY TABS
             ========================================== -->
        <section class="section-white" style="padding-top: 50px; padding-bottom: 90px;">
            <div class="container">
                
                <!-- Category Nav Switcher -->
                <nav class="pricing-tab-nav" aria-label="Kategori Pilihan Paket">
                    <button type="button" class="pricing-tab-btn active" onclick="switchPricingCategory('landing-page', this)">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="12" cy="12" r="10"/><circle cx="12" cy="12" r="6"/><circle cx="12" cy="12" r="2"/></svg>
                        Landing Page (1 Halaman)
                    </button>
                    <button type="button" class="pricing-tab-btn" onclick="switchPricingCategory('company-profile', this)">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><rect x="2" y="3" width="20" height="14" rx="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/></svg>
                        Company Profile (5 Halaman)
                    </button>
                    <button type="button" class="pricing-tab-btn" onclick="switchPricingCategory('ecommerce', this)">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/></svg>
                        Toko Online / Shopify
                    </button>
                    <button type="button" class="pricing-tab-btn" onclick="switchPricingCategory('addon', this)">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
                        Add-on &amp; Fitur Tambahan
                    </button>
                </nav>

                <!-- ====================================================
                     PANEL 1: LANDING PAGE (Satu Halaman, Fokus Konversi)
                     ==================================================== -->
                <div id="panel-landing-page" class="pricing-category-panel active" style="display: block;">
                    <div class="text-center" style="max-width: 680px; margin: 0 auto 36px auto;">
                        <span class="badge-tag-royal" style="margin-bottom: 12px; display: inline-block;">FOKUS KONVERSI TINGGI</span>
                        <h2 style="font-size: 2rem; color: var(--navy-text); margin-bottom: 8px;">Landing Page</h2>
                        <p style="color: var(--slate-body); font-size: 1.05rem; line-height: 1.6;">
                            Dirancang untuk peluncuran produk, kampanye iklan berbayar (Meta &amp; Google Ads), serta validasi pasar. Seluruh paket dapat ditingkatkan kapan saja tanpa perlu rebuild dari nol.
                        </p>
                    </div>

                    <!-- 4 Cards Grid for Landing Page -->
                    <div class="grid-4 pricing-grid-4" style="align-items: stretch;">
                        <!-- 1. LP Core -->
                        <div class="pricing-card-kalana pptx-slide-up pptx-stagger-1">
                            <span class="badge-tag-royal" style="font-size: 0.72rem; padding: 2px 10px; margin-bottom: 12px; display: inline-block;">Paket Dasar</span>
                            <div class="pricing-title-box">
                                <h3 style="color: var(--navy-text); font-size: 1.35rem; margin-bottom: 6px;">Core</h3>
                            </div>
                            <div class="pricing-desc-box">
                                Titik masuk. Mulai dari sini, naik paket kapan saja tanpa rebuild.
                            </div>
                            <div class="pricing-price-box">
                                <span style="font-size: 0.72rem; color: var(--slate-muted); font-weight: 800; text-transform: uppercase;">Harga Pasti</span>
                                <div class="price-amount text-navy">Rp 1.300.000</div>
                            </div>
                            <ul class="feature-check-list" style="margin-bottom: 16px;">
                                <li class="feature-check-item"><span class="check-icon-circle"><svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg></span>Satu halaman fokus konversi</li>
                                <li class="feature-check-item"><span class="check-icon-circle"><svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg></span>Upgrade kapan saja tanpa rebuild</li>
                                <li class="feature-check-item"><span class="check-icon-circle"><svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg></span>2x revisi desain</li>
                                <li class="feature-check-item"><span class="check-icon-circle"><svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg></span>Gratis Domain &amp; SSL 1 Tahun</li>
                            </ul>
                            <div style="font-size: 0.78rem; color: var(--slate-muted); background: #f8fafc; padding: 10px 12px; border-radius: 8px; margin-top: auto; border: 1px dashed var(--border-light); line-height: 1.45;">
                                <strong>Add-on tersedia:</strong> Booking System 800K &bull; Panel Admin 700K &bull; Visual 300K/5 foto &bull; Extra Revisi 200K/round
                            </div>
                            <div style="padding-top: 18px;">
                                <a href="/contact?package=Landing%20Page%20Core" class="btn-ghost-navy" style="width: 100%; text-align: center; display: inline-flex; align-items: center; justify-content: center; gap: 8px;">Pilih Paket Ini</a>
                            </div>
                        </div>

                        <!-- 2. LP Premier -->
                        <div class="pricing-card-kalana pptx-slide-up pptx-stagger-2">
                            <span class="badge-tag-royal" style="font-size: 0.72rem; padding: 2px 10px; margin-bottom: 12px; display: inline-block;">CMS Mandiri</span>
                            <div class="pricing-title-box">
                                <h3 style="color: var(--navy-text); font-size: 1.35rem; margin-bottom: 6px;">Premier</h3>
                            </div>
                            <div class="pricing-desc-box">
                                Kelola konten halaman secara mandiri, tanpa nunggu siapa pun.
                            </div>
                            <div class="pricing-price-box">
                                <span style="font-size: 0.72rem; color: var(--slate-muted); font-weight: 800; text-transform: uppercase;">Harga Pasti</span>
                                <div class="price-amount text-navy">Rp 2.100.000</div>
                            </div>
                            <ul class="feature-check-list" style="margin-bottom: 16px;">
                                <li class="feature-check-item"><span class="check-icon-circle"><svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg></span>Panel Admin eksklusif (700K terpisah)</li>
                                <li class="feature-check-item"><span class="check-icon-circle"><svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg></span>Update konten halaman mandiri</li>
                                <li class="feature-check-item"><span class="check-icon-circle"><svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg></span>2x revisi desain</li>
                                <li class="feature-check-item"><span class="check-icon-circle"><svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg></span>Domain, Hosting SSD &amp; SSL 1 Thn</li>
                            </ul>
                            <div style="font-size: 0.78rem; color: var(--slate-muted); background: #f8fafc; padding: 10px 12px; border-radius: 8px; margin-top: auto; border: 1px dashed var(--border-light); line-height: 1.45;">
                                <strong>Add-on tersedia:</strong> Booking System 800K &bull; Visual 300K/5 foto &bull; Extra Revisi 200K/round
                            </div>
                            <div style="padding-top: 18px;">
                                <a href="/contact?package=Landing%20Page%20Premier" class="btn-ghost-navy" style="width: 100%; text-align: center; display: inline-flex; align-items: center; justify-content: center; gap: 8px;">Pilih Paket Ini</a>
                            </div>
                        </div>

                        <!-- 3. LP Signature (Featured) -->
                        <div class="pricing-card-kalana featured pptx-slide-up pptx-stagger-3">
                            <div class="pricing-badge-popular">
                                <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l2.4 7.4h7.6l-6.2 4.5 2.4 7.4-6.2-4.6-6.2 4.6 2.4-7.4-6.2-4.5h7.6z"/></svg>
                                PALING BANYAK DIPILIH
                            </div>
                            <div class="pricing-title-box">
                                <h3 style="color: var(--navy-text); font-size: 1.35rem; margin-bottom: 6px;">Signature</h3>
                            </div>
                            <div class="pricing-desc-box">
                                Booking dan visual sudah di dalam. Dirakit dari fitur terfavorit, hemat 700K.
                            </div>
                            <div class="pricing-price-box">
                                <span style="font-size: 0.72rem; color: var(--slate-muted); font-weight: 800; text-transform: uppercase;">Harga Pasti</span>
                                <div class="price-amount text-royal">Rp 2.000.000</div>
                            </div>
                            <ul class="feature-check-list" style="margin-bottom: 16px;">
                                <li class="feature-check-item"><span class="check-icon-circle"><svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg></span>Booking System (800K kalau terpisah)</li>
                                <li class="feature-check-item"><span class="check-icon-circle"><svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg></span>Visual hingga 10 foto siap pakai</li>
                                <li class="feature-check-item"><span class="check-icon-circle"><svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg></span>2x revisi desain</li>
                                <li class="feature-check-item"><span class="check-icon-circle"><svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg></span>Direct WhatsApp Button teks otomatis</li>
                            </ul>
                            <div style="font-size: 0.78rem; color: var(--slate-muted); background: #f8fafc; padding: 10px 12px; border-radius: 8px; margin-top: auto; border: 1px dashed var(--border-light); line-height: 1.45;">
                                <strong>Add-on tersedia:</strong> Panel Admin 700K &bull; Extra Revisi 200K/round
                            </div>
                            <div style="padding-top: 18px;">
                                <a href="/contact?package=Landing%20Page%20Signature" class="btn-royal" style="width: 100%; text-align: center; display: inline-flex; align-items: center; justify-content: center; gap: 8px;">Pilih Paket Ini</a>
                            </div>
                        </div>

                        <!-- 4. LP Prestige -->
                        <div class="pricing-card-kalana pptx-slide-up pptx-stagger-4">
                            <span class="badge-tag-royal" style="font-size: 0.72rem; padding: 2px 10px; margin-bottom: 12px; display: inline-block;">Paket Lengkap</span>
                            <div class="pricing-title-box">
                                <h3 style="color: var(--navy-text); font-size: 1.35rem; margin-bottom: 6px;">Prestige</h3>
                            </div>
                            <div class="pricing-desc-box">
                                Semua fitur menyala dari hari pertama tanpa perlu add-on tambahan.
                            </div>
                            <div class="pricing-price-box">
                                <span style="font-size: 0.72rem; color: var(--slate-muted); font-weight: 800; text-transform: uppercase;">Harga Pasti</span>
                                <div class="price-amount text-navy">Rp 2.500.000</div>
                            </div>
                            <ul class="feature-check-list" style="margin-bottom: 16px;">
                                <li class="feature-check-item"><span class="check-icon-circle"><svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg></span>Booking System terintegrasi</li>
                                <li class="feature-check-item"><span class="check-icon-circle"><svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg></span>Panel Admin Mandiri</li>
                                <li class="feature-check-item"><span class="check-icon-circle"><svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg></span>Visual hingga 10 foto disiapkan tim</li>
                                <li class="feature-check-item"><span class="check-icon-circle"><svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg></span>3x revisi, 1x lebih banyak</li>
                            </ul>
                            <div style="font-size: 0.78rem; color: var(--slate-muted); background: #f8fafc; padding: 10px 12px; border-radius: 8px; margin-top: auto; border: 1px dashed var(--border-light); line-height: 1.45;">
                                <strong>Add-on tersedia:</strong> Extra round revisi 200K/round
                            </div>
                            <div style="padding-top: 18px;">
                                <a href="/contact?package=Landing%20Page%20Prestige" class="btn-ghost-navy" style="width: 100%; text-align: center; display: inline-flex; align-items: center; justify-content: center; gap: 8px;">Pilih Paket Ini</a>
                            </div>
                        </div>
                    </div>

                    <!-- All Landing Page Packages Include Box -->
                    <div class="pricing-included-box pptx-slide-up">
                        <div style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 12px; border-bottom: 1px solid rgba(255,255,255,0.12); padding-bottom: 18px;">
                            <div>
                                <span class="badge-tag-lime" style="margin-bottom: 6px;">STANDAR KUALITAS TINGGI</span>
                                <h3 style="font-size: 1.45rem; color: #ffffff; margin: 0;">Semua Paket Landing Page Sudah Termasuk:</h3>
                            </div>
                            <span style="font-size: 0.85rem; color: rgba(255,255,255,0.6);">Nol Biaya Tersembunyi</span>
                        </div>
                        <div class="included-grid-list">
                            <div class="included-item"><span style="color: var(--lime-accent);">✓</span> Desain custom sesuai karakter brand</div>
                            <div class="included-item"><span style="color: var(--lime-accent);">✓</span> Responsif di semua perangkat (HP, Tablet, PC)</div>
                            <div class="included-item"><span style="color: var(--lime-accent);">✓</span> Copywriting halaman persuasif oleh tim</div>
                            <div class="included-item"><span style="color: var(--lime-accent);">✓</span> Tampil di hasil pencarian Google (SEO)</div>
                            <div class="included-item"><span style="color: var(--lime-accent);">✓</span> Preview OpenGraph rapi di WA dan medsos</div>
                            <div class="included-item"><span style="color: var(--lime-accent);">✓</span> Konfigurasi tombol WhatsApp &amp; form kontak</div>
                            <div class="included-item"><span style="color: var(--lime-accent);">✓</span> Google Analytics &amp; integrasi domain 1 Thn</div>
                            <div class="included-item"><span style="color: var(--lime-accent);">✓</span> Preview staging sebelum go-live resmi</div>
                        </div>
                    </div>

                    <!-- Transparency Comparison (Mengapa Signature?) -->
                    <div class="tactile-card tactile-card-heavy pptx-scale-in" style="margin-top: 36px; padding: 28px 32px; background: #ffffff;">
                        <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 16px;">
                            <div style="max-width: 620px;">
                                <span class="badge-tag-royal" style="margin-bottom: 8px;">TRANSPARANSI SKEMA BIAYA</span>
