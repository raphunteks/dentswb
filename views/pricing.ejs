<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= seo.title %></title>
    <meta name="description" content="<%= seo.desc %>">
    <link rel="canonical" href="<%= settings.siteUrl %><%= seo.path %>">
    <link rel="stylesheet" href="/public/css/style.css">
</head>
<body>
    <header id="main-header">
        <div class="container nav-container">
            <a href="/" class="logo"><span class="logo-mark"></span><%= settings.siteName || 'Dents Web' %></a>
            <div class="hamburger" id="hamburger-btn"><span></span><span></span><span></span></div>
            <nav class="nav-links" id="nav-links">
                <a href="/">Home</a>
                <a href="/services">Services</a>
                <a href="/portfolio">Portfolio</a>
                <a href="/pricing" class="active">Pricing</a>
                <a href="/about">About</a>
                <a href="/contact">Contact</a>
                <a href="/faq">FAQ</a>
            </nav>
        </div>
    </header>

    <main>
        <section class="section section-pt-hero">
            <div class="container">
                <div class="text-center" style="max-width: 600px; margin: 0 auto 80px;">
                    <h1 style="margin-bottom: 16px;">Investasi Digital</h1>
                    <p>Skema harga transparan tanpa biaya tersembunyi. Pilih paket yang sesuai dengan roadmap bisnis Anda.</p>
                </div>
                
                <div class="grid-3">
                    <% if(pricing && pricing.length > 0) { %>
                        <% pricing.forEach(pkg => { %>
                            <div class="glass-panel glass-panel-p" style="display: flex; flex-direction: column; <%= pkg.isFeatured ? 'border-color: var(--primary); box-shadow: var(--shadow-glow); transform: translateY(-10px);' : '' %>">
                                <% if(pkg.isFeatured) { %>
                                    <div class="tag" style="background: var(--primary); color: var(--bg-base); border: none; margin-bottom: 16px; width: max-content; font-weight: 700;">Rekomendasi</div>
                                <% } %>
                                <h3><%= pkg.name %></h3>
                                <p style="font-size: 0.9rem; min-height: 45px;"><%= pkg.description %></p>
                                <div style="font-size: 2.5rem; font-weight: 700; margin: 24px 0; color: white;">
                                    <%= pkg.price %>
                                </div>
                                <ul style="margin-bottom: 40px; flex: 1; display: flex; flex-direction: column; gap: 12px; color: var(--text-secondary);">
                                    <% pkg.features.forEach(feat => { %>
                                        <li>✓ <%= feat %></li>
                                    <% }) %>
                                </ul>
                                <a href="/contact?package=<%= pkg.name %>" class="btn <%= pkg.isFeatured ? 'btn-primary' : 'btn-secondary' %>" style="width: 100%;">Pilih Paket</a>
                            </div>
                        <% }) %>
                    <% } else { %>
                        <p class="text-center" style="grid-column: 1 / -1;">Informasi harga sedang disiapkan.</p>
                    <% } %>
                </div>
            </div>
        </section>
    </main>

    <footer class="section" style="border-top: 1px solid var(--glass-border); padding-bottom: 40px;">
        <div class="container text-center" style="color: var(--text-muted); font-size: 0.9rem;">
            &copy; <span id="year"></span> <%= settings.siteName || 'Dents Web' %>. All rights reserved.
        </div>
    </footer>
    <script>
        document.getElementById('year').textContent = new Date().getFullYear();
        window.addEventListener('scroll', () => document.getElementById('main-header').classList.toggle('scrolled', window.scrollY > 20));
        document.getElementById('hamburger-btn').addEventListener('click', () => document.getElementById('nav-links').classList.toggle('mobile-open'));
    </script>
</body>
</html>