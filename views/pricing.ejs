<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="theme-color" content="#05081c">
    
    <!-- DYNAMIC SEO GOLD STANDARD -->
    <title><%= typeof seo !== 'undefined' ? seo.title : 'Investasi Digital Transparan | Dents Web' %></title>
    <meta name="description" content="<%= typeof seo !== 'undefined' ? seo.desc : 'Skema harga transparan tanpa biaya siluman. Solusi website performa tinggi yang siap scale bisnis lu dari hari pertama.' %>">
    <meta name="keywords" content="<%= typeof seo !== 'undefined' ? seo.keywords : 'harga pembuatan website, biaya web developer, paket aplikasi mobile, harga website profesional' %>">
    <link rel="canonical" href="<%= typeof seo !== 'undefined' ? seo.url : 'https://dentsweb.my.id/pricing' %>">
    
    <!-- Google Site Verification -->
    <% if (typeof settings !== 'undefined' && settings.googleVerification) { %>
    <meta name="google-site-verification" content="<%= settings.googleVerification %>" />
    <% } %>
    
    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="article">
    <meta property="og:url" content="<%= typeof seo !== 'undefined' ? seo.url : 'https://dentsweb.my.id/pricing' %>">
    <meta property="og:title" content="<%= typeof seo !== 'undefined' ? seo.title : 'Investasi Digital Transparan | Dents Web' %>">
    <meta property="og:description" content="<%= typeof seo !== 'undefined' ? seo.desc : '' %>">
    <meta property="og:image" content="<%= typeof seo !== 'undefined' ? seo.image : '/public/img/axalogo.png' %>">
    
    <!-- Twitter Cards -->
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:url" content="<%= typeof seo !== 'undefined' ? seo.url : 'https://dentsweb.my.id/pricing' %>">
    <meta name="twitter:title" content="<%= typeof seo !== 'undefined' ? seo.title : 'Investasi Digital Transparan | Dents Web' %>">
    <meta name="twitter:description" content="<%= typeof seo !== 'undefined' ? seo.desc : '' %>">
    <meta name="twitter:image" content="<%= typeof seo !== 'undefined' ? seo.image : '/public/img/axalogo.png' %>">

    <!-- Schema.org JSON-LD -->
    <% if (typeof seo !== 'undefined' && seo.schemaString) { %>
    <script type="application/ld+json">
        <%- seo.schemaString %>
    </script>
    <% } %>
    
    <link rel="icon" type="image/png" href="<%= typeof settings !== 'undefined' && settings.favicon ? settings.favicon : '/public/img/axalogo.png' %>">
    <link rel="apple-touch-icon" href="<%= typeof settings !== 'undefined' && settings.logo ? settings.logo : '/public/img/axalogo.png' %>">
    
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Lexend+Deca:wght@500;600;700;800&family=Playfair+Display:ital,wght@1,400;1,500;1,600;1,700&family=Plus+Jakarta+Sans:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
    
    <link rel="stylesheet" href="/public/css/style.css">
</head>
<body>
    
    <%- include('partials/header') %>

    <main>
        <!-- Pricing Hero -->
        <section class="section-hero" style="min-height: 50vh; padding-top: 150px; padding-bottom: 70px;">
            <div class="orb-glow-blue" style="top: -10%; left: -5%;"></div>
            <div class="orb-glow-lime" style="bottom: -15%; right: 5%; opacity: 0.1;"></div>

            <div class="container text-center pptx-slide-up" style="position: relative; z-index: 2; max-width: 820px;">
                <div class="badge-tag-lime" style="margin-bottom: 20px;">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg>
                    PRICING JELAS &bull; NO HIDDEN COST
                </div>
                <h1 style="margin-bottom: 20px;">
                    Investasi Cerdas, <span class="font-editorial text-lime">Hasil Maksimal</span>
                </h1>
                <p style="font-size: 1.15rem; color: rgba(255,255,255,0.76); line-height: 1.75;">
                    Nggak ada biaya siluman di belakang layar. Pilih tier yang pas buat fase bisnis lu sekarang, upgrade kapan pun lu butuh scale lebih masif.
                </p>
            </div>
        </section>

        <!-- Pricing Cards Section -->
        <section class="section-white" style="padding-top: 70px; padding-bottom: 90px;">
            <div class="container">
                <div class="grid-4 pricing-grid-4" style="align-items: stretch;">
                    <% if (typeof pricing !== 'undefined' && pricing.length > 0) { %>
                        <% pricing.forEach((pkg, pIdx) => { %>
                            <div class="pricing-card-kalana <%= pkg.isFeatured ? 'featured' : '' %> pptx-slide-up pptx-stagger-<%= (pIdx % 4) + 1 %>">
                                <% if (pkg.isFeatured) { %>
                                    <div class="pricing-badge-popular">
                                        <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l2.4 7.4h7.6l-6.2 4.5 2.4 7.4-6.2-4.6-6.2 4.6 2.4-7.4-6.2-4.5h7.6z"/></svg>
                                        PILIHAN FAVORIT
                                    </div>
                                <% } %>

                                <div class="pricing-title-box">
                                    <h3 style="color: var(--navy-text); font-size: 1.25rem; margin-bottom: 8px; line-height: 1.35;"><%= pkg.name %></h3>
                                </div>
                                <div class="pricing-desc-box">
                                    <%= pkg.description %>
                                </div>
                                
                                <div class="pricing-price-box">
                                    <span style="font-size: 0.74rem; color: var(--slate-muted); font-weight: 800; text-transform: uppercase; letter-spacing: 0.05em;">Mulai Investasi</span>
                                    <div class="<%= pkg.isFeatured ? 'text-royal' : 'text-navy' %> price-amount">
                                        <%= pkg.price %>
                                    </div>
                                </div>
                                
                                <% 
                                    let featureList = [];
                                    if (pkg.features) {
                                        if (Array.isArray(pkg.features)) {
                                            featureList = pkg.features;
                                        } else if (typeof pkg.features === 'string') {
                                            featureList = pkg.features.split(',');
                                        }
                                    }
                                %>

                                <ul class="feature-check-list" style="margin-bottom: 16px;">
                                    <% featureList.forEach(feat => { %>
                                        <li class="feature-check-item" style="font-size: 0.86rem; line-height: 1.45; margin-bottom: 10px;">
                                            <span class="check-icon-circle" style="width: 18px; height: 18px; min-width: 18px;">
                                                <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
                                            </span> 
                                            <span><%= typeof feat === 'string' ? feat.trim() : feat %></span>
                                        </li>
                                    <% }) %>
                                </ul>

                                <% if (pkg.limitations && pkg.limitations.length > 0) { %>
                                    <div class="pricing-limitations-box" style="margin-top: 12px; margin-bottom: 16px; padding: 12px 14px; background: rgba(245, 158, 11, 0.08); border-left: 3px solid #f59e0b; border-radius: 8px;">
                                        <div style="font-size: 0.74rem; font-weight: 800; color: #b45309; text-transform: uppercase; letter-spacing: 0.04em; margin-bottom: 6px; display: flex; align-items: center; gap: 4px;">
                                            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line></svg>
                                            Catatan Realita Teknis:
                                        </div>
                                        <ul style="margin: 0; padding-left: 14px; font-size: 0.76rem; color: #78350f; line-height: 1.45;">
                                            <% (Array.isArray(pkg.limitations) ? pkg.limitations : [pkg.limitations]).forEach(lim => { %>
                                                <li><%= lim %></li>
                                            <% }) %>
                                        </ul>
                                    </div>
                                <% } %>

                                <div style="margin-top: auto; padding-top: 20px;">
                                    <% if (pkg.isFeatured) { %>
                                        <a href="/contact?package=<%= encodeURIComponent(pkg.name) %>" class="btn-royal" style="width: 100%; text-align: center; display: inline-flex; align-items: center; justify-content: center; gap: 8px;">
                                            Pilih Paket Ini
                                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="7" y1="17" x2="17" y2="7"></line><polyline points="7 7 17 7 17 17"></polyline></svg>
                                        </a>
                                    <% } else { %>
                                        <a href="/contact?package=<%= encodeURIComponent(pkg.name) %>" class="btn-ghost-navy" style="width: 100%; text-align: center; display: inline-flex; align-items: center; justify-content: center; gap: 8px;">
                                            Pilih Paket Ini
                                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="7" y1="17" x2="17" y2="7"></line><polyline points="7 7 17 7 17 17"></polyline></svg>
                                        </a>
                                    <% } %>
                                </div>
                            </div>
                        <% }) %>
                    <% } else { %>
                        <!-- Fallback 4 Packages with 100% SVG Icons -->
                        <!-- 1. Starter GAS -->
                        <div class="pricing-card-kalana pptx-slide-up pptx-stagger-1">
                            <div class="pricing-title-box">
                                <h3 style="color: var(--navy-text); font-size: 1.18rem; margin-bottom: 8px; line-height: 1.35;">Starter — Web Form &amp; Otomasi (GAS)</h3>
                            </div>
                            <div class="pricing-desc-box">
                                Website 1 - 3 halaman dan 1 - 4 section ringkas dengan integrasi database Google Sheets tanpa biaya hosting selamanya.
                            </div>
                            <div class="pricing-price-box">
                                <span style="font-size: 0.74rem; color: var(--slate-muted); font-weight: 800; text-transform: uppercase; letter-spacing: 0.05em;">Mulai Investasi</span>
                                <div class="price-amount text-navy">Rp 500.000</div>
                            </div>
                            <ul class="feature-check-list" style="margin-bottom: 16px;">
                                <li class="feature-check-item"><span class="check-icon-circle"><svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg></span>1 - 3 Halaman Responsif</li>
                                <li class="feature-check-item"><span class="check-icon-circle"><svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg></span>1 - 4 Section Fokus Konversi</li>
                                <li class="feature-check-item"><span class="check-icon-circle"><svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg></span>Database Realtime Google Sheets</li>
                                <li class="feature-check-item"><span class="check-icon-circle"><svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg></span>Integrasi Direct WhatsApp &amp; Maps</li>
                                <li class="feature-check-item"><span class="check-icon-circle"><svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg></span>Nol Biaya Server Selamanya</li>
                                <li class="feature-check-item"><span class="check-icon-circle"><svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg></span>Pengerjaan 2 - 4 Hari Kerja</li>
                            </ul>
                            <div class="pricing-limitations-box" style="margin-top: 12px; margin-bottom: 16px; padding: 12px 14px; background: rgba(245, 158, 11, 0.08); border-left: 3px solid #f59e0b; border-radius: 8px;">
                                <div style="font-size: 0.74rem; font-weight: 800; color: #b45309; text-transform: uppercase; letter-spacing: 0.04em; margin-bottom: 6px; display: flex; align-items: center; gap: 4px;">
                                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line></svg>
                                    Catatan Realita Teknis:
                                </div>
                                <ul style="margin: 0; padding-left: 14px; font-size: 0.76rem; color: #78350f; line-height: 1.45;">
                                    <li>Cold Start: Butuh 1-2 detik saat dibuka pertama kali</li>
                                    <li>Batas Kuota Google: Eksekusi maks. 6 menit per proses</li>
                                    <li>Bukan untuk checkout ribuan user bersamaan</li>
                                </ul>
                            </div>
                            <div style="margin-top: auto; padding-top: 20px;">
                                <a href="/contact?package=Starter" class="btn-ghost-navy" style="width: 100%; text-align: center; display: inline-flex; align-items: center; justify-content: center; gap: 8px;">Pilih Paket Ini</a>
                            </div>
                        </div>

                        <!-- 2. Business -->
                        <div class="pricing-card-kalana pptx-slide-up pptx-stagger-2">
                            <div class="pricing-title-box">
                                <h3 style="color: var(--navy-text); font-size: 1.18rem; margin-bottom: 8px; line-height: 1.35;">Business — High-Converting Landing Page</h3>
                            </div>
                            <div class="pricing-desc-box">
                                Landing page 1 - 6 halaman terintegrasi yang dirancang khusus untuk mengubah pengunjung iklan menjadi pembeli.
                            </div>
                            <div class="pricing-price-box">
                                <span style="font-size: 0.74rem; color: var(--slate-muted); font-weight: 800; text-transform: uppercase; letter-spacing: 0.05em;">Mulai Investasi</span>
                                <div class="price-amount text-navy">Rp 1.500.000</div>
                            </div>
                            <ul class="feature-check-list">
                                <li class="feature-check-item"><span class="check-icon-circle"><svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg></span>1 - 6 Halaman Responsif (Sales Page)</li>
                                <li class="feature-check-item"><span class="check-icon-circle"><svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg></span>Struktur Psikologi Closing &amp; Copywriting</li>
                                <li class="feature-check-item"><span class="check-icon-circle"><svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg></span>Core Web Vitals Skor 95+ (Super Cepat)</li>
                                <li class="feature-check-item"><span class="check-icon-circle"><svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg></span>Domain (.com) &amp; Cloudflare SSL 1 Thn</li>
                                <li class="feature-check-item"><span class="check-icon-circle"><svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg></span>High-Speed SSD Cloud Hosting 1 Thn</li>
                                <li class="feature-check-item"><span class="check-icon-circle"><svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg></span>Direct WhatsApp Button Teks Otomatis</li>
                                <li class="feature-check-item"><span class="check-icon-circle"><svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg></span>Pengerjaan 3 - 5 Hari Kerja (Garansi 14 Hari)</li>
                            </ul>
                            <div style="margin-top: auto; padding-top: 20px;">
                                <a href="/contact?package=Business" class="btn-ghost-navy" style="width: 100%; text-align: center; display: inline-flex; align-items: center; justify-content: center; gap: 8px;">Pilih Paket Ini</a>
                            </div>
                        </div>

                        <!-- 3. Pro (Favorit) -->
                        <div class="pricing-card-kalana featured pptx-slide-up pptx-stagger-3">
                            <div class="pricing-badge-popular">
                                <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l2.4 7.4h7.6l-6.2 4.5 2.4 7.4-6.2-4.6-6.2 4.6 2.4-7.4-6.2-4.5h7.6z"/></svg>
                                PILIHAN FAVORIT
                            </div>
                            <div class="pricing-title-box">
                                <h3 style="color: var(--navy-text); font-size: 1.18rem; margin-bottom: 8px; line-height: 1.35;">Pro — Corporate Company Profile</h3>
                            </div>
                            <div class="pricing-desc-box">
                                Website profil bisnis multi-halaman berwibawa dengan CMS mandiri dan optimasi SEO Google untuk reputasi perusahaan.
                            </div>
                            <div class="pricing-price-box">
                                <span style="font-size: 0.74rem; color: var(--slate-muted); font-weight: 800; text-transform: uppercase; letter-spacing: 0.05em;">Mulai Investasi</span>
                                <div class="price-amount text-royal">Rp 3.500.000</div>
                            </div>
                            <ul class="feature-check-list">
                                <li class="feature-check-item"><span class="check-icon-circle"><svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg></span>5 - 8 Halaman Dinamis Premium</li>
                                <li class="feature-check-item"><span class="check-icon-circle"><svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg></span>Panel Admin / CMS Mandiri (Edit Bebas)</li>
                                <li class="feature-check-item"><span class="check-icon-circle"><svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg></span>Domain (.com/.id/.co.id) &amp; Cloud Host 1 Thn</li>
                                <li class="feature-check-item"><span class="check-icon-circle"><svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg></span>Hingga 1 Email Bisnis Resmi (@perusahaan.com)</li>
                                <li class="feature-check-item"><span class="check-icon-circle"><svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg></span>Dynamic Schema SEO Google Ready</li>
                                <li class="feature-check-item"><span class="check-icon-circle"><svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg></span>Form Kontak Leads &amp; Peta Google Maps</li>
                                <li class="feature-check-item"><span class="check-icon-circle"><svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg></span>Garansi Bug-Free 30 Hari &amp; Video Panduan</li>
                            </ul>
                            <div style="margin-top: auto; padding-top: 20px;">
                                <a href="/contact?package=Pro" class="btn-royal" style="width: 100%; text-align: center; display: inline-flex; align-items: center; justify-content: center; gap: 8px;">Pilih Paket Ini</a>
                            </div>
                        </div>

                        <!-- 4. Custom+ -->
                        <div class="pricing-card-kalana pptx-slide-up pptx-stagger-4">
                            <div class="pricing-title-box">
                                <h3 style="color: var(--navy-text); font-size: 1.18rem; margin-bottom: 8px; line-height: 1.35;">Custom+ — Web Application</h3>
                            </div>
                            <div class="pricing-desc-box">
                                Sistem web aplikasi khusus untuk operasional bisnis, kasir web, reservasi, portal data, dan integrasi database cloud.
                            </div>
                            <div class="pricing-price-box">
                                <span style="font-size: 0.74rem; color: var(--slate-muted); font-weight: 800; text-transform: uppercase; letter-spacing: 0.05em;">Mulai Investasi</span>
                                <div class="price-amount text-navy">Rp 7.500.000+</div>
                            </div>
                            <ul class="feature-check-list">
                                <li class="feature-check-item"><span class="check-icon-circle"><svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg></span>10 - 12 Halaman Terintegrasi Sesuai SOP</li>
                                <li class="feature-check-item"><span class="check-icon-circle"><svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg></span>Full-Stack Architecture (Node.js/Cloud DB)</li>
                                <li class="feature-check-item"><span class="check-icon-circle"><svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg></span>Multi-Role User &amp; Granular Permissions</li>
                                <li class="feature-check-item"><span class="check-icon-circle"><svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg></span>Integrasi API &amp; Payment Gateway</li>
                                <li class="feature-check-item"><span class="check-icon-circle"><svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg></span>Laporan Otomatis &amp; Ekspor PDF/Excel</li>
                                <li class="feature-check-item"><span class="check-icon-circle"><svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg></span>100% Hak Milik Source Code &amp; Dokumen</li>
                                <li class="feature-check-item"><span class="check-icon-circle"><svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg></span>Dedicated Support Prioritas 60 Hari</li>
                            </ul>
                            <div style="margin-top: auto; padding-top: 20px;">
