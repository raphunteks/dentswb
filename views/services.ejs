<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="theme-color" content="#05081c">
    
    <!-- DYNAMIC SEO GOLD STANDARD -->
    <title><%= typeof seo !== 'undefined' ? seo.title : 'Layanan Kami | Dents Web' %></title>
    <meta name="description" content="<%= typeof seo !== 'undefined' ? seo.desc : 'Jasa pembuatan website dan aplikasi profesional berkinerja tinggi.' %>">
    <meta name="keywords" content="<%= typeof seo !== 'undefined' ? seo.keywords : 'jasa pembuatan website, web developer, aplikasi mobile, solusi digital, web custom' %>">
    <link rel="canonical" href="<%= typeof seo !== 'undefined' ? seo.url : 'https://dentsweb.my.id/services' %>">
    
    <!-- Google Site Verification -->
    <% if (typeof settings !== 'undefined' && settings.googleVerification) { %>
    <meta name="google-site-verification" content="<%= settings.googleVerification %>" />
    <% } %>
    
    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="article">
    <meta property="og:url" content="<%= typeof seo !== 'undefined' ? seo.url : 'https://dentsweb.my.id/services' %>">
    <meta property="og:title" content="<%= typeof seo !== 'undefined' ? seo.title : 'Layanan Kami | Dents Web' %>">
    <meta property="og:description" content="<%= typeof seo !== 'undefined' ? seo.desc : '' %>">
    <meta property="og:image" content="<%= typeof seo !== 'undefined' ? seo.image : '/public/img/axalogo.png' %>">
    
    <!-- Twitter Cards -->
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:url" content="<%= typeof seo !== 'undefined' ? seo.url : 'https://dentsweb.my.id/services' %>">
    <meta name="twitter:title" content="<%= typeof seo !== 'undefined' ? seo.title : 'Layanan Kami | Dents Web' %>">
    <meta name="twitter:description" content="<%= typeof seo !== 'undefined' ? seo.desc : '' %>">
    <meta name="twitter:image" content="<%= typeof seo !== 'undefined' ? seo.image : '/public/img/axalogo.png' %>">

    <!-- Schema.org JSON-LD -->
    <% if (typeof seo !== 'undefined' && seo.schemaString) { %>
    <script type="application/ld+json">
        <%- seo.schemaString %>
    </script>
    <% } %>
    
    <link rel="icon" type="image/png" href="<%= typeof settings !== 'undefined' && settings.favicon ? settings.favicon : '/public/img/axalogo.png' %>">
    <link rel="apple-touch-icon" href="<%= typeof settings !== 'undefined' && settings.logo ? settings.logo : '/public/img/axalogo.png' %>">
    
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Lexend+Deca:wght@500;600;700;800&family=Playfair+Display:ital,wght@1,400;1,500;1,600;1,700&family=Plus+Jakarta+Sans:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
    
    <link rel="stylesheet" href="/public/css/style.css">
</head>
<body>
    
    <%- include('partials/header') %>

    <main>
        <!-- Services Hero -->
        <section class="section-hero" style="min-height: 50vh; padding-top: 150px; padding-bottom: 70px;">
            <div class="orb-glow-blue" style="top: -10%; left: -5%;"></div>
            <div class="orb-glow-lime" style="bottom: -15%; right: 5%; opacity: 0.1;"></div>

            <div class="container text-center" style="position: relative; z-index: 2; max-width: 800px;">
                <div class="badge-tag-lime" style="margin-bottom: 20px;">
                    <svg class="svg-icon svg-icon-sm" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="20" height="14" x="2" y="3" rx="2"/><line x1="8" x2="16" y1="21" y2="21"/><line x1="12" x2="12" y1="17" y2="21"/></svg>
                    <span>SOLUSI DIGITAL BISNIS</span>
                </div>
                <h1 style="margin-bottom: 20px;">
                    Layanan &amp; Solusi <span class="font-editorial text-lime">Terbaik Kami</span>
                </h1>
                <p style="font-size: 1.15rem; color: rgba(255,255,255,0.76); line-height: 1.75;">
                    Pilih arsitektur digital yang tepat untuk mempercepat pertumbuhan bisnis Anda. Dari landing page konversi hingga sistem web terintegrasi khusus perusahaan.
                </p>
            </div>
        </section>

        <!-- Services Catalog Grid -->
        <section class="section-white" style="padding-top: 70px;">
            <div class="container">
                <div class="grid-3">
                    <% if (typeof services !== 'undefined' && services.length > 0) { %>
                        <% services.forEach(service => { %>
                            <div class="tactile-card tactile-card-heavy" style="display: flex; flex-direction: column;">
                                <div style="width: 52px; height: 52px; border-radius: 14px; background: rgba(33, 82, 207, 0.1); color: var(--royal-blue); display: flex; align-items: center; justify-content: center; margin-bottom: 20px;">
                                    <svg class="svg-icon svg-icon-lg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="20" height="14" x="2" y="3" rx="2"/><line x1="8" x2="16" y1="21" y2="21"/><line x1="12" x2="12" y1="17" y2="21"/></svg>
                                </div>
                                <h2 style="font-size: 1.45rem; color: var(--navy-text); margin-bottom: 12px;"><%= service.title %></h2>
                                <p style="font-size: 0.95rem; color: var(--slate-body); margin-bottom: 24px; line-height: 1.7; flex-grow: 1;">
                                    <%= service.description || service.shortDescription %>
                                </p>
                                
                                <% 
                                    let featureList = [];
                                    if (service.features) {
                                        if (Array.isArray(service.features)) {
                                            featureList = service.features;
                                        } else if (typeof service.features === 'string') {
                                            featureList = service.features.split(',');
                                        }
                                    }
                                %>
                                
                                <% if (featureList.length > 0) { %>
                                    <div style="margin-bottom: 24px;">
                                        <div style="font-size: 0.8rem; font-weight: 800; text-transform: uppercase; color: var(--royal-blue); letter-spacing: 1px; margin-bottom: 12px;">Fitur &amp; Keunggulan:</div>
                                        <ul class="feature-check-list" style="margin: 0;">
                                            <% featureList.forEach(feat => { %>
                                                <li class="feature-check-item">
                                                    <span class="check-icon-circle">✓</span> 
                                                    <span><%= typeof feat === 'string' ? feat.trim() : feat %></span>
                                                </li>
                                            <% }) %>
                                        </ul>
                                    </div>
                                <% } %>
                                
                                <div style="margin-top: auto; border-top: 2px solid var(--border-light); padding-top: 20px;">
                                    <div style="font-size: 0.8rem; color: var(--slate-muted); text-transform: uppercase; font-weight: 700; letter-spacing: 1px;">Mulai dari</div>
                                    <div style="font-weight: 800; font-size: 1.6rem; color: var(--navy-text); margin-bottom: 16px;"><%= service.startingPrice || 'Hubungi Kami' %></div>
                                    
                                    <a href="/contact?service=<%= service.slug || 'custom' %>" class="btn-royal" style="width: 100%; text-align: center;">
                                        <span>Konsultasi Layanan</span>
                                        <svg class="svg-icon svg-icon-sm" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 7h10v10"></path><path d="M7 17 17 7"></path></svg>
                                    </a>
                                </div>
                            </div>
                        <% }) %>
                    <% } %>
                </div>

                <!-- Three Guarantees (Pure SVG Icons) -->
                <div class="grid-3" style="margin-top: 80px;">
                    <div class="tactile-card" style="padding: 28px;">
                        <div style="width: 44px; height: 44px; border-radius: 12px; background: rgba(33, 82, 207, 0.1); color: var(--royal-blue); display: flex; align-items: center; justify-content: center; margin-bottom: 16px;">
                            <svg class="svg-icon svg-icon-md" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>
                        </div>
                        <h4 style="font-size: 1.2rem; color: var(--navy-text); margin-bottom: 8px;">Kecepatan &amp; Core Web Vitals</h4>
                        <p style="font-size: 0.95rem; color: var(--slate-body); margin: 0;">Optimasi kode maksimal agar website terbuka instan di semua koneksi dan disukai algoritma Google.</p>
                    </div>
                    <div class="tactile-card" style="padding: 28px;">
                        <div style="width: 44px; height: 44px; border-radius: 12px; background: rgba(0, 200, 83, 0.12); color: var(--success); display: flex; align-items: center; justify-content: center; margin-bottom: 16px;">
                            <svg class="svg-icon svg-icon-md" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
                        </div>
                        <h4 style="font-size: 1.2rem; color: var(--navy-text); margin-bottom: 8px;">Keamanan Berlapis</h4>
                        <p style="font-size: 0.95rem; color: var(--slate-body); margin: 0;">Header keamanan tingkat enterprise, pencegahan rate-limit, dan sanitasi input form untuk melindungi reputasi bisnis.</p>
                    </div>
                    <div class="tactile-card" style="padding: 28px;">
                        <div style="width: 44px; height: 44px; border-radius: 12px; background: rgba(217, 255, 66, 0.25); color: var(--navy-text); display: flex; align-items: center; justify-content: center; margin-bottom: 16px;">
                            <svg class="svg-icon svg-icon-md" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 2l-2 2m-7.61 7.61a5.5 5.5 0 1 1-7.778 7.778 5.5 5.5 0 0 1 7.777-7.777zm0 0L15.5 7.5m0 0l3 3L22 7l-3-3m-3.5 3.5L19 4"/></svg>
                        </div>
                        <h4 style="font-size: 1.2rem; color: var(--navy-text); margin-bottom: 8px;">Kepemilikan Penuh 100%</h4>
                        <p style="font-size: 0.95rem; color: var(--slate-body); margin: 0;">Seluruh source code, kredensial domain, dan akses hosting diserahkan penuh tanpa biaya sewa tersembunyi.</p>
                    </div>
                </div>
            </div>
        </section>
    </main>

    <%- include('partials/footer') %>

</body>
</html>
