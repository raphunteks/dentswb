<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="theme-color" content="#05081c">
    
    <!-- DYNAMIC SEO GOLD STANDARD -->
    <title><%= typeof seo !== 'undefined' ? seo.title : 'Layanan Kami | Dents Web' %></title>
    <meta name="description" content="<%= typeof seo !== 'undefined' ? seo.desc : 'Jasa pembuatan website dan aplikasi profesional berkinerja tinggi.' %>">
    <meta name="keywords" content="<%= typeof seo !== 'undefined' ? seo.keywords : 'jasa pembuatan website, web developer, aplikasi mobile, solusi digital, web custom' %>">
    <link rel="canonical" href="<%= typeof seo !== 'undefined' ? seo.url : 'https://www.dentsweb.my.id/services' %>">
    <meta name="referrer" content="origin-when-cross-origin">
    <% if (typeof settings !== 'undefined' && settings.analyticsId) { %>
    <script async src="https://www.googletagmanager.com/gtag/js?id=<%= settings.analyticsId %>"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', '<%= settings.analyticsId %>');
    </script>
    <% } %>
    
    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="article">
    <meta property="og:url" content="<%= typeof seo !== 'undefined' ? seo.url : 'https://www.dentsweb.my.id/services' %>">
    <meta property="og:title" content="<%= typeof seo !== 'undefined' ? seo.title : 'Layanan Kami | Dents Web' %>">
    <meta property="og:description" content="<%= typeof seo !== 'undefined' ? seo.desc : '' %>">
    <meta property="og:image" content="<%= typeof seo !== 'undefined' ? seo.image : '/public/img/axalogo.png' %>">
    
    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:url" content="<%= typeof seo !== 'undefined' ? seo.url : 'https://www.dentsweb.my.id/services' %>">
    <meta name="twitter:title" content="<%= typeof seo !== 'undefined' ? seo.title : 'Layanan Kami | Dents Web' %>">
    <meta name="twitter:description" content="<%= typeof seo !== 'undefined' ? seo.desc : '' %>">
    <meta name="twitter:image" content="<%= typeof seo !== 'undefined' ? seo.image : '/public/img/axalogo.png' %>">

    <!-- Schema.org JSON-LD -->
    <% if (typeof seo !== 'undefined' && seo.schemaString) { %>
    <script type="application/ld+json">
        <%- seo.schemaString %>
    </script>
    <% } %>
    
    <link rel="icon" type="image/png" href="<%= typeof settings !== 'undefined' && settings.favicon ? settings.favicon : '/public/img/axalogo.png' %>">
    <link rel="apple-touch-icon" href="<%= typeof settings !== 'undefined' && settings.logo ? settings.logo : '/public/img/axalogo.png' %>">
    
    <!-- Ultra High-Speed Non-Blocking Web Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Lexend+Deca:wght@500;600;700;800&family=Playfair+Display:ital,wght@1,400;1,500;1,600;1,700&family=Plus+Jakarta+Sans:wght@400;500;600;700;800;900&display=swap">
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Lexend+Deca:wght@500;600;700;800&family=Playfair+Display:ital,wght@1,400;1,500;1,600;1,700&family=Plus+Jakarta+Sans:wght@400;500;600;700;800;900&display=swap" media="print" onload="this.media='all'">
    <noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Lexend+Deca:wght@500;600;700;800&family=Playfair+Display:ital,wght@1,400;1,500;1,600;1,700&family=Plus+Jakarta+Sans:wght@400;500;600;700;800;900&display=swap"></noscript>
    <link rel="stylesheet" href="/public/css/style.css?v=4.2.1">

    <!-- GSAP 3 & ScrollTrigger Engine (Deferred) -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js" defer></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/ScrollTrigger.min.js" defer></script>
    <script src="/public/js/animations.js?v=4.2.1" defer></script>
</head>
<body>
    
    <%- include('partials/header') %>

    <main>
        <!-- Services Hero -->
        <section class="section-hero" style="min-height: 50vh; padding-top: 150px; padding-bottom: 70px;">
            <div class="orb-glow-blue" style="top: -10%; left: -5%;"></div>
            <div class="orb-glow-lime" style="bottom: -15%; right: 5%; opacity: 0.1;"></div>

            <div class="container text-center pptx-slide-up" style="position: relative; z-index: 2; max-width: 800px;">
                <div class="badge-tag-lime" style="margin-bottom: 20px;">
                    <svg class="svg-icon svg-icon-sm" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="20" height="14" x="2" y="3" rx="2"/><line x1="8" x2="16" y1="21" y2="21"/><line x1="12" x2="12" y1="17" y2="21"/></svg>
                    <span>SOLUSI DIGITAL BISNIS</span>
                </div>
                <h1 style="margin-bottom: 20px;">
                    Layanan &amp; Solusi <span class="font-editorial text-lime">Terbaik Kami</span>
                </h1>
                <p style="font-size: 1.15rem; color: rgba(255,255,255,0.76); line-height: 1.75;">
                    Pilih arsitektur digital yang tepat untuk mempercepat pertumbuhan bisnis Anda. Dari landing page konversi hingga sistem web terintegrasi khusus perusahaan.
                </p>
            </div>
        </section>

        <!-- Services Catalog Grid -->
        <section class="section-white" style="padding-top: 70px;">
            <div class="container">
                <div class="grid-4 pricing-grid-4">
                    <% 
                        let displayServices = (typeof services !== 'undefined' && services && services.length > 0) ? services : [
                            {
                                id: 'serv_1',
                                slug: 'landing-page',
                                title: 'Landing Page — Fokus Konversi',
                                description: 'Website satu halaman yang dirancang khusus untuk mengubah pengunjung menjadi pembeli. Sangat optimal untuk kampanye iklan Google Ads, Meta Ads, TikTok Ads, dan peluncuran produk.',
                                startingPrice: 'Mulai Rp 1.300.000',
                                features: [
                                    'Satu halaman fokus konversi tinggi',
                                    'Psikologi closing & copywriting persuasif',
                                    'Core Web Vitals Skor 95+ (Loading < 1 detik)',
                                    'Gratis Domain, Hosting & SSL 1 Tahun',
                                    'Tersedia paket Core, Premier, Signature & Prestige'
                                ]
                            },
                            {
                                id: 'serv_2',
                                slug: 'company-profile',
                                title: 'Corporate Company Profile',
                                description: 'Website representatif 5 halaman lengkap (Home, About, Layanan, Portofolio, Kontak) untuk membangun otoritas bisnis dan kepercayaan mitra B2B, investor, serta tender resmi.',
                                startingPrice: 'Mulai Rp 3.000.000',
                                features: [
                                    '5 Halaman profil korporat lengkap & elegan',
                                    'Panel Admin CMS bahasa Indonesia mandiri',
                                    'Hingga 1 Email Bisnis Resmi (@perusahaan.com)',
                                    'On-page SEO lengkap dengan Google Schema JSON-LD',
                                    'Tersedia paket Core, Premier, Signature & Prestige'
                                ]
                            },
                            {
                                id: 'serv_3',
                                slug: 'e-commerce',
                                title: 'Toko Online & E-Commerce',
                                description: 'Toko online Shopify atau full-stack kustom dengan checkout flow instan, katalog terstruktur, dan integrasi payment gateway otomatis (QRIS, VA, Kartu).',
                                startingPrice: 'Mulai Rp 6.000.000',
                                features: [
                                    'Desain custom Shopify / Full-Stack sesuai brand',
                                    'Checkout flow siap pakai & payment gateway resmi',
                                    'Koneksi domain & SSL Cloudflare gratis',
                                    'Setup SEO Google, Search Console & GA4',
                                    '3x revisi & 1 sesi pelatihan admin (30 menit)'
                                ]
                            },
                            {
                                id: 'serv_4',
                                slug: 'web-app',
                                title: 'Custom+ Web Application & Sistem Bisnis',
                                description: 'Pengembangan sistem web dinamis khusus (10–12 halaman) dengan arsitektur database cloud SQL/NoSQL, multi-role user auth, dan integrasi API payment gateway atau sistem pihak ketiga.',
                                startingPrice: 'Rp 7.500.000+',
                                features: [
                                    '10–12 Halaman sistem terstruktur & fleksibel',
                                    'Database cloud scalable (PostgreSQL, MySQL, atau Redis)',
                                    'Multi-role akses (Admin, Pegawai, Pelanggan)',
                                    'Integrasi API (Payment Gateway, Kurir, WhatsApp Webhook)',
                                    'Dashboard analitik data bisnis & ekspor laporan PDF/Excel',
                                    'Source code 100% kepemilikan Anda, tanpa lock-in vendor'
                                ]
                            }
                        ];
                    %>
                    <% displayServices.forEach((service, idx) => { %>
                        <div class="tactile-card tactile-card-heavy service-card-kalana pptx-slide-up pptx-stagger-<%= (idx % 4) + 1 %>" style="padding: 28px 22px;">
                            <% if (service.slug === 'company-profile' || idx === 1) { %>
                                <div style="position: absolute; top: 16px; right: 16px; background: var(--royal-blue); color: #fff; font-size: 0.72rem; font-weight: 800; padding: 4px 10px; border-radius: 999px; text-transform: uppercase; letter-spacing: 0.8px;">
                                    Pilihan Favorit
                                </div>
                            <% } %>
                            <div class="service-card-header">
                                <div style="width: 46px; height: 46px; border-radius: 12px; background: rgba(33, 82, 207, 0.1); color: var(--royal-blue); display: flex; align-items: center; justify-content: center; margin-bottom: 14px;">
                                    <% if (idx === 0 || service.slug === 'landing-page') { %>
                                        <svg class="svg-icon svg-icon-md" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><circle cx="12" cy="12" r="6"/><circle cx="12" cy="12" r="2"/></svg>
                                    <% } else if (idx === 1 || service.slug === 'company-profile') { %>
                                        <svg class="svg-icon svg-icon-md" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="3" width="20" height="14" rx="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/></svg>
                                    <% } else if (idx === 2 || service.slug === 'e-commerce') { %>
                                        <svg class="svg-icon svg-icon-md" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/></svg>
                                    <% } else { %>
                                        <svg class="svg-icon svg-icon-md" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="2" width="20" height="8" rx="2" ry="2"/><rect x="2" y="14" width="20" height="8" rx="2" ry="2"/><line x1="6" y1="6" x2="6.01" y2="6"/><line x1="6" y1="18" x2="6.01" y2="18"/></svg>
                                    <% } %>
                                </div>
                                <h2 style="font-size: 1.25rem; color: var(--navy-text); margin-bottom: 8px; line-height: 1.35;"><%= service.title %></h2>
                            </div>
                            <div class="service-card-desc">
                                <%= service.description || service.shortDescription %>
                            </div>
                            
                            <% 
                                let featureList = [];
                                if (service.features) {
                                    if (Array.isArray(service.features)) {
                                        featureList = service.features;
                                    } else if (typeof service.features === 'string') {
                                        featureList = service.features.split(',');
                                    }
                                }
                            %>
                            
                            <div class="service-features-heading">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
                                <span>Fitur &amp; Keunggulan:</span>
                            </div>

                            <% if (featureList.length > 0) { %>
                                <ul class="feature-check-list" style="margin: 0 0 16px 0; min-height: 180px;">
                                    <% featureList.forEach(feat => { %>
                                        <li class="feature-check-item" style="font-size: 0.88rem; margin-bottom: 6px;">
                                            <span class="check-icon-circle" style="width: 18px; height: 18px; min-width: 18px;">
                                                <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
                                            </span> 
                                            <span><%= typeof feat === 'string' ? feat.trim() : feat %></span>
                                        </li>
                                    <% }) %>
                                </ul>
                            <% } %>

                            <div style="margin-top: auto; border-top: 2px solid var(--border-light); padding-top: 18px;">
                                <div style="font-size: 0.76rem; color: var(--slate-muted); text-transform: uppercase; font-weight: 700; letter-spacing: 0.8px;">Mulai dari</div>
                                <div style="font-weight: 800; font-size: 1.5rem; color: var(--navy-text); margin-bottom: 14px;"><%= service.startingPrice || 'Hubungi Kami' %></div>
                                
                                <a href="/contact?service=<%= service.slug || 'custom' %>" class="btn-royal" style="width: 100%; text-align: center; font-size: 0.9rem; padding: 10px 16px;">
                                    <span>Konsultasi Layanan</span>
                                    <svg class="svg-icon svg-icon-sm" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 7h10v10"></path><path d="M7 17 17 7"></path></svg>
                                </a>
                            </div>
                        </div>
                    <% }) %>
                </div>

                <!-- Three Guarantees (Pure SVG Icons) -->
                <div class="grid-3" style="margin-top: 80px;">
                    <div class="tactile-card pptx-scale-in pptx-stagger-1" style="padding: 28px;">
                        <div style="width: 44px; height: 44px; border-radius: 12px; background: rgba(33, 82, 207, 0.1); color: var(--royal-blue); display: flex; align-items: center; justify-content: center; margin-bottom: 16px;">
                            <svg class="svg-icon svg-icon-md" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>
                        </div>
                        <h4 style="font-size: 1.2rem; color: var(--navy-text); margin-bottom: 8px;">Kecepatan &amp; Core Web Vitals</h4>
                        <p style="font-size: 0.95rem; color: var(--slate-body); margin: 0;">Optimasi kode maksimal agar website terbuka instan di semua koneksi dan disukai algoritma Google.</p>
                    </div>
                    <div class="tactile-card pptx-scale-in pptx-stagger-2" style="padding: 28px;">
                        <div style="width: 44px; height: 44px; border-radius: 12px; background: rgba(0, 200, 83, 0.12); color: var(--success); display: flex; align-items: center; justify-content: center; margin-bottom: 16px;">
                            <svg class="svg-icon svg-icon-md" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
                        </div>
                        <h4 style="font-size: 1.2rem; color: var(--navy-text); margin-bottom: 8px;">Keamanan Berlapis</h4>
                        <p style="font-size: 0.95rem; color: var(--slate-body); margin: 0;">Header keamanan tingkat enterprise, pencegahan rate-limit, dan sanitasi input form untuk melindungi reputasi bisnis.</p>
                    </div>
                    <div class="tactile-card pptx-scale-in pptx-stagger-3" style="padding: 28px;">
                        <div style="width: 44px; height: 44px; border-radius: 12px; background: rgba(217, 255, 66, 0.25); color: var(--navy-text); display: flex; align-items: center; justify-content: center; margin-bottom: 16px;">
                            <svg class="svg-icon svg-icon-md" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 2l-2 2m-7.61 7.61a5.5 5.5 0 1 1-7.778 7.778 5.5 5.5 0 0 1 7.777-7.777zm0 0L15.5 7.5m0 0l3 3L22 7l-3-3m-3.5 3.5L19 4"/></svg>
                        </div>
                        <h4 style="font-size: 1.2rem; color: var(--navy-text); margin-bottom: 8px;">Kepemilikan Penuh 100%</h4>
                        <p style="font-size: 0.95rem; color: var(--slate-body); margin: 0;">Seluruh source code, kredensial domain, dan akses hosting diserahkan penuh tanpa biaya sewa tersembunyi.</p>
                    </div>
                </div>
            </div>
        </section>
    </main>

    <%- include('partials/footer') %>

</body>
</html>
